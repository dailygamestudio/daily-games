<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no">
<title>Neon Conduit - Day 23</title>
<style>
* { margin: 0; padding: 0; box-sizing: border-box; }
body { 
    background: #0a0a12; 
    min-height: 100vh; 
    display: flex; 
    flex-direction: column; 
    align-items: center; 
    justify-content: center; 
    font-family: 'Orbitron', 'Courier New', monospace; 
    color: #00ffff; 
    overflow: hidden;
    touch-action: none;
}
@import url('https://fonts.googleapis.com/css2?family=Orbitron:wght@400;700;900&display=swap');

#gameContainer { position: relative; }
canvas { display: block; border-radius: 8px; box-shadow: 0 0 40px rgba(0,255,255,0.3), inset 0 0 40px rgba(0,255,255,0.05); }

#ui {
    position: absolute; top: 0; left: 0; right: 0; bottom: 0;
    pointer-events: none; display: flex; flex-direction: column;
}
#topBar { display: flex; justify-content: space-between; padding: 16px 24px; pointer-events: auto; }
.panel { background: rgba(0,20,40,0.9); border: 1px solid #00ffff44; border-radius: 8px; padding: 8px 16px; backdrop-filter: blur(10px); }
.panel h3 { font-size: 10px; font-weight: 400; color: #00ffff88; text-transform: uppercase; letter-spacing: 2px; margin-bottom: 4px; }
.panel .value { font-size: 22px; font-weight: 700; color: #00ffff; text-shadow: 0 0 10px #00ffff; font-variant-numeric: tabular-nums; }
#levelPanel .value { color: #ffcc00; text-shadow: 0 0 10px #ffcc00; }
#timerBar { height: 4px; background: #001122; border-radius: 2px; margin-top: 8px; overflow: hidden; width: 200px; border: 1px solid #00ffff44; }
#timerFill { height: 100%; background: linear-gradient(90deg, #00ffff, #ff00ff); border-radius: 2px; transition: width 0.1s linear, background 0.3s; box-shadow: 0 0 10px #00ffff; }
#timerFill.warning { background: linear-gradient(90deg, #ffcc00, #ff6600); box-shadow: 0 0 10px #ffcc00; }
#timerFill.danger { background: linear-gradient(90deg, #ff3333, #ff0066); box-shadow: 0 0 10px #ff3333; }

#bottomBar { display: flex; justify-content: space-between; padding: 16px 24px; margin-top: auto; pointer-events: auto; }
.btn { background: rgba(0,20,40,0.9); border: 1px solid #00ffff44; color: #00ffff; padding: 10px 20px; border-radius: 6px; font-family: inherit; font-size: 12px; font-weight: 700; text-transform: uppercase; letter-spacing: 1px; cursor: pointer; transition: all 0.2s; backdrop-filter: blur(10px); touch-action: manipulation; }
.btn:hover, .btn:active { background: rgba(0,255,255,0.2); box-shadow: 0 0 20px #00ffff88; border-color: #00ffff; }
.btn:disabled { opacity: 0.4; cursor: not-allowed; }

#overlay { 
    position: fixed; top: 0; left: 0; right: 0; bottom: 0; 
    background: rgba(0,0,0,0.95); display: flex; flex-direction: column; align-items: center; justify-content: center; 
    z-index: 100; opacity: 0; visibility: hidden; transition: all 0.4s ease; backdrop-filter: blur(20px);
}
#overlay.active { opacity: 1; visibility: visible; }
#overlay h1 { font-size: clamp(32px, 8vw, 64px); font-weight: 900; background: linear-gradient(135deg, #00ffff, #ff00ff, #00ffff); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text; text-shadow: none; margin-bottom: 8px; letter-spacing: 4px; animation: pulse 2s ease-in-out infinite; }
@keyframes pulse { 0%,100% { filter: brightness(1); } 50% { filter: brightness(1.5); } }
#overlay p { color: #00ffff88; margin-bottom: 24px; font-size: 14px; letter-spacing: 2px; text-transform: uppercase; }
#overlay .stats { display: flex; gap: 32px; margin: 24px 0; text-align: center; }
#overlay .stat { display: flex; flex-direction: column; }
#overlay .stat-label { font-size: 10px; color: #00ffff44; text-transform: uppercase; letter-spacing: 2px; margin-bottom: 4px; }
#overlay .stat-value { font-size: 28px; font-weight: 700; color: #00ffff; text-shadow: 0 0 15px #00ffff; }
#overlay .stat-value.high { color: #ffcc00; text-shadow: 0 0 15px #ffcc00; }

#particles { position: fixed; top: 0; left: 0; right: 0; bottom: 0; pointer-events: none; z-index: 1; }
.scanline { position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: repeating-linear-gradient(0deg, transparent, transparent 2px, rgba(0,255,255,0.02) 2px, rgba(0,255,255,0.02) 4px); pointer-events: none; z-index: 200; animation: scan 8s linear infinite; }
@keyframes scan { 0% { transform: translateY(-100%); } 100% { transform: translateY(100%); } }

.overlay {
    position: fixed;
    top: 0; left: 0; right: 0; bottom: 0;
    background: rgba(0,0,0,0.95);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    z-index: 100;
    gap: 20px;
    padding: 20px;
}
.overlay.hidden { display: none; }
.overlay h1 { font-size: clamp(32px, 8vw, 64px); text-shadow: 0 0 30px #00ffea; letter-spacing: 4px; }
.overlay p { color: #00ffea88; font-size: 14px; text-align: center; max-width: 400px; line-height: 1.6; }
.overlay .btn {
    padding: 12px 32px;
    font-size: 16px;
    font-family: 'Courier New', monospace;
    background: transparent;
    color: #00ffea;
    border: 2px solid #00ffea;
    border-radius: 4px;
    cursor: pointer;
    transition: all 0.2s;
}
.overlay .btn:hover { background: #00ffea; color: #0a0a0f; box-shadow: 0 0 20px #00ffea; }
.mobile-hint { color: #ff6b00; font-size: 12px; }

@media (max-width: 600px) {
    #topBar, #bottomBar { padding: 12px 16px; }
    .panel { padding: 6px 12px; }
    .panel .value { font-size: 18px; }
    #timerBar { width: 150px; }
    .btn { padding: 8px 16px; font-size: 11px; }
}
</style>
</head>
<body>
<div class="scanline"></div>
<div id="particles"></div>
<div id="gameContainer">
    <canvas id="canvas"></canvas>
    <div id="ui">
        <div id="topBar">
            <div class="panel" id="scorePanel"><h3>Credits</h3><div class="value" id="score">0</div></div>
            <div class="panel" id="levelPanel"><h3>Sector</h3><div class="value" id="level">1</div></div>
            <div class="panel" id="timerPanel"><h3>Power</h3><div id="timerBar"><div id="timerFill" style="width: 100%"></div></div></div>
        </div>
        <div id="bottomBar">
            <button class="btn" id="rotateBtn" aria-label="Rotate Selected">ROTATE</button>
            <button class="btn" id="pauseBtn" aria-label="Pause">PAUSE</button>
        </div>
    </div>
</div>
<div id="overlay">
    <h1>NEON CONDUIT</h1>
    <p>Connect the Grid. Restore Power.</p>
    <div class="stats">
        <div class="stat"><span class="stat-label">Final Credits</span><span class="stat-value" id="finalScore">0</span></div>
        <div class="stat"><span class="stat-label">High Score</span><span class="stat-value high" id="highScore">0</span></div>
        <div class="stat"><span class="stat-label">Sectors Cleared</span><span class="stat-value" id="finalLevel">1</span></div>
    </div>
    <button class="btn" id="restartBtn" style="padding: 14px 40px; font-size: 14px;">REINITIALIZE</button>
</div>

<div class="overlay hidden" id="pauseOverlay">
    <h1>PAUSED</h1>
    <p>Wave <span id="pauseWave">1</span> • Score <span id="pauseScore">0</span></p>
    <button class="btn" id="resumeBtn">RESUME</button>
    <button class="btn" id="quitBtn">QUIT TO MENU</button>
</div>

<div class="overlay hidden" id="gameOverOverlay">
    <h1 style="color: #ff3366;">GAME OVER</h1>
    <p>Final Score: <span id="finalScoreGO" style="color: #00ffea;">0</span></p>
    <p id="highScoreMsg" style="color: #ffd700;"></p>
    <button class="btn" id="retryBtn">RETRY</button>
    <button class="btn" id="menuBtn">MAIN MENU</button>
</div>

<script>
/**
 * NEON CONDUIT - Day 23
 * Cyberpunk pipe-rotation puzzle game
 * Connect power source to all targets before energy depletes
 */

// ===== CONSTANTS & CONFIG =====
const TILE_TYPES = {
    EMPTY: 0,
    STRAIGHT: 1,
    CORNER: 2,
    T_JUNCTION: 3,
    CROSS: 4,
    SOURCE: 5,
    TARGET: 6,
    BLOCKED: 7
};

const TILE_CONNECTIONS = {
    [TILE_TYPES.STRAIGHT]:    [0, 1, 0, 1],
    [TILE_TYPES.CORNER]:      [0, 1, 1, 0],
    [TILE_TYPES.T_JUNCTION]:  [1, 1, 1, 0],
    [TILE_TYPES.CROSS]:       [1, 1, 1, 1],
    [TILE_TYPES.SOURCE]:      [1, 1, 1, 1],
    [TILE_TYPES.TARGET]:      [1, 1, 1, 1],
    [TILE_TYPES.BLOCKED]:     [0, 0, 0, 0],
    [TILE_TYPES.EMPTY]:       [0, 0, 0, 0]
};

const COLORS = {
    bg: '#050510',
    grid: '#003344',
    pipe: '#00ffff',
    pipeGlow: '#00ffff',
    source: '#00ff88',
    sourceGlow: '#00ff88',
    target: '#ff0066',
    targetGlow: '#ff0066',
    targetConnected: '#00ff88',
    targetConnectedGlow: '#00ff88',
    blocked: '#333344',
    blockedGlow: '#444466',
    selection: '#ffcc00',
    selectionGlow: '#ffcc00',
    particle: ['#00ffff', '#ff00ff', '#ffcc00', '#00ff88', '#ff3366']
};

const DIRECTIONS = [[-1,0], [0,1], [1,0], [0,-1]];
const OPPOSITE = [2, 3, 0, 1];

// ===== GAME STATE =====
let canvas, ctx;
let width, height;
let gridSize = 6;
let tileSize = 0;
let gridOffsetX = 0, gridOffsetY = 0;
let grid = [];
let sourcePos = {r: 0, c: 0};
let targetPositions = [];
let selectedTile = null;
let score = 0;
let level = 1;
let highScore = 0;
let timeLeft = 100;
let maxTime = 100;
let timeDepleteRate = 0.5;
let gameState = 'menu';
let animationId = 0;
let lastTime = 0;
let particles = [];
let connectionParticles = [];
let screenShake = 0;
let combo = 0;
let totalTargets = 0;
let connectedTargets = 0;
let connectedTargetSet = new Set();
let tileRotations = [];

// ===== DOM ELEMENTS =====
const scoreEl = document.getElementById('score');
const levelEl = document.getElementById('level');
const timerFill = document.getElementById('timerFill');
const overlay = document.getElementById('overlay');
const finalScoreEl = document.getElementById('finalScore');
const highScoreEl = document.getElementById('highScore');
const finalLevelEl = document.getElementById('finalLevel');
const restartBtn = document.getElementById('restartBtn');
const rotateBtn = document.getElementById('rotateBtn');
const pauseBtn = document.getElementById('pauseBtn');
const particlesContainer = document.getElementById('particles');
const pauseOverlay = document.getElementById('pauseOverlay');
const gameOverOverlay = document.getElementById('gameOverOverlay');
const resumeBtn = document.getElementById('resumeBtn');
const quitBtn = document.getElementById('quitBtn');
const retryBtn = document.getElementById('retryBtn');
const menuBtn = document.getElementById('menuBtn');
const pauseWaveEl = document.getElementById('pauseWave');
const pauseScoreEl = document.getElementById('pauseScore');
const finalScoreGO = document.getElementById('finalScoreGO');
const highScoreMsg = document.getElementById('highScoreMsg');

// ===== INITIALIZATION =====
function init() {
    canvas = document.getElementById('canvas');
    ctx = canvas.getContext('2d');
    highScore = parseInt(localStorage.getItem('neonConduitHighScore')) || 0;
    highScoreEl.textContent = highScore;
    
    resize();
    window.addEventListener('resize', resize);
    
    canvas.addEventListener('click', handleCanvasClick);
    canvas.addEventListener('touchstart', handleTouch, {passive: false});
    rotateBtn.addEventListener('click', rotateSelected);
    pauseBtn.addEventListener('click', togglePause);
    restartBtn.addEventListener('click', startGame);
    resumeBtn.addEventListener('click', resumeGame);
    quitBtn.addEventListener('click', quitToMenu);
    retryBtn.addEventListener('click', startGame);
    menuBtn.addEventListener('click', showStartScreen);
    
    document.addEventListener('keydown', handleKeyDown);
    document.addEventListener('visibilitychange', () => {
        if (document.hidden && gameState === 'playing') togglePause();
    });
    
    showOverlay('menu');
    requestAnimationFrame(gameLoop);
}

function resize() {
    const container = document.getElementById('gameContainer');
    const maxWidth = Math.min(window.innerWidth - 32, 720);
    const maxHeight = window.innerHeight - 160;
    const size = Math.min(maxWidth, maxHeight);
    
    width = size;
    height = size;
    canvas.width = width * devicePixelRatio;
    canvas.height = height * devicePixelRatio;
    canvas.style.width = width + 'px';
    canvas.style.height = height + 'px';
    ctx.setTransform(1, 0, 0, 1, 0, 0);
    ctx.scale(devicePixelRatio, devicePixelRatio);
    
    tileSize = Math.floor(width / (gridSize + 2));
    gridOffsetX = (width - tileSize * gridSize) / 2;
    gridOffsetY = (height - tileSize * gridSize) / 2;
}

// ===== OVERLAY MANAGEMENT =====
function showOverlay(type) {
    if (type === 'menu') {
        overlay.classList.add('active');
        pauseOverlay.classList.add('hidden');
        gameOverOverlay.classList.add('hidden');
    } else if (type === 'pause') {
        overlay.classList.remove('active');
        pauseOverlay.classList.remove('hidden');
        gameOverOverlay.classList.add('hidden');
        pauseWaveEl.textContent = level;
        pauseScoreEl.textContent = score.toLocaleString();
    } else if (type === 'gameOver') {
        overlay.classList.remove('active');
        pauseOverlay.classList.add('hidden');
        gameOverOverlay.classList.remove('hidden');
        finalScoreGO.textContent = score.toLocaleString();
        if (score >= highScore && score > 0) {
            highScoreMsg.textContent = 'NEW HIGH SCORE!';
        } else {
            highScoreMsg.textContent = 'High Score: ' + highScore.toLocaleString();
        }
    }
}

function hideOverlay() {
    overlay.classList.remove('active');
    pauseOverlay.classList.add('hidden');
    gameOverOverlay.classList.add('hidden');
}

// ===== GAME LOGIC =====
function startGame() {
    hideOverlay();
    score = 0;
    level = 1;
    combo = 0;
    timeDepleteRate = 0.5;
    maxTime = 100;
    timeLeft = maxTime;
    gridSize = 6;
    generateLevel();
    gameState = 'playing';
    lastTime = performance.now();
    updateUI();
}

function generateLevel() {
    grid = Array(gridSize).fill(null).map(() => Array(gridSize).fill(TILE_TYPES.EMPTY));
    tileRotations = Array(gridSize).fill(null).map(() => Array(gridSize).fill(0));
    targetPositions = [];
    connectedTargetSet.clear();
    
    // Place source at random edge
    const edges = [
        {r: 0, c: Math.floor(Math.random() * gridSize)},
        {r: gridSize-1, c: Math.floor(Math.random() * gridSize)},
        {r: Math.floor(Math.random() * gridSize), c: 0},
        {r: Math.floor(Math.random() * gridSize), c: gridSize-1}
    ];
    sourcePos = edges[Math.floor(Math.random() * edges.length)];
    grid[sourcePos.r][sourcePos.c] = TILE_TYPES.SOURCE;
    
    // Place targets (2-4 targets)
    totalTargets = Math.min(2 + level, 6);
    let attempts = 0;
    while (targetPositions.length < totalTargets && attempts < 50) {
        const r = Math.floor(Math.random() * gridSize);
        const c = Math.floor(Math.random() * gridSize);
        if (grid[r][c] === TILE_TYPES.EMPTY && !(r === sourcePos.r && c === sourcePos.c)) {
            // Ensure not adjacent to source
            const dist = Math.abs(r - sourcePos.r) + Math.abs(c - sourcePos.c);
            if (dist > 2) {
                grid[r][c] = TILE_TYPES.TARGET;
                targetPositions.push({r, c});
            }
        }
        attempts++;
    }
    
    // Fill remaining with random pipes
    const pipeTypes = [TILE_TYPES.STRAIGHT, TILE_TYPES.CORNER, TILE_TYPES.T_JUNCTION, TILE_TYPES.CROSS];
    for (let r = 0; r < gridSize; r++) {
        for (let c = 0; c < gridSize; c++) {
            if (grid[r][c] === TILE_TYPES.EMPTY) {
                if (Math.random() < 0.7) {
                    grid[r][c] = pipeTypes[Math.floor(Math.random() * pipeTypes.length)];
                    tileRotations[r][c] = Math.floor(Math.random() * 4);
                } else {
                    grid[r][c] = TILE_TYPES.BLOCKED;
                }
            }
        }
    }
    
    // Ensure source has at least one connection
    tileRotations[sourcePos.r][sourcePos.c] = 0;
    
    checkConnections();
    timeLeft = maxTime;
}

function checkConnections() {
    const visited = Array(gridSize).fill(null).map(() => Array(gridSize).fill(false));
    const queue = [{r: sourcePos.r, c: sourcePos.c, dir: -1}];
    visited[sourcePos.r][sourcePos.c] = true;
    connectedTargetSet.clear();
    
    while (queue.length > 0) {
        const {r, c, dir} = queue.shift();
        const tileType = grid[r][c];
        const baseConnections = TILE_CONNECTIONS[tileType] || [0,0,0,0];
        const rot = tileRotations[r][c] || 0;
        const connections = [
            baseConnections[(0 - rot + 4) % 4],
            baseConnections[(1 - rot + 4) % 4],
            baseConnections[(2 - rot + 4) % 4],
            baseConnections[(3 - rot + 4) % 4]
        ];
        
        for (let d = 0; d < 4; d++) {
            if (!connections[d]) continue;
            const nr = r + DIRECTIONS[d][0];
            const nc = c + DIRECTIONS[d][1];
            if (nr < 0 || nr >= gridSize || nc < 0 || nc >= gridSize) continue;
            if (visited[nr][nc]) continue;
            
            const neighborType = grid[nr][nc];
            const neighborBase = TILE_CONNECTIONS[neighborType] || [0,0,0,0];
            const neighborRot = tileRotations[nr][nc] || 0;
            const neighborConnections = [
                neighborBase[(0 - neighborRot + 4) % 4],
                neighborBase[(1 - neighborRot + 4) % 4],
                neighborBase[(2 - neighborRot + 4) % 4],
                neighborBase[(3 - neighborRot + 4) % 4]
            ];
            
            if (neighborConnections[OPPOSITE[d]]) {
                visited[nr][nc] = true;
                queue.push({r: nr, c: nc, dir: d});
                if (neighborType === TILE_TYPES.TARGET) {
                    connectedTargetSet.add(nr + ',' + nc);
                }
            }
        }
    }
    
    connectedTargets = connectedTargetSet.size;
    
    // Check win condition
    if (connectedTargets === totalTargets && totalTargets > 0) {
        levelComplete();
    }
}

function levelComplete() {
    // Bonus for remaining time
    const timeBonus = Math.floor(timeLeft * 10);
    const levelBonus = level * 100;
    const comboBonus = combo * 50;
    score += timeBonus + levelBonus + comboBonus;
    combo++;
    
    // Create celebration particles
    for (let i = 0; i < 30; i++) {
        createParticle(width/2, height/2, COLORS.particle[Math.floor(Math.random() * COLORS.particle.length)]);
    }
    screenShake = 10;
    
    level++;
    gridSize = Math.min(6 + Math.floor(level/2), 10);
    timeDepleteRate = 0.5 + level * 0.1;
    maxTime = Math.max(60, 100 - level * 5);
    
    setTimeout(() => {
        generateLevel();
        resize();
    }, 800);
}

function gameOver() {
    gameState = 'gameOver';
    if (score > highScore) {
        highScore = score;
        localStorage.setItem('neonConduitHighScore', highScore);
        highScoreEl.textContent = highScore;
    }
    finalScoreEl.textContent = score.toLocaleString();
    finalLevelEl.textContent = level;
    showOverlay('gameOver');
}

function updateUI() {
    scoreEl.textContent = score.toLocaleString();
    levelEl.textContent = level;
    const pct = (timeLeft / maxTime) * 100;
    timerFill.style.width = pct + '%';
    timerFill.classList.remove('warning', 'danger');
    if (pct < 30) timerFill.classList.add('danger');
    else if (pct < 60) timerFill.classList.add('warning');
}

// ===== INPUT HANDLING =====
function handleCanvasClick(e) {
    if (gameState !== 'playing') return;
    const rect = canvas.getBoundingClientRect();
    const x = e.clientX - rect.left;
    const y = e.clientY - rect.top;
    handleTileSelect(x, y);
}

function handleTouch(e) {
    if (gameState !== 'playing') return;
    e.preventDefault();
    const touch = e.touches[0];
    const rect = canvas.getBoundingClientRect();
    const x = touch.clientX - rect.left;
    const y = touch.clientY - rect.top;
    handleTileSelect(x, y);
}

function handleTileSelect(x, y) {
    const col = Math.floor((x - gridOffsetX) / tileSize);
    const row = Math.floor((y - gridOffsetY) / tileSize);
    
    if (row >= 0 && row < gridSize && col >= 0 && col < gridSize) {
        const type = grid[row][col];
        if (type !== TILE_TYPES.SOURCE && type !== TILE_TYPES.TARGET && type !== TILE_TYPES.BLOCKED && type !== TILE_TYPES.EMPTY) {
            selectedTile = {r: row, c: col};
        } else {
            selectedTile = null;
        }
    }
}

function rotateSelected() {
    if (!selectedTile || gameState !== 'playing') return;
    const {r, c} = selectedTile;
    tileRotations[r][c] = (tileRotations[r][c] + 1) % 4;
    checkConnections();
    createConnectionParticles(r, c);
}

function handleKeyDown(e) {
    if (e.key === 'Escape' || e.key === 'p' || e.key === 'P') {
        togglePause();
    }
    if (e.key === ' ' || e.key === 'r' || e.key === 'R') {
        if (gameState === 'playing' && selectedTile) {
            rotateSelected();
        }
    }
    if (e.key === 'ArrowUp' || e.key === 'w' || e.key === 'W') moveSelection(-1, 0);
    if (e.key === 'ArrowRight' || e.key === 'd' || e.key === 'D') moveSelection(0, 1);
    if (e.key === 'ArrowDown' || e.key === 's' || e.key === 'S') moveSelection(1, 0);
    if (e.key === 'ArrowLeft' || e.key === 'a' || e.key === 'A') moveSelection(0, -1);
}

function moveSelection(dr, dc) {
    if (gameState !== 'playing') return;
    if (!selectedTile) {
        selectedTile = {r: Math.floor(gridSize/2), c: Math.floor(gridSize/2)};
    } else {
        selectedTile.r = (selectedTile.r + dr + gridSize) % gridSize;
        selectedTile.c = (selectedTile.c + dc +