<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no">
<title>Neon Blitz - Day 52</title>
<style>
  * { margin: 0; padding: 0; box-sizing: border-box; }
  body { background: #0a0a12; color: #0ff; font-family: 'Courier New', monospace; overflow: hidden; height: 100vh; }
  canvas { display: block; background: #000; }
  .overlay {
    position: absolute; top: 0; left: 0; width: 100%; height: 100%;
    display: flex; flex-direction: column; justify-content: center; align-items: center;
    background: rgba(0,0,0,0.9); z-index: 10; pointer-events: none;
  }
  .overlay.hidden { display: none; }
  .overlay h1 { font-size: 3rem; text-shadow: 0 0 10px #0ff, 0 0 20px #0ff; margin-bottom: 1rem; }
  .overlay p { font-size: 1.5rem; margin-bottom: 2rem; color: #aaa; }
  .btn {
    padding: 1rem 2rem; font-size: 1.2rem; background: transparent; border: 2px solid #0ff;
    color: #0ff; cursor: pointer; transition: all 0.2s; text-transform: uppercase;
    box-shadow: 0 0 10px #0ff; margin: 0.5rem;
  }
  .btn:hover, .btn:focus { background: #0ff; color: #000; box-shadow: 0 0 20px #0ff, 0 0 30px #0ff; }
  .score-display { position: absolute; top: 1rem; left: 1rem; font-size: 1.5rem; text-shadow: 0 0 5px #0ff; z-index: 5; pointer-events: none; }
  .high-score-display { position: absolute; top: 1rem; right: 1rem; font-size: 1.5rem; text-shadow: 0 0 5px #f0f; z-index: 5; pointer-events: none; }
  .wave-display { position: absolute; bottom: 1rem; left: 50%; transform: translateX(-50%); font-size: 1.5rem; text-shadow: 0 0 5px #ff0; z-index: 5; pointer-events: none; }
  @media (max-width: 600px) {
    .overlay h1 { font-size: 2rem; }
    .overlay p { font-size: 1rem; }
    .btn { padding: 0.8rem 1.5rem; font-size: 1rem; }
    .score-display, .high-score-display, .wave-display { font-size: 1rem; }
  }
</style>
</head>
<body>
<canvas id="game"></canvas>
<div class="score-display">SCORE: <span id="score">0</span></div>
<div class="high-score-display">BEST: <span id="highScore">0</span></div>
<div class="wave-display">WAVE: <span id="wave">1</span></div>

<div id="startScreen" class="overlay">
  <h1>NEON BLITZ</h1>
  <p>Survive the neon onslaught</p>
  <button class="btn" id="startBtn">START</button>
  <p style="margin-top:2rem;font-size:0.9rem;color:#666;">
    WASD/Arrows: Move | Mouse: Aim | Click: Shoot<br>
    Touch Left: Move | Touch Right: Aim & Shoot<br>
    ESC/P: Pause
  </p>
</div>

<div id="pauseScreen" class="overlay hidden">
  <h1>PAUSED</h1>
  <button class="btn" id="resumeBtn">RESUME</button>
  <button class="btn" id="quitBtn">QUIT TO MENU</button>
</div>

<div id="gameOverScreen" class="overlay hidden">
  <h1>GAME OVER</h1>
  <p>Final Score: <span id="finalScore">0</span></p>
  <button class="btn" id="retryBtn">RETRY</button>
  <button class="btn" id="menuBtn">MAIN MENU</button>
</div>

<script>
/* ===== GAME CONSTANTS ===== */
const CANVAS = document.getElementById('game');
const CTX = CANVAS.getContext('2d');
const PI2 = Math.PI * 2;

// Colors
const NEON_CYAN = '#0ff';
const NEON_PINK = '#f0f';
const NEON_YELLOW = '#ff0';
const NEON_GREEN = '#0f0';
const NEON_ORANGE = '#f80';
const BG_COLOR = '#0a0a12';

/* ===== GAME STATE ===== */
let gameState = 'start'; // 'start', 'playing', 'paused', 'gameover'
let score = 0;
let highScore = parseInt(localStorage.getItem('neonBlitzHighScore')) || 0;
let wave = 1;
let waveTimer = 0;
const WAVE_DURATION = 30000; // 30 seconds per wave
let lastTime = 0;
let animationId = null;

/* ===== ENTITIES ===== */
const player = {
  x: 0, y: 0, radius: 18, color: NEON_CYAN,
  speed: 300, health: 3, maxHealth: 3,
  fireRate: 150, lastFire: 0,
  angle: 0, // aim angle
  invuln: 0
};

const enemies = [];
const bullets = [];
const particles = [];
const pickups = [];

/* ===== INPUT ===== */
const keys = { 
  KeyW: false, KeyA: false, KeyS: false, KeyD: false,
  ArrowUp: false, ArrowDown: false, ArrowLeft: false, ArrowRight: false,
  Escape: false, KeyP: false 
};
let moveTouchId = null;
let aimTouchId = null;
const moveTouchPos = { x: 0, y: 0, active: false, startX: 0, startY: 0 };
const aimTouchPos = { x: 0, y: 0, active: false };

/* ===== UI ELEMENTS ===== */
const startScreen = document.getElementById('startScreen');
const pauseScreen = document.getElementById('pauseScreen');
const gameOverScreen = document.getElementById('gameOverScreen');
const scoreEl = document.getElementById('score');
const highScoreEl = document.getElementById('highScore');
const waveEl = document.getElementById('wave');
const finalScoreEl = document.getElementById('finalScore');

/* ===== INIT ===== */
function resize() {
  CANVAS.width = window.innerWidth;
  CANVAS.height = window.innerHeight;
  player.x = CANVAS.width / 2;
  player.y = CANVAS.height / 2;
}
window.addEventListener('resize', resize);
resize();

/* ===== EVENT LISTENERS ===== */
// Keyboard
window.addEventListener('keydown', e => {
  if (e.code in keys) keys[e.code] = true;
  if (e.code === 'Escape' || e.code === 'KeyP') togglePause();
});
window.addEventListener('keyup', e => { if (e.code in keys) keys[e.code] = false; });

// Mouse aim
CANVAS.addEventListener('mousemove', e => {
  if (gameState !== 'playing') return;
  const rect = CANVAS.getBoundingClientRect();
  player.angle = Math.atan2(e.clientY - rect.top - player.y, e.clientX - rect.left - player.x);
});
// Mouse shoot
CANVAS.addEventListener('mousedown', e => {
  if (gameState === 'playing') player.lastFire = 0; // force immediate shot
});
CANVAS.addEventListener('mouseup', e => {});

// Touch controls
CANVAS.addEventListener('touchstart', e => {
  e.preventDefault();
  if (gameState !== 'playing') return;
  for (const touch of e.changedTouches) {
    const x = touch.clientX;
    if (x < CANVAS.width / 2) {
      if (!moveTouchPos.active) {
        moveTouchPos.active = true;
        moveTouchId = touch.identifier;
        moveTouchPos.startX = CANVAS.width / 4;
        moveTouchPos.startY = CANVAS.height / 2;
        moveTouchPos.x = touch.clientX;
        moveTouchPos.y = touch.clientY;
      }
    } else {
      if (!aimTouchPos.active) {
        aimTouchPos.active = true;
        aimTouchId = touch.identifier;
        aimTouchPos.x = touch.clientX;
        aimTouchPos.y = touch.clientY;
      }
    }
  }
}, { passive: false });

CANVAS.addEventListener('touchmove', e => {
  e.preventDefault();
  if (gameState !== 'playing') return;
  for (const touch of e.changedTouches) {
    if (moveTouchPos.active && touch.identifier === moveTouchId) {
      moveTouchPos.x = touch.clientX;
      moveTouchPos.y = touch.clientY;
    } else if (aimTouchPos.active && touch.identifier === aimTouchId) {
      aimTouchPos.x = touch.clientX;
      aimTouchPos.y = touch.clientY;
      const centerX = CANVAS.width * 3 / 4;
      const centerY = CANVAS.height / 2;
      player.angle = Math.atan2(touch.clientY - centerY, touch.clientX - centerX);
      player.lastFire = 0; // auto-fire while aiming
    }
  }
}, { passive: false });

CANVAS.addEventListener('touchend', e => {
  e.preventDefault();
  for (const touch of e.changedTouches) {
    if (moveTouchPos.active && touch.identifier === moveTouchId) {
      moveTouchPos.active = false;
      moveTouchId = null;
    }
    if (aimTouchPos.active && touch.identifier === aimTouchId) {
      aimTouchPos.active = false;
      aimTouchId = null;
    }
  }
}, { passive: false });

// Buttons
document.getElementById('startBtn').addEventListener('click', startGame);
document.getElementById('resumeBtn').addEventListener('click', resumeGame);
document.getElementById('quitBtn').addEventListener('click', quitToMenu);
document.getElementById('retryBtn').addEventListener('click', startGame);
document.getElementById('menuBtn').addEventListener('click', showStartScreen);

/* ===== GAME FUNCTIONS ===== */
function startGame() {
  // Reset state
  score = 0;
  wave = 1;
  waveTimer = 0;
  player.x = CANVAS.width / 2;
  player.y = CANVAS.height / 2;
  player.health = player.maxHealth;
  player.invuln = 0;
  player.lastFire = 0;
  player.angle = 0;
  enemies.length = 0;
  bullets.length = 0;
  particles.length = 0;
  pickups.length = 0;
  
  // Update UI
  scoreEl.textContent = score;
  waveEl.textContent = wave;
  highScoreEl.textContent = highScore;
  
  // Hide screens
  startScreen.classList.add('hidden');
  pauseScreen.classList.add('hidden');
  gameOverScreen.classList.add('hidden');
  
  gameState = 'playing';
  lastTime = performance.now();
  if (animationId) cancelAnimationFrame(animationId);
  animationId = requestAnimationFrame(gameLoop);
}

function pauseGame() {
  if (gameState !== 'playing') return;
  gameState = 'paused';
  pauseScreen.classList.remove('hidden');
  cancelAnimationFrame(animationId);
}

function resumeGame() {
  if (gameState !== 'paused') return;
  gameState = 'playing';
  pauseScreen.classList.add('hidden');
  lastTime = performance.now();
  animationId = requestAnimationFrame(gameLoop);
}

function togglePause() {
  if (gameState === 'playing') pauseGame();
  else if (gameState === 'paused') resumeGame();
}

function quitToMenu() {
  gameState = 'start';
  pauseScreen.classList.add('hidden');
  startScreen.classList.remove('hidden');
  cancelAnimationFrame(animationId);
}

function showStartScreen() {
  gameState = 'start';
  gameOverScreen.classList.add('hidden');
  startScreen.classList.remove('hidden');
  cancelAnimationFrame(animationId);
}

function gameOver() {
  gameState = 'gameover';
  finalScoreEl.textContent = score;
  if (score > highScore) {
    highScore = score;
    localStorage.setItem('neonBlitzHighScore', highScore);
    highScoreEl.textContent = highScore;
  }
  gameOverScreen.classList.remove('hidden');
  cancelAnimationFrame(animationId);
}

/* ===== ENTITY LOGIC ===== */
function spawnEnemy() {
  const side = Math.floor(Math.random() * 4);
  let x, y;
  const margin = 50;
  switch(side) {
    case 0: x = Math.random() * CANVAS.width; y = -margin; break; // top
    case 1: x = CANVAS.width + margin; y = Math.random() * CANVAS.height; break; // right
    case 2: x = Math.random() * CANVAS.width; y = CANVAS.height + margin; break; // bottom
    case 3: x = -margin; y = Math.random() * CANVAS.height; break; // left
  }
  const type = Math.random() < 0.7 ? 'basic' : (Math.random() < 0.5 ? 'fast' : 'tank');
  let hp, speed, radius, color, scoreValue;
  if (type === 'basic') { hp = 1; speed = 80 + wave * 10; radius = 15; color = NEON_PINK; scoreValue = 10; }
  else if (type === 'fast') { hp = 1; speed = 150 + wave * 15; radius = 10; color = NEON_YELLOW; scoreValue = 20; }
  else { hp = 3 + wave; speed = 50 + wave * 5; radius = 22; color = NEON_ORANGE; scoreValue = 50; }
  enemies.push({ x, y, radius, color, hp, maxHp: hp, speed, type, scoreValue, angle: 0 });
}

function spawnPickup(x, y) {
  if (Math.random() < 0.15) {
    const type = Math.random() < 0.6 ? 'health' : 'rapid';
    pickups.push({ x, y, radius: 12, type, color: type === 'health' ? NEON_GREEN : NEON_CYAN, life: 10000 });
  }
}

function fireBullet() {
  const now = performance.now();
  if (now - player.lastFire < player.fireRate) return;
  player.lastFire = now;
  const spread = 0.08;
  const count = player.fireRate < 100 ? 3 : 1;
  for (let i = 0; i < count; i++) {
    const angle = player.angle + (i - (count-1)/2) * spread;
    bullets.push({
      x: player.x + Math.cos(angle) * (player.radius + 5),
      y: player.y + Math.sin(angle) * (player.radius + 5),
      vx: Math.cos(angle) * 600,
      vy: Math.sin(angle) * 600,
      radius: 4,
      color: NEON_CYAN,
      life: 1500
    });
  }
  // Muzzle flash particles
  for (let i = 0; i < 5; i++) {
    const a = player.angle + (Math.random() - 0.5) * 0.5;
    const s = 100 + Math.random() * 100;
    particles.push({
      x: player.x + Math.cos(player.angle) * player.radius,
      y: player.y + Math.sin(player.angle) * player.radius,
      vx: Math.cos(a) * s,
      vy: Math.sin(a) * s,
      radius: 2 + Math.random() * 2,
      color: NEON_CYAN,
      life: 200,
      decay: 0.95
    });
  }
}

function updatePlayer(dt) {
  // Movement
  let dx = 0, dy = 0;
  if (keys.KeyW || keys.ArrowUp) dy -= 1;
  if (keys.KeyS || keys.ArrowDown) dy += 1;
  if (keys.KeyA || keys.ArrowLeft) dx -= 1;
  if (keys.KeyD || keys.ArrowRight) dx += 1;
  
  // Touch movement
  if (moveTouchPos.active) {
    const dxTouch = moveTouchPos.x - moveTouchPos.startX;
    const dyTouch = moveTouchPos.y - moveTouchPos.startY;
    const dist = Math.hypot(dxTouch, dyTouch);
    if (dist > 10) {
      dx = dxTouch / dist;
      dy = dyTouch / dist;
    }
  }
  
  if (dx !== 0 || dy !== 0) {
    const len = Math.hypot(dx, dy);
    player.x += (dx/len) * player.speed * dt;
    player.y += (dy/len) * player.speed * dt;
  }
  
  // Clamp to screen
  player.x = Math.max(player.radius, Math.min(CANVAS.width - player.radius, player.x));
  player.y = Math.max(player.radius, Math.min(CANVAS.height - player.radius, player.y));
  
  // Invulnerability
  if (player.invuln > 0) player.invuln -= dt * 1000;
  
  // Auto-fire on desktop when mouse down? We'll handle via mousedown setting lastFire=0
  fireBullet();
}

function updateEnemies(dt) {
  for (let i = enemies.length - 1; i >= 0; i--) {
    const e = enemies[i];
    // Move toward player
    const dx = player.x - e.x;
    const dy = player.y - e.y;
    const dist = Math.hypot(dx, dy);
    if (dist > 0) {
      e.x += (dx/dist) * e.speed * dt;
      e.y += (dy/dist) * e.speed * dt;
    }
    e.angle = Math.atan2(dy, dx);
    
    // Collision with player
    if (dist < e.radius + player.radius && player.invuln <= 0) {
      player.health--;
      player.invuln = 1000;
      // Knockback
      player.x += (dx/dist) * -50;
      player.y += (dy/dist) * -50;
      if (player.health <= 0) gameOver();
    }
    
    // Collision with bullets
    for (let j = bullets.length - 1; j >= 0; j--) {
      const b = bullets[j];
      const bdx = b.x - e.x;
      const bdy = b.y - e.y;
      if (Math.hypot(bdx, bdy) < e.radius + b.radius) {
        e.hp--;
        // Hit particles
        for (let k = 0; k < 8; k++) {
          const a = Math.random() * PI2;
          const s = 50 + Math.random() * 100;
          particles.push({
            x: e.x, y: e.y,
            vx: Math.cos(a) * s, vy: Math.sin(a) * s,
            radius: 2 + Math.random() * 2, color: e.color, life: 300, decay: 0.92
          });
        }
        bullets.splice(j, 1);
        if (e.hp <= 0) {
          score += e.scoreValue * wave;
          scoreEl.textContent = score;
          spawnPickup(e.x, e.y);
          // Death particles
          for (let k = 0; k < 20; k++) {
            const a = Math.random() * PI2;
            const s = 100 + Math.random() * 200;
            particles.push({
              x: e.x, y: e.y,
              vx: Math.cos(a) * s, vy: Math.sin(a) * s,
              radius: 3 + Math.random() * 3, color: e.color, life: 500, decay: 0.9
            });
          }
          enemies.splice(i, 1);
          break;
        }
      }
    }
  }
}

function updateBullets(dt) {
  for (let i = bullets.length - 1; i >= 0; i--) {
    const b = bullets[i];
    b.x += b.vx * dt;
    b.y += b.vy * dt;
    b.life -= dt * 1000;
    if (b.life <= 0 || b.x < -50 || b.x > CANVAS.width + 50 || b.y < -50 || b.y > CANVAS.height + 50) {
      bullets.splice(i, 1);
    }
  }
}

function updateParticles(dt) {
  for (let i = particles.length - 1; i >= 0; i--) {
    const p = particles[i];
    p.x += p.vx * dt;
    p.y += p.vy * dt;
    p.vx *= p.decay;
    p.vy *= p.decay;
    p.life -= dt * 1000;
    p.radius *= 0.98;
    if (p.life <= 0 || p.radius < 0.5) particles.splice(i, 1);
  }
}

function updatePickups(dt) {
  for (let i = pickups.length - 1; i >= 0; i--) {
    const p = pickups[i];
    p.life -= dt * 1000;
    const dx = player.x - p.x;
    const dy = player.y - p.y;
    if (Math.hypot(dx, dy) < p.radius + player.radius) {
      if (p.type === 'health') {
        player.health = Math.min(player.maxHealth, player.health + 1);
      } else if (p.type === 'rapid') {
        player.fireRate = Math.max(50, player.fireRate - 30);
        setTimeout(() => { player.fireRate = 150; }, 5000);
      }
      pickups.splice(i, 1);
    } else if (p.life <= 0) {
      pickups.splice(i, 1);
    }
  }
}

function updateWave(dt) {
  waveTimer += dt * 1000;
  if (waveTimer >= WAVE_DURATION) {
    wave++;
    waveTimer = 0;
    waveEl.textContent = wave;
    // Wave transition effect
    for (let i = 0; i < 30; i++) {
      const a = Math.random() * PI2;
      const r = Math.max(CANVAS.width, CANVAS.height) * 0.5;
      particles.push({
        x: CANVAS.width/2, y: CANVAS.height/2,
        vx: Math.cos(a) * 300, vy: Math.sin(a) * 300,
        radius: 4, color: NEON_YELLOW, life: 1000, decay: 0.98
      });
    }
  }
  
  // Spawn enemies based on wave
  const spawnRate = Math.max(500, 2000 - wave * 100);
  if (Math.random() * 1000 < (1000 / spawnRate) * 60 * dt) {
    spawnEnemy();
  }
}

/* ===== RENDER ===== */
function drawPlayer() {
  CTX.save();
  CTX.translate(player.x, player.y);
  // Body
  CTX.beginPath();
  CTX.arc(0, 0, player.radius, 0, PI2);
  CTX.fillStyle = player.color;
  CTX.shadowColor = player.color;
  CTX.shadowBlur = 15;
  CTX.fill();
  CTX.shadowBlur = 0;
  // Direction indicator
  CTX.beginPath();
  CTX.moveTo(Math.cos(player.angle) * player.radius, Math.sin(player.angle) * player.radius);
  CTX.lineTo(Math.cos(player.angle) * (player.radius + 10), Math.sin(player.angle) * (player.radius + 10));
  CTX.strokeStyle = '#fff';
  CTX.lineWidth = 2;
  CTX.stroke();
  // Health indicator
  if (player.invuln > 0) {
    CTX.globalAlpha = 0.5 + 0.5 * Math.sin(performance.now() * 0.02);
    CTX.beginPath();
    CTX.arc(0, 0, player.radius + 5, 0, PI2);
    CTX.strokeStyle = '#fff';
    CTX.lineWidth = 2;
    CTX.stroke();
    CTX.globalAlpha = 1;
  }
  CTX.restore();
}

function drawEnemies() {
  for (const e of enemies) {
    CTX.save();
    CTX.translate(e.x, e.y);
    CTX.rotate(e.angle);
    // Body
    CTX.beginPath();
    if (e.type === 'tank') {
      CTX.roundRect(-e.radius, -e.radius * 0.7, e.radius * 2, e.radius * 1.4, 5);
    } else {
      CTX.moveTo(e.radius, 0);
      CTX.lineTo(-e.radius * 0.7, -e.radius);
      CTX.lineTo(-e.radius * 0.5, 0);
      CTX.lineTo(-e.radius * 0.7, e.radius);
      CTX.closePath();
    }
    CTX.fillStyle = e.color;
    CTX.shadowColor = e.color;
    CTX.shadowBlur = 10;
    CTX.fill();
    CTX.shadowBlur = 0;
    // Health bar for tank
    if (e.type === 'tank' && e.hp < e.maxHp) {
      CTX.fillStyle = '#333';
      CTX.fillRect(-e.radius, -e.radius - 8, e.radius * 2, 4);
      CTX.fillStyle = NEON_GREEN;
      CTX.fillRect(-e.radius, -e.radius - 8, e.radius * 2 * (e.hp / e.maxHp), 4);
    }
    CTX.restore();
  }
}

function drawBullets() {
  for (const b of bullets) {
    CTX.beginPath();
    CTX.arc(b.x, b.y, b.radius, 0, PI2);
    CTX.fillStyle = b.color;
    CTX.shadowColor = b.color;
    CTX.shadowBlur = 10;
    CTX.fill();
    CTX.shadowBlur = 0;
  }
}

function drawParticles() {
  for (const p of particles) {
    CTX.globalAlpha = Math.max(0, p.life / 500);
    CTX.beginPath();
    CTX.arc(p.x, p.y, p.radius, 0, PI2);
    CTX.fillStyle = p.color;
    CTX.shadowColor = p.color;
    CTX.shadowBlur = 5;
    CTX.fill();
    CTX.shadowBlur = 0;
  }
  CTX.globalAlpha = 1;
}

function drawPickups() {
  for (const p of pickups) {
    CTX.save();
    CTX.translate(p.x, p.y);
    CTX.rotate(performance.now() * 0.003);
    CTX.beginPath();
    if (p.type === 'health') {
      // Cross
      CTX.moveTo(-p.radius, 0); CTX.lineTo(p.radius, 0);
      CTX.moveTo(0, -p.radius); CTX.lineTo(0, p.radius);
      CTX.lineWidth = 3;
      CTX.strokeStyle = p.color;
      CTX.shadowColor = p.color;
      CTX.shadowBlur = 10;
      CTX.stroke();
    } else {
      // Lightning bolt
      CTX.moveTo(0, -p.radius);
      CTX.lineTo(-p.radius * 0.3, -p.radius * 0.2);
      CTX.lineTo(-p.radius * 0.1, -p.radius * 0.2);
      CTX.lineTo(0, p.radius);
      CTX.lineTo(p.radius * 0.3, p.radius * 0.2);
      CTX.lineTo(p.radius * 0.1, p.radius * 0.2);
      CTX.closePath();
      CTX.fillStyle = p.color;
      CTX.shadowColor = p.color;
      CTX.shadowBlur = 10;
      CTX.fill();
    }
    CTX.shadowBlur = 0;
    CTX.restore();
  }
}

function drawBackground() {
  // Grid
  CTX.strokeStyle = 'rgba(0, 255, 255, 0.05)';
  CTX.lineWidth = 1;
  const gridSize = 50;
  for (let x = 0; x <= CANVAS.width; x += gridSize) {
    CTX.beginPath();
    CTX.moveTo(x, 0);
    CTX.lineTo(x, CANVAS.height);
    CTX.stroke();
  }
  for (let y = 0; y <= CANVAS.height; y += gridSize) {
    CTX.beginPath();
    CTX.moveTo(0, y);
    CTX.lineTo(CANVAS.width, y);
    CTX.stroke();
  }
  // Vignette
  const grad = CTX.createRadialGradient(CANVAS.width/2, CANVAS.height/2, 0, CANVAS.width/2, CANVAS.height/2, Math.max(CANVAS.width, CANVAS.height)/1.5);
  grad.addColorStop(0, 'rgba(0,0,0,0)');
  grad.addColorStop(1, 'rgba(0,0,0,0.5)');
  CTX.fillStyle = grad;
  CTX.fillRect(0, 0, CANVAS.width, CANVAS.height);
}

function draw() {
  CTX.fillStyle = BG_COLOR;
  CTX.fillRect(0, 0, CANVAS.width, CANVAS.height);
  
  drawBackground();
  drawParticles();
  drawPickups();
  drawBullets();
  drawEnemies();
  drawPlayer();
  
  // Touch control hints
  if (gameState === 'playing' && ('ontouchstart' in window)) {
    CTX.save();
    CTX.globalAlpha = 0.3;
    // Left zone
    CTX.beginPath();
    CTX.arc(CANVAS.width/4, CANVAS.height/2, 80, 0, PI2);
    CTX.fillStyle = NEON_CYAN;
    CTX.fill();
    CTX.font = '12px monospace';
    CTX.fillStyle = '#000';
    CTX.textAlign = 'center';
    CTX.fillText('MOVE', CANVAS.width/4, CANVAS.height/2 + 4);
    // Right zone
    CTX.beginPath();
    CTX.arc(CANVAS.width*3/4, CANVAS.height/2, 80, 0, PI2);
    CTX.fillStyle = NEON_PINK;
    CTX.fill();
    CTX.fillStyle = '#000';
    CTX.fillText('AIM & SHOOT', CANVAS.width*3/4, CANVAS.height/2 + 4);
    CTX.restore();
  }
}

