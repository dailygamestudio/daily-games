<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no">
<title>Neon Ricochet - Day 36</title>
<style>
    * { margin: 0; padding: 0; box-sizing: border-box; -webkit-tap-highlight-color: transparent; }
    body { background: #0a0a12; min-height: 100vh; display: flex; justify-content: center; align-items: center; font-family: 'Orbitron', 'Segoe UI', sans-serif; overflow: hidden; }
    canvas { display: block; max-width: 100vw; max-height: 100vh; border: 2px solid #00ffff; box-shadow: 0 0 20px #00ffff, inset 0 0 20px #000033; background: #000; }
    @font-face { font-family: 'Orbitron'; src: url('https://fonts.gstatic.com/s/orbitron/v35/yMJMMIlzdpvBhQQL_SC3X9yhF25-T1nyGy6xpg.ttf') format('truetype'); font-weight: 400; font-display: swap; }
    @font-face { font-family: 'Orbitron'; src: url('https://fonts.gstatic.com/s/orbitron/v35/yMJMMIlzdpvBhQQL_SC3X9yhF25-T1ny_Cmxpg.ttf') format('truetype'); font-weight: 700; font-display: swap; }
</style>
</head>
<body>
<canvas id="gameCanvas"></canvas>
<script>
// ========== CONSTANTS & CONFIG ==========
const CANVAS_WIDTH = 800;
const CANVAS_HEIGHT = 600;
const PADDLE_WIDTH = 120;
const PADDLE_HEIGHT = 18;
const PADDLE_SPEED = 7;
const BALL_RADIUS = 10;
const BALL_BASE_SPEED = 6;
const BRICK_ROWS_START = 4;
const BRICK_COLS = 10;
const BRICK_WIDTH = 70;
const BRICK_HEIGHT = 28;
const BRICK_PADDING = 6;
const BRICK_OFFSET_TOP = 60;
const BRICK_OFFSET_LEFT = (CANVAS_WIDTH - (BRICK_COLS * (BRICK_WIDTH + BRICK_PADDING) - BRICK_PADDING)) / 2;
const POWERUP_SIZE = 24;
const POWERUP_FALL_SPEED = 2;
const PARTICLE_COUNT = 15;
const MAX_LEVEL = 20;

// Neon color palette
const NEON_COLORS = [
    '#00ffff', '#ff00ff', '#ffff00', '#00ff00', '#ff6600', '#ff0066', '#66ff00', '#0066ff'
];
const BRICK_COLORS = [
    { color: '#00ffff', hits: 1, score: 10 },
    { color: '#ff00ff', hits: 2, score: 20 },
    { color: '#ffff00', hits: 3, score: 30 },
    { color: '#ff6600', hits: 1, score: 15, powerupChance: 0.3 },
    { color: '#00ff00', hits: 2, score: 25, powerupChance: 0.2 }
];
const POWERUP_TYPES = [
    { type: 'expand', color: '#00ffff', label: '⟲', duration: 0 },
    { type: 'shrink', color: '#ff0066', label: '⟳', duration: 0 },
    { type: 'multi', color: '#ffff00', label: '●●', duration: 0 },
    { type: 'slow', color: '#00ff00', label: '▼', duration: 8000 },
    { type: 'fast', color: '#ff6600', label: '▲', duration: 8000 },
    { type: 'life', color: '#ff00ff', label: '♥', duration: 0 },
    { type: 'score', color: '#66ff00', label: '$', duration: 0 }
];

// ========== GAME STATE ==========
let canvas, ctx;
let gameState = 'menu'; // 'menu', 'playing', 'paused', 'gameover'
let paused = false;
let animationId = null;
let lastTime = 0;

// Game data
let score = 0;
let highScore = 0;
let level = 1;
let lives = 3;
let paddle = { x: 0, y: 0, width: PADDLE_WIDTH, height: PADDLE_HEIGHT, baseWidth: PADDLE_WIDTH, color: '#00ffff', expandTimer: 0, shrinkTimer: 0 };
let balls = [];
let bricks = [];
let powerUps = [];
let particles = [];
let buttons = [];

// Input
const keys = { left: false, right: false, space: false };
let touchX = null; // for touch drag
let touchY = null;
let mouseX = null; // for mouse drag
let mouseY = null;
let isDragging = false;

// ========== UTILITY ==========
function roundRect(ctx, x, y, w, h, r) {
    ctx.beginPath();
    ctx.moveTo(x + r, y);
    ctx.lineTo(x + w - r, y);
    ctx.quadraticCurveTo(x + w, y, x + w, y + r);
    ctx.lineTo(x + w, y + h - r);
    ctx.quadraticCurveTo(x + w, y + h, x + w - r, y + h);
    ctx.lineTo(x + r, y + h);
    ctx.quadraticCurveTo(x, y + h, x, y + h - r);
    ctx.lineTo(x, y + r);
    ctx.quadraticCurveTo(x, y, x + r, y);
    ctx.closePath();
}

function lerp(a, b, t) { return a + (b - a) * t; }
function clamp(v, min, max) { return Math.max(min, Math.min(max, v)); }
function randomColor() { return NEON_COLORS[Math.floor(Math.random() * NEON_COLORS.length)]; }

function shadeColor(color, percent) {
    const num = parseInt(color.replace('#', ''), 16);
    const amt = Math.round(2.55 * percent);
    const R = clamp((num >> 16) + amt, 0, 255);
    const G = clamp((num >> 8 & 0x00FF) + amt, 0, 255);
    const B = clamp((num & 0x0000FF) + amt, 0, 255);
    return '#' + (0x1000000 + R * 0x10000 + G * 0x100 + B).toString(16).slice(1);
}

// ========== INITIALIZATION ==========
function init() {
    canvas = document.getElementById('gameCanvas');
    ctx = canvas.getContext('2d');
    resizeCanvas();
    window.addEventListener('resize', resizeCanvas);
    
    // Load high score
    highScore = parseInt(localStorage.getItem('neonRicochetHighScore')) || 0;
    
    // Event listeners
    window.addEventListener('keydown', handleKeyDown, { passive: false });
    window.addEventListener('keyup', handleKeyUp, { passive: false });
    canvas.addEventListener('touchstart', handleTouchStart, { passive: false });
    canvas.addEventListener('touchmove', handleTouchMove, { passive: false });
    canvas.addEventListener('touchend', handleTouchEnd, { passive: false });
    canvas.addEventListener('mousedown', handleMouseDown);
    canvas.addEventListener('mousemove', handleMouseMove);
    canvas.addEventListener('mouseup', handleMouseUp);
    canvas.addEventListener('mouseleave', handleMouseUp);
    canvas.addEventListener('click', handleCanvasClick);
    
    showStartScreen();
    lastTime = performance.now();
    requestAnimationFrame(gameLoop);
}

function resizeCanvas() {
    const scale = Math.min(window.innerWidth / CANVAS_WIDTH, window.innerHeight / CANVAS_HEIGHT) * 0.95;
    canvas.width = CANVAS_WIDTH;
    canvas.height = CANVAS_HEIGHT;
    canvas.style.width = `${CANVAS_WIDTH * scale}px`;
    canvas.style.height = `${CANVAS_HEIGHT * scale}px`;
}

// ========== GAME STATE FUNCTIONS ==========
function startGame() {
    gameState = 'playing';
    paused = false;
    score = 0;
    level = 1;
    lives = 3;
    paddle.width = paddle.baseWidth;
    paddle.expandTimer = 0;
    paddle.shrinkTimer = 0;
    resetPaddleAndBall();
    spawnBricks();
    powerUps = [];
    particles = [];
    buttons = [];
}

function resetPaddleAndBall() {
    paddle.x = (CANVAS_WIDTH - paddle.width) / 2;
    paddle.y = CANVAS_HEIGHT - 40;
    balls = [{
        x: paddle.x + paddle.width / 2,
        y: paddle.y - BALL_RADIUS,
        radius: BALL_RADIUS,
        dx: 0,
        dy: 0,
        speed: BALL_BASE_SPEED,
        baseSpeed: BALL_BASE_SPEED,
        color: '#00ffff',
        launched: false,
        trail: [],
        slowTimer: 0,
        fastTimer: 0
    }];
}

function spawnBricks() {
    bricks = [];
    const rows = Math.min(BRICK_ROWS_START + level - 1, 8);
    for (let r = 0; r < rows; r++) {
        for (let c = 0; c < BRICK_COLS; c++) {
            const brickType = BRICK_COLORS[Math.min(r, BRICK_COLORS.length - 1)];
            const x = BRICK_OFFSET_LEFT + c * (BRICK_WIDTH + BRICK_PADDING);
            const y = BRICK_OFFSET_TOP + r * (BRICK_HEIGHT + BRICK_PADDING);
            let powerupChance = brickType.powerupChance || 0.1;
            powerupChance = Math.min(0.4, powerupChance + (level - 1) * 0.02);
            bricks.push({
                x, y,
                width: BRICK_WIDTH,
                height: BRICK_HEIGHT,
                color: brickType.color,
                hits: brickType.hits,
                maxHits: brickType.hits,
                score: brickType.score,
                visible: true,
                powerupChance,
                glow: 0
            });
        }
    }
}

function pauseGame() {
    if (gameState !== 'playing') return;
    paused = true;
    gameState = 'paused';
    createPauseButtons();
}

function resumeGame() {
    if (gameState !== 'paused') return;
    paused = false;
    gameState = 'playing';
    buttons = [];
    lastTime = performance.now();
}

function quitToMenu() {
    gameState = 'menu';
    paused = false;
    balls = [];
    bricks = [];
    powerUps = [];
    particles = [];
    showStartScreen();
}

function showStartScreen() {
    gameState = 'menu';
    buttons = [];
    createMenuButtons();
}

function gameOver() {
    gameState = 'gameover';
    if (score > highScore) {
        highScore = score;
        localStorage.setItem('neonRicochetHighScore', highScore);
    }
    createGameOverButtons();
}

function nextLevel() {
    level++;
    if (level > MAX_LEVEL) level = MAX_LEVEL;
    paddle.width = paddle.baseWidth;
    paddle.expandTimer = 0;
    paddle.shrinkTimer = 0;
    resetPaddleAndBall();
    spawnBricks();
    powerUps = [];
    particles = [];
}

// ========== BUTTON SYSTEM ==========
function createButton(x, y, w, h, text, action, color = '#00ffff') {
    return { x, y, width: w, height: h, text, action, color, hover: false };
}

function createMenuButtons() {
    const btnW = 280, btnH = 65;
    const startX = (CANVAS_WIDTH - btnW) / 2;
    buttons.push(createButton(startX, 340, btnW, btnH, 'START GAME', () => startGame(), '#00ffff'));
    buttons.push(createButton(startX, 425, btnW, btnH, 'HIGH SCORE: ' + highScore, null, '#ff00ff'));
}

function createPauseButtons() {
    const btnW = 220, btnH = 55;
    const startX = (CANVAS_WIDTH - btnW) / 2;
    buttons.push(createButton(startX, 280, btnW, btnH, 'RESUME', () => resumeGame(), '#00ff00'));
    buttons.push(createButton(startX, 355, btnW, btnH, 'QUIT TO MENU', () => quitToMenu(), '#ff0066'));
}

function createGameOverButtons() {
    const btnW = 220, btnH = 55;
    const startX = (CANVAS_WIDTH - btnW) / 2;
    buttons.push(createButton(startX, 320, btnW, btnH, 'RETRY', () => startGame(), '#00ffff'));
    buttons.push(createButton(startX, 395, btnW, btnH, 'MAIN MENU', () => quitToMenu(), '#ff00ff'));
}

function drawButtons() {
    buttons.forEach(btn => {
        if (!btn.action) return;
        ctx.save();
        ctx.shadowBlur = btn.hover ? 25 : 15;
        ctx.shadowColor = btn.color;
        ctx.fillStyle = btn.hover ? 'rgba(255,255,255,0.25)' : 'rgba(0,0,0,0.9)';
        ctx.strokeStyle = btn.color;
        ctx.lineWidth = 4;
        roundRect(ctx, btn.x, btn.y, btn.width, btn.height, 10);
        ctx.fill();
        ctx.stroke();
        ctx.shadowBlur = 0;
        ctx.fillStyle = btn.color;
        ctx.font = 'bold 26px Orbitron';
        ctx.textAlign = 'center';
        ctx.textBaseline = 'middle';
        ctx.fillText(btn.text, btn.x + btn.width/2, btn.y + btn.height/2);
        ctx.restore();
    });
    
    buttons.forEach(btn => {
        if (btn.action) return;
        ctx.save();
        ctx.fillStyle = 'rgba(0,0,0,0.7)';
        ctx.strokeStyle = btn.color;
        ctx.lineWidth = 2;
        roundRect(ctx, btn.x, btn.y, btn.width, btn.height, 10);
        ctx.fill();
        ctx.stroke();
        ctx.fillStyle = btn.color;
        ctx.font = 'bold 22px Orbitron';
        ctx.textAlign = 'center';
        ctx.textBaseline = 'middle';
        ctx.fillText(btn.text, btn.x + btn.width/2, btn.y + btn.height/2);
        ctx.restore();
    });
}

function checkButtonHover(x, y) {
    buttons.forEach(btn => {
        if (!btn.action) return;
        btn.hover = x >= btn.x && x <= btn.x + btn.width && y >= btn.y && y <= btn.y + btn.height;
    });
}

function handleButtonClick(x, y) {
    buttons.forEach(btn => {
        if (btn.action && btn.hover) {
            btn.action();
        }
    });
}

// ========== INPUT HANDLERS ==========
function handleKeyDown(e) {
    if (e.code === 'ArrowLeft' || e.code === 'KeyA') keys.left = true;
    if (e.code === 'ArrowRight' || e.code === 'KeyD') keys.right = true;
    if (e.code === 'Space') {
        keys.space = true;
        e.preventDefault();
        if (gameState === 'playing' && !paused) {
            launchBall();
        }
    }
    if (e.code === 'Escape' || e.code === 'KeyP') {
        if (gameState === 'playing') pauseGame();
        else if (gameState === 'paused') resumeGame();
    }
}

function handleKeyUp(e) {
    if (e.code === 'ArrowLeft' || e.code === 'KeyA') keys.left = false;
    if (e.code === 'ArrowRight' || e.code === 'KeyD') keys.right = false;
    if (e.code === 'Space') keys.space = false;
}

function getCanvasCoords(clientX, clientY) {
    const rect = canvas.getBoundingClientRect();
    const scaleX = CANVAS_WIDTH / rect.width;
    const scaleY = CANVAS_HEIGHT / rect.height;
    return {
        x: (clientX - rect.left) * scaleX,
        y: (clientY - rect.top) * scaleY
    };
}

function handleTouchStart(e) {
    e.preventDefault();
    const touch = e.touches[0];
    const coords = getCanvasCoords(touch.clientX, touch.clientY);
    touchX = coords.x;
    touchY = coords.y;
    isDragging = true;
    
    if (gameState === 'menu' || gameState === 'paused' || gameState === 'gameover') {
        checkButtonHover(coords.x, coords.y);
    }
}

function handleTouchMove(e) {
    e.preventDefault();
    if (!isDragging) return;
    const touch = e.touches[0];
    const coords = getCanvasCoords(touch.clientX, touch.clientY);
    touchX = coords.x;
    touchY = coords.y;
    
    if (gameState === 'menu' || gameState === 'paused' || gameState === 'gameover') {
        checkButtonHover(coords.x, coords.y);
    }
}

function handleTouchEnd(e) {
    e.preventDefault();
    if (isDragging && (gameState === 'menu' || gameState === 'paused' || gameState === 'gameover')) {
        handleButtonClick(touchX, touchY);
    }
    isDragging = false;
    touchX = null;
    touchY = null;
}

function handleMouseDown(e) {
    const coords = getCanvasCoords(e.clientX, e.clientY);
    mouseX = coords.x;
    mouseY = coords.y;
    isDragging = true;
    
    if (gameState === 'menu' || gameState === 'paused' || gameState === 'gameover') {
        checkButtonHover(coords.x, coords.y);
    }
}

function handleMouseMove(e) {
    const coords = getCanvasCoords(e.clientX, e.clientY);
    mouseX = coords.x;
    mouseY = coords.y;
    
    if (gameState === 'menu' || gameState === 'paused' || gameState === 'gameover') {
        checkButtonHover(coords.x, coords.y);
    }
}

function handleMouseUp(e) {
    if (isDragging && (gameState === 'menu' || gameState === 'paused' || gameState === 'gameover')) {
        handleButtonClick(mouseX, mouseY);
    }
    isDragging = false;
}

function handleCanvasClick(e) {
    const coords = getCanvasCoords(e.clientX, e.clientY);
    if (gameState === 'menu' || gameState === 'paused' || gameState === 'gameover') {
        handleButtonClick(coords.x, coords.y);
    }
}

// ========== GAME LOGIC ==========
function launchBall() {
    balls.forEach(ball => {
        if (!ball.launched) {
            ball.launched = true;
            const angle = -Math.PI / 2 + (Math.random() - 0.5) * 0.5;
            ball.dx = Math.cos(angle) * ball.speed;
            ball.dy = Math.sin(angle) * ball.speed;
        }
    });
}

function updatePaddle(dt) {
    if (keys.left) paddle.x -= PADDLE_SPEED * dt * 60;
    if (keys.right) paddle.x += PADDLE_SPEED * dt * 60;
    
    // Touch/mouse drag control
    if (touchX !== null) {
        paddle.x = touchX - paddle.width / 2;
    } else if (mouseX !== null && isDragging && gameState === 'playing') {
        paddle.x = mouseX - paddle.width / 2;
    }
    
    paddle.x = clamp(paddle.x, 0, CANVAS_WIDTH - paddle.width);
    
    // Update paddle timers
    if (paddle.expandTimer > 0) {
        paddle.expandTimer -= dt;
        if (paddle.expandTimer <= 0) {
            paddle.width = paddle.baseWidth;
        }
    }
    if (paddle.shrinkTimer > 0) {
        paddle.shrinkTimer -= dt;
        if (paddle.shrinkTimer <= 0) {
            paddle.width = paddle.baseWidth;
        }
    }
    
    // Keep unlaunched balls on paddle
    balls.forEach(ball => {
        if (!ball.launched) {
            ball.x = paddle.x + paddle.width / 2;
            ball.y = paddle.y - ball.radius;
        }
    });
}

function updateBalls(dt) {
    for (let i = balls.length - 1; i >= 0; i--) {
        const ball = balls[i];
        
        // Update timers
        if (ball.slowTimer > 0) ball.slowTimer -= dt;
        if (ball.fastTimer > 0) ball.fastTimer -= dt;
        
        const currentSpeed = ball.baseSpeed * (ball.slowTimer > 0 ? 0.5 : 1) * (ball.fastTimer > 0 ? 1.5 : 1);
        
        if (ball.launched) {
            // Add trail
            ball.trail.push({ x: ball.x, y: ball.y, alpha: 1 });
            if (ball.trail.length > 8) ball.trail.shift();
            
            ball.x += ball.dx * dt * 60;
            ball.y += ball.dy * dt * 60;
            
            // Wall collisions
            if (ball.x - ball.radius <= 0) {
                ball.x = ball.radius;
                ball.dx = Math.abs(ball.dx);
                createParticles(ball.x, ball.y, ball.color);
            }
            if (ball.x + ball.radius >= CANVAS_WIDTH) {
                ball.x = CANVAS_WIDTH - ball.radius;
                ball.dx = -Math.abs(ball.dx);
                createParticles(ball.x, ball.y, ball.color);
            }
            if (ball.y - ball.radius <= 0) {
                ball.y = ball.radius;
                ball.dy = Math.abs(ball.dy);
                createParticles(ball.x, ball.y, ball.color);
            }
            
            // Paddle collision
            if (ball.y + ball.radius >= paddle.y && 
                ball.x >= paddle.x && ball.x <= paddle.x + paddle.width &&
                ball.dy > 0) {
                ball.y = paddle.y - ball.radius;
                const hitPos = (ball.x - paddle.x) / paddle.width - 0.5;
                const angle = hitPos * Math.PI * 0.75;
                const speed = Math.sqrt(ball.dx * ball.dx + ball.dy * ball.dy);
                ball.dx = Math.sin(angle) * speed;
                ball.dy = -Math.cos(angle) * speed;
                ball.color = paddle.color;
                createParticles(ball.x, ball.y, ball.color);
            }
            
            // Brick collisions
            bricks.forEach(brick => {
                if (!brick.visible) return;
                if (ball.x + ball.radius >= brick.x && ball.x - ball.radius <= brick.x + brick.width &&
                    ball.y + ball.radius >= brick.y && ball.y - ball.radius <= brick.y + brick.height) {
                    
                    // Determine collision side
                    const overlapX = Math.min(ball.x + ball.radius, brick.x + brick.width) - Math.max(ball.x - ball.radius, brick.x);
                    const overlapY = Math.min(ball.y + ball.radius, brick.y + brick.height) - Math.max(ball.y - ball.radius, brick.y);
                    
                    if (overlapX < overlapY) {
                        if (ball.x < brick.x + brick.width / 2) ball.x = brick.x - ball.radius;
                        else ball.x = brick.x + brick.width + ball.radius;
                        ball.dx = -ball.dx;
                    } else {
                        if (ball.y < brick.y + brick.height / 2) ball.y = brick.y - ball.radius;
                        else ball.y = brick.y + brick.height + ball.radius;
                        ball.dy = -ball.dy;
                    }
                    
                    brick.hits--;
                    brick.glow = 1;
                    score += brick.score;
                    createParticles(ball.x, ball.y, brick.color, 8);
                    
                    if (brick.hits <= 0) {
                        brick.visible = false;
                        // Chance to spawn powerup
                        if (Math.random() < brick.powerupChance) {
                            spawnPowerUp(brick.x + brick.width/2, brick.y + brick.height/2);
                        }
                    }
                }
            });
            
            // Ball lost
            if (ball.y - ball.radius > CANVAS_HEIGHT) {
                createParticles(ball.x, ball.y, ball.color, 20);
                balls.splice(i, 1);
            }
        }
    }
    
    // Check if all balls lost
    if (balls.length === 0) {
        lives--;
        if (lives <= 0) {
            gameOver();
        } else {
            resetPaddleAndBall();
        }
    }
}

function updatePowerUps(dt) {
    for (let i = powerUps.length - 1; i >= 0; i--) {
        const pu = powerUps[i];
        pu.y += POWERUP_FALL_SPEED * dt * 60;
        pu.rotation += 0.02 * dt * 60;
        
        // Check paddle collision
        if (pu.y + POWERUP_SIZE >= paddle.y && pu.y <= paddle.y + paddle.height &&
            pu.x + POWERUP_SIZE >= paddle.x && pu.x <= paddle.x + paddle.width) {
            applyPowerUp(pu.type);
            createParticles(pu.x + POWERUP_SIZE/2, pu.y + POWERUP_SIZE/2, pu.color, 10);
            powerUps.splice(i, 1);
        } else if (pu.y > CANVAS_HEIGHT) {
            powerUps.splice(i, 1);
        }
    }
}

function spawnPowerUp(x, y) {
    const type = POWERUP_TYPES[Math.floor(Math.random() * POWERUP_TYPES.length)];
    powerUps.push({
        x: x - POWERUP_SIZE/2,
        y: y - POWERUP_SIZE/2,
        type: type.type,
        color: type.color,
        label: type.label,
        rotation: 0
    });
}

function applyPowerUp(type) {
    switch(type) {
        case 'expand':
            paddle.width = Math.min(paddle.baseWidth * 1.5, CANVAS_WIDTH * 0.5);
            paddle.expandTimer = 10000;
            break;
        case 'shrink':
            paddle.width = Math.max(paddle.baseWidth * 0.6, 60);
            paddle.shrinkTimer = 10000;
            break;
        case 'multi':
            const newBalls = [];
            balls.forEach(ball => {
                if (ball.launched) {
                    for (let j = 0; j < 2; j++) {
                        const angle = Math.atan