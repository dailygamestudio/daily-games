<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no">
<title>Neon Ricochet - Day 36</title>
<style>
    * { margin: 0; padding: 0; box-sizing: border-box; -webkit-tap-highlight-color: transparent; }
    body { background: #0a0a12; min-height: 100vh; display: flex; justify-content: center; align-items: center; font-family: 'Orbitron', 'Segoe UI', sans-serif; overflow: hidden; }
    canvas { display: block; max-width: 100vw; max-height: 100vh; border: 2px solid #00ffff; box-shadow: 0 0 20px #00ffff, inset 0 0 20px #000033; background: #000; }
    @font-face { font-family: 'Orbitron'; src: url('https://fonts.gstatic.com/s/orbitron/v18/yMJMMIlzdpvBhQQL_SC3X1yU.woff2') format('woff2'); font-weight: 400 700; font-display: swap; }
</style>
</head>
<body>
<canvas id="gameCanvas"></canvas>
<script>
// ========== CONSTANTS & CONFIG ==========
const CANVAS_WIDTH = 800;
const CANVAS_HEIGHT = 600;
const PADDLE_WIDTH = 120;
const PADDLE_HEIGHT = 18;
const PADDLE_SPEED = 7;
const BALL_RADIUS = 10;
const BALL_BASE_SPEED = 6;
const BRICK_ROWS_START = 4;
const BRICK_COLS = 10;
const BRICK_WIDTH = 70;
const BRICK_HEIGHT = 28;
const BRICK_PADDING = 6;
const BRICK_OFFSET_TOP = 60;
const BRICK_OFFSET_LEFT = (CANVAS_WIDTH - (BRICK_COLS * (BRICK_WIDTH + BRICK_PADDING) - BRICK_PADDING)) / 2;
const POWERUP_SIZE = 24;
const POWERUP_FALL_SPEED = 2;
const PARTICLE_COUNT = 15;
const MAX_LEVEL = 20;

// Neon color palette
const NEON_COLORS = [
    '#00ffff', '#ff00ff', '#ffff00', '#00ff00', '#ff6600', '#ff0066', '#66ff00', '#0066ff'
];
const BRICK_COLORS = [
    { color: '#00ffff', hits: 1, score: 10 },
    { color: '#ff00ff', hits: 2, score: 20 },
    { color: '#ffff00', hits: 3, score: 30 },
    { color: '#ff6600', hits: 1, score: 15, powerupChance: 0.3 },
    { color: '#00ff00', hits: 2, score: 25, powerupChance: 0.2 }
];
const POWERUP_TYPES = [
    { type: 'expand', color: '#00ffff', label: '⟲', duration: 0 },
    { type: 'shrink', color: '#ff0066', label: '⟳', duration: 0 },
    { type: 'multi', color: '#ffff00', label: '●●', duration: 0 },
    { type: 'slow', color: '#00ff00', label: '▼', duration: 8000 },
    { type: 'fast', color: '#ff6600', label: '▲', duration: 8000 },
    { type: 'life', color: '#ff00ff', label: '♥', duration: 0 },
    { type: 'score', color: '#66ff00', label: '$', duration: 0 }
];

// ========== GAME STATE ==========
let canvas, ctx;
let gameState = 'menu'; // 'menu', 'playing', 'paused', 'gameover'
let paused = false;
let animationId = null;
let lastTime = 0;

// Game data
let score = 0;
let highScore = 0;
let level = 1;
let lives = 3;
let paddle = { x: 0, y: 0, width: PADDLE_WIDTH, height: PADDLE_HEIGHT, baseWidth: PADDLE_WIDTH, color: '#00ffff', expandTimer: 0, shrinkTimer: 0 };
let balls = [];
let bricks = [];
let powerUps = [];
let particles = [];
let buttons = [];

// Input
const keys = { left: false, right: false, space: false };
let touchX = null; // for touch drag
let mouseX = null; // for mouse drag
let isDragging = false;

// ========== INITIALIZATION ==========
function init() {
    canvas = document.getElementById('gameCanvas');
    ctx = canvas.getContext('2d');
    resizeCanvas();
    window.addEventListener('resize', resizeCanvas);
    
    // Load high score
    highScore = parseInt(localStorage.getItem('neonRicochetHighScore')) || 0;
    
    // Event listeners
    window.addEventListener('keydown', handleKeyDown, { passive: false });
    window.addEventListener('keyup', handleKeyUp, { passive: false });
    canvas.addEventListener('touchstart', handleTouchStart, { passive: false });
    canvas.addEventListener('touchmove', handleTouchMove, { passive: false });
    canvas.addEventListener('touchend', handleTouchEnd, { passive: false });
    canvas.addEventListener('mousedown', handleMouseDown);
    canvas.addEventListener('mousemove', handleMouseMove);
    canvas.addEventListener('mouseup', handleMouseUp);
    canvas.addEventListener('mouseleave', handleMouseUp);
    canvas.addEventListener('click', handleCanvasClick);
    
    showStartScreen();
    requestAnimationFrame(gameLoop);
}

function resizeCanvas() {
    const scale = Math.min(window.innerWidth / CANVAS_WIDTH, window.innerHeight / CANVAS_HEIGHT) * 0.95;
    canvas.width = CANVAS_WIDTH;
    canvas.height = CANVAS_HEIGHT;
    canvas.style.width = `${CANVAS_WIDTH * scale}px`;
    canvas.style.height = `${CANVAS_HEIGHT * scale}px`;
}

// ========== GAME STATE FUNCTIONS ==========
function startGame() {
    gameState = 'playing';
    paused = false;
    score = 0;
    level = 1;
    lives = 3;
    paddle.width = paddle.baseWidth;
    paddle.expandTimer = 0;
    paddle.shrinkTimer = 0;
    resetPaddleAndBall();
    spawnBricks();
    powerUps = [];
    particles = [];
    buttons = [];
}

function resetPaddleAndBall() {
    paddle.x = (CANVAS_WIDTH - paddle.width) / 2;
    paddle.y = CANVAS_HEIGHT - 40;
    balls = [{
        x: paddle.x + paddle.width / 2,
        y: paddle.y - BALL_RADIUS,
        radius: BALL_RADIUS,
        dx: 0,
        dy: 0,
        speed: BALL_BASE_SPEED,
        baseSpeed: BALL_BASE_SPEED,
        color: '#00ffff',
        launched: false,
        trail: [],
        slowTimer: 0,
        fastTimer: 0
    }];
}

function spawnBricks() {
    bricks = [];
    const rows = Math.min(BRICK_ROWS_START + level - 1, 8);
    for (let r = 0; r < rows; r++) {
        for (let c = 0; c < BRICK_COLS; c++) {
            const brickType = BRICK_COLORS[Math.min(r, BRICK_COLORS.length - 1)];
            const x = BRICK_OFFSET_LEFT + c * (BRICK_WIDTH + BRICK_PADDING);
            const y = BRICK_OFFSET_TOP + r * (BRICK_HEIGHT + BRICK_PADDING);
            let powerupChance = brickType.powerupChance || 0.1;
            // Increase powerup chance slightly per level
            powerupChance = Math.min(0.4, powerupChance + (level - 1) * 0.02);
            bricks.push({
                x, y,
                width: BRICK_WIDTH,
                height: BRICK_HEIGHT,
                color: brickType.color,
                hits: brickType.hits,
                maxHits: brickType.hits,
                score: brickType.score,
                visible: true,
                powerupChance,
                glow: 0
            });
        }
    }
}

function pauseGame() {
    if (gameState !== 'playing') return;
    paused = true;
    gameState = 'paused';
    createPauseButtons();
}

function resumeGame() {
    if (gameState !== 'paused') return;
    paused = false;
    gameState = 'playing';
    buttons = [];
    lastTime = performance.now(); // reset delta time
}

function quitToMenu() {
    gameState = 'menu';
    paused = false;
    balls = [];
    bricks = [];
    powerUps = [];
    particles = [];
    showStartScreen();
}

function showStartScreen() {
    gameState = 'menu';
    buttons = [];
    createMenuButtons();
}

function gameOver() {
    gameState = 'gameover';
    if (score > highScore) {
        highScore = score;
        localStorage.setItem('neonRicochetHighScore', highScore);
    }
    createGameOverButtons();
}

// ========== BUTTON SYSTEM ==========
function createButton(x, y, w, h, text, action, color = '#00ffff') {
    return { x, y, width: w, height: h, text, action, color, hover: false };
}

function createMenuButtons() {
    const btnW = 240, btnH = 60;
    const startX = (CANVAS_WIDTH - btnW) / 2;
    buttons.push(createButton(startX, 350, btnW, btnH, 'START GAME', () => startGame()));
    buttons.push(createButton(startX, 430, btnW, btnH, 'HIGH SCORE: ' + highScore, null, '#ff00ff'));
}

function createPauseButtons() {
    const btnW = 200, btnH = 50;
    const startX = (CANVAS_WIDTH - btnW) / 2;
    buttons.push(createButton(startX, 280, btnW, btnH, 'RESUME', () => resumeGame()));
    buttons.push(createButton(startX, 350, btnW, btnH, 'QUIT TO MENU', () => quitToMenu()));
}

function createGameOverButtons() {
    const btnW = 200, btnH = 50;
    const startX = (CANVAS_WIDTH - btnW) / 2;
    buttons.push(createButton(startX, 320, btnW, btnH, 'RETRY', () => startGame()));
    buttons.push(createButton(startX, 390, btnW, btnH, 'MAIN MENU', () => quitToMenu()));
}

function drawButtons() {
    buttons.forEach(btn => {
        ctx.save();
        ctx.shadowBlur = btn.hover ? 20 : 10;
        ctx.shadowColor = btn.color;
        ctx.fillStyle = btn.hover ? 'rgba(255,255,255,0.2)' : 'rgba(0,0,0,0.8)';
        ctx.strokeStyle = btn.color;
        ctx.lineWidth = 3;
        roundRect(ctx, btn.x, btn.y, btn.width, btn.height, 8);
        ctx.fill();
        ctx.stroke();
        ctx.shadowBlur = 0;
        ctx.fillStyle = btn.color;
        ctx.font = 'bold 24px Orbitron';
        ctx.textAlign = 'center';
        ctx.textBaseline = 'middle';
        ctx.fillText(btn.text, btn.x + btn.width/2, btn.y + btn.height/2);
        ctx.restore();
    });
}

function checkButtonClick(x, y) {
    buttons.forEach(btn => {
        if (btn.action && x >= btn.x && x <= btn.x + btn.width && y >= btn.y && y <= btn.y + btn.height) {
            btn.action();
        }
    });
}

function updateButtonHover(x, y) {
    buttons.forEach(btn => {
        btn.hover = btn.action && x >= btn.x && x <= btn.x + btn.width && y >= btn.y && y <= btn.y + btn.height;
    });
}

// ========== INPUT HANDLING ==========
function handleKeyDown(e) {
    if (e.key === 'ArrowLeft' || e.key === 'a' || e.key === 'A') keys.left = true;
    if (e.key === 'ArrowRight' || e.key === 'd' || e.key === 'D') keys.right = true;
    if (e.key === ' ') { keys.space = true; e.preventDefault(); }
    if (e.key === 'Escape' || e.key === 'p' || e.key === 'P') {
        if (gameState === 'playing') {
            pauseGame();
        } else if (gameState === 'paused') {
            resumeGame();
        }
        e.preventDefault();
    }
}

function handleKeyUp(e) {
    if (e.key === 'ArrowLeft' || e.key === 'a' || e.key === 'A') keys.left = false;
    if (e.key === 'ArrowRight' || e.key === 'd' || e.key === 'D') keys.right = false;
    if (e.key === ' ') keys.space = false;
}

function handleTouchStart(e) {
    e.preventDefault();
    const rect = canvas.getBoundingClientRect();
    const scaleX = CANVAS_WIDTH / rect.width;
    const scaleY = CANVAS_HEIGHT / rect.height;
    const tx = (e.touches[0].clientX - rect.left) * scaleX;
    const ty = (e.touches[0].clientY - rect.top) * scaleY;
    
    if (gameState === 'playing' && !paused) {
        // Check if touching paddle area
        if (ty > paddle.y - 20) {
            isDragging = true;
            touchX = tx;
        }
        // Launch ball if not launched
        balls.forEach(ball => {
            if (!ball.launched) launchBall(ball);
        });
    } else {
        // Menu or overlay click
        checkButtonClick(tx, ty);
    }
}

function handleTouchMove(e) {
    e.preventDefault();
    if (isDragging && gameState === 'playing' && !paused) {
        const rect = canvas.getBoundingClientRect();
        const scaleX = CANVAS_WIDTH / rect.width;
        touchX = (e.touches[0].clientX - rect.left) * scaleX;
    }
}

function handleTouchEnd(e) {
    e.preventDefault();
    isDragging = false;
    touchX = null;
}

function handleMouseDown(e) {
    const rect = canvas.getBoundingClientRect();
    const scaleX = CANVAS_WIDTH / rect.width;
    const scaleY = CANVAS_HEIGHT / rect.height;
    mouseX = (e.clientX - rect.left) * scaleX;
    const my = (e.clientY - rect.top) * scaleY;
    
    if (gameState === 'playing' && !paused) {
        if (my > paddle.y - 20) {
            isDragging = true;
        }
        balls.forEach(ball => { if (!ball.launched) launchBall(ball); });
    } else {
        checkButtonClick(mouseX, my);
    }
}

function handleMouseMove(e) {
    const rect = canvas.getBoundingClientRect();
    const scaleX = CANVAS_WIDTH / rect.width;
    const scaleY = CANVAS_HEIGHT / rect.height;
    mouseX = (e.clientX - rect.left) * scaleX;
    const my = (e.clientY - rect.top) * scaleY;
    
    if (gameState !== 'playing' || paused) {
        updateButtonHover(mouseX, my);
    }
}

function handleMouseUp(e) {
    isDragging = false;
    mouseX = null;
}

function handleCanvasClick(e) {
    // For desktop click on buttons
    if (gameState !== 'playing' || paused) {
        const rect = canvas.getBoundingClientRect();
        const scaleX = CANVAS_WIDTH / rect.width;
        const scaleY = CANVAS_HEIGHT / rect.height;
        const mx = (e.clientX - rect.left) * scaleX;
        const my = (e.clientY - rect.top) * scaleY;
        checkButtonClick(mx, my);
    }
}

// ========== GAME LOGIC ==========
function launchBall(ball) {
    ball.launched = true;
    // Randomize initial angle slightly
    const angle = -Math.PI/2 + (Math.random() - 0.5) * 0.5;
    ball.dx = Math.cos(angle) * ball.speed;
    ball.dy = Math.sin(angle) * ball.speed;
}

function updatePaddle(dt) {
    // Keyboard
    if (keys.left) paddle.x -= PADDLE_SPEED * dt * 60;
    if (keys.right) paddle.x += PADDLE_SPEED * dt * 60;
    // Touch / Mouse drag
    if (isDragging && touchX !== null) {
        paddle.x = touchX - paddle.width / 2;
    } else if (isDragging && mouseX !== null) {
        paddle.x = mouseX - paddle.width / 2;
    }
    // Clamp
    paddle.x = Math.max(0, Math.min(CANVAS_WIDTH - paddle.width, paddle.x));
    
    // Update paddle timers
    if (paddle.expandTimer > 0) {
        paddle.expandTimer -= dt * 1000;
        if (paddle.expandTimer <= 0) paddle.width = paddle.baseWidth;
    }
    if (paddle.shrinkTimer > 0) {
        paddle.shrinkTimer -= dt * 1000;
        if (paddle.shrinkTimer <= 0) paddle.width = paddle.baseWidth;
    }
    
    // Stick unlaunched balls to paddle
    balls.forEach(ball => {
        if (!ball.launched) {
            ball.x = paddle.x + paddle.width / 2;
            ball.y = paddle.y - ball.radius;
        }
    });
}

function updateBalls(dt) {
    for (let i = balls.length - 1; i >= 0; i--) {
        const ball = balls[i];
        if (!ball.launched) continue;
        
        // Update trail
        ball.trail.unshift({ x: ball.x, y: ball.y, alpha: 1 });
        if (ball.trail.length > 10) ball.trail.pop();
        ball.trail.forEach(t => t.alpha *= 0.85);
        
        // Update timers
        if (ball.slowTimer > 0) ball.slowTimer -= dt * 1000;
        if (ball.fastTimer > 0) ball.fastTimer -= dt * 1000;
        
        // Calculate effective speed
        let effectiveSpeed = ball.baseSpeed;
        if (ball.slowTimer > 0) effectiveSpeed *= 0.5;
        if (ball.fastTimer > 0) effectiveSpeed *= 1.5;
        
        // Normalize velocity to maintain speed
        const currentSpeed = Math.sqrt(ball.dx * ball.dx + ball.dy * ball.dy);
        if (currentSpeed > 0) {
            ball.dx = (ball.dx / currentSpeed) * effectiveSpeed;
            ball.dy = (ball.dy / currentSpeed) * effectiveSpeed;
        }
        
        // Move ball
        ball.x += ball.dx * dt * 60;
        ball.y += ball.dy * dt * 60;
        
        // Wall collisions
        if (ball.x - ball.radius <= 0) {
            ball.x = ball.radius;
            ball.dx = Math.abs(ball.dx);
            createParticles(ball.x, ball.y, ball.color, 5);
        }
        if (ball.x + ball.radius >= CANVAS_WIDTH) {
            ball.x = CANVAS_WIDTH - ball.radius;
            ball.dx = -Math.abs(ball.dx);
            createParticles(ball.x, ball.y, ball.color, 5);
        }
        if (ball.y - ball.radius <= 0) {
            ball.y = ball.radius;
            ball.dy = Math.abs(ball.dy);
            createParticles(ball.x, ball.y, ball.color, 5);
        }
        
        // Bottom - lose life
        if (ball.y - ball.radius > CANVAS_HEIGHT) {
            createParticles(ball.x, ball.y, ball.color, PARTICLE_COUNT);
            balls.splice(i, 1);
            continue;
        }
        
        // Paddle collision
        if (ball.y + ball.radius >= paddle.y && 
            ball.y - ball.radius <= paddle.y + paddle.height &&
            ball.x >= paddle.x && ball.x <= paddle.x + paddle.width) {
            
            ball.y = paddle.y - ball.radius;
            // Calculate bounce angle based on hit position
            const hitPos = (ball.x - paddle.x) / paddle.width; // 0 to 1
            const angle = -Math.PI/2 + (hitPos - 0.5) * Math.PI * 0.75;
            ball.dx = Math.cos(angle) * effectiveSpeed;
            ball.dy = Math.sin(angle) * effectiveSpeed;
            createParticles(ball.x, ball.y, ball.color, 8);
        }
    }
    
    // Check if all balls lost
    if (balls.length === 0) {
        loseLife();
    }
}

function loseLife() {
    lives--;
    if (lives <= 0) {
        gameOver();
    } else {
        resetPaddleAndBall();
    }
}

function updatePowerUps(dt) {
    for (let i = powerUps.length - 1; i >= 0; i--) {
        const pu = powerUps[i];
        pu.y += POWERUP_FALL_SPEED * dt * 60;
        pu.glow = (pu.glow + dt * 60 * 5) % (Math.PI * 2);
        
        // Check paddle collision
        if (pu.y + POWERUP_SIZE >= paddle.y &&
            pu.y <= paddle.y + paddle.height &&
            pu.x + POWERUP_SIZE >= paddle.x &&
            pu.x <= paddle.x + paddle.width) {
            
            applyPowerUp(pu.type);
            createParticles(pu.x + POWERUP_SIZE/2, pu.y + POWERUP_SIZE/2, pu.color, PARTICLE_COUNT);
            powerUps.splice(i, 1);
        }
        // Remove if off screen
        else if (pu.y > CANVAS_HEIGHT) {
            powerUps.splice(i, 1);
        }
    }
}

function applyPowerUp(type) {
    switch(type) {
        case 'expand':
            paddle.width = Math.min(paddle.baseWidth * 1.5, CANVAS_WIDTH * 0.5);
            paddle.expandTimer = 10000;
            break;
        case 'shrink':
            paddle.width = Math.max(paddle.baseWidth * 0.6, 60);
            paddle.shrinkTimer = 10000;
            break;
        case 'multi':
            // Add 2 extra balls
            const mainBall = balls.find(b => b.launched) || balls[0];
            if (mainBall) {
                for (let i = 0; i < 2; i++) {
                    const angle = -Math.PI/2 + (Math.random() - 0.5) * 1.0;
                    balls.push({
                        x: mainBall.x,
                        y: mainBall.y,
                        radius: BALL_RADIUS,
                        dx: Math.cos(angle) * mainBall.speed,
                        dy: Math.sin(angle) * mainBall.speed,
                        speed: mainBall.speed,
                        baseSpeed: mainBall.baseSpeed,
                        color: NEON_COLORS[Math.floor(Math.random() * NEON_COLORS.length)],
                        launched: true,
                        trail: [],
                        slowTimer: 0,
                        fastTimer: 0
                    });
                }
            }
            break;
        case 'slow':
            balls.forEach(b => { b.slowTimer = 8000; b.fastTimer = 0; });
            break;
        case 'fast':
            balls.forEach(b => { b.fastTimer = 8000; b.slowTimer = 0; });
            break;
        case 'life':
            lives = Math.min(5, lives + 1);
            break;
        case 'score':
            score += 500 * level;
            break;
    }
}

function updateParticles(dt) {
    for (let i = particles.length - 1; i >= 0; i--) {
        const p = particles[i];
        p.x += p.dx * dt * 60;
        p.y += p.dy * dt * 60;
        p.life -= dt * 1000;
        p.alpha = p.life / p.maxLife;
        if (p.life <= 0) particles.splice(i, 1);
    }
}

function checkCollisions() {
    balls.forEach(ball => {
        if (!ball.launched) return;
        
        bricks.forEach(brick => {
            if (!brick.visible) return;
            
            // AABB collision
            if (ball.x + ball.radius > brick.x &&
                ball.x - ball.radius < brick.x + brick.width &&
                ball.y + ball.radius > brick.y &&
                ball.y - ball.radius < brick.y + brick.height) {
                
                // Determine collision side
                const overlapX = Math.min(ball.x + ball.radius - brick.x, brick.x + brick.width - (ball.x - ball.radius));
                const overlapY = Math.min(ball.y + ball.radius - brick.y, brick.y + brick.height - (ball.y - ball.radius));
                
                if (overlapX < overlapY) {
                    // Horizontal collision
                    if (ball.x < brick.x + brick.width / 2) {
                        ball.x = brick.x - ball.radius;
                        ball.dx = -Math.abs(ball.dx);
                    } else {
                        ball.x = brick.x + brick.width + ball.radius;
                        ball.dx = Math.abs(ball.dx);
                    }
                } else {
                    // Vertical collision
                    if (ball.y < brick.y + brick.height / 2) {
                        ball.y = brick.y - ball.radius;
                        ball.dy = -Math.abs(ball.dy);
                    } else {
                        ball.y = brick.y + brick.height + ball.radius;
                        ball.dy = Math.abs(ball.dy);
                    }
                }
                
                // Damage brick
                brick.hits--;
                brick.glow = 1;
                score += brick.score;
                createParticles(ball.x, ball.y, brick.color, 8);
                
                if (brick.hits <= 0) {
                    brick.visible = false;
                    // Chance to spawn powerup
                    if (Math.random() < brick.powerupChance) {
                        spawnPowerUp(brick.x + brick.width/2, brick.y + brick.height/2);
                    }
                }
            }
        });
    });
    
    // Check level complete
    const remainingBricks = bricks.filter(b => b.visible).length;
    if (remainingBricks === 0) {
        nextLevel();
    }
}

function nextLevel() {
    level++;
    if (level > MAX_LEVEL) level = MAX_LEVEL;
    // Bonus points for completing level
    score += 1000 * level;
    // Reset paddle and ball, spawn new bricks
    resetPaddleAndBall();
    spawnBricks();
    powerUps = [];
    particles = [];
}

function spawnPowerUp(x, y) {
    const type = POWERUP_TYPES[Math.floor(Math.random() * POWERUP_TYPES.length)];
    powerUps.push({
        x: x - POWERUP_SIZE/2,
        y: y - POWERUP_SIZE/2,
        type: type.type,
        color: type.color,
        label: type.label,
        glow: 0
    });
}

function createParticles(x, y, color, count) {
    for (let i = 0; i < count; i++) {
        const angle = Math.random() * Math.PI * 2;
        const speed = 1 + Math.random() * 3;
        particles.push({
            x, y,
            dx: Math.cos(angle) * speed,
            dy: Math.sin(angle) * speed,
            color,
            life: 500 + Math.random() * 500,
            maxLife: 1000,
            alpha: 1,
            size: 2 + Math.random() * 4
        });
    }
}

// ========== RENDERING ==========
function roundRect(ctx, x, y, w, h, r) {
    ctx.beginPath();
    ctx.moveTo(x + r, y);
    ctx.lineTo(x + w - r, y);
    ctx.quadraticCurveTo(x + w, y, x + w, y + r);
    ctx.lineTo(x + w, y + h - r);
    ctx.quadraticCurveTo(x + w, y + h, x + w - r, y + h);
    ctx.lineTo(x + r, y + h);
    ctx.quadraticCurveTo(x, y + h, x, y + h - r);
    ctx.lineTo(x, y + r);
    ctx.quadraticCurveTo(x, y, x + r, y);
    ctx.closePath();
}

function drawBackground() {
    // Dark gradient background
    const grad = ctx.createLinearGradient(0, 0, 0, CANVAS_HEIGHT);
    grad.addColorStop(0, '#0a0a12');
    grad.addColorStop(1, '#000000');
    ctx.fillStyle = grad;
    ctx.fillRect(0, 0, CANVAS_WIDTH, CANVAS_HEIGHT);
    
    // Grid lines
    ctx.strokeStyle = 'rgba(0, 255, 255, 0.03)';
    ctx.lineWidth = 1;
    for (let x = 0; x <= CANVAS_WIDTH; x += 40) {
        ctx.beginPath();
        ctx.moveTo(x, 0);
        ctx.lineTo(x, CANVAS_HEIGHT);
        ctx.stroke();
    }
    for (let y = 0; y <= CANVAS_HEIGHT; y += 40) {
        ctx.beginPath();
        ctx.moveTo(0, y);
        ctx.lineTo(CANVAS_WIDTH, y);
        ctx.stroke();
    }
}

function drawPaddle() {
    ctx.save();
    // Paddle glow
    const glowIntensity = paddle.expandTimer > 0 ? 20 : (paddle.shrinkTimer > 0 ? 10 : 15);
    ctx.shadowBlur = glowIntensity;
    ctx.shadowColor = paddle.color;
    
    // Paddle body
    const paddleGrad = ctx.createLinearGradient(paddle.x, paddle.y, paddle.x, paddle.y + paddle.height);
    paddleGrad.addColorStop(0, paddle.color);
    paddleGrad.addColorStop(1, '#000');
    ctx.fillStyle = paddleGrad;
    roundRect(ctx, paddle.x, paddle.y, paddle.width, paddle.height, 6);
    ctx.fill();
    
    // Paddle highlight
    ctx.fillStyle = 'rgba(255,255,255,0.3)';
    roundRect(ctx, paddle.x + 2, paddle.y + 2, paddle.width - 4, 4, 2);
    ctx.fill();
    
    ctx.restore();
}

function drawBalls() {
    balls.forEach(ball => {
        if (!ball.launched) return;
        
        // Draw trail
        ball.trail.forEach((t, i) => {
            ctx.globalAlpha = t.alpha * 0.3;
            ctx.fillStyle = ball.color;
            ctx.beginPath();
            ctx.arc(t.x, t.y, ball.radius * (1 - i / ball.trail.length), 0, Math.PI * 2);
            ctx.fill();
        });
        ctx.globalAlpha = 1;
        
        // Ball glow
        ctx.shadowBlur = 15;
        ctx.shadowColor = ball.color;
        
        // Ball body
        const ballGrad = ctx.createRadialGradient(ball.x - 2, ball.y - 2, 0, ball.x, ball.y, ball.radius);
        ballGrad.addColorStop(0, '#fff');
        ballGrad.addColorStop(0.5, ball.color);
        ballGrad.addColorStop(1, '#000');
        ctx.fillStyle = ballGrad;
        ctx.beginPath();
        ctx.arc(ball.x, ball.y, ball.radius, 0, Math.PI * 2);
        ctx.fill();
        
        ctx.shadowBlur = 0;
    });
}

function drawBricks() {
    bricks.forEach(brick => {
        if (!brick.visible) return;
        
        ctx.save();
        
        // Glow effect when hit
        if (brick.glow > 0) {
            ctx.shadowBlur = 15 * brick.glow;
            ctx.shadowColor = brick.color;
            brick.glow *= 0.9;
            if (brick.glow < 0.01) brick.glow = 0;
        }
        
        // Brick body
        const brickGrad = ctx.createLinearGradient(brick.x, brick.y, brick.x, brick.y + brick.height);
        brickGrad.addColorStop(0, brick.color);
        brickGrad.addColorStop(1, '#000