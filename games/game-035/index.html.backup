<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<title>Neon TD - Day 35</title>
<style>
  * { margin:0; padding:0; box-sizing:border-box; font-family: 'Courier New', monospace; }
  body { background:#0a0a12; color:#0ff; overflow:hidden; height:100vh; display:flex; flex-direction:column; align-items:center; justify-content:center; }
  canvas { border:2px solid #0ff; box-shadow:0 0 20px #0ff, inset 0 0 20px #001; background:#000; display:block; }
  #ui { position:absolute; top:10px; left:10px; right:10px; display:flex; justify-content:space-between; pointer-events:none; z-index:10; }
  .panel { background:rgba(0,20,30,0.8); border:1px solid #0ff; padding:8px 12px; border-radius:4px; box-shadow:0 0 10px #0ff; font-size:14px; pointer-events:auto; }
  .panel span { color:#ff0; }
  #pauseBtn { background:rgba(0,20,30,0.8); border:1px solid #0ff; color:#0ff; padding:6px 12px; border-radius:4px; cursor:pointer; font-size:14px; box-shadow:0 0 10px #0ff; }
  #pauseBtn:active { background:#0ff; color:#000; }
  .overlay { position:absolute; top:0; left:0; width:100%; height:100%; background:rgba(0,0,0,0.9); display:flex; flex-direction:column; align-items:center; justify-content:center; z-index:100; gap:20px; }
  .overlay.hidden { display:none; }
  .overlay h1 { font-size:48px; text-shadow:0 0 10px #0ff, 0 0 20px #0ff; margin:0; }
  .overlay button { background:rgba(0,20,30,0.9); border:2px solid #0ff; color:#0ff; padding:12px 30px; font-size:20px; border-radius:6px; cursor:pointer; box-shadow:0 0 15px #0ff; transition:0.2s; }
  .overlay button:hover, .overlay button:active { background:#0ff; color:#000; box-shadow:0 0 25px #0ff; }
  .tower-select { position:absolute; bottom:10px; left:50%; transform:translateX(-50%); display:flex; gap:10px; pointer-events:auto; z-index:10; }
  .tower-btn { background:rgba(0,20,30,0.8); border:1px solid #0ff; color:#0ff; padding:8px 16px; border-radius:4px; cursor:pointer; font-size:12px; box-shadow:0 0 10px #0ff; display:flex; flex-direction:column; align-items:center; gap:2px; }
  .tower-btn.selected { background:#0ff; color:#000; box-shadow:0 0 20px #0ff; }
  .tower-btn:disabled { opacity:0.4; cursor:not-allowed; }
  .wave-info { position:absolute; top:50%; left:50%; transform:translate(-50%,-50%); text-align:center; pointer-events:none; z-index:50; }
  .wave-info.hidden { display:none; }
  .wave-info h2 { font-size:36px; text-shadow:0 0 10px #f0f; color:#f0f; }
</style>
</head>
<body>
<canvas id="game" width="800" height="600"></canvas>
<div id="ui">
  <div class="panel">Gold: <span id="gold">100</span></div>
  <div class="panel">Lives: <span id="lives">10</span></div>
  <div class="panel">Wave: <span id="wave">0</span></div>
  <button id="pauseBtn">PAUSE</button>
</div>
<div id="startOverlay" class="overlay">
  <h1>NEON TD</h1>
  <button id="startBtn">START GAME</button>
</div>
<div id="pauseOverlay" class="overlay hidden">
  <h1>PAUSED</h1>
  <button id="resumeBtn">RESUME</button>
  <button id="quitBtn">QUIT TO MENU</button>
</div>
<div id="gameOverOverlay" class="overlay hidden">
  <h1>GAME OVER</h1>
  <div>Wave Reached: <span id="finalWave">0</span></div>
  <button id="retryBtn">RETRY</button>
  <button id="menuBtn">MAIN MENU</button>
</div>
<div class="tower-select">
  <button class="tower-btn selected" data-type="basic" data-cost="50">BASIC<br><span>50</span></button>
  <button class="tower-btn" data-type="sniper" data-cost="100">SNIPER<br><span>100</span></button>
  <button class="tower-btn" data-type="splash" data-cost="150">SPLASH<br><span>150</span></button>
</div>
<div id="waveInfo" class="wave-info hidden"><h2>WAVE <span id="waveNum">1</span></h2></div>
<script>
const canvas = document.getElementById('game');
const ctx = canvas.getContext('2d');
const W = canvas.width, H = canvas.height;

const path = [
  {x: -50, y: 300}, {x: 150, y: 300}, {x: 150, y: 150}, {x: 400, y: 150},
  {x: 400, y: 450}, {x: 650, y: 450}, {x: 650, y: 200}, {x: 850, y: 200}
];

let gold = 100, lives = 10, wave = 0, highScore = 0;
let towers = [], enemies = [], projectiles = [], particles = [];
let selectedTowerType = 'basic';
let gameRunning = false, gamePaused = false;
let lastTime = 0, waveTimer = 0, waveDelay = 3000;
let spawnIndex = 0, spawnCount = 0, spawnInterval = 1000;

const towerData = {
  basic: {cost:50, range:120, damage:15, fireRate:1000, color:'#0ff', projectileSpeed:5},
  sniper: {cost:100, range:200, damage:50, fireRate:2000, color:'#f0f', projectileSpeed:8},
  splash: {cost:150, range:100, damage:25, fireRate:1500, color:'#ff0', projectileSpeed:4, splashRadius:60}
};

const enemyTypes = [
  {hp:50, speed:1.5, reward:10, color:'#f44', size:12},
  {hp:120, speed:1, reward:20, color:'#f80', size:16},
  {hp:300, speed:0.7, reward:40, color:'#4f4', size:20},
  {hp:600, speed:0.5, reward:80, color:'#44f', size:24}
];

function getHighScore() {
  return parseInt(localStorage.getItem('neonTD_highScore')) || 0;
}
function setHighScore(score) {
  localStorage.setItem('neonTD_highScore', score.toString());
}

function startGame() {
  gold = 100; lives = 10; wave = 0;
  towers = []; enemies = []; projectiles = []; particles = [];
  spawnIndex = 0; spawnCount = 0; waveTimer = 0;
  updateUI();
  document.getElementById('startOverlay').classList.add('hidden');
  document.getElementById('gameOverOverlay').classList.add('hidden');
  document.getElementById('pauseOverlay').classList.add('hidden');
  gameRunning = true; gamePaused = false;
  lastTime = performance.now();
  requestAnimationFrame(gameLoop);
}

function pauseGame() {
  if (!gameRunning || gamePaused) return;
  gamePaused = true;
  document.getElementById('pauseOverlay').classList.remove('hidden');
}

function resumeGame() {
  if (!gameRunning || !gamePaused) return;
  gamePaused = false;
  document.getElementById('pauseOverlay').classList.add('hidden');
  lastTime = performance.now();
  requestAnimationFrame(gameLoop);
}

function quitToMenu() {
  gameRunning = false; gamePaused = false;
  document.getElementById('pauseOverlay').classList.add('hidden');
  document.getElementById('gameOverOverlay').classList.add('hidden');
  document.getElementById('startOverlay').classList.remove('hidden');
}

function showStartScreen() {
  quitToMenu();
}

function gameOver() {
  gameRunning = false;
  if (wave > highScore) {
    highScore = wave;
    setHighScore(highScore);
  }
  document.getElementById('finalWave').textContent = wave;
  document.getElementById('gameOverOverlay').classList.remove('hidden');
}

function updateUI() {
  document.getElementById('gold').textContent = gold;
  document.getElementById('lives').textContent = lives;
  document.getElementById('wave').textContent = wave;
  document.querySelectorAll('.tower-btn').forEach(btn => {
    const cost = parseInt(btn.dataset.cost);
    btn.disabled = gold < cost;
  });
}

function getPathPosition(progress) {
  const totalLen = path.length - 1;
  const segment = progress * totalLen;
  const index = Math.floor(segment);
  const t = segment - index;
  if (index >= totalLen) return {x: path[path.length-1].x, y: path[path.length-1].y, finished: true};
  const p1 = path[index], p2 = path[index+1];
  return {x: p1.x + (p2.x - p1.x) * t, y: p1.y + (p2.y - p1.y) * t, finished: false};
}

function distance(x1, y1, x2, y2) {
  const dx = x2 - x1, dy = y2 - y1;
  return Math.sqrt(dx*dx + dy*dy);
}

function spawnEnemy() {
  const typeIndex = Math.min(wave - 1, enemyTypes.length - 1);
  const type = enemyTypes[typeIndex];
  const hpMult = 1 + (wave - 1) * 0.15;
  enemies.push({
    x: path[0].x, y: path[0].y,
    progress: 0, hp: type.hp * hpMult, maxHp: type.hp * hpMult,
    speed: type.speed, reward: type.reward, color: type.color, size: type.size
  });
}

function tryPlaceTower(x, y) {
  const gridSize = 40;
  const gx = Math.floor(x / gridSize) * gridSize + gridSize/2;
  const gy = Math.floor(y / gridSize) * gridSize + gridSize/2;
  if (towers.some(t => t.x === gx && t.y === gy)) return;
  if (distance(gx, gy, path[0].x, path[0].y) < 50) return;
  if (distance(gx, gy, path[path.length-1].x, path[path.length-1].y) < 50) return;
  const data = towerData[selectedTowerType];
  if (gold < data.cost) return;
  gold -= data.cost;
  towers.push({x:gx, y:gy, type:selectedTowerType, ...data, cooldown:0, target:null});
  updateUI();
}

function update(dt) {
  if (gamePaused) return;
  waveTimer += dt;
  if (wave === 0 || (spawnCount > 0 && enemies.length === 0 && waveTimer >= waveDelay)) {
    wave++;
    spawnCount = wave * 2;
    spawnIndex = 0;
    waveTimer = 0;
    document.getElementById('waveNum').textContent = wave;
    document.getElementById('waveInfo').classList.remove('hidden');
    setTimeout(() => document.getElementById('waveInfo').classList.add('hidden'), 1500);
  }
  if (spawnIndex < spawnCount && waveTimer >= spawnInterval) {
    spawnEnemy();
    spawnIndex++;
    waveTimer = 0;
  }

  // Enemy movement
  for (let i = enemies.length - 1; i >= 0; i--) {
    const e = enemies[i];
    e.progress += e.speed * dt / 1000;
    const pos = getPathPosition(e.progress);
    e.x = pos.x; e.y = pos.y;
    if (pos.finished) {
      lives--;
      enemies.splice(i, 1);
      updateUI();
      if (lives <= 0) gameOver();
    }
  }

  // Tower targeting and shooting
  towers.forEach(tower => {
    tower.cooldown -= dt;
    if (tower.cooldown <= 0) {
      let bestTarget = null, bestProgress = -1;
      enemies.forEach(e => {
        const d = distance(tower.x, tower.y, e.x, e.y);
        if (d <= tower.range && e.progress > bestProgress) {
          bestProgress = e.progress;
          bestTarget = e;
        }
      });
      if (bestTarget) {
        tower.target = bestTarget;
        projectiles.push({
          x: tower.x, y: tower.y,
          target: bestTarget,
          speed: tower.projectileSpeed,
          damage: tower.damage,
          color: tower.color,
          splash: tower.splashRadius || 0
        });
        tower.cooldown = tower.fireRate;
      }
    }
  });

  // Projectile movement
  for (let i = projectiles.length - 1; i >= 0; i--) {
    const p = projectiles[i];
    if (!enemies.includes(p.target)) {
      projectiles.splice(i, 1);
      continue;
    }
    const dx = p.target.x - p.x;
    const dy = p.target.y - p.y;
    const dist = Math.sqrt(dx*dx + dy*dy);
    if (dist < p.speed * dt / 1000) {
      // Hit
      if (p.splash > 0) {
        enemies.forEach(e => {
          if (distance(p.target.x, p.target.y, e.x, e.y) <= p.splash) {
            e.hp -= p.damage;
            if (e.hp <= 0) {
              gold += e.reward;
              for (let j = 0; j < 10; j++) particles.push({x:e.x, y:e.y, vx:(Math.random()-0.5)*5, vy:(Math.random()-0.5)*5, life:1, color:e.color});
            }
          }
        });
      } else {
        p.target.hp -= p.damage;
        if (p.target.hp <= 0) {
          gold += p.target.reward;
          for (let j = 0; j < 10; j++) particles.push({x:p.target.x, y:p.target.y, vx:(Math.random()-0.5)*5, vy:(Math.random()-0.5)*5, life:1, color:p.target.color});
        }
      }
      projectiles.splice(i, 1);
    } else {
      p.x += dx / dist * p.speed * dt / 1000;
      p.y += dy / dist * p.speed * dt / 1000;
    }
  }

  // Particles
  for (let i = particles.length - 1; i >= 0; i--) {
    const pt = particles[i];
    pt.x += pt.vx;
    pt.y += pt.vy;
    pt.life -= dt / 1000;
    if (pt.life <= 0) particles.splice(i, 1);
  }

  // Remove dead enemies
  for (let i = enemies.length - 1; i >= 0; i--) {
    if (enemies[i].hp <= 0) enemies.splice(i, 1);
  }

  updateUI();
}

function draw() {
  ctx.clearRect(0, 0, W, H);
  // Draw path
  ctx.strokeStyle = '#033';
  ctx.lineWidth = 40;
  ctx.lineCap = 'round';
  ctx.lineJoin = 'round';
  ctx.beginPath();
  ctx.moveTo(path[0].x, path[0].y);
  for (let i = 1; i < path.length; i++) ctx.lineTo(path[i].x, path[i].y);
  ctx.stroke();
  ctx.strokeStyle = '#0ff';
  ctx.lineWidth = 4;
  ctx.setLineDash([10, 10]);
  ctx.beginPath();
  ctx.moveTo(path[0].x, path[0].y);
  for (let i = 1; i < path.length; i++) ctx.lineTo(path[i].x, path[i].y);
  ctx.stroke();
  ctx.setLineDash([]);

  // Draw towers
  towers.forEach(t => {
    ctx.fillStyle = t.color;
    ctx.beginPath();
    ctx.arc(t.x, t.y, 18, 0, Math.PI*2);
    ctx.fill();
    ctx.strokeStyle = '#fff';
    ctx.lineWidth = 2;
    ctx.stroke();
    // Range indicator
    ctx.strokeStyle = t.color + '80';
    ctx.lineWidth = 1;
    ctx.beginPath();
    ctx.arc(t.x, t.y, t.range, 0, Math.PI*2);
    ctx.stroke();
  });

  // Draw enemies
  enemies.forEach(e => {
    ctx.fillStyle = e.color;
    ctx.beginPath();
    ctx.arc(e.x, e.y, e.size, 0, Math.PI*2);
    ctx.fill();
    ctx.strokeStyle = '#fff';
    ctx.lineWidth = 1;
    ctx.stroke();
    // Health bar
    const barW = e.size * 2;
    ctx.fillStyle = '#f00';
    ctx.fillRect(e.x - barW/2, e.y - e.size - 8, barW, 4);
    ctx.fillStyle = '#0f0';
    ctx.fillRect(e.x - barW/2, e.y - e.size - 8, barW * (e.hp / e.maxHp), 4);
  });

  // Draw projectiles
  projectiles.forEach(p => {
    ctx.fillStyle = p.color;
    ctx.beginPath();
    ctx.arc(p.x, p.y, 4, 0, Math.PI*2);
    ctx.fill();
  });

  // Draw particles
  particles.forEach(pt => {
    ctx.globalAlpha = pt.life;
    ctx.fillStyle = pt.color;
    ctx.beginPath();
    ctx.arc(pt.x, pt.y, 3, 0, Math.PI*2);
    ctx.fill();
    ctx.globalAlpha = 1;
  });

  // Grid for placement preview
  if (gameRunning && !gamePaused) {
    ctx.strokeStyle = 'rgba(0,255,255,0.1)';
    ctx.lineWidth = 1;
    for (let x = 20; x < W; x += 40) {
      for (let y = 20; y < H; y += 40) {
        ctx.strokeRect(x, y, 40, 40);
      }
    }
  }
}

function gameLoop(time) {
  if (!gameRunning) return;
  const dt = time - lastTime;
  lastTime = time;
  update(dt);
  draw();
  requestAnimationFrame(gameLoop);
}

// Event listeners
document.getElementById('startBtn').addEventListener('click', startGame);
document.getElementById('pauseBtn').addEventListener('click', pauseGame);
document.getElementById('resumeBtn').addEventListener('click', resumeGame);
document.getElementById('quitBtn').addEventListener('click', quitToMenu);
document.getElementById('retryBtn').addEventListener('click', startGame);
document.getElementById('menuBtn').addEventListener('click', showStartScreen);

document.querySelectorAll('.tower-btn').forEach(btn => {
  btn.addEventListener('click', () => {
    document.querySelectorAll('.tower-btn').forEach(b => b.classList.remove('selected'));
    btn.classList.add('selected');
    selectedTowerType = btn.dataset.type;
  });
});

canvas.addEventListener('click', e => {
  if (!gameRunning || gamePaused) return;
  const rect = canvas.getBoundingClientRect();
  const x = e.clientX - rect.left;
  const y = e.clientY - rect.top;
  tryPlaceTower(x, y);
});

canvas.addEventListener('touchstart', e => {
  if (!gameRunning || gamePaused) return;
  e.preventDefault();
  const rect = canvas.getBoundingClientRect();
  const touch = e.touches[0];
  const x = touch.clientX - rect.left;
  const y = touch.clientY - rect.top;
  tryPlaceTower(x, y);
}, {passive: false});

window.addEventListener('keydown', e => {
  if (e.key === 'Escape' || e.key === 'p' || e.key === 'P') {
    if (gameRunning && !