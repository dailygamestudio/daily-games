<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no">
<title>Neon Pipeline - Day 47</title>
<style>
  * { margin: 0; padding: 0; box-sizing: border-box; }
  body { background: #0a0a12; color: #00ffff; font-family: 'Courier New', monospace; overflow: hidden; touch-action: none; }
  canvas { display: block; margin: 0 auto; background: #05050a; box-shadow: 0 0 30px rgba(0,255,255,0.2), inset 0 0 60px rgba(0,20,30,0.5); position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); }
  #ui { position: fixed; top: 10px; left: 10px; right: 10px; display: flex; justify-content: space-between; pointer-events: none; z-index: 10; }
  .panel { background: rgba(0,10,20,0.8); border: 1px solid #00ffff44; border-radius: 8px; padding: 8px 16px; backdrop-filter: blur(4px); text-shadow: 0 0 5px #00ffff; }
  .panel h3 { font-size: 14px; font-weight: normal; color: #00ffaa; margin-bottom: 4px; text-transform: uppercase; letter-spacing: 2px; }
  .panel .value { font-size: 20px; font-weight: bold; color: #00ffff; }
  #overlay, #pauseOverlay, #gameOverOverlay { position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.9); display: flex; flex-direction: column; align-items: center; justify-content: center; z-index: 100; backdrop-filter: blur(8px); }
  #overlay.hidden, #pauseOverlay.hidden, #gameOverOverlay.hidden { display: none !important; }
  .overlay-content { text-align: center; max-width: 90%; }
  .overlay-content h1 { font-size: clamp(2rem, 8vw, 4rem); color: #00ffff; text-shadow: 0 0 20px #00ffff, 0 0 40px #00ffff; margin-bottom: 1rem; letter-spacing: 4px; }
  .overlay-content p { color: #00ffaa; font-size: 1.2rem; margin-bottom: 2rem; text-shadow: 0 0 10px #00ffaa; }
  .btn { background: transparent; border: 2px solid #00ffff; color: #00ffff; padding: 12px 32px; font-size: 1.1rem; font-family: inherit; text-transform: uppercase; letter-spacing: 2px; cursor: pointer; transition: all 0.3s; text-shadow: 0 0 5px #00ffff; box-shadow: 0 0 10px rgba(0,255,255,0.3); }
  .btn:hover, .btn:focus { background: #00ffff; color: #0a0a12; box-shadow: 0 0 30px #00ffff; outline: none; }
  .btn:active { transform: scale(0.95); }
  .btn-group { display: flex; gap: 1rem; flex-wrap: wrap; justify-content: center; }
  @media (max-width: 600px) { .btn { padding: 10px 24px; font-size: 1rem; } }
</style>
</head>
<body>
<canvas id="gameCanvas"></canvas>
<div id="ui">
  <div class="panel"><h3>Score</h3><div class="value" id="score">0</div></div>
  <div class="panel"><h3>Level</h3><div class="value" id="level">1</div></div>
  <div class="panel"><h3>High Score</h3><div class="value" id="highScore">0</div></div>
</div>

<div id="overlay">
  <div class="overlay-content">
    <h1>NEON PIPELINE</h1>
    <p>Connect the flow from source to target. Tap pipes to rotate.</p>
    <div class="btn-group">
      <button class="btn" id="startBtn">START</button>
    </div>
  </div>
</div>

<div id="pauseOverlay" class="hidden">
  <div class="overlay-content">
    <h1>PAUSED</h1>
    <div class="btn-group">
      <button class="btn" id="resumeBtn">RESUME</button>
      <button class="btn" id="quitBtn">QUIT TO MENU</button>
    </div>
  </div>
</div>

<div id="gameOverOverlay" class="hidden">
  <div class="overlay-content">
    <h1>PIPELINE BREACH</h1>
    <p>Final Score: <span id="finalScore">0</span></p>
    <div class="btn-group">
      <button class="btn" id="retryBtn">RETRY</button>
      <button class="btn" id="menuBtn">MAIN MENU</button>
    </div>
  </div>
</div>

<script>
const canvas = document.getElementById('gameCanvas');
const ctx = canvas.getContext('2d');
const scoreEl = document.getElementById('score');
const levelEl = document.getElementById('level');
const highScoreEl = document.getElementById('highScore');
const finalScoreEl = document.getElementById('finalScore');
const overlay = document.getElementById('overlay');
const pauseOverlay = document.getElementById('pauseOverlay');
const gameOverOverlay = document.getElementById('gameOverOverlay');
const startBtn = document.getElementById('startBtn');
const resumeBtn = document.getElementById('resumeBtn');
const quitBtn = document.getElementById('quitBtn');
const retryBtn = document.getElementById('retryBtn');
const menuBtn = document.getElementById('menuBtn');

let width, height, cellSize, cols, rows;
let grid = [];
let score = 0, level = 1, highScore = 0;
let gameRunning = false, paused = false;
let animationId = null;
let flowProgress = 0, flowPath = [], flowing = false;
let lastTime = 0;

const PIPE_TYPES = {
  EMPTY: 0,
  STRAIGHT: 1,
  CORNER: 2,
  T_JUNCTION: 3,
  CROSS: 4,
  SOURCE: 5,
  TARGET: 6
};

const CONNECTIONS = {
  [PIPE_TYPES.STRAIGHT]: [0, 2],
  [PIPE_TYPES.CORNER]: [0, 1],
  [PIPE_TYPES.T_JUNCTION]: [0, 1, 2],
  [PIPE_TYPES.CROSS]: [0, 1, 2, 3],
  [PIPE_TYPES.SOURCE]: [0],
  [PIPE_TYPES.TARGET]: [2]
};

const DIRS = [[0,-1],[1,0],[0,1],[-1,0]];

function resize() {
  const maxW = window.innerWidth - 20;
  const maxH = window.innerHeight - 100;
  const size = Math.min(maxW, maxH);
  canvas.width = size;
  canvas.height = size;
  width = height = size;
  cellSize = size / cols;
}
window.addEventListener('resize', () => { if (gameRunning) { resize(); draw(); } });

function initGrid() {
  cols = 4 + level;
  rows = 4 + level;
  grid = [];
  for (let y = 0; y < rows; y++) {
    grid[y] = [];
    for (let x = 0; x < cols; x++) {
      grid[y][x] = { type: PIPE_TYPES.EMPTY, rotation: 0, fixed: false };
    }
  }
  const sx = Math.floor(Math.random() * cols);
  const sy = 0;
  const tx = Math.floor(Math.random() * cols);
  const ty = rows - 1;
  grid[sy][sx] = { type: PIPE_TYPES.SOURCE, rotation: 2, fixed: true };
  grid[ty][tx] = { type: PIPE_TYPES.TARGET, rotation: 0, fixed: true };
  generatePath(sx, sy, tx, ty);
  fillRandom();
  resize();
}

function generatePath(sx, sy, tx, ty) {
  const path = [];
  let x = sx, y = sy;
  while (x !== tx || y !==