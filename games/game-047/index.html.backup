<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no">
<title>Neon Pipeline - Day 47</title>
<style>
  * { margin: 0; padding: 0; box-sizing: border-box; }
  body { background: #0a0a12; color: #00ffff; font-family: 'Courier New', monospace; overflow: hidden; touch-action: none; }
  canvas { display: block; margin: 0 auto; background: #05050a; box-shadow: 0 0 30px rgba(0,255,255,0.2), inset 0 0 60px rgba(0,20,30,0.5); position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); }
  #ui { position: fixed; top: 10px; left: 10px; right: 10px; display: flex; justify-content: space-between; pointer-events: none; z-index: 10; }
  .panel { background: rgba(0,10,20,0.8); border: 1px solid #00ffff44; border-radius: 8px; padding: 8px 16px; backdrop-filter: blur(4px); text-shadow: 0 0 5px #00ffff; }
  .panel h3 { font-size: 14px; font-weight: normal; color: #00ffaa; margin-bottom: 4px; text-transform: uppercase; letter-spacing: 2px; }
  .panel .value { font-size: 20px; font-weight: bold; color: #00ffff; }
  #overlay, #pauseOverlay, #gameOverOverlay { position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.9); display: flex; flex-direction: column; align-items: center; justify-content: center; z-index: 100; backdrop-filter: blur(8px); }
  #overlay[hidden], #pauseOverlay[hidden], #gameOverOverlay[hidden] { display: none !important; }
  .overlay-content { text-align: center; max-width: 90%; }
  .overlay-content h1 { font-size: clamp(2rem, 8vw, 4rem); color: #00ffff; text-shadow: 0 0 20px #00ffff, 0 0 40px #00ffff; margin-bottom: 1rem; letter-spacing: 4px; }
  .overlay-content p { color: #00ffaa; font-size: 1.2rem; margin-bottom: 2rem; text-shadow: 0 0 10px #00ffaa; }
  .btn { background: transparent; border: 2px solid #00ffff; color: #00ffff; padding: 12px 32px; font-size: 1.1rem; font-family: inherit; text-transform: uppercase; letter-spacing: 2px; cursor: pointer; transition: all 0.3s; text-shadow: 0 0 5px #00ffff; box-shadow: 0 0 10px rgba(0,255,255,0.3); }
  .btn:hover, .btn:focus { background: #00ffff; color: #0a0a12; box-shadow: 0 0 30px #00ffff; outline: none; }
  .btn:active { transform: scale(0.95); }
  .btn-group { display: flex; gap: 1rem; flex-wrap: wrap; justify-content: center; }
  @media (max-width: 600px) { .btn { padding: 10px 24px; font-size: 1rem; } }
</style>
</head>
<body>
<canvas id="gameCanvas"></canvas>
<div id="ui">
  <div class="panel"><h3>Score</h3><div class="value" id="scoreDisplay">0</div></div>
  <div class="panel"><h3>High Score</h3><div class="value" id="highScoreDisplay">0</div></div>
  <div class="panel"><h3>Time</h3><div class="value" id="timeDisplay">60</div></div>
</div>
<div id="overlay">
  <div class="overlay-content">
    <h1>NEON PIPELINE</h1>
    <p>Connect the flow before time runs out. Tap/click pipes to rotate. Complete paths from source to drain.</p>
    <button class="btn" id="startBtn">START GAME</button>
  </div>
</div>
<div id="pauseOverlay" hidden>
  <div class="overlay-content">
    <h1>PAUSED</h1>
    <div class="btn-group">
      <button class="btn" id="resumeBtn">RESUME</button>
      <button class="btn" id="quitBtn">QUIT TO MENU</button>
    </div>
  </div>
</div>
<div id="gameOverOverlay" hidden>
  <div class="overlay-content">
    <h1>GAME OVER</h1>
    <p>Final Score: <span id="finalScore">0</span></p>
    <div class="btn-group">
      <button class="btn" id="retryBtn">RETRY</button>
      <button class="btn" id="mainMenuBtn">MAIN MENU</button>
    </div>
  </div>
</div>
<script>
const canvas = document.getElementById('gameCanvas');
const ctx = canvas.getContext('2d');
const scoreDisplay = document.getElementById('scoreDisplay');
const highScoreDisplay = document.getElementById('highScoreDisplay');
const timeDisplay = document.getElementById('timeDisplay');
const overlay = document.getElementById('overlay');
const pauseOverlay = document.getElementById('pauseOverlay');
const gameOverOverlay = document.getElementById('gameOverOverlay');
const startBtn = document.getElementById('startBtn');
const resumeBtn = document.getElementById('resumeBtn');
const quitBtn = document.getElementById('quitBtn');
const retryBtn = document.getElementById('retryBtn');
const mainMenuBtn = document.getElementById('mainMenuBtn');
const finalScoreEl = document.getElementById('finalScore');

const GRID_SIZE = 6;
const CELL_SIZE = 60;
const PIPE_TYPES = {
  straight: { connections: [0, 2], color: '#00ffff' },
  corner: { connections: [0, 1], color: '#00ffaa' },
  tJunction: { connections: [0, 1, 2], color: '#aaff00' },
  cross: { connections: [0, 1, 2, 3], color: '#ffaa00' },
  source: { connections: [2], color: '#ff00ff', fixed: true },
  drain: { connections: [0], color: '#ff00aa', fixed: true }
};
const DIRS = [[-1,0],[0,1],[1,0],[0,-1]];

let grid = [];
let score = 0;
let highScore = parseInt(localStorage.getItem('neonPipelineHighScore')) || 0;
let timeLeft = 60;
let gameState = 'start';
let animationId = null;
let lastTime = 0;
let selectedCell = null;
let flowPaths = [];
let flowProgress = 0;
let flowActive = false;
let particles = [];

highScoreDisplay.textContent = highScore;

function resizeCanvas() {
  const maxWidth = window.innerWidth * 0.95;
  const maxHeight = window.innerHeight * 0.9;
  const size = Math.min(maxWidth, maxHeight, GRID_SIZE * CELL_SIZE + 40);
  canvas.width = size;
  canvas.height = size;
  canvas.style.width = size + 'px';
  canvas.style.height = size + 'px';
}
window.addEventListener('resize', resizeCanvas);
resizeCanvas();

function initGrid() {
  grid = [];
  for (let r = 0; r < GRID_SIZE; r++) {
    grid[r] = [];
    for (let c = 0; c < GRID_SIZE; c++) {
      grid[r][c] = { type: 'empty', rotation: 0, fixed: false };
    }
  }
  grid[0][0] = { type: 'source', rotation: 0, fixed: true };
  grid[GRID_SIZE-1][GRID_SIZE-1] = { type: 'drain', rotation: 0, fixed: true };
  for (let r = 0; r < GRID_SIZE; r++) {
    for (let c = 0; c < GRID_SIZE; c++) {
      if (grid[r][c].type === 'empty' && Math.random() < 0.7) {
        const types = ['straight', 'corner', 'tJunction', 'cross'];
        grid[r][c] = { type: types[Math.floor(Math.random()*types.length)], rotation: Math.floor(Math.random()*4), fixed: false };
      }
    }
  }
}

function getConnections(cell) {
  if (cell.type === 'empty') return [];
  const base = PIPE_TYPES[cell.type].connections;
  return base.map(d => (d + cell.rotation) % 4);
}

function canConnect(r, c, dir) {
  if (r < 0 || r >= GRID_SIZE || c < 0 || c >= GRID_SIZE) return false;
  const cell = grid[r][c];
  if (cell.type === 'empty') return false;
  const conns = getConnections(cell);
  return conns.includes((dir + 2) % 4);
}

function findPaths() {
  const visited = new Set();
  const paths = [];
  function dfs(r, c, path, incomingDir) {
    const key = `${r},${c},${incomingDir}`;
    if (visited.has(key)) return;
    visited.add(key);
    const cell = grid[r][c];
    if (cell.type === 'empty') return;
    const conns = getConnections(cell);
    if (!conns.includes(incomingDir)) return;
    path.push({r, c, dir: incomingDir});
    if (cell.type === 'drain') {
      paths.push([...path]);
      return;
    }
    for (const dir of conns) {
      if (dir === incomingDir) continue;
      const nr = r + DIRS[dir][0];
      const nc = c + DIRS[dir][1];
      if (canConnect(nr, nc, dir)) {
        dfs(nr, nc, path, (dir + 2) % 4);
      }
    }
    path.pop();
  }
  dfs(0, 0, [], 2);
  return paths;
}

function hideAllOverlays() {
  overlay.hidden = true;
  overlay.style.display = 'none';
  pauseOverlay.hidden = true;
  pauseOverlay.style.display = 'none';
  gameOverOverlay.hidden = true;
  gameOverOverlay.style.display = 'none';
}

function showOverlay(el) {
  el.hidden = false;
  el.style.display = 'flex';
}

function startGame() {
  gameState = 'playing';
  score = 0;
  timeLeft = 60;
  scoreDisplay.textContent = score;
  timeDisplay.textContent = timeLeft;
  initGrid();
  flowPaths = [];
  flowActive = false;
  particles = [];
  hideAllOverlays();
  lastTime = performance.now();
  if (animationId) cancelAnimationFrame(animationId);
  animationId = requestAnimationFrame(gameLoop);
}

function pauseGame() {
  if (gameState !== 'playing') return;
  gameState = 'paused';
  showOverlay(pauseOverlay);
  cancelAnimationFrame(animationId);
}

function resumeGame() {
  if (gameState !== 'paused') return;
  gameState = 'playing';
  hideAllOverlays();
  lastTime = performance.now();
  animationId = requestAnimationFrame(gameLoop);
}

function quitToMenu() {
  gameState = 'start';
  hideAllOverlays();
  showOverlay(overlay);
  cancelAnimationFrame(animationId);
}

function showStartScreen() {
  gameState = 'start';
  hideAllOverlays();
  showOverlay(overlay);
}

function gameOver() {
  gameState = 'gameover';
  flowActive = false;
  finalScoreEl.textContent = score;
  if (score > highScore) {
    highScore = score;
    localStorage.setItem('neonPipelineHighScore', highScore);
    highScoreDisplay.textContent = highScore;
  }
  hideAllOverlays();
  showOverlay(gameOverOverlay);
  cancelAnimationFrame(animationId);
}

function gameLoop(timestamp) {
  if (gameState !== 'playing') return;
  const dt = (timestamp - lastTime) / 1000;
  lastTime = timestamp;
  
  timeLeft -= dt;
  if (timeLeft <= 0) {
    timeLeft = 0;
    timeDisplay.textContent = '0';
    gameOver();
    return;
  }
  timeDisplay.textContent = Math.ceil(timeLeft);
  
  updateFlow(dt);
  updateParticles(dt);
  draw();
  
  animationId = requestAnimationFrame(gameLoop);
}

function updateFlow(dt) {
  if (!flowActive || flowPaths.length === 0) return;
  flowProgress += dt * 2;
  if (flowProgress >= 1) {
    flowProgress = 0;
    flowActive = false;
    score += flowPaths.length * 100;
    scoreDisplay.textContent = score;
    createParticles();
    flowPaths = findPaths();
    if (flowPaths.length > 0) {
      flowActive = true;
    }
  }
}

function updateParticles(dt) {
  for (let i = particles.length - 1; i >= 0; i--) {
    const p = particles[i];
    p.x += p.vx * dt;
    p.y += p.vy * dt;
    p.life -= dt;
    p.alpha = p.life / p.maxLife;
    if (p.life <= 0) particles.splice(i, 1);
  }
}

function createParticles() {
  for (const path of flowPaths) {
    for (const node of path) {
      const cx = node.c * CELL_SIZE + CELL_SIZE/2;
      const cy = node.r * CELL_SIZE + CELL_SIZE/2;
      for (let i = 0; i < 8; i++) {
        const angle = Math.random() * Math.PI * 2;
        const speed = 50 + Math.random() * 100;
        particles.push({
          x: cx, y: cy,
          vx: Math.cos(angle) * speed,
          vy: Math.sin(angle) * speed,
          life: 0.5 + Math.random() * 0.5,
          maxLife: 1,
          alpha: 1,
          color: PIPE_TYPES[grid[node.r][node.c].type].color,
          size: 2 + Math.random() * 3
        });
      }
    }
  }
}

function draw() {
  ctx.fillStyle = '#05050a';
  ctx.fillRect(0, 0, canvas.width, canvas.height);
  drawGrid();
  drawPipes();
  if (flowActive) drawFlow();
  drawParticles();
}

function drawGrid() {
  ctx.strokeStyle = '#00ffff11';
  ctx.lineWidth = 1;
  for (let i = 0; i <= GRID_SIZE; i++) {
    ctx.beginPath();
    ctx.moveTo(i * CELL_SIZE, 0);
    ctx.lineTo(i * CELL_SIZE, GRID_SIZE * CELL_SIZE);
    ctx.stroke();
    ctx.beginPath();
    ctx.moveTo(0, i * CELL_SIZE);
    ctx.lineTo(GRID_SIZE * CELL_SIZE, i * CELL_SIZE);
    ctx.stroke();
  }
}

function drawPipes() {
  for (let r = 0; r < GRID_SIZE; r++) {
    for (let c = 0; c < GRID_SIZE; c++) {
      const cell = grid[r][c];
      if (cell.type !== 'empty') {
        drawPipe(cell, c * CELL_SIZE, r * CELL_SIZE, CELL_SIZE);
      }
    }
  }
}

function drawPipe(cell, x, y, size) {
  const type = PIPE_TYPES[cell.type];
  const conns = getConnections(cell);
  const centerX = x + size/2;
  const centerY = y + size/2;
  const radius = size * 0.35;
  const lineWidth = size * 0.15;
  
  ctx.save();
  ctx.translate(centerX, centerY);
  
  // Glow
  ctx.shadowColor = type.color;
  ctx.shadowBlur = 15;
  
  // Draw connections
  ctx.strokeStyle = type.color;
  ctx.lineWidth = lineWidth;
  ctx.lineCap = 'round';
  
  for (const dir of conns) {
    const angle = dir * Math.PI/2;
    ctx.beginPath();
    ctx.moveTo(0, 0);
    ctx.lineTo(Math.cos(angle) * radius, Math.sin(angle) * radius);
    ctx.stroke();
  }
  
  // Center hub
  ctx.fillStyle = type.color;
  ctx.beginPath();
  ctx.arc(0, 0, lineWidth * 1.2, 0, Math.PI * 2);
  ctx.fill();
  
  // Source/Drain indicators
  if (cell.type === 'source') {
    ctx.fillStyle = '#ff00ff';
    ctx.beginPath();
    ctx.arc(0, 0, radius * 0.6, 0, Math.PI * 2);
    ctx.fill();
    ctx.fillStyle = '#fff';
    ctx.font = 'bold 14px Courier New';
    ctx.textAlign = 'center';
    ctx.textBaseline = 'middle';
    ctx.fillText('S', 0, 1);
  } else if (cell.type === 'drain') {
    ctx.fillStyle = '#ff00aa';
    ctx.beginPath();
    ctx.arc(0, 0, radius * 0.6, 0, Math.PI * 2);
    ctx.fill();
    ctx.fillStyle = '#fff';
    ctx.font = 'bold 14px Courier New';
    ctx.textAlign = 'center';
    ctx.textBaseline = 'middle';
    ctx.fillText('D', 0, 1);
  }
  
  ctx.restore();
}

function drawFlow() {
  for (const path of flowPaths) {
    for (let i = 0; i < path.length - 1; i++) {
      const a = path[i];
      const b = path[i+1];
      const ax = a.c * CELL_SIZE + CELL_SIZE/2;
      const ay = a.r * CELL_SIZE + CELL_SIZE/2;
      const bx = b.c * CELL_SIZE + CELL_SIZE/2;
      const by = b.r * CELL_SIZE + CELL_SIZE/2;
      
      const prog = flowProgress;
      const cx = ax + (bx - ax) * prog;
      const cy = ay + (by - ay) * prog;
      
      const cell = grid[a.r][a.c];
      const color = PIPE_TYPES[cell.type].color;
      
      ctx.save();
      ctx.shadowColor = color;
      ctx.shadowBlur = 20;
      ctx.fillStyle = color;
      ctx.beginPath();
      ctx.arc(cx, cy, CELL_SIZE * 0.12, 0, Math.PI * 2);
      ctx.fill();
      ctx.restore();
    }
  }
}

function drawParticles() {
  for (const p of particles) {
    ctx.save();
    ctx.globalAlpha = p.alpha;
    ctx.fillStyle = p.color;
    ctx.shadowColor = p.color;
    ctx.shadowBlur = 10;
    ctx.beginPath();
    ctx.arc(p.x, p.y, p.size, 0, Math.PI * 2);
    ctx.fill();
    ctx.restore();
  }
}

function handleCanvasClick(e) {
  if (gameState !== 'playing') return;
  const rect = canvas.getBoundingClientRect();
  const scaleX = canvas.width / rect.width;
  const scaleY = canvas.height / rect.height;
  const clientX = e.touches ? e.touches[0].clientX : e.clientX;
  const clientY = e.touches ? e.touches[0].clientY : e.clientY;
  const x = (clientX - rect.left) * scaleX;
  const y = (clientY - rect.top) * scaleY;
  
  const c = Math.floor(x / CELL_SIZE);
  const r = Math.floor(y / CELL_SIZE);
  
  if (r >= 0 && r < GRID_SIZE && c >= 0 && c < GRID_SIZE) {
    const cell = grid[r][c];
    if (cell.type !== 'empty' && !cell.fixed) {
      cell.rotation = (cell.rotation + 1) % 4;
      checkFlow();
    }
  }
}

function checkFlow() {
  const newPaths = findPaths();
  if (newPaths.length > 0 && !flowActive) {
    flowPaths = newPaths;
    flowActive = true;
    flowProgress = 0;
  }
}

function handleKeyDown(e) {
  if (e.key === 'Escape' || e.key === 'p' || e.key === 'P') {
    if (gameState === 'playing') pauseGame();
    else if (gameState === 'paused') resumeGame();
  }
}

// Event Listeners
startBtn.addEventListener('click', startGame);
resumeBtn.addEventListener('click', resumeGame);
quitBtn.addEventListener('click', quitToMenu);
retryBtn.addEventListener('click', startGame);
mainMenuBtn.addEventListener('click', showStartScreen);

canvas.addEventListener('click', handleCanvasClick, { passive: false });
canvas.addEventListener('touchstart', handleCanvasClick, { passive: false });
document.addEventListener('keydown', handleKeyDown);

// Prevent context menu on long press
canvas.addEventListener('contextmenu', e => e.preventDefault());

// Initial state
showOverlay(overlay);
</script>
</body>
</html>