<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no">
<title>Neon Pipeline - Day 47</title>
<style>
  * { margin: 0; padding: 0; box-sizing: border-box; }
  body { background: #0a0a12; color: #00ffff; font-family: 'Courier New', monospace; overflow: hidden; touch-action: none; }
  canvas { display: block; margin: 0 auto; background: #05050a; box-shadow: 0 0 30px rgba(0,255,255,0.2), inset 0 0 60px rgba(0,20,30,0.5); }
  #ui { position: fixed; top: 10px; left: 10px; right: 10px; display: flex; justify-content: space-between; pointer-events: none; z-index: 10; }
  .panel { background: rgba(0,10,20,0.8); border: 1px solid #00ffff44; border-radius: 8px; padding: 8px 16px; backdrop-filter: blur(4px); text-shadow: 0 0 5px #00ffff; }
  .panel h3 { font-size: 14px; font-weight: normal; color: #00ffaa; margin-bottom: 4px; text-transform: uppercase; letter-spacing: 2px; }
  .panel .value { font-size: 20px; font-weight: bold; color: #00ffff; }
  #overlay { position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,5,0.95); display: none; flex-direction: column; align-items: center; justify-content: center; z-index: 100; opacity: 0; pointer-events: none; transition: opacity 0.3s; }
  #overlay.active { opacity: 1; pointer-events: auto; }
  #overlay.visible { display: flex; }
  #overlay h1 { font-size: clamp(28px, 8vw, 48px); margin-bottom: 10px; text-shadow: 0 0 20px #00ffff, 0 0 40px #0088ff; background: linear-gradient(90deg, #00ffff, #0088ff, #ff00ff); -webkit-background-clip: text; -webkit-text-fill-color: transparent; animation: pulse 2s infinite; }
  @keyframes pulse { 0%,100% { filter: brightness(1); } 50% { filter: brightness(1.5); } }
  #overlay p { color: #88ffcc; margin-bottom: 30px; font-size: 16px; letter-spacing: 1px; }
  .btn { background: linear-gradient(135deg, #003344, #001122); border: 2px solid #00ffff; color: #00ffff; padding: 14px 40px; font-size: 16px; font-family: inherit; border-radius: 4px; cursor: pointer; margin: 8px; text-transform: uppercase; letter-spacing: 2px; transition: all 0.2s; box-shadow: 0 0 10px #00ffff44; }
  .btn:hover, .btn:focus { background: linear-gradient(135deg, #005566, #002233); box-shadow: 0 0 20px #00ffff, 0 0 30px #0088ff; transform: translateY(-2px); }
  .btn:active { transform: translateY(0); }
  .btn.secondary { border-color: #ff0088; color: #ff0088; box-shadow: 0 0 10px #ff008844; }
  .btn.secondary:hover { box-shadow: 0 0 20px #ff0088, 0 0 30px #ff0044; }
  #touchControls { position: fixed; bottom: 20px; left: 50%; transform: translateX(-50%); display: none; gap: 10px; z-index: 50; pointer-events: auto; }
  #touchControls .btn { padding: 12px 24px; font-size: 14px; }
  @media (hover: none) and (pointer: coarse) { #touchControls { display: flex; } }
  .hidden { display: none !important; }
</style>
</head>
<body>
<div id="ui">
  <div class="panel"><h3>Score</h3><div class="value" id="scoreDisplay">0</div></div>
  <div class="panel"><h3>Level</h3><div class="value" id="levelDisplay">1</div></div>
  <div class="panel"><h3>Best</h3><div class="value" id="bestDisplay">0</div></div>
</div>
<canvas id="gameCanvas"></canvas>
<div id="touchControls">
  <button class="btn" id="btnPause">Pause</button>
</div>
<div id="overlay" class="active visible">
  <h1 id="overlayTitle">NEON PIPELINE</h1>
  <p id="overlayText">Connect the flow before time runs out</p>
  <button class="btn" id="btnStart">Start Game</button>
  <button class="btn secondary hidden" id="btnQuit">Quit to Menu</button>
</div>
<script>
const canvas = document.getElementById('gameCanvas');
const ctx = canvas.getContext('2d');
const overlay = document.getElementById('overlay');
const overlayTitle = document.getElementById('overlayTitle');
const overlayText = document.getElementById('overlayText');
const btnStart = document.getElementById('btnStart');
const btnQuit = document.getElementById('btnQuit');
const btnPause = document.getElementById('btnPause');
const scoreDisplay = document.getElementById('scoreDisplay');
const levelDisplay = document.getElementById('levelDisplay');
const bestDisplay = document.getElementById('bestDisplay');

let width, height, cellSize, cols, rows;
let grid = [];
let startPipe = {x:0, y:0}, endPipe = {x:0, y:0};
let score = 0, level = 1, bestScore = 0;
let timeLeft = 0, maxTime = 0;
let gameState = 'start';
let animationId = null;
let lastTime = 0;
let particles = [];

const PIPE_TYPES = {
  EMPTY: 0,
  STRAIGHT: 1,
  CORNER: 2,
  T_JUNCTION: 3,
  CROSS: 4,
  SOURCE: 5,
  TARGET: 6
};

const PIPE_COLORS = {
  1: '#00ffff',
  2: '#00ff88',
  3: '#ffaa00',
  4: '#ff00ff',
  5: '#00ffff',
  6: '#ff0088'
};

const DIRECTIONS = {
  UP: 0,
  RIGHT: 1,
  DOWN: 2,
  LEFT: 3
};

const PIPE_CONNECTIONS = {
  [PIPE_TYPES.STRAIGHT]: [true, false, true, false],
  [PIPE_TYPES.CORNER]: [true, true, false, false],
  [PIPE_TYPES.T_JUNCTION]: [true, true, true, false],
  [PIPE_TYPES.CROSS]: [true, true, true, true],
  [PIPE_TYPES.SOURCE]: [true, true, true, true],
  [PIPE_TYPES.TARGET]: [true, true, true, true]
};

function resizeCanvas() {
  const uiEl = document.getElementById('ui');
  const uiHeight = uiEl ? uiEl.offsetHeight : 60;
  width = window.innerWidth;
  height = Math.max(200, window.innerHeight - uiHeight - 20);
  canvas.width = width;
  canvas.height = height;
  cellSize = Math.min(width / 10, height / 10);
  cols = Math.max(5, Math.floor(width / cellSize));
  rows = Math.max(5, Math.floor(height / cellSize));
  cellSize = Math.min(width / cols, height / rows);
}

function initGame() {
  resizeCanvas();
  bestScore = parseInt(localStorage.getItem('neonPipelineBest')) || 0;
  bestDisplay.textContent = bestScore;
  showStartScreen();
  
  btnStart.addEventListener('click', onStartClick);
  btnQuit.addEventListener('click', onQuitClick);
  btnPause.addEventListener('click', onPauseClick);
  
  window.addEventListener('keydown', handleKeydown);
  canvas.addEventListener('click', handleCanvasClick, {passive: false});
  canvas.addEventListener('touchstart', handleTouch, {passive: false});
  window.addEventListener('resize', onResize);
}

function onResize() {
  resizeCanvas();
  if (gameState === 'playing' || gameState === 'paused') {
    draw();
  }
}

function onStartClick(e) {
  e.preventDefault();
  e.stopPropagation();
  if (gameState === 'start' || gameState === 'gameover') {
    startGame();
  } else if (gameState === 'paused') {
    resumeGame();
  }
}

function onQuitClick(e) {
  e.preventDefault();
  e.stopPropagation();
  if (gameState === 'paused' || gameState === 'gameover') {
    quitToMenu();
  } else if (gameState === 'start') {
    showStartScreen();
  }
}

function onPauseClick(e) {
  e.preventDefault();
  e.stopPropagation();
  if (gameState === 'playing') {
    pauseGame();
  }
}

function showStartScreen() {
  gameState = 'start';
  overlayTitle.textContent = 'NEON PIPELINE';
  overlayText.textContent = 'Connect the flow before time runs out';
  btnStart.textContent = 'Start Game';
  btnStart.classList.remove('hidden');
  btnQuit.classList.add('hidden');
  overlay.classList.add('active', 'visible');
  cancelAnimationFrame(animationId);
  animationId = null;
}

function startGame() {
  score = 0;
  level = 1;
  scoreDisplay.textContent = score;
  levelDisplay.textContent = level;
  overlay.classList.remove('active', 'visible');
  generateLevel();
  gameState = 'playing';
  lastTime = performance.now();
  animationId = requestAnimationFrame(gameLoop);
}

function generateLevel() {
  grid = [];
  for (let y = 0; y < rows; y++) {
    grid[y] = [];
    for (let x = 0; x < cols; x++) {
      grid[y][x] = {type: PIPE_TYPES.EMPTY, rotation: 0, connected: false, flow: 0};
    }
  }
  
  const margin = 1;
  startPipe.x = Math.floor(Math.random() * Math.max(1, cols - 2 * margin)) + margin;
  startPipe.y = Math.floor(Math.random() * Math.max(1, rows - 2 * margin)) + margin;
  
  do {
    endPipe.x = Math.floor(Math.random() * Math.max(1, cols - 2 * margin)) + margin;
    endPipe.y = Math.floor(Math.random() * Math.max(1, rows - 2 * margin)) + margin;
  } while (endPipe.x === startPipe.x && endPipe.y === startPipe.y);
  
  grid[startPipe.y][startPipe.x] = {type: PIPE_TYPES.SOURCE, rotation: 0, connected: false, flow: 0};
  grid[endPipe.y][endPipe.x] = {type: PIPE_TYPES.TARGET, rotation: 0, connected: false, flow: 0};
  
  const pipeCount = Math.min(5 + level * 2, Math.max(1, cols * rows - 2));
  const pipeTypes = [PIPE_TYPES.STRAIGHT, PIPE_TYPES.CORNER, PIPE_TYPES.T_JUNCTION, PIPE_TYPES.CROSS];
  
  for (let i = 0; i < pipeCount; i++) {
    let x, y, attempts = 0;
    do {
      x = Math.floor(Math.random() * cols);
      y = Math.floor(Math.random() * rows);
      attempts++;
    } while (attempts < 100 && (grid[y][x].type !== PIPE_TYPES.EMPTY || (x === startPipe.x && y === startPipe.y) || (x === endPipe.x && y === endPipe.y)));
    
    if (attempts < 100) {
      grid[y][x] = {
        type: pipeTypes[Math.floor(Math.random() * pipeTypes.length)],
        rotation: Math.floor(Math.random() * 4),
        connected: false,
        flow: 0
      };
    }
  }
  
  maxTime = 30 + level * 5;
  timeLeft = maxTime;
}

function gameLoop(timestamp) {
  const dt = Math.min(0.1, (timestamp - lastTime) / 1000);
  lastTime = timestamp;
  
  if (gameState === 'playing') {
    update(dt);
  }
  
  draw();
  updateParticles(dt);
  
  if (gameState === 'playing' || gameState === 'paused') {
    animationId = requestAnimationFrame(gameLoop);
  }
}

function update(dt) {
  timeLeft -= dt;
  if (timeLeft <= 0) {
    gameOver();
    return;
  }
  
  checkConnections();
  
  if (grid[endPipe.y][endPipe.x].connected) {
    levelComplete();
  }
  
  particles.forEach(p => {
    p.life -= dt;
    p.x += p.vx * dt;
    p.y += p.vy * dt;
    p.vy += 50 * dt;
  });
  particles = particles.filter(p => p.life > 0);
}

function checkConnections() {
  grid.forEach(row => row.forEach(cell => { cell.connected = false; cell.flow = 0; }));
  
  const queue = [{x: startPipe.x, y: startPipe.y, from: -1}];
  grid[startPipe.y][startPipe.x].connected = true;
  grid[startPipe.y][startPipe.x].flow = 1;
  
  while (queue.length > 0) {
    const current = queue.shift();
    const cell = grid[current.y][current.x];
    const connections = getRotatedConnections(cell.type, cell.rotation);
    
    for (let dir = 0; dir < 4; dir++) {
      if (!connections[dir]) continue;
      
      let nx = current.x, ny = current.y;
      if (dir === DIRECTIONS.UP) ny--;
      else if (dir === DIRECTIONS.RIGHT) nx++;
      else if (dir === DIRECTIONS.DOWN) ny++;
      else if (dir === DIRECTIONS.LEFT) nx--;
      
      if (nx < 0 || nx >= cols || ny < 0 || ny >= rows) continue;
      
      const neighbor = grid[ny][nx];
      if (neighbor.type === PIPE_TYPES.EMPTY) continue;
      
      const neighborConnections = getRotatedConnections(neighbor.type, neighbor.rotation);
      const oppositeDir = (dir + 2) % 4;
      
      if (neighborConnections[oppositeDir] && !neighbor.connected) {
        neighbor.connected = true;
        neighbor.flow = cell.flow + 1;
        queue.push({x: nx, y: ny, from: oppositeDir});
      }
    }
  }
}

function getRotatedConnections(type, rotation) {
  const base = PIPE_CONNECTIONS[type] || [false, false, false, false];
  const rotated = [false, false, false, false];
  for (let i = 0; i < 4; i++) {
    rotated[(i + rotation) % 4] = base[i];
  }
  return rotated;
}

function handleCanvasClick(e) {
  if (gameState !== 'playing') return;
  e.preventDefault();
  
  const rect = canvas.getBoundingClientRect();
  const x = Math.floor((e.clientX - rect.left) / cellSize);
  const y = Math.floor((e.clientY - rect.top) / cellSize);
  
  if (x >= 0 && x < cols && y >= 0 && y < rows) {
    rotatePipe(x, y);
  }
}

function handleTouch(e) {
  if (gameState !== 'playing') return;
  e.preventDefault();
  const touch = e.touches[0];
  const rect = canvas.getBoundingClientRect();
  const x = Math.floor((touch.clientX - rect.left) / cellSize);
  const y = Math.floor((touch.clientY - rect.top) / cellSize);
  
  if (x >= 0 && x < cols && y >= 0 && y < rows) {
    rotatePipe(x, y);
  }
}

function rotatePipe(x, y) {
  const cell = grid[y][x];
  if (cell.type === PIPE_TYPES.EMPTY || cell.type === PIPE_TYPES.SOURCE || cell.type === PIPE_TYPES.TARGET) return;
  
  cell.rotation = (cell.rotation + 1) % 4;
  createRotationParticles(x, y);
}

function createRotationParticles(x, y) {
  const cx = (x + 0.5) * cellSize;
  const cy = (y + 0.5) * cellSize;
  for (let i = 0; i < 8; i++) {
    const angle = (Math.PI * 2 * i) / 8;
    particles.push({
      x: cx, y: cy,
      vx: Math.cos(angle) * 100,
      vy: Math.sin(angle) * 100,
      life: 0.5,
      color: PIPE_COLORS[grid[y][x].type] || '#00ffff',
      size: 3 + Math.random() * 2
    });
  }
}

function updateParticles(dt) {
  particles.forEach(p => {
    p.life -= dt;
    p.x += p.vx * dt;
    p.y += p.vy * dt;
    p.vy += 50 * dt;
  });
  particles = particles.filter(p => p.life > 0);
}

function draw() {
  ctx.fillStyle = '#05050a';
  ctx.fillRect(0, 0, width, height);
  
  drawGrid();
  drawPipes();
  drawParticles();
  drawUI();
}

function drawGrid() {
  ctx.strokeStyle = '#003344';
  ctx.lineWidth = 1;
  for (let x = 0; x <= cols; x++) {
    ctx.beginPath();
    ctx.moveTo(x * cellSize, 0);
    ctx.lineTo(x * cellSize, height);
    ctx.stroke();
  }
  for (let y = 0; y <= rows; y++) {
    ctx.beginPath();
    ctx.moveTo(0, y * cellSize);
    ctx.lineTo(width, y * cellSize);
    ctx.stroke();
  }
}

function drawPipes() {
  for (let y = 0; y < rows; y++) {
    for (let x = 0; x < cols; x++) {
      const cell = grid[y][x];
      if (cell.type === PIPE_TYPES.EMPTY) continue;
      
      const cx = (x + 0.5) * cellSize;
      const cy = (y + 0.5) * cellSize;
      const size = cellSize * 0.35;
      const color = PIPE_COLORS[cell.type] || '#00ffff';
      const is