<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no">
<title>Neon Pipeline - Day 47</title>
<style>
  * { margin: 0; padding: 0; box-sizing: border-box; }
  body { background: #0a0a12; color: #00ffff; font-family: 'Courier New', monospace; overflow: hidden; touch-action: none; }
  canvas { display: block; margin: 0 auto; background: #05050a; box-shadow: 0 0 30px rgba(0,255,255,0.2), inset 0 0 60px rgba(0,20,30,0.5); }
  #ui { position: fixed; top: 10px; left: 10px; right: 10px; display: flex; justify-content: space-between; pointer-events: none; z-index: 10; }
  .panel { background: rgba(0,10,20,0.8); border: 1px solid #00ffff44; border-radius: 8px; padding: 8px 16px; backdrop-filter: blur(4px); text-shadow: 0 0 5px #00ffff; }
  .panel h3 { font-size: 14px; font-weight: normal; color: #00ffaa; margin-bottom: 4px; text-transform: uppercase; letter-spacing: 2px; }
  .panel .value { font-size: 20px; font-weight: bold; color: #00ffff; }
  #overlay { position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,5,0.95); display: flex; flex-direction: column; align-items: center; justify-content: center; z-index: 100; opacity: 0; pointer-events: none; transition: opacity 0.3s; }
  #overlay.active { opacity: 1; pointer-events: auto; }
  #overlay h1 { font-size: clamp(28px, 8vw, 48px); margin-bottom: 10px; text-shadow: 0 0 20px #00ffff, 0 0 40px #0088ff; background: linear-gradient(90deg, #00ffff, #0088ff, #ff00ff); -webkit-background-clip: text; -webkit-text-fill-color: transparent; animation: pulse 2s infinite; }
  @keyframes pulse { 0%,100% { filter: brightness(1); } 50% { filter: brightness(1.5); } }
  #overlay p { color: #88ffcc; margin-bottom: 30px; font-size: 16px; letter-spacing: 1px; }
  .btn { background: linear-gradient(135deg, #003344, #001122); border: 2px solid #00ffff; color: #00ffff; padding: 14px 40px; font-size: 16px; font-family: inherit; border-radius: 4px; cursor: pointer; margin: 8px; text-transform: uppercase; letter-spacing: 2px; transition: all 0.2s; box-shadow: 0 0 10px #00ffff44; }
  .btn:hover, .btn:focus { background: linear-gradient(135deg, #005566, #002233); box-shadow: 0 0 20px #00ffff, 0 0 30px #0088ff; transform: translateY(-2px); }
  .btn:active { transform: translateY(0); }
  .btn.secondary { border-color: #ff0088; color: #ff0088; box-shadow: 0 0 10px #ff008844; }
  .btn.secondary:hover { box-shadow: 0 0 20px #ff0088, 0 0 30px #ff0044; }
  #touchControls { position: fixed; bottom: 20px; left: 50%; transform: translateX(-50%); display: none; gap: 10px; z-index: 50; pointer-events: auto; }
  #touchControls .btn { padding: 12px 24px; font-size: 14px; }
  @media (hover: none) and (pointer: coarse) { #touchControls { display: flex; } }
  .hidden { display: none !important; }
  .grid-line { stroke: #00ffff11; stroke-width: 0.5; }
  .pipe-path { fill: none; stroke-linecap: round; stroke-linejoin: round; filter: drop-shadow(0 0 4px currentColor); }
  .start-end { fill: #00ffff; filter: drop-shadow(0 0 8px #00ffff); }
  .timer-bar { fill: #00ffff; filter: drop-shadow(0 0 8px #00ffff); }
  .timer-bg { fill: #001122; stroke: #00ffff44; stroke-width: 1; }
</style>
</head>
<body>
<div id="ui">
  <div class="panel"><h3>Score</h3><div class="value" id="scoreDisplay">0</div></div>
  <div class="panel"><h3>Level</h3><div class="value" id="levelDisplay">1</div></div>
  <div class="panel"><h3>Best</h3><div class="value" id="bestDisplay">0</div></div>
</div>
<canvas id="gameCanvas"></canvas>
<div id="touchControls">
  <button class="btn" id="btnPause">Pause</button>
</div>
<div id="overlay">
  <h1 id="overlayTitle">NEON PIPELINE</h1>
  <p id="overlayText">Connect the flow before time runs out</p>
  <button class="btn" id="btnStart">Start Game</button>
  <button class="btn secondary" id="btnQuit" class="hidden">Quit to Menu</button>
</div>
<script>
/**
 * Neon Pipeline - Day 47
 * Rotate pipes to connect start to end before timer expires.
 * Neon/cyberpunk aesthetic, increasing difficulty, high score persistence.
 */
const canvas = document.getElementById('gameCanvas');
const ctx = canvas.getContext('2d');
const overlay = document.getElementById('overlay');
const overlayTitle = document.getElementById('overlayTitle');
const overlayText = document.getElementById('overlayText');
const btnStart = document.getElementById('btnStart');
const btnQuit = document.getElementById('btnQuit');
const btnPause = document.getElementById('btnPause');
const scoreDisplay = document.getElementById('scoreDisplay');
const levelDisplay = document.getElementById('levelDisplay');
const bestDisplay = document.getElementById('bestDisplay');

// Game constants
const PIPE_TYPES = {
  EMPTY: 0,
  STRAIGHT: 1,
  CORNER: 2,
  T_JUNCTION: 3,
  CROSS: 4
};
const ROTATIONS = [0, Math.PI/2, Math.PI, 3*Math.PI/2];
const COLORS = {
  bg: '#05050a',
  grid: '#00ffff11',
  pipe: '#00ffff',
  pipeGlow: '#00ffff',
  flow: '#00ffaa',
  flowGlow: '#00ffaa',
  startEnd: '#00ffff',
  timerBg: '#001122',
  timerBar: '#00ffff',
  timerGlow: '#00ffff',
  text: '#00ffff',
  textDim: '#88ffcc'
};
const PIPE_CONNECTIONS = {
  [PIPE_TYPES.STRAIGHT]: [0, 2],
  [PIPE_TYPES.CORNER]: [0, 1],
  [PIPE_TYPES.T_JUNCTION]: [0, 1, 3],
  [PIPE_TYPES.CROSS]: [0, 1, 2, 3]
};

// Game state
let running = false;
let gameState = 'menu';
let animationId = null;
let lastTime = 0;
let score = 0;
let level = 1;
let highScore = parseInt(localStorage.getItem('neonPipelineHighScore')) || 0;
let gridSize = 4;
let cellSize = 0;
let grid = [];
let startPos = {x:0, y:0};
let endPos = {x:0, y:0};
let timeLeft = 0;
let maxTime = 0;
let timerWarning = false;
let particles = [];
let flowProgress = 0;
let flowActive = false;
let flowPath = [];

// Input state
const keys = {};
let touchStart = null;

// Initialize canvas size
function resizeCanvas() {
  const maxWidth = window.innerWidth - 20;
  const maxHeight = window.innerHeight - 120;
  const size = Math.min(maxWidth, maxHeight, 600);
  canvas.width = size;
  canvas.height = size;
  cellSize = canvas.width / gridSize;
}
window.addEventListener('resize', resizeCanvas);
resizeCanvas();

// High score display
bestDisplay.textContent = highScore;

// --- Core Game Functions ---

function startGame() {
  score = 0;
  level = 1;
  gridSize = 4;
  running = true;
  gameState = 'playing';
  overlay.classList.remove('active');
  btnQuit.classList.add('hidden');
  btnStart.textContent = 'Start Game';
  overlayTitle.textContent = 'NEON PIPELINE';
  generateLevel();
  lastTime = performance.now();
  if (animationId) cancelAnimationFrame(animationId);
  animationId = requestAnimationFrame(gameLoop);
}

function pauseGame() {
  if (gameState !== 'playing') return;
  gameState = 'paused';
  running = false;
  overlay.classList.add('active');
  overlayTitle.textContent = 'PAUSED';
  overlayText.textContent = `Level ${level} • Score: ${score}`;
  btnStart.textContent = 'Resume';
  btnQuit.classList.remove('hidden');
  btnQuit.textContent = 'Quit to Menu';
}

function resumeGame() {
  if (gameState !== 'paused') return;
  gameState = 'playing';
  running = true;
  overlay.classList.remove('active');
  lastTime = performance.now();
  animationId = requestAnimationFrame(gameLoop);
}

function quitToMenu() {
  running = false;
  gameState = 'menu';
  if (animationId) cancelAnimationFrame(animationId);
  overlay.classList.add('active');
  overlayTitle.textContent = 'NEON PIPELINE';
  overlayText.textContent = `Final Score: ${score} • Best: ${highScore}`;
  btnStart.textContent = 'Play Again';
  btnQuit.classList.add('hidden');
}

function showStartScreen() {
  quitToMenu();
}

function gameOver() {
  running = false;
  gameState = 'gameover';
  if (animationId) cancelAnimationFrame(animationId);
  if (score > highScore) {
    highScore = score;
    localStorage.setItem('neonPipelineHighScore', highScore);
    bestDisplay.textContent = highScore;
  }
  overlay.classList.add('active');
  overlayTitle.textContent = 'TIME EXPIRED';
  overlayText.textContent = `Reached Level ${level} • Score: ${score}`;
  btnStart.textContent = 'Retry';
  btnQuit.classList.remove('hidden');
  btnQuit.textContent = 'Main Menu';
}

// --- Level Generation ---

function generateLevel() {
  gridSize = Math.min(4 + Math.floor((level - 1) / 3), 8);
  resizeCanvas();
  
  maxTime = Math.max(60 - (level - 1) * 3, 15);
  timeLeft = maxTime;
  timerWarning = false;
  
  grid = Array(gridSize).fill(null).map(() => Array(gridSize).fill(null).map(() => ({
    type: PIPE_TYPES.EMPTY,
    rotation: 0,
    connected: false,
    flowProgress: 0
  })));
  
  generateSolvablePath();
  fillRandomPipes();
  scrambleRotations();
  
  flowActive = false;
  flowProgress = 0;
  flowPath = [];
  
  updateUI();
}

function generateSolvablePath() {
  const edges = [];
  for (let x = 0; x < gridSize; x++) { edges.push({x, y: -1, dir: 2}); edges.push({x, y: gridSize, dir: 0}); }
  for (let y = 0; y < gridSize; y++) { edges.push({x: -1, y, dir: 1}); edges.push({x: gridSize, y, dir: 3}); }
  
  const startEdge = edges[Math.floor(Math.random() * edges.length)];
  let endEdge;
  do { endEdge = edges[Math.floor(Math.random() * edges.length)]; } while (endEdge === startEdge);
  
  startPos = {x: clamp(startEdge.x, 0, gridSize-1), y: clamp(startEdge.y, 0, gridSize-1)};
  endPos = {x: clamp(endEdge.x, 0, gridSize-1), y: clamp(endEdge.y, 0, gridSize-1)};
  
  grid[startPos.y][startPos.x].isStart = true;
  grid[startPos.y][startPos.x].requiredDir = startEdge.dir;
  grid[endPos.y][endPos.x].isEnd = true;
  grid[endPos.y][endPos.x].requiredDir = endEdge.dir;
  
  const path = findPath(startPos, endPos);
  if (!path) { generateSolvablePath(); return; }
  
  for (let i = 0; i < path.length - 1; i++) {
    const a = path[i], b = path[i+1];
    const dir = getDirection(a, b);
    const cell = grid[a.y][a.x];
    cell.type = choosePipeForConnection(cell.type, dir);
    cell.correctRotation = getRotationForConnection(cell.type, dir, cell.correctRotation);
  }
  const last = path[path.length-1];
  const prev = path[path.length-2];
  const dirToEnd = getDirection(prev, last);
  const endCell = grid[last.y][last.x];
  endCell.type = choosePipeForConnection(endCell.type, oppositeDir(dirToEnd));
  endCell.correctRotation = getRotationForConnection(endCell.type, oppositeDir(dirToEnd), endCell.correctRotation);
}

function findPath(start, end) {
  const queue = [[start]];
  const visited = new Set([`${start.x},${start.y}`]);
  const dirs = [{x:0,y:-1},{x:1,y:0},{x:0,y:1},{x:-1,y:0}];
  
  while (queue.length) {
    const path = queue.shift();
    const current = path[path.length-1];
    if (current.x === end.x && current.y === end.y) return path;
    
    const shuffled = [...dirs].sort(() => Math.random() - 0.5);
    for (const d of shuffled) {
      const nx = current.x + d.x, ny = current.y + d.y;
      if (nx >= 0 && nx < gridSize && ny >= 0 && ny < gridSize) {
        const key = `${nx},${ny}`;
        if (!visited.has(key)) {
          visited.add(key);
          queue.push([...path, {x:nx, y:ny}]);
        }
      }
    }
  }
  return null;
}

function choosePipeForConnection(currentType, newDir) {
  const existing = currentType === PIPE_TYPES.EMPTY ? [] : getConnections(currentType, 0);
  const allDirs = [...new Set([...existing, newDir])];
  
  if (allDirs.length === 1) return PIPE_TYPES.STRAIGHT;
  if (allDirs.length === 2) {
    const diff = (allDirs[1] - allDirs[0] + 4) % 4;
    return diff === 2 ? PIPE_TYPES.STRAIGHT : PIPE_TYPES.CORNER;
  }
  if (allDirs.length === 3) return PIPE_TYPES.T_JUNCTION;
  return PIPE_TYPES.CROSS;
}

function getRotationForConnection(type, dir, currentRot) {
  const baseConns = PIPE_CONNECTIONS[type] || [];
  for (let r = 0; r < 4; r++) {
    const rotated = baseConns.map(d => (d + r) % 4);
    if (rotated.includes(dir)) return r;
  }
  return currentRot || 0;
}

function getConnections(type, rotation) {
  const base = PIPE_CONNECTIONS[type] || [];
  return base.map(d => (d + rotation) % 4);
}

function getDirection(a, b) {
  if (b.x === a.x + 1) return 1;
  if (b.x === a.x - 1) return 3;
  if (b.y === a.y + 1) return 2;
  if (b.y === a.y - 1) return 0;
  return -1;
}

function oppositeDir(d) { return (d + 2) % 4; }

function fillRandomPipes() {
  const types = [PIPE_TYPES.STRAIGHT, PIPE_TYPES.CORNER, PIPE_TYPES.T_JUNCTION, PIPE_TYPES.CROSS];
  for (let y = 0; y < gridSize; y++) {
    for (let x = 0; x < gridSize; x++) {
      if (grid[y][x].type === PIPE_TYPES.EMPTY) {
        grid[y][x].type = types[Math.floor(Math.random() * types.length)];
        grid[y][x].correctRotation = Math.floor(Math.random() * 4);
      }
    }
  }
}

function scrambleRotations() {
  for (let y = 0; y < gridSize; y++) {
    for (let x = 0; x < gridSize; x++) {
      const cell = grid[y][x];
      if (cell.type !== PIPE_TYPES.EMPTY) {
        const offset = 1 + Math.floor(Math.random() * 3);
        cell.rotation = (cell.correctRotation + offset) % 4;
      }
    }
  }
}

function clamp(v, min, max) { return Math.max(min, Math.min(max, v)); }

// --- Input Handling ---

function getCellFromClient(clientX, clientY) {
  const rect = canvas.getBoundingClientRect();
  const x = clientX - rect.left;
  const y = clientY - rect.top;
  const col = Math.floor(x / cellSize);
  const row = Math.floor(y / cellSize);
  if (col >= 0 && col < gridSize && row >= 0 && row < gridSize) return {x: col, y: row};
  return null;
}

function handleCellClick(cell) {
  if (gameState !== 'playing' || flowActive) return;
  const c = grid[cell.y][cell.x];
  if (c.type !== PIPE_TYPES.EMPTY) {
    c.rotation = (c.rotation + 1) % 4;
    checkConnection();
    createClickParticles(cell.x * cellSize + cellSize/2, cell.y * cellSize + cellSize/2);
  }
}

function checkConnection() {
  const visited = new Set();
  const queue = [{x: startPos.x, y: startPos.y, fromDir: grid[startPos.y][startPos.x].requiredDir}];
  flowPath = [{x: startPos.x, y: startPos.y}];
  
  while (queue.length) {
    const current = queue.shift();
    const key = `${current.x},${current.y},${current.fromDir}`;
    if (visited.has(key)) continue;
    visited.add(key);
    
    const cell = grid[current.y][current.x];
    const conns = getConnections(cell.type, cell.rotation);
    
    if (!(current.x === startPos.x && current.y === startPos.y)) {
      if (!conns.includes(current.fromDir)) continue;
    }
    
    for (const dir of conns) {
      if (dir === current.fromDir && !(current.x === startPos.x && current.y === startPos.y)) continue;
      
      let nx = current.x, ny = current.y;
      if (dir === 0) ny--;
      else if (dir === 1) nx++;
      else if (dir === 2) ny++;
      else if (dir === 3) nx--;
      
      if (nx < 0 || nx >= gridSize || ny < 0 || ny >= gridSize) {
        if (current.x === endPos.x && current.y === endPos.y && dir === grid[endPos.y][endPos.x].requiredDir) {
          activateFlow();
          return;
        }
        continue;
      }
      
      const nextCell = grid[ny][nx];
      if (nextCell.type !== PIPE_TYPES.EMPTY) {
        queue.push({x: nx, y: ny, fromDir: oppositeDir(dir)});
        if (!flowPath.some(p => p.x === nx && p.y === ny)) flowPath.push({x: nx, y: ny});
      }
    }
  }
}

function activateFlow() {
  flowActive = true;
  flowProgress = 0;
  score += Math.floor(timeLeft * 10 * level);
  updateUI();
  createSuccessParticles();
}

function nextLevel() {
  level++;
  generateLevel();
}

// --- Particle Systems ---

function createClickParticles(x, y) {
  for (let i = 0; i < 8; i++) {
    const angle = Math.random() * Math.PI * 2;
    const speed = 2 + Math.random() * 3;
    particles.push({
      x, y,
      vx: Math.cos(angle) * speed,
      vy: Math.sin(angle) * speed,
      life: 1,
      decay: 0.02 + Math.random() * 0.02,
      color: `hsl(${180 + Math.random() * 60}, 100%, 50%)`,
      size: 2 + Math.random() * 3
    });
  }
}

function createSuccessParticles() {
  for (let i = 0; i < 30; i++) {
    const angle = Math.random() * Math.PI * 2;
    const speed = 3 + Math.random() * 5;
    particles.push({
      x: canvas.width/2, y: canvas.height/2,
      vx: Math.cos(angle) * speed,
      vy: Math.sin(angle) * speed,
      life: 1,
      decay: 0.01 + Math.random() * 0.015,
      color: `hsl(${120 + Math.random() * 120}, 100%, 50%)`,
      size: 3 + Math.random() * 4
    });
  }
}

function createFlowParticles(x, y) {
  if (Math.random() < 0.3) {
    particles.push({
      x, y,
      vx: (Math.random()-0.5)*2,
      vy: (Math.random()-0.5)*2,
      life: 0.5,
      decay: 0.05,
      color: '#00ffaa',
      size: 1 + Math.random() * 2
    });
  }
}

function updateParticles(dt) {
  for (let i = particles.length - 1; i >= 0; i--) {
    const p = particles[i];
    p.x += p.vx * dt * 60;
    p.y += p.vy * dt * 60;
    p.life -= p.decay * dt * 60;
    p.vx *= 0.98; p.vy *= 0.98;
    if (p.life <= 0) particles.splice(i, 1);
  }
}

function drawParticles() {
  for (const p of particles) {
    ctx.globalAlpha = p.life;
    ctx.fillStyle = p.color;
    ctx.shadowColor = p.color;
    ctx.shadowBlur = 10;
    ctx.beginPath();
    ctx.arc(p.x, p.y, p.size, 0, Math.PI * 2);
    ctx.fill();
    ctx.shadowBlur = 0;
  }
  ctx.globalAlpha = 1;
}

// --- Rendering ---

function drawGrid() {
  ctx.strokeStyle = COLORS.grid;
  ctx.lineWidth = 1;
  ctx.beginPath();
  for (let i = 1; i < gridSize; i++) {
    const pos = i * cellSize;
    ctx.moveTo(pos, 0); ctx.lineTo(pos, canvas.height);
    ctx.moveTo(0, pos); ctx.lineTo(canvas.width, pos);
  }
  ctx.stroke();
}

function drawPipeShape(ctx, type, radius) {
  const r = radius;
  switch(type) {
    case PIPE_TYPES.STRAIGHT:
      ctx.moveTo(0, -r);
      ctx.lineTo(0, r);
      break;
    case PIPE_TYPES.CORNER:
      ctx.moveTo(0, -r);
      ctx.lineTo(0, 0);
      ctx.lineTo(r, 0);
      break;
    case PIPE_TYPES.T_JUNCTION:
      ctx.moveTo(0, -r);
      ctx.lineTo(0, 0);
      ctx.moveTo(-r, 0);
      ctx.lineTo(r, 0);
      break;
    case PIPE_TYPES.CROSS:
      ctx.moveTo(0, -r);
      ctx.lineTo(0, r);
      ctx.moveTo(-r, 0);
      ctx.lineTo(r, 0);
      break;
  }
}

function drawPipes() {
  for (let y = 0; y < gridSize; y++) {
    for (let x = 0; x < gridSize; x++) {
      const cell = grid[y][x];
      if (cell.type === PIPE_TYPES.EMPTY) continue;
      
      const cx = x * cellSize + cellSize/2;
      const cy = y * cellSize + cellSize/2;
      const radius = cellSize * 0.35;
      const lineWidth = Math.max(3, cellSize * 0.12);
      
      ctx.save();
      ctx.translate(cx, cy);
      ctx.rotate(cell.rotation * Math.PI/2);
      
      const isFlow = flowActive && flowPath.some(p => p.x === x && p.y === y);
      const pathIndex = flowPath.findIndex(p => p.x === x && p.y === y);
      const flowAmount = isFlow ? Math.min(1, flowProgress * flowPath.length - pathIndex) : 0;
      
      ctx.strokeStyle = isFlow && flowAmount > 0 ? COLORS.flow : COLORS.pipe;
      ctx.shadowColor = isFlow && flowAmount > 0 ? COLORS.flowGlow : COLORS.pipeGlow;
      ctx.shadowBlur = isFlow && flowAmount > 0 ? 15 : 8;
      ctx.lineWidth = lineWidth;
      ctx.lineCap = 'round';
      ctx.lineJoin = 'round';
      
      ctx.beginPath();
      drawPipeShape(ctx, cell.type, radius);
      ctx.stroke();
      
      if (isFlow && flowAmount > 0) {
        ctx.strokeStyle = COLORS.flow;
        ctx.shadowColor = COLORS.flowGlow;
        ctx.shadowBlur = 20;
        ctx.lineWidth = lineWidth * 0.6;
        ctx.globalAlpha = 0.8;
        ctx.beginPath();
        drawPipeShape(ctx, cell.type, radius);
        ctx.stroke();
        ctx.globalAlpha = 1;
      }
      
      ctx.restore();
      
      if (isFlow && flowAmount > 0 && flowAmount < 1) {
        createFlowParticles(cx, cy);
      }
    }
  }
}

function drawStartEnd() {
  const radius = cellSize * 0.25;
  // Start
  ctx.fillStyle = COLORS.startEnd;
  ctx.shadowColor = COLORS.startEnd;
  ctx.shadowBlur = 15;
  ctx.beginPath();
  ctx.arc(startPos.x * cellSize + cellSize/2, startPos.y * cellSize + cellSize/2, radius, 0, Math.PI * 2);
  ctx.fill();
  // End
  ctx.beginPath();
  ctx.arc(endPos.x * cellSize + cellSize/2, endPos.y * cellSize + cellSize/2, radius, 0, Math.PI * 2);
  ctx.fill();
  ctx.shadowBlur = 0;
}

function drawTimer() {
  const barWidth = canvas.width * 0.8;
  const barHeight = 8;
  const x = (canvas.width - barWidth) / 2;
  const y = canvas.height - 20;
  
  ctx.fillStyle = COLORS.timerBg;
  ctx.strokeStyle = '#00ffff44';
  ctx.lineWidth = 1;
  ctx.beginPath();
  ctx.roundRect(x, y, barWidth, barHeight, 4);
  ctx.fill();
  ctx.stroke();
  
  const progress = timeLeft / maxTime;
  ctx.fillStyle = progress < 0.3 ? '#ff0044' : COLORS.timerBar;
  ctx.shadowColor = progress < 0.3 ? '#ff0044' : COLORS.timerGlow;
  ctx.shadowBlur = 10;
  ctx.beginPath();
  ctx.roundRect(x, y, barWidth * progress, barHeight, 4);
  ctx.fill();
  ctx.shadowBlur = 0;
}

function updateUI() {
  scoreDisplay.textContent = score;
  levelDisplay.textContent = level;
  bestDisplay.textContent = highScore;
}

// --- Game Loop ---

function gameLoop(timestamp) {
  if (!running) return;
  const dt = (timestamp - lastTime) / 1000;
  lastTime = timestamp;
  
  update(dt);
  draw();
  
  animationId = requestAnimationFrame(gameLoop);
}

function update(dt) {
  updateParticles(dt);
  
  if (gameState === 'playing') {
    timeLeft -= dt;
    if (timeLeft <= 0) {
      timeLeft = 0;
      gameOver();
      return;
    }
    if (timeLeft / maxTime < 0.3 && !timerWarning) {
      timerWarning = true;
    }
    
    if (flowActive) {
      flowProgress += dt * 2; // 0.5 seconds to complete flow
      if (flowProgress >= 1) {
        flowActive = false;
        nextLevel();
      }
    }
  }
}

function draw() {
  ctx.fillStyle = COLORS.bg;
  ctx.fillRect(0, 0, canvas.width, canvas.height);
  
  drawGrid();
  drawPipes();
  drawStartEnd();
  drawTimer();
  drawParticles();
}

// --- Event Listeners ---

canvas.addEventListener('click', (e) => {
  const cell = getCellFromClient(e.clientX, e.clientY);
  if (cell) handleCellClick(cell);
}, {passive: true});

canvas.addEventListener('touchstart', (e) => {
  if (e.touches.length === 1) {
    touchStart = {x: e.touches[0].clientX, y: e.touches[0].clientY};
  }
}, {passive: false});

canvas.addEventListener('touchend', (e) => {
