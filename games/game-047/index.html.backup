<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no">
<title>Neon Pipeline - Day 47</title>
<style>
  * { margin: 0; padding: 0; box-sizing: border-box; }
  body { background: #0a0a12; color: #00ffff; font-family: 'Courier New', monospace; overflow: hidden; touch-action: none; }
  canvas { display: block; margin: 0 auto; background: #05050a; box-shadow: 0 0 30px rgba(0,255,255,0.2), inset 0 0 60px rgba(0,20,30,0.5); }
  #ui { position: fixed; top: 10px; left: 10px; right: 10px; display: flex; justify-content: space-between; pointer-events: none; z-index: 10; }
  .panel { background: rgba(0,10,20,0.8); border: 1px solid #00ffff44; border-radius: 8px; padding: 8px 16px; backdrop-filter: blur(4px); text-shadow: 0 0 5px #00ffff; }
  .panel h3 { font-size: 14px; font-weight: normal; color: #00ffaa; margin-bottom: 4px; text-transform: uppercase; letter-spacing: 2px; }
  .panel .value { font-size: 20px; font-weight: bold; color: #00ffff; }
  #overlay { position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,5,0.95); display: none; flex-direction: column; align-items: center; justify-content: center; z-index: 100; opacity: 0; pointer-events: none; transition: opacity 0.3s; }
  #overlay.active { opacity: 1; pointer-events: auto; }
  #overlay.visible { display: flex; }
  #overlay h1 { font-size: clamp(28px, 8vw, 48px); margin-bottom: 10px; text-shadow: 0 0 20px #00ffff, 0 0 40px #0088ff; background: linear-gradient(90deg, #00ffff, #0088ff, #ff00ff); -webkit-background-clip: text; -webkit-text-fill-color: transparent; animation: pulse 2s infinite; }
  @keyframes pulse { 0%,100% { filter: brightness(1); } 50% { filter: brightness(1.5); } }
  #overlay p { color: #88ffcc; margin-bottom: 30px; font-size: 16px; letter-spacing: 1px; }
  .btn { background: linear-gradient(135deg, #003344, #001122); border: 2px solid #00ffff; color: #00ffff; padding: 14px 40px; font-size: 16px; font-family: inherit; border-radius: 4px; cursor: pointer; margin: 8px; text-transform: uppercase; letter-spacing: 2px; transition: all 0.2s; box-shadow: 0 0 10px #00ffff44; }
  .btn:hover, .btn:focus { background: linear-gradient(135deg, #005566, #002233); box-shadow: 0 0 20px #00ffff, 0 0 30px #0088ff; transform: translateY(-2px); }
  .btn:active { transform: translateY(0); }
  .btn.secondary { border-color: #ff0088; color: #ff0088; box-shadow: 0 0 10px #ff008844; }
  .btn.secondary:hover { box-shadow: 0 0 20px #ff0088, 0 0 30px #ff0044; }
  #touchControls { position: fixed; bottom: 20px; left: 50%; transform: translateX(-50%); display: none; gap: 10px; z-index: 50; pointer-events: auto; }
  #touchControls .btn { padding: 12px 24px; font-size: 14px; }
  @media (hover: none) and (pointer: coarse) { #touchControls { display: flex; } }
  .hidden { display: none !important; }
</style>
</head>
<body>
<div id="ui">
  <div class="panel"><h3>Score</h3><div class="value" id="scoreDisplay">0</div></div>
  <div class="panel"><h3>Level</h3><div class="value" id="levelDisplay">1</div></div>
  <div class="panel"><h3>Best</h3><div class="value" id="bestDisplay">0</div></div>
</div>
<canvas id="gameCanvas"></canvas>
<div id="touchControls">
  <button class="btn" id="btnPause">Pause</button>
</div>
<div id="overlay" class="active visible">
  <h1 id="overlayTitle">NEON PIPELINE</h1>
  <p id="overlayText">Connect the flow before time runs out</p>
  <button class="btn" id="btnStart">Start Game</button>
  <button class="btn secondary hidden" id="btnQuit">Quit to Menu</button>
</div>
<script>
/**
 * Neon Pipeline - Day 47
 * Rotate pipes to connect start to end before timer expires.
 * Neon/cyberpunk aesthetic, increasing difficulty, high score persistence.
 */
const canvas = document.getElementById('gameCanvas');
const ctx = canvas.getContext('2d');
const overlay = document.getElementById('overlay');
const overlayTitle = document.getElementById('overlayTitle');
const overlayText = document.getElementById('overlayText');
const btnStart = document.getElementById('btnStart');
const btnQuit = document.getElementById('btnQuit');
const btnPause = document.getElementById('btnPause');
const scoreDisplay = document.getElementById('scoreDisplay');
const levelDisplay = document.getElementById('levelDisplay');
const bestDisplay = document.getElementById('bestDisplay');

// Game constants
const PIPE_TYPES = {
  EMPTY: 0,
  STRAIGHT: 1,
  CORNER: 2,
  T_JUNCTION: 3,
  CROSS: 4
};
const ROTATIONS = [0, Math.PI/2, Math.PI, 3*Math.PI/2];
const COLORS = {
  bg: '#05050a',
  grid: '#00ffff11',
  pipe: '#00ffff',
  pipeGlow: '#00ffff',
  flow: '#00ffaa',
  flowGlow: '#00ffaa',
  startEnd: '#00ffff',
  timerBg: '#001122',
  timerBar: '#00ffff',
  timerGlow: '#00ffff',
  text: '#00ffff',
  textDim: '#88ffcc'
};
const PIPE_CONNECTIONS = {
  [PIPE_TYPES.STRAIGHT]: [0, 2],
  [PIPE_TYPES.CORNER]: [0, 1],
  [PIPE_TYPES.T_JUNCTION]: [0, 1, 3],
  [PIPE_TYPES.CROSS]: [0, 1, 2, 3]
};

// Game state
let running = false;
let gameState = 'menu';
let animationId = null;
let lastTime = 0;
let score = 0;
let level = 1;
let highScore = parseInt(localStorage.getItem('neonPipelineHighScore')) || 0;
let gridSize = 4;
let cellSize = 0;
let grid = [];
let startPos = {x:0, y:0};
let endPos = {x:0, y:0};
let timeLeft = 0;
let maxTime = 0;
let timerWarning = false;
let particles = [];
let flowProgress = 0;
let flowActive = false;
let flowPath = [];

// Input state
const keys = {};
let touchStart = null;

// Initialize canvas size
function resizeCanvas() {
  const maxWidth = window.innerWidth - 20;
  const maxHeight = window.innerHeight - 120;
  const size = Math.min(maxWidth, maxHeight, 600);
  canvas.width = size;
  canvas.height = size;
  cellSize = canvas.width / gridSize;
}
window.addEventListener('resize', resizeCanvas);
resizeCanvas();

// High score display
bestDisplay.textContent = highScore;

// Overlay helpers
function showOverlay() {
  overlay.classList.add('visible');
  // Force reflow for transition
  overlay.offsetHeight;
  overlay.classList.add('active');
}

function hideOverlay() {
  overlay.classList.remove('active');
  setTimeout(() => {
    if (!overlay.classList.contains('active')) {
      overlay.classList.remove('visible');
    }
  }, 300);
}

// --- Event Listeners ---
btnStart.addEventListener('click', () => {
  if (gameState === 'menu' || gameState === 'gameover') {
    startGame();
  } else if (gameState === 'paused') {
    resumeGame();
  }
});

btnQuit.addEventListener('click', () => {
  quitToMenu();
});

btnPause.addEventListener('click', () => {
  pauseGame();
});

document.addEventListener('keydown', (e) => {
  keys[e.code] = true;
  if (e.code === 'Escape' || e.code === 'KeyP') {
    if (gameState === 'playing') pauseGame();
    else if (gameState === 'paused') resumeGame();
  }
});

document.addEventListener('keyup', (e) => {
  keys[e.code] = false;
});

canvas.addEventListener('click', (e) => {
  const cell = getCellFromClient(e.clientX, e.clientY);
  if (cell) handleCellClick(cell);
});

canvas.addEventListener('touchstart', (e) => {
  e.preventDefault();
  const touch = e.touches[0];
  const cell = getCellFromClient(touch.clientX, touch.clientY);
  if (cell) handleCellClick(cell);
}, {passive: false});

// --- Core Game Functions ---

function startGame() {
  score = 0;
  level = 1;
  gridSize = 4;
  running = true;
  gameState = 'playing';
  hideOverlay();
  btnQuit.classList.add('hidden');
  btnStart.textContent = 'Start Game';
  overlayTitle.textContent = 'NEON PIPELINE';
  generateLevel();
  lastTime = performance.now();
  if (animationId) cancelAnimationFrame(animationId);
  animationId = requestAnimationFrame(gameLoop);
}

function pauseGame() {
  if (gameState !== 'playing') return;
  gameState = 'paused';
  running = false;
  showOverlay();
  overlayTitle.textContent = 'PAUSED';
  overlayText.textContent = `Level ${level} • Score: ${score}`;
  btnStart.textContent = 'Resume';
  btnQuit.classList.remove('hidden');
  btnQuit.textContent = 'Quit to Menu';
}

function resumeGame() {
  if (gameState !== 'paused') return;
  gameState = 'playing';
  running = true;
  hideOverlay();
  lastTime = performance.now();
  animationId = requestAnimationFrame(gameLoop);
}

function quitToMenu() {
  running = false;
  gameState = 'menu';
  if (animationId) cancelAnimationFrame(animationId);
  showOverlay();
  overlayTitle.textContent = 'NEON PIPELINE';
  overlayText.textContent = `Final Score: ${score} • Best: ${highScore}`;
  btnStart.textContent = 'Play Again';
  btnQuit.classList.add('hidden');
}

function showStartScreen() {
  quitToMenu();
}

function gameOver() {
  running = false;
  gameState = 'gameover';
  if (animationId) cancelAnimationFrame(animationId);
  if (score > highScore) {
    highScore = score;
    localStorage.setItem('neonPipelineHighScore', highScore);
    bestDisplay.textContent = highScore;
  }
  showOverlay();
  overlayTitle.textContent = 'TIME EXPIRED';
  overlayText.textContent = `Reached Level ${level} • Score: ${score}`;
  btnStart.textContent = 'Retry';
  btnQuit.classList.remove('hidden');
  btnQuit.textContent = 'Main Menu';
}

// --- Level Generation ---

function generateLevel() {
  gridSize = Math.min(4 + Math.floor((level - 1) / 3), 8);
  resizeCanvas();
  
  maxTime = Math.max(60 - (level - 1) * 3, 15);
  timeLeft = maxTime;
  timerWarning = false;
  
  grid = Array(gridSize).fill(null).map(() => Array(gridSize).fill(null).map(() => ({
    type: PIPE_TYPES.EMPTY,
    rotation: 0,
    connected: false,
    flowProgress: 0
  })));
  
  generateSolvablePath();
  fillRandomPipes();
  scrambleRotations();
  
  flowActive = false;
  flowProgress = 0;
  flowPath = [];
  
  updateUI();
}

function generateSolvablePath() {
  const edges = [];
  for (let x = 0; x < gridSize; x++) { edges.push({x, y: -1, dir: 2}); edges.push({x, y: gridSize, dir: 0}); }
  for (let y = 0; y < gridSize; y++) { edges.push({x: -1, y, dir: 1}); edges.push({x: gridSize, y, dir: 3}); }
  
  const startEdge = edges[Math.floor(Math.random() * edges.length)];
  let endEdge;
  do { endEdge = edges[Math.floor(Math.random() * edges.length)]; } while (endEdge === startEdge);
  
  startPos = {x: clamp(startEdge.x, 0, gridSize-1), y: clamp(startEdge.y, 0, gridSize-1)};
  endPos = {x: clamp(endEdge.x, 0, gridSize-1), y: clamp(endEdge.y, 0, gridSize-1)};
  
  grid[startPos.y][startPos.x].isStart = true;
  grid[startPos.y][startPos.x].requiredDir = startEdge.dir;
  grid[endPos.y][endPos.x].isEnd = true;
  grid[endPos.y][endPos.x].requiredDir = endEdge.dir;
  
  const path = findPath(startPos, endPos);
  if (!path) { generateSolvablePath(); return; }
  
  for (let i = 0; i < path.length - 1; i++) {
    const a = path[i], b = path[i+1];
    const dir = getDirection(a, b);
    const cell = grid[a.y][a.x];
    cell.type = choosePipeForConnection(cell.type, dir);
    cell.correctRotation = getRotationForConnection(cell.type, dir, cell.correctRotation);
  }
  const last = path[path.length-1];
  const prev = path[path.length-2];
  const dirToEnd = getDirection(prev, last);
  const endCell = grid[last.y][last.x];
  endCell.type = choosePipeForConnection(endCell.type, oppositeDir(dirToEnd));
  endCell.correctRotation = getRotationForConnection(endCell.type, oppositeDir(dirToEnd), endCell.correctRotation);
}

function findPath(start, end) {
  const queue = [[start]];
  const visited = new Set([`${start.x},${start.y}`]);
  const dirs = [{x:0,y:-1},{x:1,y:0},{x:0,y:1},{x:-1,y:0}];
  
  while (queue.length) {
    const path = queue.shift();
    const current = path[path.length-1];
    if (current.x === end.x && current.y === end.y) return path;
    
    for (const d of dirs) {
      const nx = current.x + d.x;
      const ny = current.y + d.y;
      if (nx < 0 || nx >= gridSize || ny < 0 || ny >= gridSize) continue;
      const key = `${nx},${ny}`;
      if (visited.has(key)) continue;
      visited.add(key);
      queue.push([...path, {x:nx, y:ny}]);
    }
  }
  return null;
}

function getDirection(a, b) {
  if (b.x === a.x + 1) return 1;
  if (b.x === a.x - 1) return 3;
  if (b.y === a.y + 1) return 2;
  if (b.y === a.y - 1) return 0;
  return -1;
}

function oppositeDir(dir) {
  return (dir + 2) % 4;
}

function choosePipeForConnection(currentType, dir) {
  if (currentType === PIPE_TYPES.EMPTY) {
    return Math.random() < 0.5 ? PIPE_TYPES.STRAIGHT : PIPE_TYPES.CORNER;
  }
  const connections = PIPE_CONNECTIONS[currentType] || [];
  if (connections.includes(dir) || connections.includes(oppositeDir(dir))) return currentType;
  
  if (currentType === PIPE_TYPES.STRAIGHT) return PIPE_TYPES.CORNER;
  if (currentType === PIPE_TYPES.CORNER) return PIPE_TYPES.T_JUNCTION;
  if (currentType === PIPE_TYPES.T_JUNCTION) return PIPE_TYPES.CROSS;
  return PIPE_TYPES.CROSS;
}

function getRotationForConnection(type, dir, currentRotation = 0) {
  const baseConnections = PIPE_CONNECTIONS[type] || [];
  for (let rot = 0; rot < 4; rot++) {
    const rotated = baseConnections.map(d => (d + rot) % 4);
    if (rotated.includes(dir)) return rot;
  }
  return currentRotation;
}

function fillRandomPipes() {
  const types = [PIPE_TYPES.STRAIGHT, PIPE_TYPES.CORNER, PIPE_TYPES.T_JUNCTION, PIPE_TYPES.CROSS];
  for (let y = 0; y < gridSize; y++) {
    for (let x = 0; x < gridSize; x++) {
      const cell = grid[y][x];
      if (cell.type === PIPE_TYPES.EMPTY && !cell.isStart && !cell.isEnd) {
        cell.type = types[Math.floor(Math.random() * types.length)];
        cell.correctRotation = Math.floor(Math.random() * 4);
      }
    }
  }
}

function scrambleRotations() {
  for (let y = 0; y < gridSize; y++) {
    for (let x = 0; x < gridSize; x++) {
      const cell = grid[y][x];
      if (cell.type !== PIPE_TYPES.EMPTY) {
        cell.rotation = Math.floor(Math.random() * 4);
      }
    }
  }
}

function updateUI() {
  scoreDisplay.textContent = score;
  levelDisplay.textContent = level;
  bestDisplay.textContent = highScore;
}

// --- Input Handling ---

function getCellFromClient(clientX, clientY) {
  const rect = canvas.getBoundingClientRect();
  const x = clientX - rect.left;
  const y = clientY - rect.top;
  if (x < 0 || x >= canvas.width || y < 0 || y >= canvas.height) return null;
  return {x: Math.floor(x / cellSize), y: Math.floor(y / cellSize)};
}

function handleCellClick(cell) {
  if (gameState !== 'playing') return;
  const gridCell = grid[cell.y][cell.x];
  if (gridCell.type === PIPE_TYPES.EMPTY || gridCell.isStart || gridCell.isEnd) return;
  gridCell.rotation = (gridCell.rotation + 1) % 4;
  checkConnections();
}

// --- Game Logic ---

function checkConnections() {
  for (let y = 0; y < gridSize; y++) {
    for (let x = 0; x < gridSize; x++) {
      grid[y][x].connected = false;
      grid[y][x].flowProgress = 0;
    }
  }
  
  const queue = [{x: startPos.x, y: startPos.y, fromDir: grid[startPos.y][startPos.x].requiredDir}];
  grid[startPos.y][startPos.x].connected = true;
  
  while (queue.length) {
    const current = queue.shift();
    const cell = grid[current.y][current.x];
    const connections = getCellConnections(cell);
    
    for (const dir of connections) {
      if (dir === current.fromDir) continue;
      const nx = current.x + (dir === 1 ? 1 : dir === 3 ? -1 : 0);
      const ny = current.y + (dir === 2 ? 1 : dir === 0 ? -1 : 0);
      if (nx < 0 || nx >= gridSize || ny < 0 || ny >= gridSize) continue;
      const neighbor = grid[ny][nx];
      const neighborConnections = getCellConnections(neighbor);
      if (neighborConnections.includes(oppositeDir(dir))) {
        if (!neighbor.connected) {
          neighbor.connected = true;
          queue.push({x: nx, y: ny, fromDir: oppositeDir(dir)});
        }
      }
    }
  }
  
  if (grid[endPos.y][endPos.x].connected) {
    activateFlow();
  }
}

function getCellConnections(cell) {
  if (cell.type === PIPE_TYPES.EMPTY) return [];
  const base = PIPE_CONNECTIONS[cell.type] || [];
  return base.map(d => (d + cell.rotation) % 4);
}

function activateFlow() {
  flowActive = true;
  flowProgress = 0;
  flowPath = [];
  
  const queue = [{x: startPos.x, y: startPos.y, fromDir: grid[startPos.y][startPos.x].requiredDir, path: []}];
  const visited = new Set();
  
  while (queue.length) {
    const current = queue.shift();
    const key = `${current.x},${current.y},${current.fromDir}`;
    if (visited.has(key)) continue;
    visited.add(key);
    
    const cell = grid[current.y][current.x];
    const connections = getCellConnections(cell);
    const newPath = [...current.path, {x: current.x, y: current.y, fromDir: current.fromDir}];
    
    if (current.x === endPos.x && current.y === endPos.y) {
      flowPath = newPath;
      break;
    }
    
    for (const dir of connections) {
      if (dir === current.fromDir) continue;
      const nx = current.x + (dir === 1 ? 1 : dir === 3 ? -1 : 0);
      const ny = current.y + (dir === 2 ? 1 : dir === 0 ? -1 : 0);
      if (nx < 0 || nx >= gridSize || ny < 0 || ny >= gridSize) continue;
      const neighbor = grid[ny][nx];
      const neighborConnections = getCellConnections(neighbor);
      if (neighborConnections.includes(oppositeDir(dir))) {
        queue.push({x: nx, y: ny, fromDir: oppositeDir(dir), path: newPath});
      }
    }
  }
}

function nextLevel() {
  level++;
  score += Math.floor(maxTime * 10) + level * 100;
  generateLevel();
}

// --- Game Loop ---

function gameLoop(timestamp) {
  if (!running) return;
  
  const dt = (timestamp - lastTime) / 1000;
  lastTime = timestamp;
  
  update(dt);
  render();
  
  animationId = requestAnimationFrame(gameLoop);
}

function update(dt) {
  if (gameState !== 'playing') return;
  
  timeLeft -= dt;
  if (timeLeft <= 0) {
    timeLeft = 0;
    gameOver();
    return;
  }
  
  if (timeLeft / maxTime < 0.3 && !timerWarning) {
    timerWarning = true;
  }
  
  updateParticles(dt);
  
  if (flowActive) {
    flowProgress += dt * 2;
    if (flowProgress >= flowPath.length) {
      flowActive = false;
      nextLevel();
    }
  }
}

function updateParticles(dt) {
  for (let i = particles.length - 1; i >= 0; i--) {
    const p = particles[i];
    p.x += p.vx * dt;
    p.y += p.vy * dt;
    p.life -= dt;
    p.alpha = p.life / p.maxLife;
    if (p.life <= 0) particles.splice(i, 1);
  }
  
  if (Math.random() < 0.02) {
    particles.push({
      x: Math.random() * canvas.width,
      y: Math.random() * canvas.height,
      vx: (Math.random() - 0.5) * 20,
      vy: (Math.random() - 0.5) * 20,
      size: Math.random() * 2 + 1,
      color: Math.random() < 0.5 ? '#00ffff' : '#ff00ff',
      life: Math.random() * 2 + 1,
      maxLife: 0,
      alpha: 1
    });
    particles[particles.length-1].maxLife = particles[particles.length-1].life;
  }
}

// --- Rendering ---

function render() {
  ctx.fillStyle = COLORS.bg;
  ctx.fillRect(0, 0, canvas.width, canvas.height);
  
  drawGrid();
  drawPipes();
  drawStartEnd();
  drawFlow();
  draw