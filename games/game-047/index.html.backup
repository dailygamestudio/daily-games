<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no">
<title>Neon Pipeline - Day 47</title>
<style>
  * { margin: 0; padding: 0; box-sizing: border-box; }
  body { background: #0a0a12; color: #00ffff; font-family: 'Courier New', monospace; overflow: hidden; touch-action: none; }
  canvas { display: block; margin: 0 auto; background: #05050a; box-shadow: 0 0 30px rgba(0,255,255,0.2), inset 0 0 60px rgba(0,20,30,0.5); position: absolute; }
  #ui { position: fixed; top: 10px; left: 10px; right: 10px; display: flex; justify-content: space-between; pointer-events: none; z-index: 10; }
  .panel { background: rgba(0,10,20,0.8); border: 1px solid #00ffff44; border-radius: 8px; padding: 8px 16px; backdrop-filter: blur(4px); text-shadow: 0 0 5px #00ffff; }
  .panel h3 { font-size: 14px; font-weight: normal; color: #00ffaa; margin-bottom: 4px; text-transform: uppercase; letter-spacing: 2px; }
  .panel .value { font-size: 20px; font-weight: bold; color: #00ffff; }
  #overlay, #pauseOverlay, #gameOverOverlay { position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.9); display: flex; flex-direction: column; align-items: center; justify-content: center; z-index: 100; backdrop-filter: blur(8px); }
  #overlay.hidden, #pauseOverlay.hidden, #gameOverOverlay.hidden { display: none !important; }
  .overlay-content { text-align: center; max-width: 90%; }
  .overlay-content h1 { font-size: clamp(2rem, 8vw, 4rem); color: #00ffff; text-shadow: 0 0 20px #00ffff, 0 0 40px #00ffff; margin-bottom: 1rem; letter-spacing: 4px; }
  .overlay-content p { color: #00ffaa; font-size: 1.2rem; margin-bottom: 2rem; text-shadow: 0 0 10px #00ffaa; }
  .btn { background: transparent; border: 2px solid #00ffff; color: #00ffff; padding: 12px 32px; font-size: 1.1rem; font-family: inherit; text-transform: uppercase; letter-spacing: 2px; cursor: pointer; transition: all 0.3s; text-shadow: 0 0 5px #00ffff; box-shadow: 0 0 10px rgba(0,255,255,0.3); }
  .btn:hover, .btn:focus { background: #00ffff; color: #0a0a12; box-shadow: 0 0 30px #00ffff; outline: none; }
  .btn:active { transform: scale(0.95); }
  .btn-group { display: flex; gap: 1rem; flex-wrap: wrap; justify-content: center; }
  @media (max-width: 600px) { .btn { padding: 10px 24px; font-size: 1rem; } }
</style>
</head>
<body>
<canvas id="gameCanvas"></canvas>
<div id="ui">
  <div class="panel"><h3>Score</h3><div class="value" id="score">0</div></div>
  <div class="panel"><h3>Level</h3><div class="value" id="level">1</div></div>
  <div class="panel"><h3>High Score</h3><div class="value" id="highScore">0</div></div>
</div>

<div id="overlay">
  <div class="overlay-content">
    <h1>NEON PIPELINE</h1>
    <p>Connect the flow. Rotate pipes to complete the circuit.</p>
    <div class="btn-group">
      <button class="btn" id="startBtn">START GAME</button>
    </div>
  </div>
</div>

<div id="pauseOverlay" class="hidden">
  <div class="overlay-content">
    <h1>PAUSED</h1>
    <div class="btn-group">
      <button class="btn" id="resumeBtn">RESUME</button>
      <button class="btn" id="quitPauseBtn">QUIT TO MENU</button>
    </div>
  </div>
</div>

<div id="gameOverOverlay" class="hidden">
  <div class="overlay-content">
    <h1>GAME OVER</h1>
    <p>Final Score: <span id="finalScore">0</span></p>
    <div class="btn-group">
      <button class="btn" id="retryBtn">RETRY</button>
      <button class="btn" id="mainMenuBtn">MAIN MENU</button>
    </div>
  </div>
</div>

<script>
const canvas = document.getElementById('gameCanvas');
const ctx = canvas.getContext('2d');
const scoreEl = document.getElementById('score');
const levelEl = document.getElementById('level');
const highScoreEl = document.getElementById('highScore');
const finalScoreEl = document.getElementById('finalScore');
const overlay = document.getElementById('overlay');
const pauseOverlay = document.getElementById('pauseOverlay');
const gameOverOverlay = document.getElementById('gameOverOverlay');
const startBtn = document.getElementById('startBtn');
const resumeBtn = document.getElementById('resumeBtn');
const quitPauseBtn = document.getElementById('quitPauseBtn');
const retryBtn = document.getElementById('retryBtn');
const mainMenuBtn = document.getElementById('mainMenuBtn');

let width, height, cellSize, gridSize, offsetX, offsetY;
let pipes = [];
let score = 0, level = 1, highScore = 0;
let gameState = 'menu';
let animationId = null;
let flowProgress = 0;
let flowPath = [];
let isFlowing = false;
let flowSpeed = 0.02;
let lastTime = 0;

const PIPE_TYPES = {
  straight: { connections: [0,2], color: '#00ffff' },
  corner: { connections: [0,1], color: '#00ffaa' },
  t_junction: { connections: [0,1,2], color: '#ffaa00' },
  cross: { connections: [0,1,2,3], color: '#ff00aa' }
};
const DIRS = [[0,-1],[1,0],[0,1],[-1,0]];

function resize() {
  const maxWidth = window.innerWidth - 20;
  const maxHeight = window.innerHeight - 120;
  const size = Math.min(maxWidth, maxHeight);
  gridSize = 5 + level;
  if (gridSize > 10) gridSize = 10;
  cellSize = Math.max(20, Math.floor(size / gridSize));
  width = cellSize * gridSize;
  height = cellSize * gridSize;
  canvas.width = width;
  canvas.height = height;
  offsetX = (window.innerWidth - width) / 2;
  offsetY = (window.innerHeight - height) / 2 + 60;
  canvas.style.left = offsetX + 'px';
  canvas.style.top = offsetY + 'px';
}

function generateLevel() {
  pipes = [];
  for (let y = 0; y < gridSize; y++) {
    pipes[y] = [];
    for (let x = 0; x < gridSize; x++) {
      const types = Object.keys(PIPE_TYPES);
      const type = types[Math.floor(Math.random() * types.length)];
      const rotation = Math.floor(Math.random() * 4);
      pipes[y][x] = { type, rotation, x, y };
    }
  }
  pipes[0][0] = { type: 'straight', rotation: 1, x: 0, y: 0 };
  pipes[gridSize-1][gridSize-1] = { type: 'straight', rotation: 1, x: gridSize-1, y: gridSize-1 };
}

function getConnections(pipe) {
  const base = PIPE_TYPES[pipe.type].connections;
  return base.map(d => (d + pipe.rotation) % 4);
}

function hasConnection(pipe, dir) {
  return getConnections(pipe).includes(dir);
}

function rotatePipe(x, y) {
  if (gameState !== 'playing') return;
  const pipe = pipes[y][x];
  pipe.rotation = (pipe.rotation + 1) % 4;
  checkFlow();
}

function checkFlow() {
  const visited = Array(gridSize).fill().map(() => Array(gridSize).fill(false));
  const queue = [{x:0, y:0, path:[]}];
  visited[0][0] = true;
  
  while (queue.length) {
    const {x, y, path} = queue.shift();
    if (x === gridSize-1 && y === gridSize-1) {
      flowPath = path.concat({x,y});
      triggerFlow();
      return;
    }
    const pipe = pipes[y][x];
    const conns = getConnections(pipe);
    for (const dir of conns) {
      const nx = x + DIRS[dir][0];
      const ny = y + DIRS[dir][1];
      if (nx >= 0 && nx < gridSize && ny >= 0 && ny < gridSize && !visited[ny][nx]) {
        const nPipe = pipes[ny][nx];
        const oppDir = (dir + 2) % 4;
        if (hasConnection(nPipe, oppDir)) {
          visited[ny][nx] = true;
          queue.push({x:nx, y:ny, path: path.concat({x,y})});
        }
      }
    }
  }
  flowPath = [];
}

function triggerFlow() {
  isFlowing = true;
  flowProgress = 0;
}

function completeLevel() {
  score += 100 * level;
  level++;
  scoreEl.textContent = score;
  levelEl.textContent = level;
  if (score > highScore) {
    highScore = score;
    highScoreEl.textContent = highScore;
    localStorage.setItem('neonPipelineHighScore', highScore);
  }
  generateLevel();
  checkFlow();
}

function gameOver() {
  gameState = 'gameover';
  finalScoreEl.textContent = score;
  gameOverOverlay.classList.remove('hidden');
  cancelAnimationFrame(animationId);
}

function startGame() {
  overlay.classList.add('hidden');
  pauseOverlay.classList.add('hidden');
  gameOverOverlay.classList.add('hidden');
  
  score = 0;
  level = 1;
  scoreEl.textContent = score;
  levelEl.textContent = level;
  highScore = parseInt(localStorage.getItem('neonPipelineHighScore')) || 0;
  highScoreEl.textContent = highScore;
  
  resize();
  generateLevel();
  checkFlow();
  
  gameState = 'playing';
  lastTime = performance.now();
  animationId = requestAnimationFrame(gameLoop);
}

function pauseGame() {
  if (gameState !== 'playing') return;
  gameState = 'paused';
  pauseOverlay.classList.remove('hidden');
  cancelAnimationFrame(animationId);
}

function resumeGame() {
  if (gameState !== 'paused') return;
  gameState = 'playing';
  pauseOverlay.classList.add('hidden');
  lastTime = performance.now();
  animationId = requestAnimationFrame(gameLoop);
}

function quitToMenu() {
  gameState = 'menu';
  pauseOverlay.classList.add('hidden');
  overlay.classList.remove('hidden');
  cancelAnimationFrame(animationId);
}

function showStartScreen() {
  gameState = 'menu';
  gameOverOverlay.classList.add('hidden');
  overlay.classList.remove('hidden');
}

function gameLoop(timestamp) {
  if (gameState !== 'playing') return;
  const dt = timestamp - lastTime;
  lastTime = timestamp;
  
  update(dt);
  draw();
  
  animationId = requestAnimationFrame(gameLoop);
}

function update(dt) {
  if (isFlowing) {
    flowProgress += flowSpeed * dt;
    if (flowProgress >= 1) {
      flowProgress = 0;
      isFlowing = false;
      completeLevel();
    }
  }
}

function draw() {
  ctx.fillStyle = '#05050a';
  ctx.fillRect(0, 0, width, height);
  
  ctx.strokeStyle = '#00ffff11';
  ctx.lineWidth = 1;
  for (let i = 0; i <= gridSize; i++) {
    ctx.beginPath();
    ctx.moveTo(i * cellSize, 0);
    ctx.lineTo(i * cellSize, height);
    ctx.stroke();
    ctx.beginPath();
    ctx.moveTo(0, i * cellSize);
    ctx.lineTo(width, i * cellSize);
    ctx.stroke();
  }
  
  for (let y = 0; y < gridSize; y++) {
    for (let x = 0; x < gridSize; x++) {
      drawPipe(pipes[y][x]);
    }
  }
  
  if (isFlowing && flowPath.length > 0) {
    drawFlow();
  }
  
  drawMarker(0, 0, '#00ff00', 'START');
  drawMarker(gridSize-1, gridSize-1, '#ff0000', 'END');
}

function drawPipe(pipe) {
  const cx = pipe.x * cellSize + cellSize / 2;
  const cy = pipe.y * cellSize + cellSize / 2;
  const radius = cellSize * 0.35;
  const color = PIPE_TYPES[pipe.type].color;
  
  ctx.save();
  ctx.translate(cx, cy);
  ctx.rotate((pipe.rotation * Math.PI) / 2);
  
  ctx.strokeStyle = color;
  ctx.lineWidth = Math.max(2, cellSize * 0.15);
  ctx.lineCap = 'round';
  ctx.shadowColor = color;
  ctx.shadowBlur = 10;
  
  const baseConns = PIPE_TYPES[pipe.type].connections;
  for (const dir of baseConns) {
    const angle = (dir * Math.PI) / 2;
    const x1 = 0;
    const y1 = 0;
    const x2 = Math.cos(angle) * radius;
    const y2 = Math.sin(angle) * radius;
    ctx.beginPath();
    ctx.moveTo(x1, y1);
    ctx.lineTo(x2, y2);
    ctx.stroke();
  }
  
  ctx.fillStyle = color;
  ctx.beginPath();
  ctx.arc(0, 0, Math.max(3, cellSize * 0.08), 0, Math.PI * 2);
  ctx.fill();
  
  ctx.restore();
}

function drawFlow() {
  if (flowPath.length < 2) return;
  
  const totalSegments = flowPath.length - 1;
  const segmentProgress = flowProgress * totalSegments;
  const currentSegment = Math.floor(segmentProgress);
  const segmentT = segmentProgress - currentSegment;
  
  if (currentSegment >= totalSegments) return;
  
  const p1 = flowPath[currentSegment];
  const p2 = flowPath[currentSegment + 1];
  
  const x1 = p1.x * cellSize + cellSize / 2;
  const y1 = p1.y * cellSize + cellSize / 2;
  const x2 = p2.x * cellSize + cellSize / 2;
  const y2 = p2.y * cellSize + cellSize / 2;
  
  const cx = x1 + (x2 - x1) * segmentT;
  const cy = y1 + (y2 - y1) * segmentT;
  
  ctx.fillStyle = '#ffffff';
  ctx.shadowColor = '#00ffff';
  ctx.shadowBlur = 20;
  ctx.beginPath();
  ctx.arc(cx, cy, Math.max(4, cellSize * 0.12), 0, Math.PI * 2);
  ctx.fill();
  
  const trailLength = 0.3;
  const trailStart = Math.max(0, segmentProgress - trailLength);
  const trailSegments = Math.floor(trailStart);
  const trailT = trailStart - trailSegments;
  
  ctx.strokeStyle = '#00ffff88';
  ctx.lineWidth = Math.max(2, cellSize * 0.1);
  ctx.lineCap = 'round';
  ctx.shadowBlur = 15;
  
  ctx.beginPath();
  let first = true;
  for (let i = trailSegments; i <= currentSegment; i++) {
    if (i >= flowPath.length - 1) break;
    const sp1 = flowPath[i];
    const sp2 = flowPath[i + 1];
    const sx1 = sp1.x * cellSize + cellSize / 2;
    const sy1 = sp1.y * cellSize + cellSize / 2;
    const sx2 = sp2.x * cellSize + cellSize / 2;
    const sy2 = sp2.y * cellSize + cellSize / 2;
    
    if (first) {
      if (i === trailSegments) {
        const tx = sx1 + (sx2 - sx1) * trailT;
        const ty = sy1 + (sy2 - sy1) * trailT;
        ctx.moveTo(tx, ty);
      } else {
        ctx.moveTo(sx1, sy1);
      }
      first = false;
    }
    
    if (i === currentSegment) {
      ctx.lineTo(cx, cy);
    } else {
      ctx.lineTo(sx2, sy2);
    }
  }
  ctx.stroke();
}

function drawMarker(x, y, color, label) {
  const cx = x * cellSize + cellSize / 2;
  const cy = y * cellSize + cellSize / 2;
  const r = cellSize * 0.4;
  
  ctx.strokeStyle = color;
  ctx.lineWidth = 3;
  ctx.shadowColor = color;
  ctx.shadowBlur = 15;
  ctx.beginPath();
  ctx.arc(cx, cy, r, 0, Math.PI * 2);
  ctx.stroke();
  
  ctx.fillStyle = color;
  ctx.font = `${Math.max(10, cellSize * 0.15)}px Courier New`;
  ctx.textAlign = 'center';
  ctx.textBaseline = 'middle';
  ctx.fillText(label, cx, cy);
}

startBtn.addEventListener('click', startGame);
resumeBtn.addEventListener('click', resumeGame);
quitPauseBtn.addEventListener('click', quitToMenu);
retryBtn.addEventListener('click', startGame);
mainMenuBtn.addEventListener('click', showStartScreen);

window.addEventListener('resize', resize);

canvas.addEventListener('click', (e) => {
  if (gameState !== 'playing') return;
  const rect = canvas.getBoundingClientRect();
  const x = Math.floor((e.clientX - rect.left) / cellSize);
  const y = Math.floor((e.clientY - rect.top) / cellSize);
  if (x >= 0 && x < gridSize && y >= 0 && y < gridSize) {
    rotatePipe(x, y);
  }
});

canvas.addEventListener('touchstart', (e) => {
  if (gameState !== 'playing') return;
  e.preventDefault();
  const touch = e.touches[0];
  const rect = canvas.getBoundingClientRect();
  const x = Math.floor((touch.clientX - rect.left) / cellSize);
  const y = Math.floor((touch.clientY - rect.top) / cellSize);
  if (x >= 0 && x < gridSize && y >= 0 && y < gridSize) {
    rotatePipe(x, y);
  }
}, { passive: false });

document.addEventListener('keydown', (e) => {
  if (e.key === 'Escape' || e.key === 'p' || e.key === 'P') {
    if (gameState === 'playing') pauseGame();
    else if (gameState === 'paused') resumeGame();
  }
});

highScore = parseInt(localStorage.getItem('neonPipelineHighScore')) || 0;
highScoreEl.textContent = highScore;
resize();
</script>
</body>
</html>