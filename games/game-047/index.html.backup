<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no">
<title>Neon Pipeline - Day 47</title>
<style>
  * { margin: 0; padding: 0; box-sizing: border-box; }
  body { background: #0a0a12; color: #00ffff; font-family: 'Courier New', monospace; overflow: hidden; touch-action: none; }
  canvas { display: block; margin: 0 auto; background: #05050a; box-shadow: 0 0 30px rgba(0,255,255,0.2), inset 0 0 60px rgba(0,20,30,0.5); }
  #ui { position: fixed; top: 10px; left: 10px; right: 10px; display: flex; justify-content: space-between; pointer-events: none; z-index: 10; }
  .panel { background: rgba(0,10,20,0.8); border: 1px solid #00ffff44; border-radius: 8px; padding: 8px 16px; backdrop-filter: blur(4px); text-shadow: 0 0 5px #00ffff; }
  .panel h3 { font-size: 14px; font-weight: normal; color: #00ffaa; margin-bottom: 4px; text-transform: uppercase; letter-spacing: 2px; }
  .panel .value { font-size: 20px; font-weight: bold; color: #00ffff; }
  #overlay { position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,5,0.95); display: flex; flex-direction: column; align-items: center; justify-content: center; z-index: 100; opacity: 0; pointer-events: none; transition: opacity 0.3s; display: none; }
  #overlay.visible { opacity: 1; pointer-events: auto; display: flex; }
  #overlay h1 { font-size: clamp(28px, 8vw, 48px); margin-bottom: 10px; text-shadow: 0 0 20px #00ffff, 0 0 40px #0088ff; background: linear-gradient(90deg, #00ffff, #0088ff, #ff00ff); -webkit-background-clip: text; -webkit-text-fill-color: transparent; animation: pulse 2s infinite; }
  @keyframes pulse { 0%,100% { filter: brightness(1); } 50% { filter: brightness(1.5); } }
  #overlay p { color: #88ffcc; margin-bottom: 30px; font-size: 16px; letter-spacing: 1px; }
  .btn { background: linear-gradient(135deg, #003344, #001122); border: 2px solid #00ffff; color: #00ffff; padding: 14px 40px; font-size: 16px; font-family: inherit; border-radius: 4px; cursor: pointer; margin: 8px; text-transform: uppercase; letter-spacing: 2px; transition: all 0.2s; box-shadow: 0 0 10px rgba(0,255,255,0.3); }
  .btn:hover { background: linear-gradient(135deg, #005566, #002233); box-shadow: 0 0 20px rgba(0,255,255,0.6), 0 0 30px rgba(0,255,255,0.4); transform: scale(1.05); }
  .btn:active { transform: scale(0.98); }
  .btn.secondary { border-color: #ff00ff; color: #ff00ff; box-shadow: 0 0 10px rgba(255,0,255,0.3); }
  .btn.secondary:hover { background: linear-gradient(135deg, #330033, #110011); box-shadow: 0 0 20px rgba(255,0,255,0.6), 0 0 30px rgba(255,0,255,0.4); }
  #touchControls { position: fixed; bottom: 20px; left: 50%; transform: translateX(-50%); display: none; gap: 10px; z-index: 20; }
  .touchBtn { width: 60px; height: 60px; background: rgba(0,20,30,0.8); border: 2px solid #00ffff; border-radius: 50%; display: flex; align-items: center; justify-content: center; color: #00ffff; font-size: 24px; touch-action: manipulation; }
  .touchBtn:active { background: rgba(0,255,255,0.3); }
  @media (max-width: 768px) { #touchControls { display: flex; } }
  #pauseOverlay, #gameOverOverlay { position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,5,0.95); z-index: 100; display: none; flex-direction: column; align-items: center; justify-content: center; }
</style>
</head>
<body>
<canvas id="gameCanvas"></canvas>
<div id="ui">
  <div class="panel"><h3>Score</h3><div class="value" id="score">0</div></div>
  <div class="panel"><h3>Level</h3><div class="value" id="level">1</div></div>
  <div class="panel"><h3>Time</h3><div class="value" id="timer">60</div></div>
  <div class="panel"><h3>High Score</h3><div class="value" id="highScore">0</div></div>
</div>
<div id="overlay">
  <h1>NEON PIPELINE</h1>
  <p>Connect the flow before time runs out</p>
  <button class="btn" id="startBtn">START GAME</button>
  <button class="btn secondary" id="quitBtn">QUIT TO MENU</button>
</div>
<div id="pauseOverlay">
  <h1 style="color:#00ffff; text-shadow:0 0 20px #00ffff;">PAUSED</h1>
  <button class="btn" id="resumeBtn">RESUME</button>
  <button class="btn secondary" id="pauseQuitBtn">QUIT TO MENU</button>
</div>
<div id="gameOverOverlay">
  <h1 style="color:#ff0066; text-shadow:0 0 20px #ff0066;">GAME OVER</h1>
  <p id="finalScore" style="color:#00ffff; font-size:24px; margin-bottom:20px;">Score: 0</p>
  <button class="btn" id="retryBtn">RETRY</button>
  <button class="btn secondary" id="menuBtn">MAIN MENU</button>
</div>
<div id="touchControls">
  <button class="touchBtn" id="touchUp">▲</button>
  <button class="touchBtn" id="touchDown">▼</button>
  <button class="touchBtn" id="touchLeft">◄</button>
  <button class="touchBtn" id="touchRight">►</button>
  <button class="touchBtn" id="touchRotate">⟳</button>
</div>
<script>
const canvas = document.getElementById('gameCanvas');
const ctx = canvas.getContext('2d');
let width, height, cellSize, cols, rows;
let grid = [];
let score = 0, level = 1, timeLeft = 60, highScore = 0;
let gameState = 'menu';
let animationId = null;
let lastTime = 0;
let flowProgress = 0;
let flowActive = false;
let selectedCell = null;

const PIPE_TYPES = {
  empty: 0,
  straight: 1,
  corner: 2,
  tshape: 3,
  cross: 4,
  start: 5,
  end: 6
};

const PIPE_CONNECTIONS = {
  [PIPE_TYPES.straight]: [0, 2],
  [PIPE_TYPES.corner]: [0, 1],
  [PIPE_TYPES.tshape]: [0, 1, 3],
  [PIPE_TYPES.cross]: [0, 1, 2, 3],
  [PIPE_TYPES.start]: [1],
  [PIPE_TYPES.end]: [3]
};

function resize() {
  width = window.innerWidth;
  height = window.innerHeight - 80;
  canvas.width = width;
  canvas.height = height;
  cellSize = Math.min(width / 12, height / 8);
  cols = Math.floor(width / cellSize);
  rows = Math.floor(height / cellSize);
  if (gameState === 'playing') generateLevel();
}
window.addEventListener('resize', resize);

function generateLevel() {
  grid = [];
  for (let y = 0; y < rows; y++) {
    grid[y] = [];
    for (let x = 0; x < cols; x++) {
      grid[y][x] = { type: PIPE_TYPES.empty, rotation: 0, fixed: false };
    }
  }
  const startY = Math.floor(rows / 2);
  grid[startY][0] = { type: PIPE_TYPES.start, rotation: 0, fixed: true };
  grid[startY][cols - 1] = { type: PIPE_TYPES.end, rotation: 0, fixed: true };
  const pipeTypes = [PIPE_TYPES.straight, PIPE_TYPES.corner, PIPE_TYPES.tshape, PIPE_TYPES.cross];
  for (let y = 0; y < rows; y++) {
    for (let x = 0; x < cols; x++) {
      if (grid[y][x].type === PIPE_TYPES.empty) {
        grid[y][x] = {
          type: pipeTypes[Math.floor(Math.random() * pipeTypes.length)],
          rotation: Math.floor(Math.random() * 4) * 90,
          fixed: false
        };
      }
    }
  }
  flowProgress = 0;
  flowActive = false;
  selectedCell = null;
}

function rotatePipe(x, y) {
  if (grid[y][x].fixed) return;
  grid[y][x].rotation = (grid[y][x].rotation + 90) % 360;
}

function getConnections(type, rotation) {
  const base = PIPE_CONNECTIONS[type] || [];
  const rotSteps = rotation / 90;
  return base.map(dir => (dir + rotSteps) % 4);
}

function checkConnection(x1, y1, x2, y2, dir) {
  if (x2 < 0 || x2 >= cols || y2 < 0 || y2 >= rows) return false;
  const c1 = getConnections(grid[y1][x1].type, grid[y1][x1].rotation);
  const c2 = getConnections(grid[y2][x2].type, grid[y2][x2].rotation);
  const opposite = (dir + 2) % 4;
  return c1.includes(dir) && c2.includes(opposite);
}

function traceFlow() {
  const startY = Math.floor(rows / 2);
  let x = 0, y = startY, dir = 1;
  const path = [{x, y}];
  const visited = new Set();
  visited.add(`${x},${y},${dir}`);
  let steps = 0;
  while (steps < cols * rows * 2) {
    const conn = getConnections(grid[y][x].type, grid[y][x].rotation);
    if (!conn.includes(dir)) break;
    let nx = x, ny = y;
    if (dir === 0) ny--;
    else if (dir === 1) nx++;
    else if (dir === 2) ny++;
    else if (dir === 3) nx--;
    if (nx < 0 || nx >= cols || ny < 0 || ny >= rows) break;
    const nConn = getConnections(grid[ny][nx].type, grid[ny][nx].rotation);
    const opp = (dir + 2) % 4;
    if (!nConn.includes(opp)) break;
    x = nx; y = ny;
    path.push({x, y});
    if (grid[y][x].type === PIPE_TYPES.end) return path;
    const nextDirs = nConn.filter(d => d !== opp);
    if (nextDirs.length === 0) break;
    dir = nextDirs[0];
    if (visited.has(`${x},${y},${dir}`)) break;
    visited.add(`${x},${y},${dir}`);
    steps++;
  }
  return null;
}

function updateFlow(dt) {
  if (!flowActive) return;
  flowProgress += dt * 2;
  const path = traceFlow();
  if (path && flowProgress >= path.length - 1) {
    score += 100 * level + Math.max(0, timeLeft) * 10;
    level++;
    timeLeft = Math.max(30, 60 - level