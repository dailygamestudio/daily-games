<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no">
    <title>Neon Tron - Day 54</title>
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body { 
            background: #0a0a1a; 
            font-family: 'Orbitron', 'Courier New', monospace; 
            color: #00ffff; 
            overflow: hidden; 
            height: 100vh; 
            display: flex; 
            justify-content: center; 
            align-items: center; 
        }
        #gameContainer { position: relative; width: 100%; max-width: 800px; aspect-ratio: 4/3; }
        canvas { 
            display: block; 
            width: 100%; 
            height: 100%; 
            background: #050510; 
            border: 2px solid #00ffff; 
            box-shadow: 0 0 20px #00ffff, inset 0 0 20px #00ffff; 
            border-radius: 4px; 
        }
        .overlay { 
            position: absolute; 
            top: 0; 
            left: 0; 
            width: 100%; 
            height: 100%; 
            background: rgba(5, 5, 20, 0.95); 
            display: flex; 
            flex-direction: column; 
            justify-content: center; 
            align-items: center; 
            z-index: 10; 
            border-radius: 4px; 
            border: 2px solid #00ffff; 
            box-shadow: 0 0 30px #00ffff; 
        }
        .overlay.hidden { display: none !important; }
        h1 { 
            font-size: 3rem; 
            text-shadow: 0 0 10px #00ffff, 0 0 20px #00ffff; 
            margin-bottom: 1rem; 
            letter-spacing: 0.2em; 
        }
        h2 { font-size: 2rem; text-shadow: 0 0 10px #ff00ff; margin-bottom: 1rem; }
        p { font-size: 1.2rem; margin: 0.5rem 0; opacity: 0.8; }
        .score-display { font-size: 1.5rem; color: #ffff00; text-shadow: 0 0 10px #ffff00; }
        button { 
            background: linear-gradient(45deg, #001122, #003344); 
            border: 2px solid #00ffff; 
            color: #00ffff; 
            padding: 1rem 2.5rem; 
            font-size: 1.2rem; 
            font-family: inherit; 
            cursor: pointer; 
            margin: 0.5rem; 
            text-transform: uppercase; 
            letter-spacing: 0.1em; 
            transition: all 0.3s; 
            box-shadow: 0 0 10px #00ffff; 
            border-radius: 2px; 
        }
        button:hover, button:focus { 
            background: linear-gradient(45deg, #00ffff, #0088ff); 
            color: #000; 
            box-shadow: 0 0 20px #00ffff, 0 0 40px #00ffff; 
            transform: scale(1.05); 
        }
        .controls-hint { font-size: 0.9rem; opacity: 0.6; margin-top: 1rem; line-height: 1.8; }
        #hud { 
            position: absolute; 
            top: 10px; 
            left: 10px; 
            z-index: 5; 
            display: flex; 
            gap: 2rem; 
            font-size: 1.2rem; 
            text-shadow: 0 0 5px #00ffff; 
        }
        #hud span { background: rgba(0,0,0,0.7); padding: 0.3rem 0.8rem; border: 1px solid #00ffff; border-radius: 2px; }
    </style>
    <link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@400;700;900&display=swap" rel="stylesheet">
</head>
<body>
    <div id="gameContainer">
        <canvas id="gameCanvas"></canvas>
        <div id="hud">
            <span>SCORE: <span id="score">0</span></span>
            <span>HI-SCORE: <span id="highScore">0</span></span>
        </div>
        
        <div id="startScreen" class="overlay">
            <h1>NEON TRON</h1>
            <p>Survive the Grid</p>
            <button id="startBtn">START GAME</button>
            <div class="controls-hint">
                <p>ARROWS / WASD: Move</p>
                <p>ESC / P: Pause</p>
                <p>Swipe on Mobile</p>
            </div>
        </div>
        
        <div id="pauseOverlay" class="overlay hidden">
            <h2>PAUSED</h2>
            <button id="resumeBtn">RESUME</button>
            <button id="quitPauseBtn">QUIT TO MENU</button>
        </div>
        
        <div id="gameOverOverlay" class="overlay hidden">
            <h2>GAME OVER</h2>
            <p class="score-display">Final Score: <span id="finalScore">0</span></p>
            <button id="retryBtn">RETRY</button>
            <button id="mainMenuBtn">MAIN MENU</button>
        </div>
    </div>

    <script>
        const canvas = document.getElementById('gameCanvas');
        const ctx = canvas.getContext('2d');
        
        // Game state
        let gameState = 'start'; // start, playing, paused, gameover
        let score = 0;
        let highScore = parseInt(localStorage.getItem('tronHighScore')) || 0;
        let animationId = null;
        let lastTime = 0;
        let gameSpeed = 120; // ms per move
        let speedIncreaseInterval = 5000; // ms
        let lastSpeedIncrease = 0;
        let accumulatedTime = 0;
        
        // Grid settings
        const GRID_SIZE = 20;
        let cols = 0;
        let rows = 0;
        
        // Player
        let player = null;
        
        // Trails - using a grid for collision detection
        let grid = [];
        
        // Input
        const keys = {};
        let touchStartX = 0;
        let touchStartY = 0;
        let nextDirection = null;
        
        // DOM elements
        const startScreen = document.getElementById('startScreen');
        const pauseOverlay = document.getElementById('pauseOverlay');
        const gameOverOverlay = document.getElementById('gameOverOverlay');
        const scoreEl = document.getElementById('score');
        const highScoreEl = document.getElementById('highScore');
        const finalScoreEl = document.getElementById('finalScore');
        
        // Initialize
        function init() {
            resizeCanvas();
            window.addEventListener('resize', resizeCanvas);
            setupEventListeners();
            updateHighScoreDisplay();
            showStartScreen();
        }
        
        function resizeCanvas() {
            const container = document.getElementById('gameContainer');
            const rect = container.getBoundingClientRect();
            canvas.width = rect.width;
            canvas.height = rect.height;
            cols = Math.max(1, Math.floor(canvas.width / GRID_SIZE));
            rows = Math.max(1, Math.floor(canvas.height / GRID_SIZE));
            // Reinitialize grid if game is running
            if (gameState === 'playing' || gameState === 'paused') {
                initGrid();
            }
        }
        
        function initGrid() {
            grid = [];
            for (let i = 0; i < cols; i++) {
                grid[i] = new Array(rows).fill(0);
            }
            // Restore player trail to grid if player exists and has trail
            if (player && Array.isArray(player.trail)) {
                for (const segment of player.trail) {
                    if (segment.x >= 0 && segment.x < cols && segment.y >= 0 && segment.y < rows) {
                        grid[segment.x][segment.y] = 1;
                    }
                }
            }
        }
        
        function setupEventListeners() {
            // Keyboard
            document.addEventListener('keydown', (e) => {
                keys[e.code] = true;
                handleKeyPress(e.code);
                if (e.code === 'Escape' || e.code === 'KeyP') {
                    e.preventDefault();
                    if (gameState === 'playing') pauseGame();
                    else if (gameState === 'paused') resumeGame();
                }
            });
            document.addEventListener('keyup', (e) => {
                keys[e.code] = false;
            });
            
            // Touch
            canvas.addEventListener('touchstart', (e) => {
                if (e.touches.length > 0) {
                    touchStartX = e.touches[0].clientX;
                    touchStartY = e.touches[0].clientY;
                }
            }, { passive: false });
            
            canvas.addEventListener('touchend', (e) => {
                if (gameState !== 'playing') return;
                if (e.changedTouches.length === 0) return;
                const touchEndX = e.changedTouches[0].clientX;
                const touchEndY = e.changedTouches[0].clientY;
                const dx = touchEndX - touchStartX;
                const dy = touchEndY - touchStartY;
                
                if (Math.abs(dx) > Math.abs(dy)) {
                    if (dx > 30) nextDirection = { x: 1, y: 0 };
                    else if (dx < -30) nextDirection = { x: -1, y: 0 };
                } else {
                    if (dy > 30) nextDirection = { x: 0, y: 1 };
                    else if (dy < -30) nextDirection = { x: 0, y: -1 };
                }
            }, { passive: false });
            
            // Buttons
            document.getElementById('startBtn').addEventListener('click', startGame);
            document.getElementById('resumeBtn').addEventListener('click', resumeGame);
            document.getElementById('quitPauseBtn').addEventListener('click', quitToMenu);
            document.getElementById('retryBtn').addEventListener('click', startGame);
            document.getElementById('mainMenuBtn').addEventListener('click', quitToMenu);
        }
        
        function handleKeyPress(code) {
            if (gameState !== 'playing') return;
            const dir = { x: 0, y: 0 };
            switch (code) {
                case 'ArrowUp': case 'KeyW': dir.x = 0; dir.y = -1; break;
                case 'ArrowDown': case 'KeyS': dir.x = 0; dir.y = 1; break;
                case 'ArrowLeft': case 'KeyA': dir.x = -1; dir.y = 0; break;
                case 'ArrowRight': case 'KeyD': dir.x = 1; dir.y = 0; break;
            }
            // Prevent 180-degree turns
            if (player && (dir.x !== 0 || dir.y !== 0)) {
                if (!(dir.x === -player.dx && dir.y === -player.dy)) {
                    nextDirection = dir;
                }
            }
        }
        
        function updateHighScoreDisplay() {
            highScoreEl.textContent = highScore;
        }
        
        function showStartScreen() {
            gameState = 'start';
            startScreen.classList.remove('hidden');
            pauseOverlay.classList.add('hidden');
            gameOverOverlay.classList.add('hidden');
            if (animationId) {
                cancelAnimationFrame(animationId);
                animationId = null;
            }
        }
        
        function startGame() {
            // Reset game state
            score = 0;
            gameSpeed = 120;
            lastSpeedIncrease = 0;
            accumulatedTime = 0;
            lastTime = 0;
            nextDirection = null;
            
            // Initialize player at center
            const startX = Math.floor(cols / 2);
            const startY = Math.floor(rows / 2);
            // Random initial direction
            const dirs = [{x:1,y:0}, {x:-1,y:0}, {x:0,y:1}, {x:0,y:-1}];
            const initialDir = dirs[Math.floor(Math.random() * dirs.length)];
            
            player = {
                x: startX,
                y: startY,
                dx: initialDir.x,
                dy: initialDir.y,
                trail: [{x: startX, y: startY}],
                color: '#00ffff'
            };
            
            // Initialize grid
            initGrid();
            grid[player.x][player.y] = 1;
            
            // Update UI
            scoreEl.textContent = score;
            startScreen.classList.add('hidden');
            pauseOverlay.classList.add('hidden');
            gameOverOverlay.classList.add('hidden');
            gameState = 'playing';
            
            // Start game loop
            if (animationId) cancelAnimationFrame(animationId);
            animationId = requestAnimationFrame(gameLoop);
        }
        
        function pauseGame() {
            if (gameState !== 'playing') return;
            gameState = 'paused';
            pauseOverlay.classList.remove('hidden');
            if (animationId) {
                cancelAnimationFrame(animationId);
                animationId = null;
            }
        }
        
        function resumeGame() {
            if (gameState !== 'paused') return;
            gameState = 'playing';
            pauseOverlay.classList.add('hidden');
            lastTime = performance.now(); // reset lastTime to avoid big jump
            animationId = requestAnimationFrame(gameLoop);
        }
        
        function quitToMenu() {
            gameState = 'start';
            pauseOverlay.classList.add('hidden');
            gameOverOverlay.classList.add('hidden');
            startScreen.classList.remove('hidden');
            if (animationId) {
                cancelAnimationFrame(animationId);
                animationId = null;
            }
            player = null;
        }
        
        function gameOver() {
            gameState = 'gameover';
            if (animationId) {
                cancelAnimationFrame(animationId);
                animationId = null;
            }
            // Update high score
            if (score > highScore) {
                highScore = score;
                localStorage.setItem('tronHighScore', highScore);
                updateHighScoreDisplay();
            }
            finalScoreEl.textContent = score;
            gameOverOverlay.classList.remove('hidden');
        }
        
        function gameLoop(timestamp) {
            if (gameState !== 'playing') return;
            
            if (!lastTime) lastTime = timestamp;
            const delta = timestamp - lastTime;
            lastTime = timestamp;
            
            accumulatedTime += delta;
            lastSpeedIncrease += delta;
            
            // Increase speed over time
            if (lastSpeedIncrease >= speedIncreaseInterval) {
                gameSpeed = Math.max(30, gameSpeed - 5);
                lastSpeedIncrease = 0;
            }
            
            // Move player at intervals
            if (accumulatedTime >= gameSpeed) {
                update();
                accumulatedTime = 0;
            }
            
            draw();
            animationId = requestAnimationFrame(gameLoop);
        }
        
        function update() {
            // Apply next direction
            if (nextDirection) {
                player.dx = nextDirection.x;
                player.dy = nextDirection.y;
                nextDirection = null;
            }
            
            // Calculate new head position
            const newX = player.x + player.dx;
            const newY = player.y + player.dy;
            
            // Check collision with walls
            if (newX < 0 || newX >= cols || newY < 0 || newY >= rows) {
                gameOver();
                return;
            }
            
            // Check collision with trail
            if (grid[newX][newY] === 1) {
                gameOver();
                return;
            }
            
            // Move player
            player.x = newX;
            player.y = newY;
            player.trail.push({x: newX, y: newY});
            grid[newX][newY] = 1;
            
            // Increase score
            score++;
            scoreEl.textContent = score;
        }
        
        function draw() {
            // Clear canvas
            ctx.fillStyle = '#050510';
            ctx.fillRect(0, 0, canvas.width, canvas.height);
            
            // Draw grid lines (subtle)
            ctx.strokeStyle = 'rgba(0, 255, 255, 0.05)';
            ctx.lineWidth = 1;
            for (let i = 0; i <= cols; i++) {
                ctx.beginPath();
                ctx.moveTo(i * GRID_SIZE, 0);
                ctx.lineTo(i * GRID_SIZE, canvas.height);
                ctx.stroke();
            }
            for (let j = 0; j <= rows; j++) {
                ctx.beginPath();
                ctx.moveTo(0, j * GRID_SIZE);
                ctx.lineTo(canvas.width, j * GRID_SIZE);
                ctx.stroke();
            }
            
            // Draw trail
            if (player && player.trail.length > 0) {
                // Draw trail segments with glow
                for (let i = 0; i < player.trail.length; i++) {
                    const seg = player.trail[i];
                    const x = seg.x * GRID_SIZE;
                    const y = seg.y * GRID_SIZE;
                    const size = GRID_SIZE - 2;
                    
                    // Fade older segments
                    const alpha = 0.3 + 0.7 * (i / player.trail.length);
                    
                    // Segment color
                    ctx.fillStyle = `rgba(0, 255, 255, ${alpha})`;
                    ctx.shadowColor = '#00ffff';
                    ctx.shadowBlur = 10;
                    ctx.fillRect(x + 1, y + 1, size, size);
                    
                    // Inner glow
                    ctx.fillStyle = `rgba(255, 255, 255, ${alpha * 0.5})`;
                    ctx.shadowBlur = 0;
                    ctx.fillRect(x + 3, y + 3, size - 4, size - 4);
                }
                
                // Draw head (last segment) brighter
                const head = player.trail[player.trail.length - 1];
                const hx = head.x * GRID_SIZE;
                const hy = head.y * GRID_SIZE;
                const hsize = GRID_SIZE - 2;
                ctx.fillStyle = '#ffffff';
                ctx.shadowColor = '#00ffff';
                ctx.shadowBlur = 20;
                ctx.fillRect(hx + 1, hy + 1, hsize, hsize);
                ctx.shadowBlur = 0;
            }
        }
        
        // Start the game
        init();
    </script>
</body>
</html>