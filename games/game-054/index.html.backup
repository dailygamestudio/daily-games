<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no">
    <title>Neon Tron - Day 54</title>
    <link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@400;700;900&display=swap" rel="stylesheet">
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body { 
            background: #0a0a1a; 
            font-family: 'Orbitron', 'Courier New', monospace; 
            color: #00ffff; 
            overflow: hidden; 
            height: 100vh;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
        }
        #gameCanvas { 
            border: 3px solid #00ffff; 
            box-shadow: 0 0 30px #00ffff, inset 0 0 30px rgba(0,255,255,0.1);
            background: #050515;
            display: block;
            max-width: 100%;
            max-height: 100%;
        }
        .overlay {
            position: fixed;
            top: 0; left: 0;
            width: 100%; height: 100%;
            background: rgba(10,10,26,0.95);
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            z-index: 10;
            backdrop-filter: blur(5px);
        }
        .overlay.hidden { display: none; }
        .overlay h1 { 
            font-size: 3rem; 
            font-weight: 900; 
            text-shadow: 0 0 20px #00ffff, 0 0 40px #00ffff;
            margin-bottom: 1rem;
            background: linear-gradient(45deg, #00ffff, #ff00ff, #ffff00);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }
        .overlay p { font-size: 1.2rem; margin-bottom: 2rem; opacity: 0.8; }
        .btn {
            padding: 1rem 3rem;
            font-family: 'Orbitron', monospace;
            font-size: 1.2rem;
            font-weight: 700;
            border: 2px solid #00ffff;
            background: rgba(0,255,255,0.1);
            color: #00ffff;
            cursor: pointer;
            transition: all 0.3s;
            text-transform: uppercase;
            letter-spacing: 2px;
            margin: 0.5rem;
        }
        .btn:hover { 
            background: #00ffff; 
            color: #0a0a1a; 
            box-shadow: 0 0 20px #00ffff;
            transform: scale(1.05);
        }
        .btn:active { transform: scale(0.95); }
        .btn.secondary { border-color: #ff00ff; color: #ff00ff; }
        .btn.secondary:hover { background: #ff00ff; color: #0a0a1a; box-shadow: 0 0 20px #ff00ff; }
        .score-display { 
            position: fixed; 
            top: 20px; 
            left: 50%; 
            transform: translateX(-50%);
            font-size: 1.5rem; 
            font-weight: 700;
            text-shadow: 0 0 10px #00ffff;
            z-index: 5;
        }
        .high-score { 
            position: fixed; 
            top: 20px; 
            right: 20px; 
            font-size: 1rem; 
            opacity: 0.7;
        }
        .controls-hint {
            position: fixed;
            bottom: 20px;
            left: 50%;
            transform: translateX(-50%);
            font-size: 0.9rem;
            opacity: 0.6;
            display: flex;
            gap: 2rem;
        }
        .touch-controls {
            position: fixed;
            bottom: 20px;
            left: 50%;
            transform: translateX(-50%);
            display: none;
            gap: 1rem;
        }
        .touch-btn {
            width: 60px;
            height: 60px;
            border: 2px solid #00ffff;
            background: rgba(0,255,255,0.1);
            color: #00ffff;
            font-size: 1.5rem;
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
        }
        .touch-btn:active { background: #00ffff; color: #0a0a1a; }
        @media (max-width: 768px) {
            .touch-controls { display: flex; }
            .controls-hint { display: none; }
        }
    </style>
</head>
<body>
    <canvas id="gameCanvas" width="800" height="600"></canvas>
    
    <div class="score-display">SCORE: <span id="score">0</span></div>
    <div class="high-score">HIGH: <span id="highScore">0</span></div>
    <div class="controls-hint">ARROWS/WASD to move | ESC/P to pause</div>
    <div class="touch-controls">
        <button class="touch-btn" data-dir="up">▲</button>
        <button class="touch-btn" data-dir="left">◄</button>
        <button class="touch-btn" data-dir="right">►</button>
        <button class="touch-btn" data-dir="down">▼</button>
    </div>

    <div id="startOverlay" class="overlay">
        <h1>NEON TRON</h1>
        <p>Survive the grid. Don't hit walls or trails.</p>
        <button class="btn" id="startBtn">START GAME</button>
    </div>

    <div id="pauseOverlay" class="overlay hidden">
        <h1>PAUSED</h1>
        <button class="btn" id="resumeBtn">RESUME</button>
        <button class="btn secondary" id="quitBtn">QUIT TO MENU</button>
    </div>

    <div id="gameOverOverlay" class="overlay hidden">
        <h1>GAME OVER</h1>
        <p>Final Score: <span id="finalScore">0</span></p>
        <button class="btn" id="retryBtn">RETRY</button>
        <button class="btn secondary" id="menuBtn">MAIN MENU</button>
    </div>

    <script>
        const canvas = document.getElementById('gameCanvas');
        const ctx = canvas.getContext('2d');
        
        const GRID_SIZE = 20;
        const COLS = canvas.width / GRID_SIZE;
        const ROWS = canvas.height / GRID_SIZE;
        
        let player = { x: 0, y: 0, dx: 1, dy: 0, trail: [], color: '#00ffff' };
        let score = 0;
        let highScore = parseInt(localStorage.getItem('tronHighScore')) || 0;
        let gameLoop = null;
        let isPaused = false;
        let isGameOver = false;
        let nextDirection = { dx: 1, dy: 0 };
        let trailMap = [];
        
        document.getElementById('highScore').textContent = highScore;
        
        function hideOverlay(id) {
            const overlay = document.getElementById(id);
            if (overlay) {
                overlay.classList.add('hidden');
                overlay.style.display = 'none';
            }
        }
        
        function showOverlay(id) {
            const overlay = document.getElementById(id);
            if (overlay) {
                overlay.classList.remove('hidden');
                overlay.style.display = 'flex';
            }
        }
        
        function initTrailMap() {
            trailMap = [];
            for (let i = 0; i < COLS; i++) {
                trailMap[i] = [];
                for (let j = 0; j < ROWS; j++) {
                    trailMap[i][j] = 0;
                }
            }
        }
        
        function startGame() {
            player = { 
                x: Math.floor(COLS / 4), 
                y: Math.floor(ROWS / 2), 
                dx: 1, dy: 0, 
                trail: [], 
                color: '#00ffff' 
            };
            score = 0;
            document.getElementById('score').textContent = score;
            isGameOver = false;
            isPaused = false;
            nextDirection = { dx: 1, dy: 0 };
            initTrailMap();
            
            hideOverlay('startOverlay');
            hideOverlay('pauseOverlay');
            hideOverlay('gameOverOverlay');
            
            if (gameLoop) clearInterval(gameLoop);
            gameLoop = setInterval(update, 100);
        }
        
        function pauseGame() {
            if (isGameOver) return;
            isPaused = true;
            clearInterval(gameLoop);
            showOverlay('pauseOverlay');
        }
        
        function resumeGame() {
            if (isGameOver) return;
            isPaused = false;
            hideOverlay('pauseOverlay');
            gameLoop = setInterval(update, 100);
        }
        
        function quitToMenu() {
            isGameOver = true;
            isPaused = false;
            clearInterval(gameLoop);
            hideOverlay('pauseOverlay');
            showOverlay('startOverlay');
        }
        
        function showStartScreen() {
            isGameOver = true;
            isPaused = false;
            clearInterval(gameLoop);
            hideOverlay('gameOverOverlay');
            showOverlay('startOverlay');
        }
        
        function gameOver() {
            isGameOver = true;
            clearInterval(gameLoop);
            if (score > highScore) {
                highScore = score;
                localStorage.setItem('tronHighScore', highScore);
                document.getElementById('highScore').textContent = highScore;
            }
            document.getElementById('finalScore').textContent = score;
            showOverlay('gameOverOverlay');
        }
        
        function update() {
            if (isPaused || isGameOver) return;
            
            player.dx = nextDirection.dx;
            player.dy = nextDirection.dy;
            
            const newX = player.x + player.dx;
            const newY = player.y + player.dy;
            
            if (newX < 0 || newX >= COLS || newY < 0 || newY >= ROWS || trailMap[newX][newY]) {
                gameOver();
                return;
            }
            
            player.trail.unshift({ x: player.x, y: player.y });
            trailMap[player.x][player.y] = 1;
            player.x = newX;
            player.y = newY;
            
            if (player.trail.length > 5 + Math.floor(score / 100)) {
                const tail = player.trail.pop();
                trailMap[tail.x][tail.y] = 0;
            }
            
            score += 10;
            document.getElementById('score').textContent = score;
            
            draw();
        }
        
        function draw() {
            ctx.fillStyle = '#050515';
            ctx.fillRect(0, 0, canvas.width, canvas.height);
            
            ctx.strokeStyle = 'rgba(0,255,255,0.05)';
            ctx.lineWidth = 1;
            for (let i = 0; i <= COLS; i++) {
                ctx.beginPath();
                ctx.moveTo(i * GRID_SIZE, 0);
                ctx.lineTo(i * GRID_SIZE, canvas.height);
                ctx.stroke();
            }
            for (let j = 0; j <= ROWS; j++) {
                ctx.beginPath();
                ctx.moveTo(0, j * GRID_SIZE);
                ctx.lineTo(canvas.width, j * GRID_SIZE);
                ctx.stroke();
            }
            
            ctx.fillStyle = player.color;
            ctx.shadowColor = player.color;
            ctx.shadowBlur = 15;
            player.trail.forEach((segment, index) => {
                const alpha = 1 - (index / player.trail.length) * 0.7;
                ctx.globalAlpha = alpha;
                ctx.fillRect(segment.x * GRID_SIZE + 2, segment.y * GRID_SIZE + 2, GRID_SIZE - 4, GRID_SIZE - 4);
            });
            ctx.globalAlpha = 1;
            ctx.fillRect(player.x * GRID_SIZE + 2, player.y * GRID_SIZE + 2, GRID_SIZE - 4, GRID_SIZE - 4);
            ctx.shadowBlur = 0;
        }
        
        function setDirection(dx, dy) {
            if (isPaused || isGameOver) return;
            if (dx === -player.dx && dy === -player.dy) return;
            nextDirection = { dx, dy };
        }
        
        document.addEventListener('keydown', (e) => {
            switch(e.key) {
                case 'ArrowUp': case 'w': case 'W': setDirection(0, -1); break;
                case 'ArrowDown': case 's': case 'S': setDirection(0, 1); break;
                case 'ArrowLeft': case 'a': case 'A': setDirection(-1, 0); break;
                case 'ArrowRight': case 'd': case 'D': setDirection(1, 0); break;
                case 'Escape': case 'p': case 'P':
                    if (isGameOver) return;
                    if (isPaused) resumeGame();
                    else pauseGame();
                    break;
            }
        });
        
        document.querySelectorAll('.touch-btn').forEach(btn => {
            btn.addEventListener('touchstart', (e) => {
                e.preventDefault();
                const dir = btn.dataset.dir;
                switch(dir) {
                    case 'up': setDirection(0, -1); break;
                    case 'down': setDirection(0, 1); break;
                    case 'left': setDirection(-1, 0); break;
                    case 'right': setDirection(1, 0); break;
                }
            }, { passive: false });
        });
        
        document.getElementById('startBtn').addEventListener('click', startGame);
        document.getElementById('resumeBtn').addEventListener('click', resumeGame);
        document.getElementById('quitBtn').addEventListener('click', quitToMenu);
        document.getElementById('retryBtn').addEventListener('click', startGame);
        document.getElementById('menuBtn').addEventListener('click', showStartScreen);
        
        draw();
    </script>
</body>
</html>