<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no">
    <title>Neon Tron - Day 54</title>
    <link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@400;700;900&display=swap" rel="stylesheet">
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body { 
            background: #0a0a1a; 
            font-family: 'Orbitron', 'Courier New', monospace; 
            color: #00ffff; 
            overflow: hidden; 
            height: 100vh; 
            display: flex; 
            justify-content: center; 
            align-items: center; 
        }
        #gameContainer { position: relative; width: 100%; max-width: 800px; aspect-ratio: 4/3; }
        canvas { 
            display: block; 
            width: 100%; 
            height: 100%; 
            background: #050510; 
            border: 2px solid #00ffff; 
            box-shadow: 0 0 20px #00ffff, inset 0 0 20px #00ffff; 
        }
        .overlay {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(5, 5, 16, 0.95);
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            z-index: 10;
            border: 2px solid #00ffff;
            box-shadow: 0 0 20px #00ffff, inset 0 0 20px #00ffff;
        }
        .overlay.hidden { display: none; }
        .overlay h1 { font-size: 3rem; margin-bottom: 1rem; text-shadow: 0 0 10px #00ffff, 0 0 20px #00ffff; }
        .overlay p { font-size: 1.2rem; margin-bottom: 2rem; color: #88ffff; }
        .btn {
            background: transparent;
            border: 2px solid #00ffff;
            color: #00ffff;
            padding: 1rem 2.5rem;
            font-family: 'Orbitron', monospace;
            font-size: 1.2rem;
            cursor: pointer;
            margin: 0.5rem;
            transition: all 0.2s;
            text-shadow: 0 0 5px #00ffff;
            box-shadow: 0 0 10px #00ffff;
        }
        .btn:hover, .btn:focus { background: #00ffff; color: #050510; box-shadow: 0 0 20px #00ffff, inset 0 0 10px #00ffff; }
        .score-display { position: absolute; top: 10px; left: 10px; z-index: 5; font-size: 1.2rem; text-shadow: 0 0 5px #00ffff; }
        .high-score-display { position: absolute; top: 10px; right: 10px; z-index: 5; font-size: 1.2rem; text-shadow: 0 0 5px #00ffff; color: #ffcc00; }
        .controls-hint { position: absolute; bottom: 10px; left: 50%; transform: translateX(-50%); z-index: 5; font-size: 0.9rem; color: #66ccff; text-shadow: 0 0 5px #00ffff; }
    </style>
</head>
<body>
    <div id="gameContainer">
        <canvas id="gameCanvas"></canvas>
        <div class="score-display">SCORE: <span id="score">0</span></div>
        <div class="high-score-display">HIGH: <span id="highScore">0</span></div>
        <div class="controls-hint">ARROWS/WASD to move | ESC/P to pause | Swipe on mobile</div>
        
        <div id="startOverlay" class="overlay">
            <h1>NEON TRON</h1>
            <p>Survive the grid. Don't hit the trails.</p>
            <button class="btn" id="startBtn">START GAME</button>
        </div>
        
        <div id="pauseOverlay" class="overlay hidden">
            <h1>PAUSED</h1>
            <button class="btn" id="resumeBtn">RESUME</button>
            <button class="btn" id="quitPauseBtn">QUIT TO MENU</button>
        </div>
        
        <div id="gameOverOverlay" class="overlay hidden">
            <h1>GAME OVER</h1>
            <p>Final Score: <span id="finalScore">0</span></p>
            <button class="btn" id="retryBtn">RETRY</button>
            <button class="btn" id="mainMenuBtn">MAIN MENU</button>
        </div>
    </div>

    <script>
        const canvas = document.getElementById('gameCanvas');
        const ctx = canvas.getContext('2d');
        
        const startOverlay = document.getElementById('startOverlay');
        const pauseOverlay = document.getElementById('pauseOverlay');
        const gameOverOverlay = document.getElementById('gameOverOverlay');
        const startBtn = document.getElementById('startBtn');
        const resumeBtn = document.getElementById('resumeBtn');
        const quitPauseBtn = document.getElementById('quitPauseBtn');
        const retryBtn = document.getElementById('retryBtn');
        const mainMenuBtn = document.getElementById('mainMenuBtn');
        const scoreEl = document.getElementById('score');
        const highScoreEl = document.getElementById('highScore');
        const finalScoreEl = document.getElementById('finalScore');
        
        let gridSize, tileCount;
        let player, ai;
        let trails = [];
        let score = 0;
        let highScore = parseInt(localStorage.getItem('tronHighScore')) || 0;
        let gameLoopId = null;
        let isPaused = false;
        let isGameOver = false;
        let lastTime = 0;
        const gameSpeed = 120; // ms per frame
        
        const directions = {
            UP: { x: 0, y: -1 },
            DOWN: { x: 0, y: 1 },
            LEFT: { x: -1, y: 0 },
            RIGHT: { x: 1, y: 0 }
        };
        
        function resizeCanvas() {
            const container = document.getElementById('gameContainer');
            const rect = container.getBoundingClientRect();
            canvas.width = rect.width;
            canvas.height = rect.height;
            gridSize = Math.min(canvas.width, canvas.height) / 30;
            tileCount = Math.floor(canvas.width / gridSize);
        }
        
        function initGame() {
            resizeCanvas();
            highScoreEl.textContent = highScore;
            
            const startX = Math.floor(tileCount / 4);
            const startY = Math.floor(tileCount / 2);
            const aiStartX = Math.floor(tileCount * 3 / 4);
            
            player = {
                x: startX,
                y: startY,
                dx: 1,
                dy: 0,
                color: '#00ffff',
                trail: [],
                nextDir: null
            };
            
            ai = {
                x: aiStartX,
                y: startY,
                dx: -1,
                dy: 0,
                color: '#ff0066',
                trail: [],
                nextDir: null,
                decisionTimer: 0
            };
            
            trails = [];
            score = 0;
            scoreEl.textContent = score;
            isGameOver = false;
            isPaused = false;
        }
        
        function startGame() {
            initGame();
            startOverlay.classList.add('hidden');
            pauseOverlay.classList.add('hidden');
            gameOverOverlay.classList.add('hidden');
            lastTime = performance.now();
            if (gameLoopId) cancelAnimationFrame(gameLoopId);
            gameLoopId = requestAnimationFrame(gameLoop);
        }
        
        function pauseGame() {
            if (isGameOver) return;
            isPaused = true;
            pauseOverlay.classList.remove('hidden');
        }
        
        function resumeGame() {
            isPaused = false;
            pauseOverlay.classList.add('hidden');
            lastTime = performance.now();
            gameLoopId = requestAnimationFrame(gameLoop);
        }
        
        function quitToMenu() {
            isPaused = false;
            isGameOver = true;
            if (gameLoopId) cancelAnimationFrame(gameLoopId);
            pauseOverlay.classList.add('hidden');
            gameOverOverlay.classList.add('hidden');
            startOverlay.classList.remove('hidden');
        }
        
        function showStartScreen() {
            quitToMenu();
        }
        
        function gameLoop(timestamp) {
            if (isGameOver || isPaused) return;
            
            const delta = timestamp - lastTime;
            if (delta >= gameSpeed) {
                update();
                draw();
                lastTime = timestamp;
            }
            gameLoopId = requestAnimationFrame(gameLoop);
        }
        
        function update() {
            // Player direction change
            if (player.nextDir) {
                if (!(player.nextDir.x === -player.dx && player.nextDir.y === -player.dy)) {
                    player.dx = player.nextDir.x;
                    player.dy = player.nextDir.y;
                }
                player.nextDir = null;
            }
            
            // AI simple logic: avoid walls and trails, try to trap player
            ai.decisionTimer--;
            if (ai.decisionTimer <= 0) {
                makeAIDecision();
                ai.decisionTimer = Math.floor(Math.random() * 3) + 2;
            }
            
            // Move player
            const newPlayerX = player.x + player.dx;
            const newPlayerY = player.y + player.dy;
            
            // Move AI
            const newAIX = ai.x + ai.dx;
            const newAIY = ai.y + ai.dy;
            
            // Check collisions for player
            if (checkCollision(newPlayerX, newPlayerY, player.trail, ai.trail)) {
                gameOver();
                return;
            }
            
            // Check collisions for AI
            if (checkCollision(newAIX, newAIY, ai.trail, player.trail)) {
                // AI died, player gets points
                score += 100;
                scoreEl.textContent = score;
                // Respawn AI
                respawnAI();
            } else {
                // Update AI position
                ai.trail.unshift({ x: ai.x, y: ai.y });
                if (ai.trail.length > 50) ai.trail.pop();
                ai.x = newAIX;
                ai.y = newAIY;
            }
            
            // Update player position
            player.trail.unshift({ x: player.x, y: player.y });
            if (player.trail.length > 50) player.trail.pop();
            player.x = newPlayerX;
            player.y = newPlayerY;
            
            // Increase score over time
            score += 1;
            scoreEl.textContent = score;
        }
        
        function checkCollision(x, y, ownTrail, otherTrail) {
            // Wall collision
            if (x < 0 || x >= tileCount || y < 0 || y >= tileCount) return true;
            
            // Own trail collision
            for (let segment of ownTrail) {
                if (segment.x === x && segment.y === y) return true;
            }
            
            // Other trail collision
            for (let segment of otherTrail) {
                if (segment.x === x && segment.y === y) return true;
            }
            
            // Head-on collision with other player
            if (x === ai.x && y === ai.y) return true;
            
            return false;
        }
        
        function makeAIDecision() {
            const possibleDirs = [
                directions.UP,
                directions.DOWN,
                directions.LEFT,
                directions.RIGHT
            ].filter(dir => !(dir.x === -ai.dx && dir.y === -ai.dy)); // Can't reverse
            
            // Evaluate each direction
            let bestDir = null;
            let bestScore = -Infinity;
            
            for (let dir of possibleDirs) {
                const nx = ai.x + dir.x;
                const ny = ai.y + dir.y;
                
                if (checkCollision(nx, ny, ai.trail, player.trail)) continue;
                
                // Score based on distance to player and space available
                let score = 0;
                const distToPlayer = Math.abs(nx - player.x) + Math.abs(ny - player.y);
                score += (tileCount * 2 - distToPlayer) * 2; // Prefer closer to player
                
                // Count free space in that direction (flood fill approximation)
                score += countFreeSpace(nx, ny, dir) * 5;
                
                if (score > bestScore) {
                    bestScore = score;
                    bestDir = dir;
                }
            }
            
            if (bestDir) {
                ai.nextDir = bestDir;
            }
        }
        
        function countFreeSpace(x, y, dir, depth = 0) {
            if (depth > 10) return 0;
            const nx = x + dir.x;
            const ny = y + dir.y;
            if (checkCollision(nx, ny, ai.trail, player.trail)) return 0;
            return 1 + countFreeSpace(nx, ny, dir, depth + 1);
        }
        
        function respawnAI() {
            // Find safe spot for AI
            let safeSpots = [];
            for (let x = 2; x < tileCount - 2; x++) {
                for (let y = 2; y < tileCount - 2; y++) {
                    if (!checkCollision(x, y, [], player.trail)) {
                        safeSpots.push({ x, y });
                    }
                }
            }
            if (safeSpots.length === 0) {
                gameOver();
                return;
            }
            const spot = safeSpots[Math.floor(Math.random() * safeSpots.length)];
            ai.x = spot.x;
            ai.y = spot.y;
            ai.dx = Math.random() > 0.5 ? 1 : -1;
            ai.dy = 0;
            ai.trail = [];
            ai.nextDir = null;
        }
        
        function gameOver() {
            isGameOver = true;
            if (gameLoopId) cancelAnimationFrame(gameLoopId);
            
            if (score > highScore) {
                highScore = score;
                localStorage.setItem('tronHighScore', highScore);
                highScoreEl.textContent = highScore;
            }
            
            finalScoreEl.textContent = score;
            gameOverOverlay.classList.remove('hidden');
        }
        
        function draw() {
            // Clear with slight trail effect
            ctx.fillStyle = 'rgba(5, 5, 16, 0.3)';
            ctx.fillRect(0, 0, canvas.width, canvas.height);
            
            // Draw grid
            ctx.strokeStyle = 'rgba(0, 255, 255, 0.05)';
            ctx.lineWidth = 1;
            for (let i = 0; i <= tileCount; i++) {
                ctx.beginPath();
                ctx.moveTo(i * gridSize, 0);
                ctx.lineTo(i * gridSize, canvas.height);
                ctx.stroke();
                ctx.beginPath();
                ctx.moveTo(0, i * gridSize);
                ctx.lineTo(canvas.width, i * gridSize);
                ctx.stroke();
            }
            
            // Draw trails
            drawTrail(player.trail, player.color, 0.6);
            drawTrail(ai.trail, ai.color, 0.6);
            
            // Draw heads
            drawCycle(player.x, player.y, player.color, player.dx, player.dy);
            drawCycle(ai.x, ai.y, ai.color, ai.dx, ai.dy);
        }
        
        function drawTrail(trail, color, alpha) {
            for (let i = 0; i < trail.length; i++) {
                const segment = trail[i];
                const intensity = 1 - (i / trail.length) * 0.5;
                ctx.fillStyle = hexToRgba(color, alpha * intensity);
                ctx.fillRect(
                    segment.x * gridSize + 1,
                    segment.y * gridSize + 1,
                    gridSize - 2,
                    gridSize - 2
                );
                
                // Glow effect
                if (i < 5) {
                    ctx.shadowColor = color;
                    ctx.shadowBlur = 10;
                    ctx.fillRect(
                        segment.x * gridSize + 1,
                        segment.y * gridSize + 1,
                        gridSize - 2,
                        gridSize - 2
                    );
                    ctx.shadowBlur = 0;
                }
            }
        }
        
        function drawCycle(x, y, color, dx, dy) {
            const centerX = x * gridSize + gridSize / 2;
            const centerY = y * gridSize + gridSize / 2;
            const radius = gridSize / 2 - 2;
            
            // Body
            ctx.fillStyle = color;
            ctx.shadowColor = color;
            ctx.shadowBlur = 15;
            ctx.beginPath();
            ctx.arc(centerX, centerY, radius, 0, Math.PI * 2);
            ctx.fill();
            
            // Direction indicator
            ctx.fillStyle = '#fff';
            ctx.shadowBlur = 0;
            const indicatorSize = radius * 0.4;
            let indX = centerX, indY = centerY;
            if (dx === 1) indX += radius * 0.3;
            if (dx === -1) indX -= radius * 0.3;
            if (dy === 1) indY += radius * 0.3;
            if (dy === -1) indY -= radius * 0.3;
            ctx.beginPath();
            ctx.arc(indX, indY, indicatorSize, 0, Math.PI * 2);
            ctx.fill();
        }
        
        function hexToRgba(hex, alpha) {
            const r = parseInt(hex.slice(1, 3), 16);
            const g = parseInt(hex.slice(3, 5), 16);
            const b = parseInt(hex.slice(5, 7), 16);
            return `rgba(${r}, ${g}, ${b}, ${alpha})`;
        }
        
        // Input handling
        document.addEventListener('keydown', (e) => {
            if (e.key === 'Escape' || e.key === 'p' || e.key === 'P') {
                e.preventDefault();
                if (isGameOver) return;
                if (isPaused) resumeGame();
                else pauseGame();
                return;
            }
            
            if (isPaused || isGameOver) return;
            
            switch(e.key) {
                case 'ArrowUp': case 'w': case 'W':
                    player.nextDir = directions.UP; break;
                case 'ArrowDown': case 's': case 'S':
                    player.nextDir = directions.DOWN; break;
                case 'ArrowLeft': case 'a': case 'A':
                    player.nextDir = directions.LEFT; break;
                case 'ArrowRight': case 'd': case 'D':
                    player.nextDir = directions.RIGHT; break;
            }
        });
        
        // Touch controls
        let touchStartX = 0;
        let touchStartY = 0;
        
        canvas.addEventListener('touchstart', (e) => {
            e.preventDefault();
            touchStartX = e.touches[0].clientX;
            touchStartY = e.touches[0].clientY;
        }, { passive: false });
        
        canvas.addEventListener('touchend', (e) => {
            e.preventDefault();
            if (isPaused || isGameOver) return;
            
            const touchEndX = e.changedTouches[0].clientX;
            const touchEndY = e.changedTouches[0].clientY;
            const dx = touchEndX - touchStartX;
            const dy = touchEndY - touchStartY;
            
            if (Math.abs(dx) > Math.abs(dy)) {
                if (dx > 30) player.nextDir = directions.RIGHT;
                else if (dx < -30) player.nextDir = directions.LEFT;
            } else {
                if (dy > 30) player.nextDir = directions.DOWN;
                else if (dy < -30) player.nextDir = directions.UP;
            }
        }, { passive: false });
        
        // Button events
        startBtn.addEventListener('click', startGame);
        resumeBtn.addEventListener('click', resumeGame);
        quitPauseBtn.addEventListener('click', quitToMenu);
        retryBtn.addEventListener('click', startGame);
        mainMenuBtn.addEventListener('click', showStartScreen);
        
        // Window resize
        window.addEventListener('resize', () => {
            resizeCanvas();
            if (!isGameOver && !isPaused) draw();
        });
        
        // Initialize high score display
        highScoreEl.textContent = highScore;
        // Show start screen initially
        startOverlay.classList.remove('hidden');
    </script>
</body>
</html>