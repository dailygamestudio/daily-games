<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no">
<title>Neon Gravity Runner - Day 37</title>
<style>
  * { margin: 0; padding: 0; box-sizing: border-box; }
  body { background: #0a0a12; color: #00ffcc; font-family: 'Orbitron', 'Courier New', monospace; overflow: hidden; touch-action: none; }
  canvas { display: block; background: #05050a; }
  #ui { position: fixed; top: 0; left: 0; width: 100%; height: 100%; pointer-events: none; z-index: 10; }
  .overlay { position: absolute; top: 0; left: 0; width: 100%; height: 100%; background: rgba(5,5,10,0.95); display: flex; flex-direction: column; justify-content: center; align-items: center; gap: 20px; pointer-events: auto; z-index: 20; border: 2px solid #00ffcc; box-shadow: 0 0 30px #00ffcc, inset 0 0 30px #00ffcc; }
  .overlay.hidden { display: none; }
  h1 { font-size: clamp(2rem, 8vw, 4rem); text-shadow: 0 0 10px #00ffcc, 0 0 20px #00ffcc; letter-spacing: 0.1em; animation: pulse 2s infinite; }
  @keyframes pulse { 0%,100% { text-shadow: 0 0 10px #00ffcc, 0 0 20px #00ffcc; } 50% { text-shadow: 0 0 20px #00ffcc, 0 0 40px #00ffcc; } }
  .btn { padding: 15px 40px; font-size: clamp(1rem, 3vw, 1.5rem); background: transparent; border: 2px solid #00ffcc; color: #00ffcc; font-family: inherit; cursor: pointer; transition: all 0.2s; text-transform: uppercase; letter-spacing: 0.1em; box-shadow: 0 0 10px #00ffcc; }
  .btn:hover, .btn:focus { background: #00ffcc; color: #05050a; box-shadow: 0 0 20px #00ffcc, 0 0 40px #00ffcc; outline: none; }
  .btn:active { transform: scale(0.95); }
  #hud { position: absolute; top: 20px; left: 20px; right: 20px; display: flex; justify-content: space-between; pointer-events: none; }
  .stat { background: rgba(5,5,10,0.8); border: 1px solid #00ffcc; padding: 10px 20px; box-shadow: 0 0 10px #00ffcc; }
  .stat-label { font-size: 0.7rem; opacity: 0.7; }
  .stat-value { font-size: 1.2rem; font-weight: bold; }
  @media (max-width: 600px) { #hud { top: 10px; left: 10px; right: 10px; } .stat { padding: 8px 12px; } }
</style>
</head>
<body>
<canvas id="game"></canvas>
<div id="ui">
  <div id="hud">
    <div class="stat"><div class="stat-label">SCORE</div><div class="stat-value" id="score">0</div></div>
    <div class="stat"><div class="stat-label">BEST</div><div class="stat-value" id="best">0</div></div>
  </div>
  <div id="startOverlay" class="overlay">
    <h1>NEON GRAVITY RUNNER</h1>
    <button class="btn" id="startBtn">START RUN</button>
    <p style="font-size:0.9rem; opacity:0.7;">Tap / Click / Space to Flip Gravity</p>
  </div>
  <div id="pauseOverlay" class="overlay hidden">
    <h1>PAUSED</h1>
    <button class="btn" id="resumeBtn">RESUME</button>
    <button class="btn" id="quitBtn">QUIT TO MENU</button>
  </div>
  <div id="gameOverOverlay" class="overlay hidden">
    <h1>RUN ENDED</h1>
    <div class="stat" style="background:rgba(0,255,204,0.1);"><div class="stat-label">FINAL SCORE</div><div class="stat-value" id="finalScore">0</div></div>
    <button class="btn" id="retryBtn">RETRY</button>
    <button class="btn" id="menuBtn">MAIN MENU</button>
  </div>
</div>
<script>
const canvas = document.getElementById('game');
const ctx = canvas.getContext('2d');
let width, height, dpr;

const startOverlay = document.getElementById('startOverlay');
const pauseOverlay = document.getElementById('pauseOverlay');
const gameOverOverlay = document.getElementById('gameOverOverlay');
const scoreEl = document.getElementById('score');
const bestEl = document.getElementById('best');
const finalScoreEl = document.getElementById('finalScore');

let running = false;
let paused = false;
let gameOver = false;
let lastTime = 0;
let score = 0;
let best = parseInt(localStorage.getItem('neonGravityBest') || '0', 10);
bestEl.textContent = best;

const player = { x: 0, y: 0, w: 40, h: 40, gravity: 1, vy: 0, onFloor: true, color: '#00ffcc' };
const obstacles = [];
let obstacleTimer = 0;
let obstacleInterval = 1500;
let speed = 5;
let bgOffset = 0;

function resize() {
  dpr = window.devicePixelRatio || 1;
  width = window.innerWidth;
  height = window.innerHeight;
  canvas.width = width * dpr;
  canvas.height = height * dpr;
  canvas.style.width = width + 'px';
  canvas.style.height = height + 'px';
  ctx.scale(dpr, dpr);
  player.x = width * 0.15;
  player.y = height - player.h - 20;
  player.onFloor = true;
  player.gravity = 1;
  player.vy = 0;
}
window.addEventListener('resize', resize);
resize();

function flipGravity() {
  if (gameOver || paused || !running) return;
  player.gravity *= -1;
  player.vy = -player.gravity * 12;
  player.onFloor = false;
  createParticles(player.x + player.w/2, player.y + player.h/2, player.gravity > 0 ? '#00ffcc' : '#ff0066');
}

function createParticles(x, y, color) {
  for (let i=0;i<8;i++) particles.push({x,y,vx:(Math.random()-0.5)*8,vy:(Math.random()-0.5)*8,life:1,color,size:Math.random()*4+2});
}
const particles = [];

function spawnObstacle() {
  const gap = 120;
  const topH = Math.random() * (height - gap - 100) + 50;
  const bottomY = topH + gap;
  const bottomH = height - bottomY;
  obstacles.push({ x: width, topH, bottomY, bottomH, passed: false, color: '#ff0066' });
}

function update(dt) {
  if (paused || gameOver || !running) return;
  score += dt * 0.1;
  scoreEl.textContent = Math.floor(score);
  speed = 5 + Math.floor(score / 500) * 0.5;
  obstacleInterval = Math.max(800, 1500 - Math.floor(score / 500) * 100);

  bgOffset = (bgOffset + speed * 0.5 * dt) % 100;

  player.vy += player.gravity * 30 * dt;
  player.y += player.vy * dt;

  const floorY = height - 20;
  const ceilY = 20;
  if (player.gravity > 0) {
    if (player.y + player.h >= floorY) { player.y = floorY - player.h; player.vy = 0; player.onFloor = true; }
  } else {
    if (player.y <= ceilY) { player.y = ceilY; player.vy = 0; player.onFloor = true; }
  }

  obstacleTimer += dt;
  if (obstacleTimer >= obstacleInterval) { obstacleTimer = 0; spawnObstacle(); }

  for (let i = obstacles.length - 1; i >= 0; i--) {
    const o = obstacles[i];
    o.x -= speed * dt;
    if (!o.passed && o.x + 30 < player.x) { o.passed = true; }
    if (o.x < -50) { obstacles.splice(i,1); continue; }
    if (checkCollision(o)) { triggerGameOver(); break; }
  }

  for (let i = particles.length - 1; i >= 0; i--) {
    const p = particles[i];
    p.x += p.vx * dt; p.y += p.vy * dt; p.life -= dt * 2;
    if (p.life <= 0) particles.splice(i,1);
  }
}

function checkCollision(o) {
  const px = player.x, py = player.y, pw = player.w, ph = player.h;
  const ox = o.x, ow = 30;
  if (px + pw < ox || px > ox + ow) return false;
  if (player.gravity > 0) {
    if (py + ph > o.bottomY) return true;
  } else {
    if (py < o.topH) return true;
  }
  return false;
}

function triggerGameOver() {
  gameOver = true;
  running = false;
  if (score > best) { best = Math.floor(score); localStorage.setItem('neonGravityBest', best); bestEl.textContent = best; }
  finalScoreEl.textContent = Math.floor(score);
  gameOverOverlay.classList.remove('hidden');
  createExplosion(player.x + player.w/2, player.y + player.h/2);
}

function createExplosion(x, y) {
  for (let i=0;i<30;i++) particles.push({x,y,vx:(Math.random()-0.5)*15,vy:(Math.random()-0.5)*15,life:1,color:Math.random()<0.5?'#00ffcc':'#ff0066',size:Math.random()*6+3});
}

function draw() {
  ctx.fillStyle = '#05050a';
  ctx.fillRect(0,0,width,height);

  ctx.strokeStyle = 'rgba(0,255,204,0.1)';
  ctx.lineWidth = 1;
  for (let x = -bgOffset % 100; x < width; x += 100) { ctx.beginPath(); ctx.moveTo(x,0); ctx.lineTo(x,height); ctx.stroke(); }
  for (let y = -bgOffset % 100; y < height; y += 100) { ctx.beginPath(); ctx.moveTo(0,y); ctx.lineTo(width,y); ctx.stroke(); }

  ctx.fillStyle = '#00ffcc';
  ctx.fillRect(0, height-20, width, 20);
  ctx.fillRect(0, 0, width, 20);

  ctx.shadowColor = player.color;
  ctx.shadowBlur = 20;
  ctx.fillStyle = player.color;
  ctx.fillRect(player.x, player.y, player.w, player.h);
  ctx.shadowBlur = 0;

  ctx.fillStyle = '#ff0066';
  ctx.shadowColor = '#ff0066';
  ctx.shadowBlur = 15;
  obstacles.forEach(o => {
    ctx.fillRect(o.x, 0, 30, o.topH);
    ctx.fillRect(o.x, o.bottomY, 30, o.bottomH);
  });
  ctx.shadowBlur = 0;

  particles.forEach(p => {
    ctx.globalAlpha = p.life;
    ctx.fillStyle = p.color;
    ctx.beginPath();
    ctx.arc(p.x, p.y, p.size * p.life, 0, Math.PI*2);
    ctx.fill();
  });
  ctx.globalAlpha = 1;
}

function loop(time) {
  if (!lastTime) lastTime = time;
  const dt = Math.min((time - lastTime) / 1000, 0.1);
  lastTime = time;
  update(dt);
  draw();
  if (running) requestAnimationFrame(loop);
}

function startGame() {
  running = true;
  paused = false;
  gameOver = false;
  score = 0;
  obstacles.length = 0;
  particles.length = 0;
  obstacleTimer = 0;
  speed = 5;
  player.x = width * 0.15;
  player.y = height - player.h - 20;
  player.gravity = 1;
  player.vy = 0;
  player.onFloor = true;
  startOverlay.classList.add('hidden');
  pauseOverlay.classList.add('hidden');
  gameOverOverlay.classList.add('hidden');
  lastTime = 0;
  requestAnimationFrame(loop);
}

function pauseGame() {
  if (!running || gameOver) return;
  paused = true;
  pauseOverlay.classList.remove('hidden');
}

function resumeGame() {
  if (!running || gameOver) return;
  paused = false;
  pauseOverlay.classList.add('hidden');
  lastTime = performance.now();
  requestAnimationFrame(loop);
}

function quitToMenu() {
  running = false;
  paused = false;
  gameOver = false;
  pauseOverlay.classList.add('hidden');
  gameOverOverlay.classList.add('hidden');
  startOverlay.classList.remove('hidden');
}

function showStartScreen() {
  quitToMenu();
}

document.getElementById('startBtn').addEventListener('click', startGame);
document.getElementById('resumeBtn').addEventListener('click', resumeGame);
document.getElementById('quitBtn').addEventListener('click', quitToMenu);
document.getElementById('retryBtn').addEventListener('click', startGame);
document.getElementById('menuBtn').addEventListener('click', showStartScreen);

window.addEventListener('keydown', e => {
  if (e.code === 'Escape' || e.code === 'KeyP') {
    if (running && !gameOver) { if (paused) resumeGame(); else pauseGame(); }
  }
  if (e.code === 'Space' || e.code === 'ArrowUp' || e.code === 'KeyW') { e.preventDefault(); flipGravity(); }
}, { passive: false });

canvas.addEventListener('click', flipGravity);
canvas.addEventListener('touchstart', e => { e.preventDefault(); flipGravity(); }, { passive: false });

startOverlay.classList.remove('hidden');
</script>
</body>
</html>