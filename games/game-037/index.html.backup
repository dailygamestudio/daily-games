<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no">
<title>Neon Gravity Runner - Day 37</title>
<style>
  * { margin: 0; padding: 0; box-sizing: border-box; }
  body { background: #0a0a12; color: #00ffcc; font-family: 'Orbitron', 'Courier New', monospace; overflow: hidden; touch-action: none; }
  canvas { display: block; background: #05050a; }
  #ui { position: fixed; top: 0; left: 0; width: 100%; height: 100%; pointer-events: none; z-index: 10; }
  .overlay { position: absolute; top: 0; left: 0; width: 100%; height: 100%; background: rgba(5,5,10,0.95); display: flex; flex-direction: column; justify-content: center; align-items: center; gap: 20px; pointer-events: auto; z-index: 20; border: 2px solid #00ffcc; box-shadow: 0 0 30px #00ffcc, inset 0 0 30px #00ffcc; }
  .overlay.hidden { display: none !important; }
  h1 { font-size: clamp(2rem, 8vw, 4rem); text-shadow: 0 0 10px #00ffcc, 0 0 20px #00ffcc; letter-spacing: 0.1em; animation: pulse 2s infinite; }
  @keyframes pulse { 0%,100% { text-shadow: 0 0 10px #00ffcc, 0 0 20px #00ffcc; } 50% { text-shadow: 0 0 20px #00ffcc, 0 0 40px #00ffcc; } }
  .btn { padding: 15px 40px; font-size: clamp(1rem, 3vw, 1.5rem); background: transparent; border: 2px solid #00ffcc; color: #00ffcc; font-family: inherit; cursor: pointer; transition: all 0.2s; text-transform: uppercase; letter-spacing: 0.1em; box-shadow: 0 0 10px #00ffcc; touch-action: manipulation; }
  .btn:hover, .btn:focus { background: #00ffcc; color: #05050a; box-shadow: 0 0 20px #00ffcc, 0 0 40px #00ffcc; outline: none; }
  .btn:active { transform: scale(0.95); }
  #hud { position: absolute; top: 20px; left: 20px; right: 20px; display: flex; justify-content: space-between; pointer-events: none; }
  .stat { background: rgba(5,5,10,0.8); border: 1px solid #00ffcc; padding: 10px 20px; box-shadow: 0 0 10px #00ffcc; }
  .stat-label { font-size: 0.7rem; opacity: 0.7; }
  .stat-value { font-size: 1.2rem; font-weight: bold; }
  @media (max-width: 600px) { #hud { top: 10px; left: 10px; right: 10px; } .stat { padding: 8px 12px; } }
</style>
</head>
<body>
<canvas id="game"></canvas>
<div id="ui">
  <div id="hud">
    <div class="stat"><div class="stat-label">SCORE</div><div class="stat-value" id="score">0</div></div>
    <div class="stat"><div class="stat-label">BEST</div><div class="stat-value" id="best">0</div></div>
  </div>
  <div id="startOverlay" class="overlay">
    <h1>NEON GRAVITY RUNNER</h1>
    <button class="btn" id="startBtn">START RUN</button>
    <p style="font-size:0.9rem; opacity:0.7;">Tap / Click / Space to Flip Gravity</p>
  </div>
  <div id="pauseOverlay" class="overlay hidden">
    <h1>PAUSED</h1>
    <button class="btn" id="resumeBtn">RESUME</button>
    <button class="btn" id="quitBtn">QUIT TO MENU</button>
  </div>
  <div id="gameOverOverlay" class="overlay hidden">
    <h1>RUN ENDED</h1>
    <div class="stat" style="background:rgba(0,255,204,0.1);"><div class="stat-label">FINAL SCORE</div><div class="stat-value" id="finalScore">0</div></div>
    <button class="btn" id="retryBtn">RETRY</button>
    <button class="btn" id="menuBtn">MAIN MENU</button>
  </div>
</div>
<script>
const canvas = document.getElementById('game');
const ctx = canvas.getContext('2d');
let width, height, dpr;

const startOverlay = document.getElementById('startOverlay');
const pauseOverlay = document.getElementById('pauseOverlay');
const gameOverOverlay = document.getElementById('gameOverOverlay');
const scoreEl = document.getElementById('score');
const bestEl = document.getElementById('best');
const finalScoreEl = document.getElementById('finalScore');

let running = false;
let paused = false;
let gameOver = false;
let lastTime = 0;
let score = 0;
let best = parseInt(localStorage.getItem('neonGravityBest') || '0', 10);
bestEl.textContent = best;

const player = { x: 0, y: 0, w: 40, h: 40, gravity: 1, vy: 0, onFloor: true, color: '#00ffcc' };
const obstacles = [];
let obstacleTimer = 0;
let obstacleInterval = 1500;
let speed = 5;
let bgOffset = 0;
let particles = [];

function resize() {
  dpr = window.devicePixelRatio || 1;
  width = window.innerWidth;
  height = window.innerHeight;
  canvas.width = width * dpr;
  canvas.height = height * dpr;
  canvas.style.width = width + 'px';
  canvas.style.height = height + 'px';
  ctx.setTransform(1, 0, 0, 1, 0, 0);
  ctx.scale(dpr, dpr);
  player.x = width * 0.2;
  player.y = height * 0.5;
  player.w = 40;
  player.h = 40;
}
window.addEventListener('resize', resize);
resize();

function hideAllOverlays() {
  [startOverlay, pauseOverlay, gameOverOverlay].forEach(overlay => {
    overlay.classList.add('hidden');
    overlay.style.display = 'none';
  });
}

function showOverlay(overlay) {
  hideAllOverlays();
  overlay.classList.remove('hidden');
  overlay.style.display = 'flex';
}

function showStartScreen() {
  running = false;
  paused = false;
  gameOver = false;
  hideAllOverlays();
  showOverlay(startOverlay);
}

function startGame() {
  if (running) return;
  running = true;
  paused = false;
  gameOver = false;
  score = 0;
  speed = 5;
  obstacleInterval = 1500;
  obstacles.length = 0;
  obstacleTimer = 0;
  particles.length = 0;
  player.y = height * 0.5;
  player.vy = 0;
  player.gravity = 1;
  player.onFloor = false;
  scoreEl.textContent = '0';
  hideAllOverlays();
  lastTime = performance.now();
  requestAnimationFrame(gameLoop);
}

function pauseGame() {
  if (!running || gameOver) return;
  paused = true;
  showOverlay(pauseOverlay);
}

function resumeGame() {
  if (!running || gameOver) return;
  paused = false;
  hideAllOverlays();
  lastTime = performance.now();
  requestAnimationFrame(gameLoop);
}

function quitToMenu() {
  running = false;
  paused = false;
  gameOver = false;
  showStartScreen();
}

function showGameOver() {
  running = false;
  gameOver = true;
  finalScoreEl.textContent = score;
  if (score > best) {
    best = score;
    localStorage.setItem('neonGravityBest', best.toString());
    bestEl.textContent = best;
  }
  showOverlay(gameOverOverlay);
}

function flipGravity() {
  if (!running || paused || gameOver) return;
  player.gravity *= -1;
  player.vy = 0;
  player.onFloor = false;
  for (let i = 0; i < 8; i++) {
    particles.push({
      x: player.x + player.w/2,
      y: player.y + player.h/2,
      vx: (Math.random()-0.5)*8,
      vy: (Math.random()-0.5)*8,
      life: 1,
      color: `hsl(${Math.random()*60+180}, 100%, 50%)`
    });
  }
}

function spawnObstacle() {
  const gap = 180;
  const minGapY = 100;
  const maxGapY = height - gap - 100;
  const gapY = Math.random() * (maxGapY - minGapY) + minGapY;
  const thickness = 60;
  obstacles.push({
    x: width,
    topH: gapY,
    bottomY: gapY + gap,
    bottomH: height - (gapY + gap),
    width: thickness,
    passed: false,
    color: `hsl(${Math.random() * 60 + 180}, 100%, 50%)`
  });
}

function update(dt) {
  if (paused || gameOver) return;

  player.vy += player.gravity * 0.8 * dt * 60;
  player.y += player.vy * dt * 60;

  if (player.gravity === 1 && player.y + player.h >= height) {
    player.y = height - player.h;
    player.vy = 0;
    player.onFloor = true;
  } else if (player.gravity === -1 && player.y <= 0) {
    player.y = 0;
    player.vy = 0;
    player.onFloor = true;
  } else {
    player.onFloor = false;
  }

  obstacleTimer += dt * 1000;
  if (obstacleTimer >= obstacleInterval) {
    spawnObstacle();
    obstacleTimer = 0;
    obstacleInterval = Math.max(800, obstacleInterval * 0.995);
    speed = Math.min(15, speed * 1.001);
  }

  for (let i = obstacles.length - 1; i >= 0; i--) {
    const obs = obstacles[i];
    obs.x -= speed * dt * 60;

    const playerLeft = player.x;
    const playerRight = player.x + player.w;
    const playerTop = player.y;
    const playerBottom = player.y + player.h;

    const obsLeft = obs.x;
    const obsRight = obs.x + obs.width;
    const obsTop = obs.topH;
    const obsBottom = obs.bottomY;

    if (playerRight > obsLeft && playerLeft < obsRight) {
      if (playerTop < obsTop || playerBottom > obsBottom) {
        showGameOver();
        return;
      }
    }

    if (!obs.passed && obsRight < player.x) {
      obs.passed = true;
      score++;
      scoreEl.textContent = score;
    }

    if (obsRight < 0) {
      obstacles.splice(i, 1);
    }
  }

  for (let i = particles.length - 1; i >= 0; i--) {
    const p = particles[i];
    p.x += p.vx;
    p.y += p.vy;
    p.life -= 0.02;
    if (p.life <= 0) particles.splice(i, 1);
  }

  bgOffset = (bgOffset + speed * 0.5 * dt * 60) % 50;
}

function draw() {
  ctx.fillStyle = '#05050a';
  ctx.fillRect(0, 0, width, height);

  ctx.strokeStyle = 'rgba(0,255,204,0.05)';
  ctx.lineWidth = 1;
  const gridSize = 50;
  for (let x = -bgOffset; x < width + gridSize; x += gridSize) {
    ctx.beginPath();
    ctx.moveTo(x, 0);
    ctx.lineTo(x, height);
    ctx.stroke();
  }
  for (let y = -bgOffset; y < height + gridSize; y += gridSize) {
    ctx.beginPath();
    ctx.moveTo(0, y);
    ctx.lineTo(width, y);
    ctx.stroke();
  }

  for (const obs of obstacles) {
    const gradient = ctx.createLinearGradient(obs.x, 0, obs.x + obs.width, 0);
    gradient.addColorStop(0, obs.color);
    gradient.addColorStop(1, '#00ffcc');
    ctx.fillStyle = gradient;
    ctx.shadowColor = obs.color;
    ctx.shadowBlur = 20;
    ctx.fillRect(obs.x, 0, obs.width, obs.topH);
    ctx.fillRect(obs.x, obs.bottomY, obs.width, obs.bottomH);
    ctx.shadowBlur = 0;
  }

  ctx.fillStyle = player.color;
  ctx.shadowColor = player.color;
  ctx.shadowBlur = 15;
  ctx.fillRect(player.x, player.y, player.w, player.h);
  ctx.shadowBlur = 0;

  for (const p of particles) {
    ctx.globalAlpha = p.life;
    ctx.fillStyle = p.color;
    ctx.beginPath();
    ctx.arc(p.x, p.y, 3, 0, Math.PI * 2);
    ctx.fill();
  }
  ctx.globalAlpha = 1;
}

function gameLoop(time) {
  if (!running) return;
  const dt = (time - lastTime) / 1000;
  lastTime = time;
  update(dt);
  draw();
  if (running && !paused && !gameOver) {
    requestAnimationFrame(gameLoop);
  }
}

// Event listeners
document.getElementById('startBtn').addEventListener('click', startGame);
document.getElementById('resumeBtn').addEventListener('click', resumeGame);
document.getElementById('quitBtn').addEventListener('click', quitToMenu);
document.getElementById('retryBtn').addEventListener('click', startGame);
document.getElementById('menuBtn').addEventListener('click', quitToMenu);

window.addEventListener('keydown', (e) => {
  if (e.code === 'Space') {
    e.preventDefault();
    flipGravity();
  } else if (e.code === 'Escape' || e.code === 'KeyP') {
    if (running && !gameOver) {
      if (paused) resumeGame();
      else pauseGame();
    }
  }
}, { passive: false });

canvas.addEventListener('click', flipGravity, { passive: false });
canvas.addEventListener('touchstart', (e) => {
  e.preventDefault();
  flipGravity();
}, { passive: false });

// Prevent context menu on long press
canvas.addEventListener('contextmenu', (e) => e.preventDefault());

// Initialize start screen
showStartScreen();
</script>
</body>
</html>