<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no">
<title>Neon Rhythm - Day 44</title>
<style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body { background: #0a0a12; color: #0ff; font-family: 'Courier New', monospace; overflow: hidden; height: 100vh; display: flex; flex-direction: column; align-items: center; justify-content: center; }
    canvas { display: block; border: 2px solid #0ff; box-shadow: 0 0 20px #0ff, inset 0 0 20px #001122; background: #000; }
    .overlay { position: absolute; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.9); display: flex; flex-direction: column; align-items: center; justify-content: center; z-index: 10; gap: 20px; }
    .overlay.hidden { display: none; }
    .overlay h1 { font-size: 3rem; text-shadow: 0 0 10px #0ff, 0 0 20px #0ff; letter-spacing: 4px; margin-bottom: 10px; }
    .overlay p { font-size: 1.2rem; color: #8ff; margin-bottom: 20px; }
    .btn { padding: 15px 40px; font-size: 1.2rem; font-family: inherit; background: transparent; border: 2px solid #0ff; color: #0ff; cursor: pointer; transition: all 0.2s; text-transform: uppercase; letter-spacing: 2px; box-shadow: 0 0 10px #0ff; }
    .btn:hover, .btn:focus { background: #0ff; color: #000; box-shadow: 0 0 20px #0ff, 0 0 40px #0ff; outline: none; }
    .btn:active { transform: scale(0.95); }
    #ui { position: absolute; top: 10px; left: 10px; right: 10px; display: flex; justify-content: space-between; pointer-events: none; z-index: 5; }
    .ui-box { background: rgba(0,0,0,0.7); border: 1px solid #0ff; padding: 10px 20px; border-radius: 4px; box-shadow: 0 0 10px #0ff; }
    .ui-box h3 { font-size: 0.8rem; color: #8ff; margin-bottom: 4px; }
    .ui-box span { font-size: 1.5rem; font-weight: bold; color: #0ff; text-shadow: 0 0 5px #0ff; }
    #healthBar { position: absolute; bottom: 10px; left: 50%; transform: translateX(-50%); width: 80%; max-width: 400px; height: 15px; background: #111; border: 1px solid #0ff; border-radius: 8px; overflow: hidden; box-shadow: 0 0 10px #0ff; pointer-events: none; z-index: 5; }
    #healthFill { height: 100%; background: linear-gradient(90deg, #f00, #ff0, #0f0); width: 100%; transition: width 0.2s; box-shadow: 0 0 10px #0f0; }
    @media (max-width: 600px) { .overlay h1 { font-size: 2rem; } .btn { padding: 12px 30px; font-size: 1rem; } .ui-box span { font-size: 1.2rem; } }
</style>
</head>
<body>
<canvas id="gameCanvas"></canvas>
<div id="ui">
    <div class="ui-box"><h3>SCORE</h3><span id="scoreDisplay">0</span></div>
    <div class="ui-box"><h3>COMBO</h3><span id="comboDisplay">0</span></div>
    <div class="ui-box"><h3>BEST</h3><span id="highScoreDisplay">0</span></div>
</div>
<div id="healthBar"><div id="healthFill"></div></div>

<div id="startScreen" class="overlay">
    <h1>NEON RHYTHM</h1>
    <p>Day 44 - Daily Game Studio</p>
    <p>Arrow Keys / WASD / Tap Lanes</p>
    <button class="btn" id="startBtn">START</button>
</div>

<div id="pauseOverlay" class="overlay hidden">
    <h1>PAUSED</h1>
    <button class="btn" id="resumeBtn">RESUME</button>
    <button class="btn" id="quitBtn">QUIT TO MENU</button>
</div>

<div id="gameOverOverlay" class="overlay hidden">
    <h1>GAME OVER</h1>
    <p id="finalScore">Score: 0</p>
    <button class="btn" id="retryBtn">RETRY</button>
    <button class="btn" id="menuBtn">MAIN MENU</button>
</div>

<script>
/* ===== Neon Rhythm - Day 44 =====
   Rhythm game: notes fall in 4 lanes, hit at bottom.
   Increasing difficulty, health bar, combo, high score.
   Pause/Resume/Quit, touch & keyboard support.
*/

const canvas = document.getElementById('gameCanvas');
const ctx = canvas.getContext('2d');

// Game constants
const LANES = 4;
const KEY_MAP = {
    'ArrowLeft': 0, 'KeyA': 0,
    'ArrowUp': 1, 'KeyW': 1,
    'ArrowDown': 2, 'KeyS': 2,
    'ArrowRight': 3, 'KeyD': 3
};

// Game state variables
let isRunning = false;
let gameState = 'start';
let lastTime = 0;
let animationId = null;

// Gameplay variables
let notes = [];
let noteSpeed = 2.5;
let baseSpawnInterval = 1200;
let spawnInterval = baseSpawnInterval;
let lastSpawn = 0;
let score = 0;
let combo = 0;
let maxCombo = 0;
let health = 100;
let highScore = parseInt(localStorage.getItem('neonRhythmHighScore')) || 0;
let difficultyLevel = 1;
let difficultyTimer = 0;
const DIFFICULTY_INCREASE_TIME = 30000;

// Visuals
let laneWidth = 0;
let hitZoneY = 0;
const NOTE_HEIGHT = 30;
const HIT_WINDOW = 40;

// Audio context for simple beeps
let audioCtx = null;
function playBeep(freq, duration, type = 'square') {
    if (!audioCtx) audioCtx = new (window.AudioContext || window.webkitAudioContext)();
    if (audioCtx.state === 'suspended') audioCtx.resume();
    const osc = audioCtx.createOscillator();
    const gain = audioCtx.createGain();
    osc.type = type;
    osc.frequency.value = freq;
    gain.gain.value = 0.1;
    osc.connect(gain).connect(audioCtx.destination);
    osc.start();
    gain.gain.exponentialRampToValueAtTime(0.001, audioCtx.currentTime + duration);
    osc.stop(audioCtx.currentTime + duration);
}

// DOM elements
const startScreen = document.getElementById('startScreen');
const pauseOverlay = document.getElementById('pauseOverlay');
const gameOverOverlay = document.getElementById('gameOverOverlay');
const startBtn = document.getElementById('startBtn');
const resumeBtn = document.getElementById('resumeBtn');
const quitBtn = document.getElementById('quitBtn');
const retryBtn = document.getElementById('retryBtn');
const menuBtn = document.getElementById('menuBtn');
const scoreDisplay = document.getElementById('scoreDisplay');
const comboDisplay = document.getElementById('comboDisplay');
const highScoreDisplay = document.getElementById('highScoreDisplay');
const healthFill = document.getElementById('healthFill');
const finalScore = document.getElementById('finalScore');

// Initialize high score display
highScoreDisplay.textContent = highScore;

// Resize canvas
function resizeCanvas() {
    const maxWidth = window.innerWidth - 20;
    const maxHeight = window.innerHeight - 20;
    const size = Math.min(maxWidth, maxHeight, 600);
    canvas.width = size;
    canvas.height = size;
    laneWidth = canvas.width / LANES;
    hitZoneY = canvas.height - 50;
}
window.addEventListener('resize', resizeCanvas);
resizeCanvas();

// Input handling
const keysPressed = new Set();
document.addEventListener('keydown', e => {
    if (KEY_MAP[e.code] !== undefined) {
        e.preventDefault();
        keysPressed.add(KEY_MAP[e.code]);
    }
    if (e.code === 'Escape' || e.code === 'KeyP') {
        if (gameState === 'playing') pauseGame();
        else if (gameState === 'paused') resumeGame();
    }
});
document.addEventListener('keyup', e => {
    if (KEY_MAP[e.code] !== undefined) {
        keysPressed.delete(KEY_MAP[e.code]);
    }
});

// Touch controls
const laneElements = [];
for (let i = 0; i < LANES; i++) {
    const lane = document.createElement('div');
    lane.style.position = 'absolute';
    lane.style.left = (i / LANES * 100) + '%';
    lane.style.top = '0';
    lane.style.width = (100 / LANES) + '%';
    lane.style.height = '100%';
    lane.style.zIndex = '3';
    lane.dataset.lane = i;
    canvas.parentElement.appendChild(lane);
    laneElements.push(lane);
}
laneElements.forEach(lane => {
    lane.addEventListener('touchstart', e => {
        e.preventDefault();
        const laneIndex = parseInt(lane.dataset.lane);
        keysPressed.add(laneIndex);
    }, { passive: false });
    lane.addEventListener('touchend', e => {
        e.preventDefault();
        const laneIndex = parseInt(lane.dataset.lane);
        keysPressed.delete(laneIndex);
    }, { passive: false });
});

// Button events
startBtn.addEventListener('click', startGame);
resumeBtn.addEventListener('click', resumeGame);
quitBtn.addEventListener('click', quitToMenu);
retryBtn.addEventListener('click', startGame);
menuBtn.addEventListener('click', showStartScreen);

// Game functions
function startGame() {
    // Reset state
    notes = [];
    noteSpeed = 2.5;
    spawnInterval = baseSpawnInterval;
    lastSpawn = 0;
    score = 0;
    combo = 0;
    maxCombo = 0;
    health = 100;
    difficultyLevel = 1;
    difficultyTimer = 0;
    updateUI();
    healthFill.style.width = '100%';
    hideAllOverlays();
    gameState = 'playing';
    isRunning = true;
    lastTime = performance.now();
    if (!animationId) gameLoop(lastTime);
}

function pauseGame() {
    if (gameState !== 'playing') return;
    gameState = 'paused';
    isRunning = false;
    pauseOverlay.classList.remove('hidden');
}

function resumeGame() {
    if (gameState !== 'paused') return;
    gameState = 'playing';
    isRunning = true;
    pauseOverlay.classList.add('hidden');
    lastTime = performance.now();
    gameLoop(lastTime);
}

function quitToMenu() {
    gameState = 'start';
    isRunning = false;
    hideAllOverlays();
    startScreen.classList.remove('hidden');
}

function showStartScreen() {
    quitToMenu();
}

function hideAllOverlays() {
    startScreen.classList.add('hidden');
    pauseOverlay.classList.add('hidden');
    gameOverOverlay.classList.add('hidden');
}

function updateUI() {
    scoreDisplay.textContent = score;
    comboDisplay.textContent = combo;
    highScoreDisplay.textContent = highScore;
    healthFill.style.width = health + '%';
}

function gameLoop(timestamp) {
    if (!isRunning) return;
    const dt = timestamp - lastTime;
    lastTime = timestamp;

    update(dt);
    draw();

    animationId = requestAnimationFrame(gameLoop);
}

function update(dt) {
    if (gameState !== 'playing') return;

    // Difficulty increase
    difficultyTimer += dt;
    if (difficultyTimer >= DIFFICULTY_INCREASE_TIME) {
        difficultyLevel++;
        difficultyTimer = 0;
        noteSpeed *= 1.05;
        spawnInterval = Math.max(400, baseSpawnInterval / difficultyLevel);
    }

    // Spawn notes
    lastSpawn += dt;
    if (lastSpawn >= spawnInterval) {
        spawnNote();
        lastSpawn = 0;
    }

    // Update notes
    for (let i = notes.length - 1; i >= 0; i--) {
        const note = notes[i];
        note.y += noteSpeed * (dt / 16.67); // normalize to 60fps

        // Check if note passed hit zone without being hit
        if (note.y - NOTE_HEIGHT/2 > hitZoneY + HIT_WINDOW && !note.hit) {
            missNote(i);
        }
        // Remove notes that are far below
        if (note.y > canvas.height + 100) {
            notes.splice(i, 1);
        }
    }

    // Check key presses for hits
    keysPressed.forEach(lane => {
        checkHit(lane);
    });
}

function spawnNote() {
    const lane = Math.floor(Math.random() * LANES);
    notes.push({
        lane: lane,
        y: -NOTE_HEIGHT,
        hit: false,
        color: `hsl(${lane * 90 + 180}, 100%, 50%)`
    });
}

function checkHit(lane) {
    for (let i = 0; i < notes.length; i++) {
        const note = notes[i];
        if (note.lane === lane && !note.hit) {
            const dist = Math.abs(note.y - hitZoneY);
            if (dist <= HIT_WINDOW) {
                hitNote(i, dist);
                return;
            }
        }
    }
    // If no note hit, it's a bad press - small penalty
    health = Math.max(0, health - 2);
    combo = 0;
    updateUI();
}

function hitNote(index, accuracy) {
    const note = notes[index];
    note.hit = true;
    
    // Score based on accuracy
    let points = 100;
    if (accuracy < 10) points = 300;
    else if (accuracy < 20) points = 200;
    else if (accuracy < 30) points = 100;
    else points = 50;
    
    score += points * (1 + Math.min(combo / 10, 5));
    combo++;
    maxCombo = Math.max(maxCombo, combo);
    
    // Health recovery
    health = Math.min(100, health + 1);
    
    // Visual feedback
    createHitEffect(note.lane, accuracy < 15 ? 'perfect' : 'good');
    
    // Sound
    playBeep(440 + note.lane * 100 + combo * 10, 0.1);
    
    // Remove note after brief moment
    setTimeout(() => {
        const idx = notes.indexOf(note);
        if (idx !== -1) notes.splice(idx, 1);
    }, 100);
    
    updateUI();
}

function missNote(index) {
    const note = notes[index];
    notes.splice(index, 1);
    
    health -= 10;
    combo = 0;
    
    createHitEffect(note.lane, 'miss');
    playBeep(200, 0.2, 'sawtooth');
    
    if (health <= 0) {
        gameOver();
    }
    
    updateUI();
}

function createHitEffect(lane, type) {
    // Simple particle effect
    for (let i = 0; i < 8; i++) {
        const angle = Math.random() * Math.PI * 2;
        const speed = 2 + Math.random() * 3;
        notes.push({
            lane: lane,
            y: hitZoneY,
            hit: true,
            isEffect: true,
            vx: Math.cos(angle) * speed,
            vy: Math.sin(angle) * speed,
            life: 30,
            color: type === 'perfect' ? '#0ff' : type === 'good' ? '#0f0' : '#f00'
        });
    }
}

function gameOver() {
    isRunning = false;
    gameState = 'gameover';
    
    if (score > highScore) {
        highScore = score;
        localStorage.setItem('neonRhythmHighScore', highScore);
    }
    
    finalScore.textContent = `Score: ${score} | Max Combo: ${maxCombo} | Best: ${highScore}`;
    hideAllOverlays();
    gameOverOverlay.classList.remove('hidden');
}

function draw() {
    // Clear
    ctx.fillStyle = '#000';
    ctx.fillRect(0, 0, canvas.width, canvas.height);
    
    // Draw lanes
    for (let i = 0; i < LANES; i++) {
        const x = i * laneWidth;
        // Lane background
        ctx.fillStyle = i % 2 === 0 ? '#001122' : '#000';
        ctx.fillRect(x, 0, laneWidth, canvas.height);
        
        // Lane separator
        ctx.strokeStyle = '#003344';
        ctx.lineWidth = 1;
        ctx.beginPath();
        ctx.moveTo(x, 0);
        ctx.lineTo(x, canvas.height);
        ctx.stroke();
    }
    
    // Draw hit zone line
    ctx.strokeStyle = '#0ff';
    ctx.lineWidth = 3;
    ctx.shadowColor = '#0ff';
    ctx.shadowBlur = 10;
    ctx.beginPath();
    ctx.moveTo(0, hitZoneY);
    ctx.lineTo(canvas.width, hitZoneY);
    ctx.stroke();
    ctx.shadowBlur = 0;
    
    // Draw hit zone indicators
    for (let i = 0; i < LANES; i++) {
        const x = i * laneWidth + laneWidth / 2;
        ctx.fillStyle = '#0ff';
        ctx.beginPath();
        ctx.arc(x, hitZoneY, 12, 0, Math.PI * 2);
        ctx.fill();
        
        // Highlight if key pressed
        if (keysPressed.has(i)) {
            ctx.fillStyle = 'rgba(0, 255, 255, 0.3)';
            ctx.beginPath();
            ctx.arc(x, hitZoneY, 20, 0, Math.PI * 2);
            ctx.fill();
        }
    }
    
    // Draw notes
    notes.forEach(note => {
        if (note.isEffect) {
            // Particle effect
            note.x = (note.lane + 0.5) * laneWidth + (note.vx * (30 - note.life));
            note.y += note.vy;
            note.life--;
            
            ctx.globalAlpha = note.life / 30;
            ctx.fillStyle = note.color;
            ctx.beginPath();
            ctx.arc(note.x, note.y, 3, 0, Math.PI * 2);
            ctx.fill();
            ctx.globalAlpha = 1;
            
            if (note.life <= 0) {
                const idx = notes.indexOf(note);
                if (idx !== -1) notes.splice(idx, 1);
            }
            return;
        }
        
        const x = note.lane * laneWidth + laneWidth / 2;
        const y = note.y;
        
        if (note.hit) return; // Don't draw hit notes (they're removed quickly)
        
        // Note body
        ctx.fillStyle = note.color;
        ctx.shadowColor = note.color;
        ctx.shadowBlur = 15;
        ctx.fillRect(
            note.lane * laneWidth + 4,
            y - NOTE_HEIGHT / 2,
            laneWidth - 8,
            NOTE_HEIGHT
        );
        ctx.shadowBlur = 0;
        
        // Note glow
        ctx.strokeStyle = note.color;
        ctx.lineWidth = 2;
        ctx.strokeRect(
            note.lane * laneWidth + 4,
            y - NOTE_HEIGHT / 2,
            laneWidth - 8,
            NOTE_HEIGHT
        );
    });
    
    // Draw lane numbers
    ctx.fillStyle = '#0ff';
    ctx.font = '14px Courier New';
    ctx.textAlign = 'center';
    for (let i = 0; i < LANES; i++) {
        ctx.fillText(
            ['←', '↑', '↓', '→'][i],
            i * laneWidth + laneWidth / 2,
            canvas.height - 20
        );
    }
}
</script>
</body>
</html>