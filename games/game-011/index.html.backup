<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no">
<title>Neon Asteroids</title>
<style>
* { margin: 0; padding: 0; box-sizing: border-box; }
body {
    background: #0a0a12;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    font-family: 'Orbitron', 'Courier New', monospace;
    color: #00ffea;
    overflow: hidden;
    touch-action: none;
}
@import url('https://fonts.googleapis.com/css2?family=Orbitron:wght@400;700;900&display=swap');

#gameContainer {
    position: relative;
    border: 3px solid #00ffea;
    border-radius: 8px;
    box-shadow: 
        0 0 30px #00ffea,
        0 0 60px #cc00ff,
        inset 0 0 30px rgba(0, 255, 234, 0.1);
    background: #050510;
}
canvas { display: block; }

#ui {
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    pointer-events: none;
    display: flex;
    flex-direction: column;
    padding: 16px;
}
#topBar {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
}
.statBox {
    background: rgba(0, 20, 30, 0.85);
    border: 1px solid #00ffea44;
    border-radius: 6px;
    padding: 8px 16px;
    backdrop-filter: blur(4px);
}
.statLabel { font-size: 10px; color: #00ffea88; text-transform: uppercase; letter-spacing: 1px; }
.statValue { font-size: 22px; font-weight: 700; color: #00ffea; text-shadow: 0 0 10px #00ffea; font-variant-numeric: tabular-nums; }
#highScore .statValue { color: #ffcc00; text-shadow: 0 0 10px #ffcc00; }
#wave .statValue { color: #cc00ff; text-shadow: 0 0 10px #cc00ff; }
#lives .statValue { color: #ff3366; text-shadow: 0 0 10px #ff3366; }

#bottomBar { margin-top: auto; display: flex; justify-content: center; gap: 12px; }
.controlHint {
    background: rgba(0, 20, 30, 0.85);
    border: 1px solid #00ffea44;
    border-radius: 20px;
    padding: 6px 14px;
    font-size: 11px;
    color: #00ffea88;
    display: flex;
    align-items: center;
    gap: 6px;
}
.controlHint kbd {
    background: #001122;
    border: 1px solid #00ffea66;
    border-radius: 4px;
    padding: 2px 8px;
    font-family: inherit;
    font-size: 10px;
    color: #00ffea;
}

#startScreen, #gameOverScreen {
    position: absolute;
    inset: 0;
    background: rgba(5, 5, 16, 0.98);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 24px;
    z-index: 10;
    backdrop-filter: blur(8px);
}
#startScreen.hidden, #gameOverScreen.hidden { display: none; }
.title {
    font-size: clamp(32px, 8vw, 56px);
    font-weight: 900;
    background: linear-gradient(135deg, #00ffea, #cc00ff, #ffcc00);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    text-shadow: none;
    letter-spacing: 4px;
    animation: pulse 2s ease-in-out infinite;
}
@keyframes pulse { 0%,100% { filter: brightness(1); } 50% { filter: brightness(1.3); } }
.subtitle { font-size: 14px; color: #00ffea88; letter-spacing: 3px; text-transform: uppercase; }
.btn {
    background: linear-gradient(135deg, #003344, #001122);
    border: 2px solid #00ffea;
    color: #00ffea;
    padding: 14px 48px;
    font-size: 16px;
    font-weight: 700;
    font-family: inherit;
    border-radius: 4px;
    cursor: pointer;
    text-transform: uppercase;
    letter-spacing: 2px;
    transition: all 0.2s;
    box-shadow: 0 0 20px #00ffea44;
}
.btn:hover, .btn:focus { background: linear-gradient(135deg, #00ffea, #cc00ff); color: #000; box-shadow: 0 0 30px #00ffea, 0 0 60px #cc00ff; outline: none; }
.btn:active { transform: scale(0.96); }

#finalScore { font-size: 28px; font-weight: 700; color: #00ffea; text-shadow: 0 0 15px #00ffea; }
#bestScore { font-size: 16px; color: #ffcc00; text-shadow: 0 0 10px #ffcc00; }

.overlay {
    position: absolute;
    inset: 0;
    background: rgba(5, 5, 16, 0.98);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 16px;
    z-index: 20;
    backdrop-filter: blur(8px);
}
.overlay.hidden { display: none; }
.overlay h1 { font-size: clamp(28px, 6vw, 48px); font-weight: 900; background: linear-gradient(135deg, #00ffea, #cc00ff); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text; }
.overlay p { font-size: 18px; color: #00ffea88; }
.overlay .btn { margin-top: 8px; }

@media (max-width: 600px) {
    #gameContainer { border-width: 2px; border-radius: 0; width: 100vw; height: 100vh; max-width: 100%; max-height: 100%; }
    body { align-items: stretch; justify-content: stretch; }
    #ui { padding: 12px; }
    .statValue { font-size: 18px; }
    .controlHint { padding: 5px 10px; font-size: 10px; }
}
</style>
</head>
<body>
<div id="gameContainer">
    <canvas id="canvas"></canvas>
    <div id="ui">
        <div id="topBar">
            <div class="statBox" id="score">
                <div class="statLabel">Score</div>
                <div class="statValue" id="scoreVal">0</div>
            </div>
            <div class="statBox" id="highScore">
                <div class="statLabel">Best</div>
                <div class="statValue" id="highScoreVal">0</div>
            </div>
            <div class="statBox" id="wave">
                <div class="statLabel">Wave</div>
                <div class="statValue" id="waveVal">1</div>
            </div>
            <div class="statBox" id="lives">
                <div class="statLabel">Lives</div>
                <div class="statValue" id="livesVal">3</div>
            </div>
        </div>
        <div id="bottomBar">
            <div class="controlHint"><kbd>←</kbd> <kbd>→</kbd> Rotate</div>
            <div class="controlHint"><kbd>↑</kbd> / <kbd>W</kbd> Thrust</div>
            <div class="controlHint"><kbd>Space</kbd> Fire</div>
        </div>
    </div>

    <div id="startScreen">
        <div class="title">NEON ASTEROIDS</div>
        <div class="subtitle">Classic Arcade Action</div>
        <button class="btn" id="startBtn">Start Game</button>
    </div>

    <div id="gameOverScreen" class="hidden">
        <div class="title">GAME OVER</div>
        <div id="finalScore">Score: 0</div>
        <div id="bestScore">Best: 0</div>
        <button class="btn" id="restartBtn">Play Again</button>
    </div>

    <div class="overlay hidden" id="pauseOverlay">
        <h1>PAUSED</h1>
        <p>Wave <span id="pauseWave">1</span> • Score <span id="pauseScore">0</span></p>
        <button class="btn" id="resumeBtn">RESUME</button>
        <button class="btn" id="quitBtn">QUIT TO MENU</button>
    </div>

    <div class="overlay hidden" id="gameOverOverlay">
        <h1 style="color: #ff3366;">GAME OVER</h1>
        <p>Final Score: <span id="finalScoreOverlay" style="color: #00ffea;">0</span></p>
        <p id="highScoreMsg" style="color: #ffd700;"></p>
        <button class="btn" id="retryBtn">RETRY</button>
        <button class="btn" id="menuBtn">MAIN MENU</button>
    </div>
</div>

<script>
// ============================================
// NEON ASTEROIDS - Classic Arcade Recreation
// ============================================

const canvas = document.getElementById('canvas');
const ctx = canvas.getContext('2d');

// --- Config ---
const CONFIG = {
    baseWidth: 800,
    baseHeight: 600,
    ship: {
        radius: 16,
        turnSpeed: 0.08,
        thrustPower: 0.3,
        maxSpeed: 8,
        friction: 0.99,
        fireRate: 200,
        bulletSpeed: 12,
        lives: 3
    },
    asteroid: {
        minSize: 20,
        maxSize: 60,
        speeds: { large: 1.5, medium: 2.5, small: 4 },
        vertices: { min: 7, max: 12 },
        points: { large: 20, medium: 50, small: 100 }
    },
    ufo: {
        spawnChance: 0.001,
        speed: 2,
        fireRate: 1500,
        bulletSpeed: 5,
        points: 200
    },
    bullet: {
        speed: 12,
        life: 60,
        maxBullets: 8
    },
    particle: {
        max: 200,
        colors: ['#00ffea', '#ff006e', '#ffbe0b', '#cc00ff', '#00ff88', '#ffbe0b']
    },
    starCount: 100
};

// --- Utility ---
const wrap = (pos, size) => {
    if (pos < 0) return size;
    if (pos > size) return 0;
    return pos;
};
const rand = (min, max) => Math.random() * (max - min) + min;
const randInt = (min, max) => Math.floor(Math.random() * (max - min + 1)) + min;
const clamp = (v, min, max) => Math.max(min, Math.min(max, v));
const dist = (x1, y1, x2, y2) => Math.hypot(x2 - x1, y2 - y1);
const angleTo = (x1, y1, x2, y2) => Math.atan2(y2 - y1, x2 - x1);
const choose = (arr) => arr[Math.floor(Math.random() * arr.length)];

// ===== Vec2 =====
class Vec2 {
    constructor(x = 0, y = 0) { this.x = x; this.y = y; }
    set(x, y) { this.x = x; this.y = y; return this; }
    copy(v) { this.x = v.x; this.y = v.y; return this; }
    add(v) { this.x += v.x; this.y += v.y; return this; }
    sub(v) { this.x -= v.x; this.y -= v.y; return this; }
    mul(s) { this.x *= s; this.y *= s; return this; }
    div(s) { this.x /= s; this.y /= s; return this; }
    len() { return Math.hypot(this.x, this.y); }
    lenSq() { return this.x * this.x + this.y * this.y; }
    normalize() { const l = this.len(); if (l > 0) this.div(l); return this; }
    limit(max) { const l = this.len(); if (l > max) this.mul(max / l); return this; }
    angle() { return Math.atan2(this.y, this.x); }
    rotate(a) { const c = Math.cos(a), s = Math.sin(a); const x = this.x * c - this.y * s; this.y = this.x * s + this.y * c; this.x = x; return this; }
    clone() { return new Vec2(this.x, this.y); }
    static fromAngle(a) { return new Vec2(Math.cos(a), Math.sin(a)); }
}

// ===== Particle System =====
class Particle {
    constructor(x, y, color, size, life, velocity, gravity = 0, fade = true) {
        this.pos = new Vec2(x, y);
        this.vel = velocity || new Vec2();
        this.color = color;
        this.size = size;
        this.maxSize = size;
        this.life = life;
        this.maxLife = life;
        this.gravity = gravity;
        this.fade = fade;
    }
    update(dt) {
        this.pos.add(this.vel.mul(dt));
        this.vel.y += this.gravity * dt;
        this.life -= dt;
        if (this.fade) this.size = this.maxSize * (this.life / this.maxLife);
    }
    draw(ctx) {
        if (this.life <= 0) return;
        ctx.save();
        ctx.translate(this.pos.x, this.pos.y);
        ctx.fillStyle = this.color;
        ctx.shadowColor = this.color;
        ctx.shadowBlur = 10;
        ctx.globalAlpha = this.life / this.maxLife;
        ctx.beginPath();
        ctx.arc(0, 0, this.size, 0, Math.PI * 2);
        ctx.fill();
        ctx.restore();
    }
}

class ParticleSystem {
    constructor() { this.particles = []; }
    emit(x, y, color, count, options = {}) {
        for (let i = 0; i < count; i++) {
            const ang = rand(0, Math.PI * 2);
            const speed = rand(options.minSpeed || 50, options.maxSpeed || 150);
            const vel = Vec2.fromAngle(ang).mul(speed);
            this.particles.push(new Particle(
                x, y, color,
                rand(options.minSize || 2, options.maxSize || 5),
                rand(options.minLife || 0.1, options.maxLife || 0.3),
                vel,
                options.gravity || 0,
                options.fade !== false
            ));
        }
    }
    update(dt) {
        for (let i = this.particles.length - 1; i >= 0; i--) {
            this.particles[i].update(dt);
            if (this.particles[i].life <= 0) this.particles.splice(i, 1);
        }
    }
    draw(ctx) { this.particles.forEach(p => p.draw(ctx)); }
}

// ===== Entity Base =====
class Entity {
    constructor(x, y, radius) {
        this.pos = new Vec2(x, y);
        this.vel = new Vec2();
        this.radius = radius;
        this.active = true;
        this.color = '#fff';
        this.glowColor = '#fff';
    }
    update(dt) { this.pos.add(this.vel.mul(dt)); }
    draw(ctx) {
        ctx.save();
        ctx.translate(this.pos.x, this.pos.y);
        ctx.fillStyle = this.color;
        ctx.shadowColor = this.glowColor;
        ctx.shadowBlur = 15;
        ctx.beginPath();
        ctx.arc(0, 0, this.radius, 0, Math.PI * 2);
        ctx.fill();
        ctx.restore();
    }
    destroy() { this.active = false; }
}

// --- State ---
let state = {
    running: false,
    paused: false,
    score: 0,
    highScore: 0,
    lives: 3,
    level: 1,
    ship: null,
    bullets: [],
    asteroids: [],
    ufo: null,
    ufoBullets: [],
    particles: new ParticleSystem(),
    stars: [],
    screenShake: 0,
    gameTime: 0,
    lastFire: 0,
    ufoSpawnTimer: 0,
    scaleX: 1,
    scaleY: 1,
    keys: { left: false, right: false, up: false, fire: false },
    touchControls: { rotate: 0, thrust: false, fire: false }
};

// --- Starfield ---
function initStars() {
    state.stars = [];
    for (let i = 0; i < CONFIG.starCount; i++) {
        state.stars.push({
            x: Math.random() * CONFIG.baseWidth,
            y: Math.random() * CONFIG.baseHeight,
            size: Math.random() * 1.5 + 0.5,
            speed: Math.random() * 0.5 + 0.1,
            brightness: Math.random() * 0.5 + 0.5
        });
    }
}

// --- Ship Class ---
class Ship {
    constructor() {
        this.pos = new Vec2(CONFIG.baseWidth / 2, CONFIG.baseHeight / 2);
        this.vel = new Vec2();
        this.rotation = -Math.PI / 2;
        this.radius = CONFIG.ship.radius;
        this.thrusting = false;
        this.invulnerable = 0;
        this.blinkTimer = 0;
        this.visible = true;
        this.active = true;
    }
    update(dt) {
        if (!this.active) return;
        
        // Rotation
        let rotInput = 0;
        if (state.keys.left || state.touchControls.rotate < 0) rotInput -= 1;
        if (state.keys.right || state.touchControls.rotate > 0) rotInput += 1;
        this.rotation += rotInput * CONFIG.ship.turnSpeed * dt * 60;
        
        // Thrust
        this.thrusting = state.keys.up || state.touchControls.thrust;
        if (this.thrusting) {
            const thrust = Vec2.fromAngle(this.rotation).mul(CONFIG.ship.thrustPower * dt * 60);
            this.vel.add(thrust);
            // Thrust particles
            const backAngle = this.rotation + Math.PI;
            const backPos = this.pos.clone().add(Vec2.fromAngle(backAngle).mul(this.radius * 0.8));
            state.particles.emit(backPos.x, backPos.y, '#00ffea', 2, {
                minSpeed: 30, maxSpeed: 80,
                minSize: 1, maxSize: 3,
                minLife: 0.05, maxLife: 0.15
            });
        }
        
        // Physics
        this.vel.mul(CONFIG.ship.friction);
        this.vel.limit(CONFIG.ship.maxSpeed);
        this.pos.add(this.vel.mul(dt * 60));
        
        // Screen wrap
        this.pos.x = wrap(this.pos.x, CONFIG.baseWidth);
        this.pos.y = wrap(this.pos.y, CONFIG.baseHeight);
        
        // Invulnerability
        if (this.invulnerable > 0) {
            this.invulnerable -= dt;
            this.blinkTimer += dt;
            this.visible = Math.floor(this.blinkTimer * 10) % 2 === 0;
        } else {
            this.visible = true;
        }
        
        // Fire
        if ((state.keys.fire || state.touchControls.fire) && state.gameTime - state.lastFire > CONFIG.ship.fireRate) {
            this.fire();
            state.lastFire = state.gameTime;
            state.keys.fire = false;
            state.touchControls.fire = false;
        }
    }
    fire() {
        if (state.bullets.length >= CONFIG.bullet.maxBullets) return;
        const nose = this.pos.clone().add(Vec2.fromAngle(this.rotation).mul(this.radius));
        const vel = Vec2.fromAngle(this.rotation).mul(CONFIG.ship.bulletSpeed);
        state.bullets.push(new Bullet(nose.x, nose.y, vel, true));
        // Muzzle flash
        state.particles.emit(nose.x, nose.y, '#00ffea', 5, {
            minSpeed: 50, maxSpeed: 150,
            minSize: 2, maxSize: 4,
            minLife: 0.05, maxLife: 0.1
        });
    }
    draw(ctx) {
        if (!this.active || !this.visible) return;
        ctx.save();
        ctx.translate(this.pos.x, this.pos.y);
        ctx.rotate(this.rotation);
        
        // Ship body
        ctx.strokeStyle = this.thrusting ? '#00ffea' : '#00cccc';
        ctx.lineWidth = 2;
        ctx.shadowColor = '#00ffea';
        ctx.shadowBlur = 10;
