<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no">
<title>Neon Flood - Day 32</title>
<style>
  * { margin:0; padding:0; box-sizing:border-box; font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; }
  body { background:#0a0a12; color:#e0e0ff; overflow:hidden; touch-action:none; }
  canvas { display:block; background:#05050a; }
  #ui { position:absolute; top:0; left:0; width:100%; height:100%; pointer-events:none; }
  .panel { position:absolute; background:rgba(10,10,30,0.95); border:2px solid #00ffff; border-radius:12px; padding:20px; box-shadow:0 0 20px #00ffff88, inset 0 0 20px #00ffff22; pointer-events:auto; }
  .panel h1 { font-size:2.5rem; text-align:center; margin-bottom:10px; background:linear-gradient(90deg,#00ffff,#ff00ff,#ffff00); -webkit-background-clip:text; background-clip:text; color:transparent; text-shadow:0 0 10px #00ffff; }
  .panel p { text-align:center; margin:10px 0; font-size:1.2rem; color:#aaccff; }
  .btn { display:block; width:100%; padding:14px; margin:12px 0; background:linear-gradient(135deg,#111133,#222255); border:2px solid #00ffff; border-radius:8px; color:#00ffff; font-size:1.1rem; font-weight:bold; cursor:pointer; transition:all 0.2s; text-transform:uppercase; letter-spacing:1px; }
  .btn:hover, .btn:active { background:linear-gradient(135deg,#00ffff44,#ff00ff44); box-shadow:0 0 15px #00ffff, inset 0 0 10px #00ffff88; color:#fff; transform:scale(1.02); }
  .btn:disabled { opacity:0.5; cursor:not-allowed; transform:none; }
  .stat-row { display:flex; justify-content:space-between; margin:8px 0; font-size:1.1rem; }
  .stat-label { color:#88aaff; }
  .stat-value { color:#00ffff; font-weight:bold; text-shadow:0 0 5px #00ffff; }
  .color-btns { display:flex; justify-content:center; gap:8px; flex-wrap:wrap; margin-top:15px; pointer-events:auto; }
  .color-btn { width:50px; height:50px; border-radius:50%; border:3px solid transparent; cursor:pointer; transition:transform 0.1s, box-shadow 0.1s; box-shadow:0 0 10px currentColor; }
  .color-btn:hover, .color-btn:active { transform:scale(1.15); box-shadow:0 0 20px currentColor; }
  .color-btn.selected { border-color:#fff; box-shadow:0 0 25px #fff, 0 0 40px currentColor; transform:scale(1.2); }
  .hidden { display:none !important; }
  @media (max-width:600px) { .panel { margin:10px; padding:15px; } .panel h1 { font-size:1.8rem; } .btn { padding:12px; font-size:1rem; } .color-btn { width:44px; height:44px; } }
</style>
</head>
<body>
<canvas id="gameCanvas"></canvas>
<div id="ui">
  <div id="startScreen" class="panel" style="top:50%; left:50%; transform:translate(-50%,-50%); min-width:300px; max-width:90%; z-index:10;">
    <h1>NEON FLOOD</h1>
    <p>Flood the grid with neon light!</p>
    <div class="stat-row"><span class="stat-label">HIGH SCORE</span><span class="stat-value" id="highScoreDisplay">0</span></div>
    <button class="btn" id="startBtn">START GAME</button>
  </div>

  <div id="pauseOverlay" class="panel hidden" style="top:50%; left:50%; transform:translate(-50%,-50%); min-width:280px; z-index:20;">
    <h1>PAUSED</h1>
    <button class="btn" id="resumeBtn">RESUME</button>
    <button class="btn" id="quitBtn">QUIT TO MENU</button>
  </div>

  <div id="gameOverOverlay" class="panel hidden" style="top:50%; left:50%; transform:translate(-50%,-50%); min-width:280px; z-index:20;">
    <h1>GAME OVER</h1>
    <div class="stat-row"><span class="stat-label">FINAL SCORE</span><span class="stat-value" id="finalScoreDisplay">0</span></div>
    <div class="stat-row"><span class="stat-label">LEVEL REACHED</span><span class="stat-value" id="finalLevelDisplay">1</span></div>
    <button class="btn" id="retryBtn">RETRY</button>
    <button class="btn" id="mainMenuBtn">MAIN MENU</button>
  </div>

  <div id="hud" class="panel hidden" style="top:10px; left:50%; transform:translateX(-50%); display:flex; gap:30px; align-items:center; padding:10px 20px; pointer-events:none;">
    <div class="stat-row" style="flex-direction:column; align-items:center;"><span class="stat-label">LEVEL</span><span class="stat-value" id="levelDisplay">1</span></div>
    <div class="stat-row" style="flex-direction:column; align-items:center;"><span class="stat-label">MOVES</span><span class="stat-value" id="movesDisplay">25</span></div>
    <div class="stat-row" style="flex-direction:column; align-items:center;"><span class="stat-label">SCORE</span><span class="stat-value" id="scoreDisplay">0</span></div>
  </div>

  <div id="colorPalette" class="panel hidden" style="bottom:10px; left:50%; transform:translateX(-50%); padding:10px 20px; pointer-events:auto;">
    <div class="color-btns" id="colorButtons"></div>
  </div>
</div>

<script>
/**
 * Neon Flood - Day 32
 * A neon-themed flood-fill puzzle game.
 * Connect the entire grid by changing colors in limited moves.
 */

// ========== CONSTANTS & CONFIG ==========
const NEON_COLORS = [
  '#00ffff', // cyan
  '#ff00ff', // magenta
  '#ffff00', // yellow
  '#00ff00', // green
  '#ff6600', // orange
  '#ff0066'  // pink
];
const CELL_PADDING = 2;
const GLOW_BLUR = 15;
const ANIM_DURATION = 150; // ms for cell color change

// ========== GAME STATE ==========
let canvas = document.getElementById('gameCanvas');
let ctx = canvas.getContext('2d');
let width = 0, height = 0;
let dpr = window.devicePixelRatio || 1;

let gameState = 'start'; // 'start', 'playing', 'paused', 'gameover'
let running = false; // game loop running flag

// Game data
let grid = [];
let gridSize = 14; // cells per side
let cellSize = 0;
let gridOffsetX = 0, gridOffsetY = 0;
let movesLeft = 0;
let maxMoves = 25;
let level = 1;
let score = 0;
let highScore = parseInt(localStorage.getItem('neonFloodHighScore')) || 0;
let floodColor = 0; // current color index of the flooded region (top-left)
let animating = false;
let animQueue = []; // cells to animate
let animStartTime = 0;

// DOM elements
const startScreen = document.getElementById('startScreen');
const pauseOverlay = document.getElementById('pauseOverlay');
const gameOverOverlay = document.getElementById('gameOverOverlay');
const hud = document.getElementById('hud');
const colorPalette = document.getElementById('colorPalette');
const colorButtonsContainer = document.getElementById('colorButtons');
const highScoreDisplay = document.getElementById('highScoreDisplay');
const levelDisplay = document.getElementById('levelDisplay');
const movesDisplay = document.getElementById('movesDisplay');
const scoreDisplay = document.getElementById('scoreDisplay');
const finalScoreDisplay = document.getElementById('finalScoreDisplay');
const finalLevelDisplay = document.getElementById('finalLevelDisplay');

// ========== INITIALIZATION ==========
function resizeCanvas() {
  width = window.innerWidth;
  height = window.innerHeight;
  canvas.width = width * dpr;
  canvas.height = height * dpr;
  canvas.style.width = width + 'px';
  canvas.style.height = height + 'px';
  ctx.setTransform(1, 0, 0, 1, 0, 0);
  ctx.scale(dpr, dpr);
  
  // Calculate grid size to fit with padding
  const maxGridWidth = width - 40;
  const maxGridHeight = height - 180; // space for HUD and palette
  cellSize = Math.min(maxGridWidth, maxGridHeight) / gridSize;
  gridOffsetX = (width - cellSize * gridSize) / 2;
  gridOffsetY = (height - cellSize * gridSize) / 2;
  
  // Adjust grid size for small screens
  if (width < 500) gridSize = 12;
  else if (width < 700) gridSize = 13;
  else gridSize = 14;
  
  // Recalculate cellSize after gridSize change
  cellSize = Math.min(maxGridWidth, maxGridHeight) / gridSize;
  gridOffsetX = (width - cellSize * gridSize) / 2;
  gridOffsetY = (height - cellSize * gridSize) / 2;
}

window.addEventListener('resize', resizeCanvas);
resizeCanvas();

// ========== GRID LOGIC ==========
function initGrid() {
  grid = [];
  for (let y = 0; y < gridSize; y++) {
    const row = [];
    for (let x = 0; x < gridSize; x++) {
      row.push(Math.floor(Math.random() * NEON_COLORS.length));
    }
    grid.push(row);
  }
  // Ensure top-left starts as color 0
  grid[0][0] = 0;
  floodColor = 0;
}

function getFloodRegion(color = floodColor) {
  const visited = Array(gridSize).fill().map(() => Array(gridSize).fill(false));
  const region = [];
  const stack = [[0, 0]];
  const targetColor = grid[0][0];
  
  while (stack.length) {
    const [x, y] = stack.pop();
    if (x < 0 || x >= gridSize || y < 0 || y >= gridSize) continue;
    if (visited[y][x]) continue;
    if (grid[y][x] !== targetColor) continue;
    
    visited[y][x] = true;
    region.push([x, y]);
    
    stack.push([x+1, y], [x-1, y], [x, y+1], [x, y-1]);
  }
  return region;
}

function floodFill(newColor) {
  if (newColor === floodColor) return false;
  if (animating) return false;
  
  const region = getFloodRegion();
  if (region.length === 0) return false;
  
  // Prepare animation queue
  animQueue = region.map(([x, y]) => ({x, y, from: grid[y][x], to: newColor}));
  animating = true;
  animStartTime = performance.now();
  
  // Actually change colors immediately for logic, but animate visually
  for (const [x, y] of region) {
    grid[y][x] = newColor;
  }
  floodColor = newColor;
  movesLeft--;
  updateHUD();
  checkWin();
  return true;
}

function checkWin() {
  const firstColor = grid[0][0];
  for (let y = 0; y < gridSize; y++) {
    for (let x = 0; x < gridSize; x++) {
      if (grid[y][x] !== firstColor) return;
    }
  }
  // Win!
  const levelBonus = level * 100;
  const moveBonus = movesLeft * 50;
  score += levelBonus + moveBonus;
  level++;
  maxMoves = Math.max(15, 25 - Math.floor(level / 3));
  movesLeft = maxMoves;
  updateHUD();
  setTimeout(() => {
    initGrid();
    createColorButtons();
  }, 500);
}

function updateHUD() {
  levelDisplay.textContent = level;
  movesDisplay.textContent = movesLeft;
  scoreDisplay.textContent = score;
  highScoreDisplay.textContent = highScore;
}

// ========== RENDERING ==========
function drawCell(x, y, colorIndex, progress = 1) {
  const cx = gridOffsetX + x * cellSize + CELL_PADDING;
  const cy = gridOffsetY + y * cellSize + CELL_PADDING;
  const size = cellSize - CELL_PADDING * 2;
  
  const color = NEON_COLORS[colorIndex];
  
  ctx.save();
  ctx.shadowColor = color;
  ctx.shadowBlur = GLOW_BLUR * progress;
  ctx.fillStyle = color;
  ctx.beginPath();
  const radius = Math.max(2, size * 0.1);
  ctx.roundRect(cx, cy, size, size, radius);
  ctx.fill();
  ctx.restore();
}

function drawGrid() {
  ctx.fillStyle = '#05050a';
  ctx.fillRect(0, 0, width, height);
  
  const now = performance.now();
  let animProgress = 1;
  if (animating) {
    animProgress = Math.min(1, (now - animStartTime) / ANIM_DURATION);
    if (animProgress >= 1) {
      animating = false;
      animQueue = [];
    }
  }
  
  for (let y = 0; y < gridSize; y++) {
    for (let x = 0; x < gridSize; x++) {
      let colorIndex = grid[y][x];
      let progress = 1;
      
      // Check if this cell is animating
      if (animating) {
        const animCell = animQueue.find(c => c.x === x && c.y === y);
        if (animCell) {
          // Interpolate color for animation
          colorIndex = animCell.to;
          progress = animProgress;
        }
      }
      
      drawCell(x, y, colorIndex, progress);
    }
  }
  
  // Draw grid lines for clarity
  ctx.strokeStyle = '#00ffff22';
  ctx.lineWidth = 1;
  for (let i = 0; i <= gridSize; i++) {
    const pos = gridOffsetX + i * cellSize;
    ctx.beginPath();
    ctx.moveTo(pos, gridOffsetY);
    ctx.lineTo(pos, gridOffsetY + gridSize * cellSize);
    ctx.stroke();
    
    const posY = gridOffsetY + i * cellSize;
    ctx.beginPath();
    ctx.moveTo(gridOffsetX, posY);
    ctx.lineTo(gridOffsetX + gridSize * cellSize, posY);
    ctx.stroke();
  }
}

function render() {
  drawGrid();
}

// ========== GAME LOOP ==========
function gameLoop(timestamp) {
  if (!running) return;
  
  render();
  
  requestAnimationFrame(gameLoop);
}

function startGameLoop() {
  if (running) return;
  running = true;
  requestAnimationFrame(gameLoop);
}

function stopGameLoop() {
  running = false;
}

// ========== GAME FLOW ==========
function startGame() {
  gameState = 'playing';
  level = 1;
  score = 0;
  maxMoves = 25;
  movesLeft = maxMoves;
  initGrid();
  createColorButtons();
  updateHUD();
  
  startScreen.classList.add('hidden');
  pauseOverlay.classList.add('hidden');
  gameOverOverlay.classList.add('hidden');
  hud.classList.remove('hidden');
  colorPalette.classList.remove('hidden');
  
  startGameLoop();
}

function pauseGame() {
  if (gameState !== 'playing') return;
  gameState = 'paused';
  pauseOverlay.classList.remove('hidden');
  stopGameLoop();
}

function resumeGame() {
  if (gameState !== 'paused') return;
  gameState = 'playing';
  pauseOverlay.classList.add('hidden');
  startGameLoop();
}

function quitToMenu() {
  gameState = 'start';
  pauseOverlay.classList.add('hidden');
  gameOverOverlay.classList.add('hidden');
  hud.classList.add('hidden');
  colorPalette.classList.add('hidden');
  startScreen.classList.remove('hidden');
  stopGameLoop();
}

function showStartScreen() {
  quitToMenu();
}

function gameOver() {
  gameState = 'gameover';
  if (score > highScore) {
    highScore = score;
    localStorage.setItem('neonFloodHighScore', highScore);
    highScoreDisplay.textContent = highScore;
  }
  finalScoreDisplay.textContent = score;
  finalLevelDisplay.textContent = level;
  gameOverOverlay.classList.remove('hidden');
  hud.classList.add('hidden');
  colorPalette.classList.add('hidden');
  stopGameLoop();
}

// ========== COLOR BUTTONS ==========
function createColorButtons() {
  colorButtonsContainer.innerHTML = '';
  NEON_COLORS.forEach((color, index) => {
    const btn = document.createElement('div');
    btn.className = 'color-btn';
    btn.style.background = color;
    btn.style.color = color;
    btn.dataset.colorIndex = index;
    if (index === floodColor) btn.classList.add('selected');
    btn.addEventListener('click', () => onColorSelect(index));
    btn.addEventListener('touchstart', (e) => {
      e.preventDefault();
      onColorSelect(index);
    }, { passive: false });
    colorButtonsContainer.appendChild(btn);
  });
}

function updateColorButtons() {
  const buttons = colorButtonsContainer.querySelectorAll('.color-btn');
  buttons.forEach((btn, index) => {
    if (index === floodColor) {
      btn.classList.add('selected');
    } else {
      btn.classList.remove('selected');
    }
  });
}

function onColorSelect(colorIndex) {
  if (gameState !== 'playing') return;
  if (floodFill(colorIndex)) {
    updateColorButtons();
    if (movesLeft <= 0) {
      // Check if game over (no more moves and not won)
      const firstColor = grid[0][0];
      let allSame = true;
      for (let y = 0; y < gridSize; y++) {
        for (let x = 0; x < gridSize; x++) {
          if (grid[y][x] !== firstColor) {
            allSame = false;
            break;
          }
        }
        if (!allSame) break;
      }
      if (!allSame) {
        gameOver();
      }
    }
  }
}

// ========== INPUT HANDLING ==========
function handleKeyDown(e) {
  if (e.key === 'Escape' || e.key === 'p' || e.key === 'P') {
    if (gameState === 'playing') pauseGame();
    else if (gameState === 'paused') resumeGame();
  }
  
  // Number keys 1-6 for color selection
  if (gameState === 'playing' && e.key >= '1' && e.key <= '6') {
    const colorIndex = parseInt(e.key) - 1;
    if (colorIndex < NEON_COLORS.length) {
      onColorSelect(colorIndex);
    }
  }
}

document.addEventListener('keydown', handleKeyDown);

// Touch handling for grid (optional: tap to flood with most adjacent color?)
// For now, we rely on color buttons.

// Button event listeners
document.getElementById('startBtn').addEventListener('click', startGame);
document.getElementById('resumeBtn').addEventListener('click', resumeGame);
document.getElementById('quitBtn').addEventListener('click', quitToMenu);
document.getElementById('retryBtn').addEventListener('click', startGame);
document.getElementById('mainMenuBtn').addEventListener('click', showStartScreen);

// Touch support for buttons
['startBtn', 'resumeBtn', 'quitBtn', 'retryBtn', 'mainMenuBtn'].forEach(id => {
  const btn = document.getElementById(id);
  btn.addEventListener('touchstart', (e) => {
    e.preventDefault();
    btn.click();
  }, { passive: false });
});

// Initialize high score display
highScoreDisplay.textContent = highScore;

// Start with start screen
showStartScreen();

</script>
</body>
</html>