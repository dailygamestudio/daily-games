<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no">
<title>Neon Echo - Day 17</title>
<style>
* { margin: 0; padding: 0; box-sizing: border-box; }
body {
    background: #0a0a12;
    color: #00ffff;
    font-family: 'Courier New', monospace;
    overflow: hidden;
    touch-action: none;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    min-height: 100vh;
}
#gameCanvas { 
    display: block; 
    box-shadow: 0 0 30px #00ffff88, inset 0 0 30px #00ffff22;
    border: 2px solid #00ffff44;
    border-radius: 8px;
    background: #05050a;
}
.ui {
    position: fixed;
    top: 12px;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    gap: 30px;
    font-size: 16px;
    text-shadow: 0 0 10px #00ffff;
    z-index: 10;
}
.ui div { display: flex; flex-direction: column; align-items: center; }
.ui .label { font-size: 10px; opacity: 0.6; letter-spacing: 2px; }
.ui .value { font-size: 20px; font-weight: bold; }
#msg {
    position: fixed;
    bottom: 30px;
    left: 50%;
    transform: translateX(-50%);
    text-align: center;
    font-size: 14px;
    opacity: 0;
    transition: opacity 0.3s;
    pointer-events: none;
    text-shadow: 0 0 15px #ff00ff;
}
#msg.visible { opacity: 1; }
@media (max-width: 600px) {
    .ui { font-size: 12px; gap: 15px; top: 8px; }
    .ui .value { font-size: 16px; }
    #msg { font-size: 12px; bottom: 20px; padding: 0 10px; }
}

.overlay {
    position: fixed;
    top: 0; left: 0; right: 0; bottom: 0;
    background: rgba(0,0,0,0.95);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    z-index: 100;
    gap: 20px;
    padding: 20px;
}
.overlay.hidden { display: none; }
.overlay h1 { font-size: clamp(32px, 8vw, 64px); text-shadow: 0 0 30px #00ffea; letter-spacing: 4px; }
.overlay p { color: #00ffea88; font-size: 14px; text-align: center; max-width: 400px; line-height: 1.6; }
.btn {
    padding: 12px 32px;
    font-size: 16px;
    font-family: 'Courier New', monospace;
    background: transparent;
    color: #00ffea;
    border: 2px solid #00ffea;
    border-radius: 4px;
    cursor: pointer;
    transition: all 0.2s;
}
.btn:hover { background: #00ffea; color: #0a0a0f; box-shadow: 0 0 20px #00ffea; }
.mobile-hint { color: #ff6b00; font-size: 12px; }
</style>
</head>
<body>
<canvas id="gameCanvas"></canvas>
<div class="ui">
    <div><span class="label">LEVEL</span><span class="value" id="levelEl">1</span></div>
    <div><span class="label">SCORE</span><span class="value" id="scoreEl">0</span></div>
    <div><span class="label">BEST</span><span class="value" id="bestEl">0</span></div>
    <div><span class="label">MOVES</span><span class="value" id="movesEl">0</span></div>
</div>
<div id="msg"></div>

<div class="overlay" id="startOverlay">
    <h1>NEON ECHO</h1>
    <p>Navigate the grid, collect targets, avoid enemies.</p>
    <p>Arrow keys / WASD to move. Swipe on mobile.</p>
    <button class="btn" id="startBtn">START GAME</button>
</div>

<div class="overlay hidden" id="pauseOverlay">
    <h1>PAUSED</h1>
    <p>Wave <span id="pauseWave">1</span> • Score <span id="pauseScore">0</span></p>
    <button class="btn" id="resumeBtn">RESUME</button>
    <button class="btn" id="quitBtn">QUIT TO MENU</button>
</div>

<div class="overlay hidden" id="gameOverOverlay">
    <h1 style="color: #ff3366;">GAME OVER</h1>
    <p>Final Score: <span id="finalScore" style="color: #00ffea;">0</span></p>
    <p id="highScoreMsg" style="color: #ffd700;"></p>
    <button class="btn" id="retryBtn">RETRY</button>
    <button class="btn" id="menuBtn">MAIN MENU</button>
</div>

<script>
const canvas = document.getElementById('gameCanvas');
const ctx = canvas.getContext('2d');
const levelEl = document.getElementById('levelEl');
const scoreEl = document.getElementById('scoreEl');
const bestEl = document.getElementById('bestEl');
const movesEl = document.getElementById('movesEl');
const msgEl = document.getElementById('msg');

const startOverlay = document.getElementById('startOverlay');
const pauseOverlay = document.getElementById('pauseOverlay');
const gameOverOverlay = document.getElementById('gameOverOverlay');
const startBtn = document.getElementById('startBtn');
const resumeBtn = document.getElementById('resumeBtn');
const quitBtn = document.getElementById('quitBtn');
const retryBtn = document.getElementById('retryBtn');
const menuBtn = document.getElementById('menuBtn');
const pauseWaveEl = document.getElementById('pauseWave');
const pauseScoreEl = document.getElementById('pauseScore');
const finalScoreEl = document.getElementById('finalScore');
const highScoreMsgEl = document.getElementById('highScoreMsg');

const CELL_SIZE = 28;
const GRID_W = 21;
const GRID_H = 15;
const PADDING = 20;

let width = GRID_W * CELL_SIZE + PADDING * 2;
let height = GRID_H * CELL_SIZE + PADDING * 2;
canvas.width = width;
canvas.height = height;

const DIRS = { up: {x:0,y:-1}, down:{x:0,y:1}, left:{x:-1,y:0}, right:{x:1,y:0} };
const KEY_MAP = { ArrowUp:'up', ArrowDown:'down', ArrowLeft:'left', ArrowRight:'right', KeyW:'up', KeyS:'down', KeyA:'left', KeyD:'right' };

let grid = [];
let player = { x: 1, y: 1, tx: 1, ty: 1, moving: false, progress: 0, trail: [] };
let targets = [];
let enemies = [];
let teleporters = [];
let particles = [];
let level = 1;
let score = 0;
let moves = 0;
let bestScore = parseInt(localStorage.getItem('neonEchoBest') || '0');
let gameState = 'start';
let animTime = 0;
let inputQueue = [];
let shake = 0;
let lastTime = 0;

bestEl.textContent = bestScore;

function showMsg(text, dur=2000) {
    msgEl.textContent = text;
    msgEl.classList.add('visible');
    setTimeout(() => msgEl.classList.remove('visible'), dur);
}

function lerp(a, b, t) { return a + (b - a) * t; }
function randInt(min, max) { return Math.floor(Math.random() * (max - min + 1)) + min; }
function randChoice(arr) { return arr[Math.floor(Math.random() * arr.length)]; }
function dist(a, b) { return Math.abs(a.x - b.x) + Math.abs(a.y - b.y); }

function createLevel(lv) {
    grid = Array(GRID_H).fill().map(() => Array(GRID_W).fill(0));
    player = { x: 1, y: 1, tx: 1, ty: 1, moving: false, progress: 0, trail: [{x:1, y:1, alpha: 1}] };
    targets = [];
    enemies = [];
    teleporters = [];
    particles = [];
    moves = 0;
    movesEl.textContent = moves;
    gameState = 'playing';
    
    const wallProb = Math.min(0.15 + lv * 0.015, 0.35);
    for (let y = 1; y < GRID_H - 1; y++) {
        for (let x = 1; x < GRID_W - 1; x++) {
            if ((x === 1 && y === 1) || (x === GRID_W - 2 && y === GRID_H - 2)) continue;
            if (Math.random() < wallProb) grid[y][x] = 1;
        }
    }
    
    const targetCount = Math.min(3 + lv, 10);
    let attempts = 0;
    while (targets.length < targetCount && attempts < 200) {
        const x = randInt(1, GRID_W - 2);
        const y = randInt(1, GRID_H - 2);
        if (grid[y][x] === 0 && !(x === 1 && y === 1) && !(x === GRID_W - 2 && y === GRID_H - 2)) {
            if (targets.every(t => dist(t, {x,y}) > 3)) {
                targets.push({ x, y, pulse: Math.random() * Math.PI * 2, collected: false });
            }
        }
        attempts++;
    }
    
    const enemyCount = Math.min(Math.floor(lv / 2) + 1, 6);
    for (let i = 0; i < enemyCount; i++) {
        let ex, ey, valid = false;
        for (let a = 0; a < 50; a++) {
            ex = randInt(2, GRID_W - 3);
            ey = randInt(2, GRID_H - 3);
            if (grid[ey][ex] === 0 && dist({x:ex,y:ey}, player) > 5 && targets.every(t => dist(t, {x:ex,y:ey}) > 2)) {
                valid = true; break;
            }
        }
        if (valid) {
            const dirs = Object.values(DIRS);
            enemies.push({ x: ex, y: ey, tx: ex, ty: ey, moving: false, progress: 0, dir: randChoice(dirs), wait: 0, color: `hsl(${180 + i * 40}, 100%, 50%)` });
        }
    }
    
    if (lv >= 3) {
        const tpCount = Math.min(Math.floor(lv / 3), 4);
        for (let i = 0; i < tpCount; i++) {
            let p1, p2;
            for (let a = 0; a < 30; a++) {
                const x1 = randInt(1, GRID_W - 2), y1 = randInt(1, GRID_H - 2);
                const x2 = randInt(1, GRID_W - 2), y2 = randInt(1, GRID_H - 2);
                if (grid[y1][x1] === 0 && grid[y2][x2] === 0 && dist({x:x1,y:y1}, {x:x2,y:y2}) > 5) {
                    p1 = {x:x1,y:y1}; p2 = {x:x2,y:y2}; break;
                }
            }
            if (p1 && p2) teleporters.push({ a: p1, b: p2, hue: 300 + i * 30, pulse: 0 });
        }
    }
    
    levelEl.textContent = lv;
}

function tryMove(dir) {
    if (gameState !== 'playing' || player.moving) return false;
    const nx = player.x + dir.x;
    const ny = player.y + dir.y;
    if (nx < 0 || nx >= GRID_W || ny < 0 || ny >= GRID_H) return false;
    if (grid[ny][nx] === 1) return false;
    for (const e of enemies) if (e.x === nx && e.y === ny) return false;
    
    player.tx = nx; player.ty = ny; player.moving = true; player.progress = 0;
    moves++; movesEl.textContent = moves;
    
    for (let i = 0; i < 8; i++) {
        particles.push({
            x: player.x * CELL_SIZE + PADDING + CELL_SIZE/2 + (Math.random()-0.5)*CELL_SIZE*0.5,
            y: player.y * CELL_SIZE + PADDING + CELL_SIZE/2 + (Math.random()-0.5)*CELL_SIZE*0.5,
            vx: (Math.random()-0.5)*3, vy: (Math.random()-0.5)*3,
            life: 1, maxLife: 1, hue: 180 + Math.random()*60, size: 2+Math.random()*3
        });
    }
    return true;
}

function updatePlayer(dt) {
    if (!player.moving) return;
    player.progress += dt * 10;
    if (player.progress >= 1) {
        player.progress = 1; player.moving = false;
        player.x = player.tx; player.y = player.ty;
        player.trail.push({x: player.x, y: player.y, alpha: 1});
        if (player.trail.length > 500) player.trail.shift();
        
        for (let i = targets.length - 1; i >= 0; i--) {
            if (!targets[i].collected && targets[i].x === player.x && targets[i].y === player.y) {
                targets[i].collected = true;
                score += 100 + level * 10;
                scoreEl.textContent = score;
                shake = 8;
                for (let j = 0; j < 20; j++) {
                    particles.push({
                        x: player.x * CELL_SIZE + PADDING + CELL_SIZE/2,
                        y: player.y * CELL_SIZE + PADDING + CELL_SIZE/2,
                        vx: (Math.random()-0.5)*8, vy: (Math.random()-0.5)*8,
                        life: 1, maxLife: 1, hue: 60 + Math.random()*60, size: 3+Math.random()*4
                    });
                }
                showMsg(`TARGET ACQUIRED +${100 + level * 10}`, 1000);
            }
        }
        
        for (const tp of teleporters) {
            if (player.x === tp.a.x && player.y === tp.a.y) {
                player.x = tp.b.x; player.y = tp.b.y; player.tx = tp.b.x; player.ty = tp.b.y;
                player.trail.push({x: player.x, y: player.y, alpha: 1});
                shake = 5;
                for (let j = 0; j < 15; j++) {
                    particles.push({ x: player.x * CELL_SIZE + PADDING + CELL_SIZE/2, y: player.y * CELL_SIZE + PADDING + CELL_SIZE/2, vx: (Math.random()-0.5)*6, vy: (Math.random()-0.5)*6, life: 1, maxLife: 1, hue: tp.hue, size: 2+Math.random()*3 });
                }
                break;
            } else if (player.x === tp.b.x && player.y === tp.b.y) {
                player.x = tp.a.x; player.y = tp.a.y; player.tx = tp.a.x; player.ty = tp.a.y;
                player.trail.push({x: player.x, y: player.y, alpha: 1});
                shake = 5;
                for (let j = 0; j < 15; j++) {
                    particles.push({ x: player.x * CELL_SIZE + PADDING + CELL_SIZE/2, y: player.y * CELL_SIZE + PADDING + CELL_SIZE/2, vx: (Math.random()-0.5)*6, vy: (Math.random()-0.5)*6, life: 1, maxLife: 1, hue: tp.hue, size: 2+Math.random()*3 });
                }
                break;
            }
        }
        
        checkWin();
    }
}

function updateEnemies(dt) {
    const speed = 3 + Math.min(level * 0.5, 5);
    for (const e of enemies) {
        if (e.moving) {
            e.progress += dt * speed;
            if (e.progress >= 1) {
                e.progress = 1; e.moving = false;
                e.x = e.tx; e.y = e.ty;
                if (e.x === player.x && e.y === player.y) gameOver();
            }
        } else {
            e.wait -= dt;
            if (e.wait <= 0) {
                const choices = [];
                for (const d of Object.values(DIRS)) {
                    const nx = e.x + d.x, ny = e.y + d.y;
                    if (nx >= 0 && nx < GRID_W && ny >= 0 && ny < GRID_H && grid[ny][nx] === 0) {
                        let blocked = false;
                        for (const o of enemies) if (o !== e && o.x === nx && o.y === ny) blocked = true;
                        if (!blocked) choices.push(d);
                    }
                }
                if (choices.length) {
                    if (Math.random() < 0.7 && choices.length > 1) {
                        const toPlayer = { x: Math.sign(player.x - e.x), y: Math.sign(player.y - e.y) };
                        const aligned = choices.find(c => c.x === toPlayer.x || c.y === toPlayer.y);
                        if (aligned) e.dir = aligned;
                        else e.dir = randChoice(choices);
                    } else e.dir = randChoice(choices);
                    e.tx = e.x + e.dir.x; e.ty = e.y + e.dir.y;
                    e.moving = true; e.progress = 0;
                }
                e.wait = 0.3 + Math.random() * 0.4;
            }
        }
    }
}

function updateParticles(dt) {
    for (let i = particles.length - 1; i >= 0; i--) {
        const p = particles[i];
        p.life -= dt * 1.5;
        p.x += p.vx;
        p.y += p.vy;
        p.vx *= 0.98;
        p.vy *= 0.98;
        if (p.life <= 0) particles.splice(i, 1);
    }
    
    for (const t of player.trail) {
        t.alpha -= dt * 0.5;
    }
    while (player.trail.length && player.trail[0].alpha <= 0) player.trail.shift();
}

function checkWin() {
    if (targets.every(t => t.collected)) {
        level++;
        score += 500 * level;
        scoreEl.textContent = score;
        showMsg(`LEVEL COMPLETE! +${500 * level} BONUS`, 1500);
        setTimeout(() => createLevel(level), 1500);
    }
}

function gameOver() {
    gameState = 'gameover';
    shake = 15;
    if (score > bestScore) {
        bestScore = score;
        localStorage.setItem('neonEchoBest', bestScore.toString());
        bestEl.textContent = bestScore;
        highScoreMsgEl.textContent = 'NEW HIGH SCORE!';
    } else {
        highScoreMsgEl.textContent = `Best: ${bestScore}`;
    }
    finalScoreEl.textContent = score;
    gameOverOverlay.classList.remove('hidden');
}

function startGame() {
    level = 1;
    score = 0;
    scoreEl.textContent = 0;
    createLevel(1);
    startOverlay.classList.add('hidden');
    pauseOverlay.classList.add('hidden');
    gameOverOverlay.classList.add('hidden');
    lastTime = performance.now();
    requestAnimationFrame(gameLoop);
}

function pauseGame() {
    if (gameState !== 'playing') return;
    gameState = 'paused';
    pauseWaveEl.textContent = level;
    pauseScoreEl.textContent = score;
    pauseOverlay.classList.remove('hidden');
}

function resumeGame() {
    if (gameState !== 'paused') return;
    gameState = 'playing';
    pauseOverlay.classList.add('hidden');
    lastTime = performance.now();
    requestAnimationFrame(gameLoop);
}

function quitToMenu() {
    gameState = 'start';
    pauseOverlay.classList.add('hidden');
    startOverlay.classList.remove('hidden');
}

function showStartScreen() {
    gameState = 'start';
    gameOverOverlay.classList.add('hidden');
    startOverlay.classList.remove('hidden');
}

function render() {
    ctx.clearRect(0, 0, width, height);
    
    const shakeX = shake > 0 ? (Math.random() - 0.5) * shake : 0;
    const shakeY = shake > 0 ? (Math.random() - 0.5) * shake : 0;
    ctx.save();
    ctx.translate(shakeX, shakeY);
    
    // Grid background
    ctx.strokeStyle = '#00ffff11';
    ctx.lineWidth = 1;
    for (let x = 0; x <= GRID_W; x++) {
        ctx.beginPath();
        ctx.moveTo(PADDING + x * CELL_SIZE, PADDING);
        ctx.lineTo(PADDING + x * CELL_SIZE, PADDING + GRID_H * CELL_SIZE);
        ctx.stroke();
    }
    for (let y = 0; y <= GRID_H; y++) {
        ctx.beginPath();
        ctx.moveTo(PADDING, PADDING + y * CELL_SIZE);
        ctx.lineTo(PADDING + GRID_W * CELL_SIZE, PADDING + y * CELL_SIZE);
        ctx.stroke();
    }
    
    // Walls
    ctx.fillStyle = '#003333';
    for (let y = 0; y < GRID_H; y++) {
        for (let x = 0; x < GRID_W; x++) {
            if (grid[y][x] === 1) {
                const px = PADDING + x * CELL_SIZE;
                const py = PADDING + y * CELL_SIZE;
                ctx.fillRect(px + 1, py + 1, CELL_SIZE - 2, CELL_SIZE - 2);
                // Neon border
                ctx.strokeStyle = '#00ffff44';
                ctx.lineWidth = 1;
                ctx.strokeRect(px + 1, py + 1, CELL_SIZE - 2, CELL_SIZE - 2);
            }
        }
    }
    
    // Teleporters
    for (const tp of teleporters) {
        tp.pulse += 0.05;
        const pulse = Math.sin(tp.pulse) * 0.3 + 0.7;
        const drawTp = (pos) => {
            const px = PADDING + pos.x * CELL_SIZE;
            const py = PADDING + pos.y * CELL_SIZE;
            const cx = px + CELL_SIZE / 2;
            const cy = py + CELL_SIZE / 2;
            const radius = Math.max(1, (CELL_SIZE / 2 - 4) * pulse);
            
            // Safe gradient creation with finite values
            const grad = ctx.createRadialGradient(cx, cy, 0, cx, cy, radius);
            grad.addColorStop(0, `hsla(${tp.hue}, 100%, 60%, ${0.4 * pulse})`);
            grad.addColorStop(1, `hsla(${tp.hue}, 100%, 40%, 0)`);
            ctx.fillStyle = grad;
            ctx.beginPath();
            ctx.arc(cx, cy, radius, 0, Math.PI * 2);
            ctx.fill();
            
            // Ring
            ctx.strokeStyle = `hsla(${tp.hue}, 100%, 70%, ${0.8 * pulse})`;
            ctx.lineWidth = 2;
            ctx.beginPath();
            ctx.arc(cx, cy, radius * 0.8, 0, Math.PI * 2);
            ctx.stroke();
        };
        drawTp(tp.a);
        drawTp(tp.b);
        
        // Connection line
        const ax = PADDING + tp.a.x * CELL_SIZE + CELL_SIZE/2;
        const ay = PADDING + tp.a.y * CELL_SIZE + CELL_SIZE/2;
        const bx = PADDING + tp.b.x * CELL_SIZE + CELL_SIZE/2;
        const by = PADDING + tp.b.y * CELL_SIZE + CELL_SIZE/2;
        ctx.strokeStyle = `hsla(${tp.hue}, 100%, 60%, 0.15)`;
        ctx.lineWidth = 1;
        ctx.setLineDash([8, 8]);
        ctx.beginPath();
        ctx.moveTo(ax, ay);
        ctx.lineTo(bx, by);
        ctx.stroke();
        ctx.setLineDash([]);
    }
    
    // Targets
    for (const t of targets) {
        if (t.collected) continue;
        t.pulse += 0.1;
        const px = PADDING + t.x * CELL_SIZE;
        const py = PADDING + t.y * CELL_SIZE;
        const cx = px + CELL_SIZE / 2;
        const cy = py + CELL_SIZE / 2;
        const pulse = Math.sin(t.pulse) * 0.2 + 0.8;
        const radius = Math.max(1, (CELL_SIZE / 2 - 6) * pulse);
        
        const grad = ctx.createRadialGradient(cx, cy, 0, cx, cy, radius);
        grad.addColorStop(0, `hsla(60, 100%, 70%, ${0.6 * pulse})`);
        grad.addColorStop(1, `hsla(60, 100%, 50%, 0)`);
        ctx.fillStyle = grad;
        ctx.beginPath();
        ctx.arc(cx, cy, radius, 0, Math.PI * 2);
        ctx.fill();
        
        // Core
        ctx.fillStyle = '#ffff00';
        ctx.beginPath();
        ctx.arc(cx, cy, Math.max(1, radius * 0.4), 0, Math.PI * 2);
        ctx.fill();
        
        // Ring
        ctx.strokeStyle = `hsla(60, 100%, 80%, ${pulse})`;
        ctx.lineWidth = 2;
        ctx.beginPath();
        ctx.arc(cx, cy, radius * 0.9, 0, Math.PI * 2);
        ctx.stroke();
    }
    
    // Player trail
    for (const t of player.trail) {
        const px = PADDING + t.x * CELL_SIZE;
        const py = PADDING + t.y * CELL_SIZE;
        const alpha = t.alpha * 0.3;
        if (alpha > 0.01) {
            ctx.fillStyle = `rgba(0, 255, 255, ${alpha})`;
            ctx.fillRect(px + 4, py + 4, CELL_SIZE - 8, CELL_SIZE - 8);
        }
    }
    
    // Player
    const px = lerp(player.x, player.tx, player.progress);
    const py = lerp(player.y, player.ty, player.progress);
    const drawX = PADDING + px * CELL_SIZE;
    const drawY = PADDING + py * CELL_SIZE;
    const cx = drawX + CELL_SIZE / 2;
    const cy = drawY + CELL_SIZE / 2;
    
    // Glow
    const glowRadius = Math.max(1, CELL_SIZE * 0.6);
    const playerGrad = ctx.createRadialGradient(cx, cy, 0, cx, cy, glowRadius);
    playerGrad.addColorStop(0, 'rgba(0, 255, 255, 0.4)');
    playerGrad.addColorStop(1, 'rgba(0, 255, 255, 0)');
    ctx.fillStyle = playerGrad;
    ctx.beginPath();
    ctx.arc(cx, cy, glowRadius, 0, Math.PI * 2);
    ctx.fill();
    
    // Body
    ctx.fillStyle = '#00ffff';
    ctx.fillRect(drawX + 3, drawY + 3, CELL_SIZE - 6, CELL_SIZE - 6);
    ctx.strokeStyle = '#ffffff';
    ctx.lineWidth = 2;
    ctx.strokeRect(drawX + 3, drawY + 3, CELL_SIZE - 6, CELL_SIZE - 6);
    
    // Eyes
    ctx.fillStyle = '#0a0a12';
    const eyeSize = 4;
    ctx.fillRect(drawX + 7, drawY + 7, eyeSize, eyeSize);
    ctx.fillRect(drawX + CELL_SIZE - 11, drawY + 7, eyeSize, eyeSize);
    
    // Enemies
    for (const e of enemies) {
        const ex = lerp(e.x, e.tx, e.progress);
        const ey = lerp(e.y, e.ty, e.progress);
        const edx = PADDING + ex * CELL_SIZE;
        const edy = PADDING + ey * CELL_SIZE;
        const ecx = edx + CELL_SIZE / 2;
        const ecy = edy + CELL_SIZE / 2;
        
        // Glow
        const eGlowRadius = Math.max(1, CELL_SIZE * 0.5);
        const enemyGrad = ctx.createRadialGradient(ecx, ecy, 0, ecx, ecy, eGlowRadius);
        enemyGrad.addColorStop(0, `${e.color}80`);
        enemyGrad.addColorStop(1, `${e.color}00`);
        ctx.fillStyle = enemyGrad;
        ctx.beginPath();
        ctx.arc(ecx, ecy, eGlowRadius, 0, Math.PI * 2);
        ctx.fill();
        
        // Body - diamond shape
        ctx.fillStyle = e.color;
        ctx.beginPath();
        ctx.moveTo(ecx, edy + 3);
        ctx.lineTo(edx + CELL_SIZE - 3, ecy);
        ctx.lineTo(ecx, edy + CELL_SIZE - 3);
        ctx.lineTo(edx + 3, ecy);
        ctx.closePath();
        ctx.fill();
        ctx.strokeStyle = '#ffffff';
        ctx.lineWidth = 1.5;
        ctx.stroke();
        
        // Core
        ctx.fillStyle = '#ffffff';
        ctx.beginPath();
        ctx.arc(ecx, ecy, 3, 0, Math.PI * 2);
        ctx.fill();
    }
    
    // Particles
    for (const p of particles) {
        const alpha = Math.max(0, Math.min(1, p.life / p.maxLife));
        if (alpha <= 0) continue;
        ctx.fillStyle = `hsla(${p.hue}, 100%, 60%, ${alpha})`;
        ctx.beginPath();
        const size = Math.max(0.5, p.size * alpha);
        ctx.arc(p.x, p.y, size, 0, Math.PI * 2);
        ctx.fill();
    }
    
    ctx.restore();
    
    // Screen shake decay
    if (shake > 0) shake = Math.max(0, shake - 0.5);
}

function gameLoop(time) {
    if (gameState !== 'playing') return;
    const dt = Math.min((time - lastTime) / 1000, 0.1);
    lastTime = time;
    animTime += dt;
    
    updatePlayer(dt);
    updateEnemies(dt);
    updateParticles(dt);
    render();
    
    requestAnimationFrame(gameLoop);
}

// Input handling
window.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' || e.key === 'p' || e.key === 'P') {
        if (gameState === 'playing') pauseGame();
        else if (gameState === 'paused') resumeGame();
       