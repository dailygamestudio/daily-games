<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no">
    <title>Neon Air Hockey - Day 46</title>
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body { background: #0a0a12; overflow: hidden; font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; color: #e0e0ff; }
        canvas { display: block; position: fixed; top: 0; left: 0; z-index: 1; }
        .overlay { position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(10, 10, 25, 0.95); display: flex; flex-direction: column; justify-content: center; align-items: center; z-index: 10; gap: 20px; }
        .overlay.hidden { display: none; }
        h1 { font-size: clamp(2rem, 8vw, 4rem); font-weight: 700; text-transform: uppercase; letter-spacing: 0.2em; background: linear-gradient(135deg, #00ffff, #ff00ff, #ffff00); -webkit-background-clip: text; background-clip: text; color: transparent; text-shadow: 0 0 30px rgba(0, 255, 255, 0.5); animation: pulse 2s infinite alternate; }
        @keyframes pulse { from { filter: brightness(1); } to { filter: brightness(1.5); } }
        .score-display { font-size: clamp(1.5rem, 5vw, 2.5rem); font-weight: 600; color: #00ffff; text-shadow: 0 0 10px #00ffff, 0 0 20px #00ffff; }
        .btn { padding: 15px 40px; font-size: clamp(1rem, 3vw, 1.3rem); font-weight: 700; text-transform: uppercase; letter-spacing: 0.1em; border: none; border-radius: 50px; cursor: pointer; transition: all 0.2s; box-shadow: 0 0 15px currentColor; }
        .btn:hover, .btn:focus { transform: scale(1.05); box-shadow: 0 0 25px currentColor; }
        .btn:active { transform: scale(0.98); }
        .btn-primary { background: linear-gradient(135deg, #00ffff, #0088ff); color: #000; }
        .btn-secondary { background: linear-gradient(135deg, #ff00ff, #aa00aa); color: #fff; }
        .btn-danger { background: linear-gradient(135deg, #ff3333, #cc0000); color: #fff; }
        .controls-hint { font-size: 0.9rem; color: #888; margin-top: 10px; text-align: center; line-height: 1.6; }
        .difficulty-indicator { font-size: 1rem; color: #ffff00; text-shadow: 0 0 10px #ffff00; }
    </style>
</head>
<body>
    <canvas id="gameCanvas"></canvas>

    <div id="startScreen" class="overlay">
        <h1>Neon Air Hockey</h1>
        <div class="score-display">HIGH SCORE: <span id="highScoreDisplay">0</span></div>
        <button id="startBtn" class="btn btn-primary">START</button>
        <div class="controls-hint">
            <strong>CONTROLS:</strong><br>
            Desktop: ← / → or A / D to move paddle<br>
            Mobile: Drag on screen to move paddle<br>
            Pause: ESC or P
        </div>
    </div>

    <div id="pauseOverlay" class="overlay hidden">
        <h1>PAUSED</h1>
        <button id="resumeBtn" class="btn btn-primary">RESUME</button>
        <button id="quitBtn" class="btn btn-danger">QUIT TO MENU</button>
    </div>

    <div id="gameOverOverlay" class="overlay hidden">
        <h1>GAME OVER</h1>
        <div class="score-display">FINAL SCORE: <span id="finalScore">0</span></div>
        <button id="retryBtn" class="btn btn-primary">RETRY</button>
        <button id="menuBtn" class="btn btn-secondary">MAIN MENU</button>
    </div>

    <script>
        // ==========================================
        // GAME CONSTANTS & CONFIGURATION
        // ==========================================
        const CONFIG = {
            GAME_WIDTH: 800,
            GAME_HEIGHT: 600,
            PADDLE_WIDTH: 120,
            PADDLE_HEIGHT: 20,
            PADDLE_RADIUS: 60,
            PADDLE_SPEED: 8,
            PADDLE_COLOR: '#00ffff',
            PADDLE_GLOW: '#00ffff',
            PUCK_RADIUS: 14,
            PUCK_MASS: 1,
            PUCK_FRICTION: 0.992,
            PUCK_MAX_SPEED: 18,
            PUCK_COLOR: '#ff00ff',
            PUCK_GLOW: '#ff00ff',
            GOAL_WIDTH: 200,
            GOAL_DEPTH: 30,
            AI_BASE_SPEED: 4.5,
            AI_REACTION_DELAY: 0.15,
            AI_MAX_SPEED: 10,
            DIFFICULTY_INCREASE_INTERVAL: 15,
            SPEED_INCREASE_FACTOR: 1.08,
            MAX_DIFFICULTY_LEVEL: 10,
            TRAIL_LENGTH: 8,
            PARTICLE_COUNT: 12,
            PARTICLE_LIFE: 0.6,
            BG_COLOR: '#0a0a12',
            LINE_COLOR: '#004444',
            CENTER_LINE_COLOR: '#006666',
            SCORE_COLOR_PLAYER: '#00ffff',
            SCORE_COLOR_AI: '#ff3333',
            TEXT_COLOR: '#e0e0ff'
        };

        // ==========================================
        // GAME STATE
        // ==========================================
        let canvas = document.getElementById('gameCanvas');
        let ctx = canvas.getContext('2d');
        let dpr = window.devicePixelRatio || 1;
        let scaleX = 1, scaleY = 1;

        let gameState = 'start';
        let animationId = null;
        let lastTime = 0;
        let score = { player: 0, ai: 0 };
        let highScore = parseInt(localStorage.getItem('neonAirHockeyHighScore')) || 0;
        let difficultyLevel = 1;
        let difficultyTimer = 0;

        let playerPaddle = { x: 0, y: 0, vx: 0, targetX: 0 };
        let aiPaddle = { x: 0, y: 0, vx: 0, targetX: 0, reactionTimer: 0 };
        let puck = { x: 0, y: 0, vx: 0, vy: 0, trail: [] };
        let particles = [];

        let keys = { left: false, right: false };
        let touchX = null;

        const startScreen = document.getElementById('startScreen');
        const pauseOverlay = document.getElementById('pauseOverlay');
        const gameOverOverlay = document.getElementById('gameOverOverlay');
        const highScoreDisplay = document.getElementById('highScoreDisplay');
        const finalScoreEl = document.getElementById('finalScore');

        // ==========================================
        // INITIALIZATION
        // ==========================================
        function init() {
            resizeCanvas();
            window.addEventListener('resize', resizeCanvas);
            setupInput();
            setupButtons();
            updateHighScoreDisplay();
            showStartScreen();
        }

        function resizeCanvas() {
            const width = window.innerWidth;
            const height = window.innerHeight;
            canvas.width = width * dpr;
            canvas.height = height * dpr;
            canvas.style.width = width + 'px';
            canvas.style.height = height + 'px';
            ctx.setTransform(1, 0, 0, 1, 0, 0);
            ctx.scale(dpr, dpr);
            scaleX = width / CONFIG.GAME_WIDTH;
            scaleY = height / CONFIG.GAME_HEIGHT;
        }

        function setupInput() {
            window.addEventListener('keydown', e => {
                if (e.key === 'ArrowLeft' || e.key === 'a' || e.key === 'A') keys.left = true;
                if (e.key === 'ArrowRight' || e.key === 'd' || e.key === 'D') keys.right = true;
                if (e.key === 'Escape' || e.key === 'p' || e.key === 'P') togglePause();
            });
            window.addEventListener('keyup', e => {
                if (e.key === 'ArrowLeft' || e.key === 'a' || e.key === 'A') keys.left = false;
                if (e.key === 'ArrowRight' || e.key === 'd' || e.key === 'D') keys.right = false;
            });

            canvas.addEventListener('touchstart', e => {
                e.preventDefault();
                if (gameState === 'playing') {
                    touchX = e.touches[0].clientX;
                }
            }, { passive: false });
            canvas.addEventListener('touchmove', e => {
                e.preventDefault();
                if (gameState === 'playing' && touchX !== null) {
                    touchX = e.touches[0].clientX;
                }
            }, { passive: false });
            canvas.addEventListener('touchend', e => {
                e.preventDefault();
                touchX = null;
            }, { passive: false });
            canvas.addEventListener('touchcancel', e => {
                touchX = null;
            }, { passive: false });
        }

        function setupButtons() {
            document.getElementById('startBtn').addEventListener('click', startGame);
            document.getElementById('resumeBtn').addEventListener('click', resumeGame);
            document.getElementById('quitBtn').addEventListener('click', quitToMenu);
            document.getElementById('retryBtn').addEventListener('click', startGame);
            document.getElementById('menuBtn').addEventListener('click', quitToMenu);
        }

        // ==========================================
        // GAME FLOW CONTROL
        // ==========================================
        function startGame() {
            gameState = 'playing';
            score = { player: 0, ai: 0 };
            difficultyLevel = 1;
            difficultyTimer = 0;
            hideAllOverlays();
            resetEntities();
            lastTime = performance.now();
            animationId = requestAnimationFrame(gameLoop);
        }

        function pauseGame() {
            if (gameState !== 'playing') return;
            gameState = 'paused';
            cancelAnimationFrame(animationId);
            pauseOverlay.classList.remove('hidden');
        }

        function resumeGame() {
            if (gameState !== 'paused') return;
            gameState = 'playing';
            pauseOverlay.classList.add('hidden');
            lastTime = performance.now();
            animationId = requestAnimationFrame(gameLoop);
        }

        function togglePause() {
            if (gameState === 'playing') pauseGame();
            else if (gameState === 'paused') resumeGame();
        }

        function quitToMenu() {
            gameState = 'start';
            cancelAnimationFrame(animationId);
            hideAllOverlays();
            showStartScreen();
        }

        function gameOver() {
            gameState = 'gameover';
            cancelAnimationFrame(animationId);
            const final = score.player;
            if (final > highScore) {
                highScore = final;
                localStorage.setItem('neonAirHockeyHighScore', highScore);
                updateHighScoreDisplay();
            }
            finalScoreEl.textContent = final;
            gameOverOverlay.classList.remove('hidden');
        }

        function showStartScreen() {
            startScreen.classList.remove('hidden');
        }

        function hideAllOverlays() {
            startScreen.classList.add('hidden');
            pauseOverlay.classList.add('hidden');
            gameOverOverlay.classList.add('hidden');
        }

        function updateHighScoreDisplay() {
            highScoreDisplay.textContent = highScore;
        }

        // ==========================================
        // ENTITY RESET & SPAWN
        // ==========================================
        function resetEntities() {
            const w = CONFIG.GAME_WIDTH;
            const h = CONFIG.GAME_HEIGHT;
            const ph = CONFIG.PADDLE_HEIGHT;
            const pr = CONFIG.PADDLE_RADIUS;

            playerPaddle.x = w / 2;
            playerPaddle.y = h - ph - 20;
            playerPaddle.vx = 0;
            playerPaddle.targetX = w / 2;

            aiPaddle.x = w / 2;
            aiPaddle.y = ph + 20;
            aiPaddle.vx = 0;
            aiPaddle.targetX = w / 2;
            aiPaddle.reactionTimer = 0;

            spawnPuck(true);
        }

        function spawnPuck(towardsPlayer) {
            const w = CONFIG.GAME_WIDTH;
            const h = CONFIG.GAME_HEIGHT;
            puck.x = w / 2;
            puck.y = h / 2;
            puck.trail = [];
            let angle;
            if (towardsPlayer) {
                angle = Math.PI / 2 + (Math.random() - 0.5) * 0.8;
            } else {
                angle = -Math.PI / 2 + (Math.random() - 0.5) * 0.8;
            }
            const speed = 6 + difficultyLevel * 0.5;
            puck.vx = Math.cos(angle) * speed;
            puck.vy = Math.sin(angle) * speed;
        }

        // ==========================================
        // GAME LOOP
        // ==========================================
        function gameLoop(timestamp) {
            if (gameState !== 'playing') return;
            const dt = Math.min((timestamp - lastTime) / 1000, 1/30);
            lastTime = timestamp;

            update(dt);
            render();

            animationId = requestAnimationFrame(gameLoop);
        }

        // ==========================================
        // UPDATE LOGIC
        // ==========================================
        function update(dt) {
            difficultyTimer += dt;
            if (difficultyTimer >= CONFIG.DIFFICULTY_INCREASE_INTERVAL && difficultyLevel < CONFIG.MAX_DIFFICULTY_LEVEL) {
                difficultyLevel++;
                difficultyTimer = 0;
                const currentSpeed = Math.hypot(puck.vx, puck.vy);
                if (currentSpeed > 0) {
                    const factor = CONFIG.SPEED_INCREASE_FACTOR;
                    puck.vx *= factor;
                    puck.vy *= factor;
                    clampPuckSpeed();
                }
            }

            handlePlayerInput(dt);
            updateAI(dt);
            updatePuck(dt);
            updateParticles(dt);
        }

        function handlePlayerInput(dt) {
            const speed = CONFIG.PADDLE_SPEED;
            const w = CONFIG.GAME_WIDTH;
            const pr = CONFIG.PADDLE_RADIUS;

            if (keys.left) playerPaddle.targetX -= speed * 60 * dt;
            if (keys.right) playerPaddle.targetX += speed * 60 * dt;

            if (touchX !== null) {
                const rect = canvas.getBoundingClientRect();
                const scaleX = CONFIG.GAME_WIDTH / rect.width;
                const gameTouchX = (touchX - rect.left) * scaleX;
                playerPaddle.targetX = gameTouchX;
            }

            playerPaddle.targetX = Math.max(pr, Math.min(w - pr, playerPaddle.targetX));
            playerPaddle.vx = (playerPaddle.targetX - playerPaddle.x) * 0.3;
            playerPaddle.x += playerPaddle.vx;
        }

        function updateAI(dt) {
            const w = CONFIG.GAME_WIDTH;
            const pr = CONFIG.PADDLE_RADIUS;
            const aiSpeed = Math.min(CONFIG.AI_BASE_SPEED * difficultyLevel * 0.3, CONFIG.AI_MAX_SPEED);

            aiPaddle.reactionTimer -= dt;
            if (aiPaddle.reactionTimer <= 0) {
                if (puck.vy < 0) {
                    const timeToReach = (aiPaddle.y - puck.y) / puck.vy;
                    if (timeToReach > 0 && timeToReach < 3) {
                        let predictedX = puck.x + puck.vx * timeToReach;
                        while (predictedX < pr || predictedX > w - pr) {
                            if (predictedX < pr) predictedX = 2 * pr - predictedX;
                            if (predictedX > w - pr) predictedX = 2 * (w - pr) - predictedX;
                        }
                        aiPaddle.targetX = predictedX;
                    }
                } else {
                    aiPaddle.targetX = w / 2;
                }
                aiPaddle.reactionTimer = CONFIG.AI_REACTION_DELAY;
            }

            aiPaddle.targetX = Math.max(pr, Math.min(w - pr, aiPaddle.targetX));
            const dx = aiPaddle.targetX - aiPaddle.x;
            const maxMove = aiSpeed * 60 * dt;
            if (Math.abs(dx) > maxMove) {
                aiPaddle.vx = Math.sign(dx) * maxMove;
            } else {
                aiPaddle.vx = dx;
            }
            aiPaddle.x += aiPaddle.vx;
        }

        function updatePuck(dt) {
            const w = CONFIG.GAME_WIDTH;
            const h = CONFIG.GAME_HEIGHT;
            const pr = CONFIG.PUCK_RADIUS;
            const pRad = CONFIG.PADDLE_RADIUS;

            puck.vx *= CONFIG.PUCK_FRICTION;
            puck.vy *= CONFIG.PUCK_FRICTION;

            puck.x += puck.vx * 60 * dt;
            puck.y += puck.vy * 60 * dt;

            puck.trail.unshift({ x: puck.x, y: puck.y, alpha: 1 });
            if (puck.trail.length > CONFIG.TRAIL_LENGTH) puck.trail.pop();

            if (puck.x - pr < 0) {
                puck.x = pr;
                puck.vx = Math.abs(puck.vx);
                spawnWallParticles(puck.x, puck.y, 'vertical');
            } else if (puck.x + pr > w) {
                puck.x = w - pr;
                puck.vx = -Math.abs(puck.vx);
                spawnWallParticles(puck.x, puck.y, 'vertical');
            }

            const goalLeft = (w - CONFIG.GOAL_WIDTH) / 2;
            const goalRight = (w + CONFIG.GOAL_WIDTH) / 2;

            if (puck.y - pr < 0) {
                if (puck.x > goalLeft && puck.x < goalRight) {
                    score.player++;
                    spawnGoalParticles(puck.x, puck.y, CONFIG.SCORE_COLOR_PLAYER);
                    spawnPuck(false);
                    return;
                } else {
                    puck.y = pr;
                    puck.vy = Math.abs(puck.vy);
                    spawnWallParticles(puck.x, puck.y, 'horizontal');
                }
            }

            if (puck.y + pr > h) {
                if (puck.x > goalLeft && puck.x < goalRight) {
                    score.ai++;
                    spawnGoalParticles(puck.x, puck.y, CONFIG.SCORE_COLOR_AI);
                    if (score.ai >= 7) {
                        gameOver();
                        return;
                    }
                    spawnPuck(true);
                    return;
                } else {
                    puck.y = h - pr;
                    puck.vy = -Math.abs(puck.vy);
                    spawnWallParticles(puck.x, puck.y, 'horizontal');
                }
            }

            if (checkPaddleCollision(playerPaddle)) {
                resolvePaddleCollision(playerPaddle);
                spawnPaddleParticles(playerPaddle.x, puck.y, CONFIG.PADDLE_GLOW);
            }
            if (checkPaddleCollision(aiPaddle)) {
                resolvePaddleCollision(aiPaddle);
                spawnPaddleParticles(aiPaddle.x, puck.y, CONFIG.PADDLE_GLOW);
            }

            clampPuckSpeed();
        }

        function checkPaddleCollision(paddle) {
            const pr = CONFIG.PUCK_RADIUS;
            const pRad = CONFIG.PADDLE_RADIUS;
            const dx = puck.x - paddle.x;
            const dy = puck.y - paddle.y;
            const dist = Math.hypot(dx, dy);
            return dist < pr + pRad;
        }

        function resolvePaddleCollision(paddle) {
            const pr = CONFIG.PUCK_RADIUS;
            const pRad = CONFIG.PADDLE_RADIUS;
            const dx = puck.x - paddle.x;
            const dy = puck.y - paddle.y;
            const dist = Math.hypot(dx, dy);
            const overlap = pr + pRad - dist;

            const nx = dx / dist || 0;
            const ny = dy / dist || 1;

            puck.x += nx * overlap;
            puck.y += ny * overlap;

            const rvx = puck.vx - paddle.vx;
            const rvy = puck.vy;
            const velAlongNormal = rvx * nx + rvy * ny;

            if (velAlongNormal > 0) return;

            const e = 1.1;
            const impulse = -(1 + e) * velAlongNormal;
            puck.vx += impulse * nx;
            puck.vy += impulse * ny;
            puck.vx += paddle.vx * 0.5;
        }

        function clampPuckSpeed() {
            const max = CONFIG.PUCK_MAX_SPEED * (1 + difficultyLevel * 0.1);
            const speed = Math.hypot(puck.vx, puck.vy);
            if (speed > max) {
                puck.vx = (puck.vx / speed) * max;
                puck.vy = (puck.vy / speed) * max;
            }
        }

        // ==========================================
        // PARTICLE SYSTEM
        // ==========================================
        function spawnWallParticles(x, y, orientation) {
            const count = CONFIG.PARTICLE_COUNT;
            for (let i = 0; i < count; i++) {
                const angle = orientation === 'vertical' 
                    ? Math.random() * Math.PI - Math.PI/2 
                    : Math.random() * Math.PI;
                const speed = 2 + Math.random() * 4;
                particles.push({
                    x, y,
                    vx: Math.cos(angle) * speed,
                    vy: Math.sin(angle) * speed,
                    life: CONFIG.PARTICLE_LIFE,
                    maxLife: CONFIG.PARTICLE_LIFE,
                    color: CONFIG.PUCK_GLOW,
                    size: 2 + Math.random() * 3
                });
            }
        }

        function spawnGoalParticles(x, y, color) {
            const count = CONFIG.PARTICLE_COUNT * 2;
            for (let i = 0; i < count; i++) {
                const angle = Math.random() * Math.PI * 2;
                const speed = 3 + Math.random() * 6;
                particles.push({
                    x, y,
                    vx: Math.cos(angle) * speed,
                    vy: Math.sin(angle) * speed,
                    life: CONFIG.PARTICLE_LIFE * 1.5,
                    maxLife: CONFIG.PARTICLE_LIFE * 1.5,
                    color,
                    size: 3 + Math.random() * 4
                });
            }
        }

        function spawnPaddleParticles(x, y, color) {
            const count = CONFIG.PARTICLE_COUNT;
            for (let i = 0; i < count; i++) {
                const angle = Math.random() * Math.PI * 2;
                const speed = 1 + Math.random() * 3;
                particles.push({
                    x, y,
                    vx: Math.cos(angle) * speed,
                    vy: Math.sin(angle) * speed,
                    life: CONFIG.PARTICLE_LIFE * 0.7,
                    maxLife: CONFIG.PARTICLE_LIFE * 0.7,
                    color,
                    size: 2 + Math.random() * 2
                });
            }
        }

        function updateParticles(dt) {
            for (let i = particles.length - 1; i >= 0; i--) {
                const p = particles[i];
                p.life -= dt;
                if (p.life <= 0) {
                    particles.splice(i, 1);
                    continue;
                }
                p.x += p.vx * 60 * dt;
                p.y += p.vy * 60 * dt;
                p.vx *= 0.98;
                p.vy *= 0.98;
            }
        }

        // ==========================================
        // RENDER
        // ==========================================
        function render() {
            const w = CONFIG.GAME_WIDTH;
            const h = CONFIG.GAME_HEIGHT;

            ctx.save();
            ctx.scale(scaleX, scaleY);

            // Clear
            ctx.fillStyle = CONFIG.BG_COLOR;
            ctx.fillRect(0, 0, w, h);

            // Grid lines
            ctx.strokeStyle = CONFIG.LINE_COLOR;
            ctx.lineWidth = 1;
            const gridSize = 40;
            for (let x = 0; x <= w; x += gridSize) {
                ctx.beginPath();
                ctx.moveTo(x, 0);
                ctx.lineTo(x, h);
                ctx.stroke();
            }
            for (let y = 0; y <= h; y += gridSize) {
                ctx.beginPath();
                ctx.moveTo(0, y);
                ctx.lineTo(w, y);
                ctx.stroke();
            }

            // Center line
            ctx.strokeStyle = CONFIG.CENTER_LINE_COLOR;
            ctx.lineWidth = 2;
            ctx.setLineDash([10, 10]);
            ctx.beginPath();
            ctx.moveTo(0, h / 2);
            ctx.lineTo(w, h / 2);
            ctx.stroke();
            ctx.setLineDash([]);

            // Center circle
            ctx.beginPath();
            ctx.arc(w / 2, h / 2, 60, 0, Math.PI * 2);
            ctx.stroke();

            // Goals
            const goalLeft = (w - CONFIG.GOAL_WIDTH) / 2;
            const goalRight = (w + CONFIG.GOAL_WIDTH) / 2;
            ctx.fillStyle = 'rgba(255, 0, 0, 0.1)';
            ctx.fillRect(goalLeft, 0, CONFIG.GOAL_WIDTH, CONFIG.GOAL_DEPTH);
            ctx.fillStyle = 'rgba(0, 255, 255, 0.1)';
            ctx.fillRect(goalLeft, h - CONFIG.GOAL_DEPTH, CONFIG.GOAL_WIDTH, CONFIG.GOAL_DEPTH);

            // Goal lines
            ctx.strokeStyle = '#ff3333';
            ctx.lineWidth = 3;
            ctx.beginPath();
            ctx.moveTo(goalLeft, 0);
            ctx.lineTo(goalLeft, CONFIG.GOAL_DEPTH);
            ctx.moveTo(goalRight, 0);
            ctx.lineTo(goalRight, CONFIG.GOAL_DEPTH);
            ctx.stroke();
            ctx.strokeStyle = '#00ffff';
            ctx.beginPath();
            ctx.moveTo(goalLeft, h);
            ctx.lineTo(goalLeft, h - CONFIG.GOAL_DEPTH);
            ctx.moveTo(goalRight, h);
            ctx.lineTo(goalRight, h - CONFIG.GOAL_DEPTH);
            ctx.stroke();

            // Puck trail
            for (let i = puck.trail.length - 1; i >= 0; i--) {
                const t = puck.trail[i];
                const alpha = (1 - i / puck.trail.length) * 0.5;
                const radius = CONFIG.PUCK_RADIUS * (1 - i / puck.trail.length * 0.5);
                ctx.beginPath();
                ctx.arc(t.x, t.y, radius, 0, Math.PI * 2);
                ctx.fillStyle = `rgba(255, 0, 255, ${alpha})`;
                ctx.fill();
            }

            // Puck
            const puckGradient = ctx.createRadialGradient(puck.x - 3, puck.y - 3, 0, puck.x, puck.y, CONFIG.PUCK_RADIUS);
            puckGradient.addColorStop(0, '#ffffff');
            puckGradient.addColorStop(0.5, CONFIG.PUCK_COLOR);
            puckGradient.addColorStop(1, '#880088');
            ctx.beginPath();
            ctx.arc(puck.x, puck.y, CONFIG.PUCK_RADIUS, 0, Math.PI * 2);
            ctx.fillStyle = puckGradient;
            ctx.fill();
            // Puck glow
            ctx.shadowColor = CONFIG.PUCK_GLOW;
            ctx.shadowBlur = 20;
            ctx.beginPath();
            ctx.arc(puck.x, puck.y, CONFIG.PUCK_RADIUS, 0, Math.PI * 2);
            ctx.strokeStyle = CONFIG.PUCK_GLOW;
            ctx.lineWidth = 2;
            ctx.stroke();
            ctx.shadowBlur = 0;

            // Player paddle
            drawPaddle(playerPaddle.x, playerPaddle.y, CONFIG.PADDLE_COLOR, CONFIG.PADDLE_GLOW, true);

            // AI paddle
            drawPaddle(aiPaddle.x, aiPaddle.y, '#ff3333', '#ff3333', false);

            // Particles
            for (const p of particles) {
                const alpha = p.life / p.maxLife;
                ctx.beginPath();
                ctx.arc(p.x, p.y, p.size * alpha, 0, Math.PI * 2);
                // Convert hex to rgba
                let r, g, b;
                if (p.color.startsWith('#')) {
                    r = parseInt(p.color.slice(1, 3), 16);
                    g = parseInt(p.color.slice(3, 5), 16);
                    b = parseInt(p.color.slice(5, 7), 16);
                    ctx.fillStyle = `rgba(${r}, ${g}, ${b}, ${alpha})`;
                } else {
                    ctx.fillStyle = p.color.replace(')', `, ${alpha})`).replace('rgb', 'rgba');
                }
                ctx.fill();
            }

            // Scores
            ctx.font = 'bold 48px Segoe UI';
            ctx.textAlign = 'center';
            ctx.fillStyle = CONFIG.SCORE_COLOR_PLAYER;
            ctx.shadowColor = CONFIG.SCORE_COLOR_PLAYER;
            ctx.shadowBlur = 10;
            ctx.fillText(score.player, w / 2, h - 80);
            ctx.fillStyle = CONFIG.SCORE_COLOR_AI;
            ctx.shadowColor = CONFIG.SCORE_COLOR_AI;
            ctx.fillText(score.ai, w / 2, 80);
            ctx.shadowBlur = 0;

            // Difficulty indicator
            ctx.font = '16px Segoe UI';
            ctx.fillStyle = '#ffff00';
            ctx.shadowColor = '#ffff00';
            ctx.shadowBlur = 5;
            ctx.textAlign = 'left';
            ctx.fillText(`LEVEL: ${difficultyLevel}`, 20, 30);
            ctx.textAlign = 'right';
            ctx.fillText(`BEST: ${highScore}`, w - 20, 30);
            ctx.shadowBlur = 0;

            ctx.restore();
        }

        function drawPaddle(x, y, color, glowColor, isPlayer) {
            const r = CONFIG.PADDLE_RADIUS;
            const gradient = ctx.createRadialGradient(x, y, 0, x, y, r);
            gradient.addColorStop(0, isPlayer ? '#ffffff' : '#ffaaaa');
            gradient.addColorStop(0.5, color);
            gradient.addColorStop(1, isPlayer ? '#008888' : '#880000');
            
            ctx.beginPath();
            ctx.arc(x, y, r, 0, Math.PI * 2);
            ctx.fillStyle = gradient;
            ctx.fill();
            
            // Glow
            ctx.shadowColor = glowColor;
            ctx.shadowBlur = 15;
            ctx.beginPath();
            ctx.arc(x, y, r, 0, Math.PI * 2);
            ctx.strokeStyle = glowColor;
            ctx.lineWidth = 3;
            ctx.stroke();
            ctx.shadowBlur = 0;
        }

        // Start the game
        init();
    </script>
</body>
</html>