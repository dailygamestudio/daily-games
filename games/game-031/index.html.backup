<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no">
<title>Neon Minesweeper - Day 31</title>
<style>
:root {
  --bg: #0a0a12;
  --fg: #e0ffe0;
  --neon-green: #00ff88;
  --neon-blue: #00ccff;
  --neon-pink: #ff00aa;
  --neon-orange: #ff8800;
  --neon-red: #ff3344;
  --panel: rgba(10, 10, 20, 0.9);
  --border: #00ff88;
}
* { margin: 0; padding: 0; box-sizing: border-box; }
body {
  background: var(--bg);
  color: var(--fg);
  font-family: 'Courier New', Courier, monospace;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 100vh;
  overflow: hidden;
  touch-action: none;
}
canvas {
  display: block;
  border: 2px solid var(--border);
  border-radius: 8px;
  box-shadow: 0 0 20px rgba(0, 255, 136, 0.3), inset 0 0 20px rgba(0, 255, 136, 0.1);
  background: #05050a;
}
.ui {
  position: fixed;
  top: 12px;
  left: 50%;
  transform: translateX(-50%);
  display: flex;
  gap: 24px;
  padding: 8px 16px;
  background: var(--panel);
  border: 1px solid var(--border);
  border-radius: 6px;
  box-shadow: 0 0 15px rgba(0, 255, 136, 0.2);
  z-index: 10;
  font-size: 14px;
  letter-spacing: 1px;
}
.ui span { color: var(--neon-green); text-shadow: 0 0 5px var(--neon-green); }
.btn {
  position: fixed;
  bottom: 20px;
  left: 50%;
  transform: translateX(-50%);
  padding: 10px 28px;
  background: transparent;
  border: 2px solid var(--neon-green);
  color: var(--neon-green);
  font-family: inherit;
  font-size: 14px;
  letter-spacing: 2px;
  cursor: pointer;
  border-radius: 4px;
  transition: all 0.2s;
  text-shadow: 0 0 5px var(--neon-green);
}
.btn:hover, .btn:focus {
  background: var(--neon-green);
  color: var(--bg);
  box-shadow: 0 0 20px var(--neon-green);
}
.msg {
  position: fixed;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  padding: 30px 50px;
  background: var(--panel);
  border: 2px solid var(--neon-pink);
  border-radius: 12px;
  text-align: center;
  display: none;
  z-index: 20;
  box-shadow: 0 0 30px rgba(255, 0, 170, 0.4);
}
.msg h2 { margin-bottom: 12px; color: var(--neon-pink); text-shadow: 0 0 10px var(--neon-pink); font-size: 28px; }
.msg p { color: var(--neon-blue); margin-bottom: 20px; font-size: 18px; }
@media (max-width: 600px) {
  .ui { font-size: 11px; gap: 12px; padding: 6px 10px; top: 8px; }
  .btn { bottom: 12px; padding: 8px 20px; font-size: 12px; }
  .msg { padding: 20px 30px; width: 90%; }
  .msg h2 { font-size: 22px; }
  .msg p { font-size: 16px; }
}

.overlay {
    position: fixed;
    top: 0; left: 0; right: 0; bottom: 0;
    background: rgba(0,0,0,0.95);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    z-index: 100;
    gap: 20px;
    padding: 20px;
}
.overlay.hidden { display: none; }
.overlay h1 { font-size: clamp(32px, 8vw, 64px); text-shadow: 0 0 30px #00ffea; letter-spacing: 4px; }
.overlay p { color: #00ffea88; font-size: 14px; text-align: center; max-width: 400px; line-height: 1.6; }
.btn {
    padding: 12px 32px;
    font-size: 16px;
    font-family: 'Courier New', monospace;
    background: transparent;
    color: #00ffea;
    border: 2px solid #00ffea;
    border-radius: 4px;
    cursor: pointer;
    transition: all 0.2s;
}
.btn:hover { background: #00ffea; color: #0a0a0f; box-shadow: 0 0 20px #00ffea; }
.mobile-hint { color: #ff6b00; font-size: 12px; }
</style>
</head>
<body>
<canvas id="gameCanvas"></canvas>
<div class="ui">
  <div>LEVEL: <span id="levelEl">1</span></div>
  <div>MINES: <span id="minesEl">10</span></div>
  <div>FLAGS: <span id="flagsEl">0</span></div>
  <div>TIME: <span id="timeEl">0</span></div>
  <div>SCORE: <span id="scoreEl">0</span></div>
  <div>BEST: <span id="bestEl">0</span></div>
</div>
<button class="btn" id="restartBtn">RESTART</button>
<div class="msg" id="msgBox">
  <h2 id="msgTitle">GAME OVER</h2>
  <p id="msgText">You hit a mine!</p>
  <button class="btn" onclick="hideMsg()">CONTINUE</button>
</div>

<!-- Pause Overlay -->
<div class="overlay hidden" id="pauseOverlay">
  <h1>PAUSED</h1>
  <p>Game is paused. Press RESUME to continue.</p>
  <button class="btn" onclick="resumeGame()">RESUME</button>
  <button class="btn" onclick="quitToMenu()">QUIT TO MENU</button>
</div>

<!-- Game Over Overlay -->
<div class="overlay hidden" id="gameOverOverlay">
  <h1 id="gameOverTitle">GAME OVER</h1>
  <p id="gameOverText"></p>
  <button class="btn" onclick="startGame()">RETRY</button>
  <button class="btn" onclick="quitToMenu()">MAIN MENU</button>
</div>

<script>
// ===== Neon Minesweeper - Day 31 =====
// Cyberpunk Minesweeper with increasing grid size, neon aesthetic, touch & keyboard support

const canvas = document.getElementById('gameCanvas');
const ctx = canvas.getContext('2d');

// UI elements
const levelEl = document.getElementById('levelEl');
const minesEl = document.getElementById('minesEl');
const flagsEl = document.getElementById('flagsEl');
const timeEl = document.getElementById('timeEl');
const scoreEl = document.getElementById('scoreEl');
const bestEl = document.getElementById('bestEl');
const restartBtn = document.getElementById('restartBtn');
const msgBox = document.getElementById('msgBox');
const msgTitle = document.getElementById('msgTitle');
const msgText = document.getElementById('msgText');
const pauseOverlay = document.getElementById('pauseOverlay');
const gameOverOverlay = document.getElementById('gameOverOverlay');
const gameOverTitle = document.getElementById('gameOverTitle');
const gameOverText = document.getElementById('gameOverText');

// Game constants
const CELL_BASE = 28; // base cell size in px
const MIN_GRID = 8;
const MAX_GRID = 24;
const MINE_RATIO = 0.15625; // 10/64 for 8x8

// Colors
const COLORS = {
  bg: '#05050a',
  grid: '#003322',
  hidden: '#0a1a12',
  revealed: '#081810',
  flag: '#ff00aa',
  mine: '#ff3344',
  numbers: [
    '#000000', // 0 unused
    '#00ccff', // 1 - cyan
    '#00ff88', // 2 - green
    '#ff8800', // 3 - orange
    '#ff00aa', // 4 - pink
    '#ff3344', // 5 - red
    '#ffff00', // 6 - yellow
    '#ffffff', // 7 - white
    '#aa00ff'  // 8 - purple
  ],
  glow: 'rgba(0, 255, 136, 0.6)',
  cursor: 'rgba(0, 255, 136, 0.4)'
};

// Game state
let gridW = MIN_GRID, gridH = MIN_GRID;
let cellSize = CELL_BASE;
let grid = []; // 2D array of cells
let mineCount = 0;
let revealedCount = 0;
let flaggedCount = 0;
let gameOver = false;
let win = false;
let firstClick = true;
let level = 1;
let score = 0;
let bestScore = parseInt(localStorage.getItem('neonMinesweeperBest') || '0', 10);
let startTime = 0;
let timerId = 0;
let cursorX = 0, cursorY = 0; // for keyboard navigation
let hasCursor = false;

// State for pause/menu
const state = {
    running: false,
    paused: false
};

// Cell structure: { mine: bool, revealed: bool, flagged: bool, adjacent: number, x: int, y: int }

function init() {
  // Calculate canvas size based on grid
  cellSize = Math.min(CELL_BASE, Math.floor(Math.min(window.innerWidth * 0.92, window.innerHeight * 0.7) / Math.max(gridW, gridH)));
  canvas.width = gridW * cellSize;
  canvas.height = gridH * cellSize;

  // Reset state
  grid = [];
  mineCount = Math.max(1, Math.floor(gridW * gridH * MINE_RATIO));
  revealedCount = 0;
  flaggedCount = 0;
  gameOver = false;
  win = false;
  firstClick = true;
  startTime = Date.now();
  clearInterval(timerId);
  timerId = setInterval(updateTimer, 1000);
  updateTimer();

  // Create empty grid
  for (let y = 0; y < gridH; y++) {
    grid[y] = [];
    for (let x = 0; x < gridW; x++) {
      grid[y][x] = { mine: false, revealed: false, flagged: false, adjacent: 0, x, y };
    }
  }

  // Reset cursor to center
  cursorX = Math.floor(gridW / 2);
  cursorY = Math.floor(gridH / 2);
  hasCursor = false;

  updateUI();
  draw();
}

function placeMines(excludeX, excludeY) {
  let placed = 0;
  while (placed < mineCount) {
    const x = Math.floor(Math.random() * gridW);
    const y = Math.floor(Math.random() * gridH);
    const cell = grid[y][x];
    if (cell.mine) continue;
    if (x === excludeX && y === excludeY) continue;
    // Also avoid immediate neighbors of first click for fairness
    if (Math.abs(x - excludeX) <= 1 && Math.abs(y - excludeY) <= 1) continue;
    cell.mine = true;
    placed++;
  }
  // Calculate adjacent counts
  for (let y = 0; y < gridH; y++) {
    for (let x = 0; x < gridW; x++) {
      if (grid[y][x].mine) continue;
      let count = 0;
      for (let dy = -1; dy <= 1; dy++) {
        for (let dx = -1; dx <= 1; dx++) {
          if (dx === 0 && dy === 0) continue;
          const nx = x + dx, ny = y + dy;
          if (nx >= 0 && nx < gridW && ny >= 0 && ny < gridH && grid[ny][nx].mine) count++;
        }
      }
      grid[y][x].adjacent = count;
    }
  }
}

function reveal(x, y) {
  if (x < 0 || x >= gridW || y < 0 || y >= gridH) return;
  const cell = grid[y][x];
  if (cell.revealed || cell.flagged) return;

  if (firstClick) {
    placeMines(x, y);
    firstClick = false;
  }

  if (cell.mine) {
    cell.revealed = true;
    gameOver = true;
    loseGame();
    return;
  }

  cell.revealed = true;
  revealedCount++;
  score += 10 * level;

  if (cell.adjacent === 0) {
    // Flood fill
    for (let dy = -1; dy <= 1; dy++) {
      for (let dx = -1; dx <= 1; dx++) {
        if (dx === 0 && dy === 0) continue;
        reveal(x + dx, y + dy);
      }
    }
  }
  checkWin();
  draw();
}

function toggleFlag(x, y) {
  if (x < 0 || x >= gridW || y < 0 || y >= gridH) return;
  const cell = grid[y][x];
  if (cell.revealed) return;
  if (cell.flagged) {
    cell.flagged = false;
    flaggedCount--;
  } else {
    if (flaggedCount < mineCount) {
      cell.flagged = true;
      flaggedCount++;
    }
  }
  updateUI();
  draw();
}

function checkWin() {
  if (revealedCount === gridW * gridH - mineCount) {
    win = true;
    gameOver = true;
    winGame();
  }
}

function loseGame() {
  clearInterval(timerId);
  // Reveal all mines
  for (let y = 0; y < gridH; y++) {
    for (let x = 0; x < gridW; x++) {
      if (grid[y][x].mine) grid[y][x].revealed = true;
    }
  }
  draw();
  showGameOver('SYSTEM BREACH', 'MINE DETONATED. NEURAL LINK SEVERED.', '#ff3344');
}

function winGame() {
  clearInterval(timerId);
  const timeBonus = Math.max(0, 5000 - (Date.now() - startTime));
  const levelBonus = level * 1000;
  score += timeBonus + levelBonus;
  if (score > bestScore) {
    bestScore = score;
    localStorage.setItem('neonMinesweeperBest', bestScore.toString());
  }
  draw();
  showGameOver('SECTOR CLEARED', `LEVEL ${level} COMPLETE. BONUS: ${timeBonus + levelBonus}`, '#00ff88');
  // Advance level after short delay
  setTimeout(() => {
    level++;
    gridW = Math.min(MAX_GRID, MIN_GRID + (level - 1) * 2);
    gridH = Math.min(MAX_GRID, MIN_GRID + (level - 1) * 2);
    init();
  }, 2000);
}

function updateTimer() {
  const elapsed = Math.floor((Date.now() - startTime) / 1000);
  timeEl.textContent = elapsed;
}

function updateUI() {
  levelEl.textContent = level;
  minesEl.textContent = mineCount;
  flagsEl.textContent = flaggedCount;
  scoreEl.textContent = score;
  bestEl.textContent = bestScore;
}

function showMsg(title, text, color) {
  msgTitle.textContent = title;
  msgTitle.style.color = color;
  msgTitle.style.textShadow = `0 0 10px ${color}`;
  msgText.textContent = text;
  msgBox.style.display = 'block';
  msgBox.style.borderColor = color;
  msgBox.style.boxShadow = `0 0 30px ${color}80`;
}

function hideMsg() {
  msgBox.style.display = 'none';
}

function showGameOver(title, text, color) {
  gameOverTitle.textContent = title;
  gameOverTitle.style.color = color;
  gameOverTitle.style.textShadow = `0 0 30px ${color}`;
  gameOverText.textContent = text;
  gameOverOverlay.classList.remove('hidden');
}

// ===== Rendering =====
function draw() {
  // Clear
  ctx.fillStyle = COLORS.bg;
  ctx.fillRect(0, 0, canvas.width, canvas.height);

  // Draw grid lines
  ctx.strokeStyle = COLORS.grid;
  ctx.lineWidth = 1;
  ctx.beginPath();
  for (let x = 0; x <= gridW; x++) {
    const px = x * cellSize;
    ctx.moveTo(px, 0);
    ctx.lineTo(px, canvas.height);
  }
  for (let y = 0; y <= gridH; y++) {
    const py = y * cellSize;
    ctx.moveTo(0, py);
    ctx.lineTo(canvas.width, py);
  }
  ctx.stroke();

  // Draw cells
  for (let y = 0; y < gridH; y++) {
    for (let x = 0; x < gridW; x++) {
      const cell = grid[y][x];
      const px = x * cellSize;
      const py = y * cellSize;
      const padding = 2;
      const innerW = cellSize - padding * 2;
      const innerH = cellSize - padding * 2;

      if (cell.revealed) {
        // Revealed cell background
        ctx.fillStyle = cell.mine ? COLORS.mine : COLORS.revealed;
        ctx.fillRect(px + padding, py + padding, innerW, innerH);

        if (cell.mine) {
          // Draw mine - pulsing circle
          const centerX = px + cellSize / 2;
          const centerY = py + cellSize / 2;
          const radius = (cellSize * 0.35) * (1 + 0.15 * Math.sin(Date.now() / 150));
          ctx.beginPath();
          ctx.arc(centerX, centerY, radius, 0, Math.PI * 2);
          ctx.fillStyle = COLORS.mine;
          ctx.shadowColor = COLORS.mine;
          ctx.shadowBlur = 15;
          ctx.fill();
          ctx.shadowBlur = 0;
          // Crosshair
          ctx.strokeStyle = '#ffaaaa';
          ctx.lineWidth = 2;
          ctx.beginPath();
          ctx.moveTo(centerX - radius * 0.6, centerY);
          ctx.lineTo(centerX + radius * 0.6, centerY);
          ctx.moveTo(centerX, centerY - radius * 0.6);
          ctx.lineTo(centerX, centerY + radius * 0.6);
          ctx.stroke();
        } else if (cell.adjacent > 0) {
          // Draw number
          const num = cell.adjacent;
          ctx.font = `bold ${cellSize * 0.55}px 'Courier New', monospace`;
          ctx.fillStyle = COLORS.numbers[num];
          ctx.textAlign = 'center';
          ctx.textBaseline = 'middle';
          ctx.shadowColor = COLORS.numbers[num];
          ctx.shadowBlur = 8;
          ctx.fillText(num.toString(), px + cellSize / 2, py + cellSize / 2 + 1);
          ctx.shadowBlur = 0;
        }
      } else {
        // Hidden cell
        const grad = ctx.createLinearGradient(px, py, px, py + cellSize);
        grad.addColorStop(0, '#0d2d20');
        grad.addColorStop(1, '#081810');
        ctx.fillStyle = grad;
        ctx.fillRect(px + padding, py + padding, innerW, innerH);
        // Subtle border highlight
        ctx.strokeStyle = '#004433';
        ctx.lineWidth = 1;
        ctx.strokeRect(px + padding + 0.5, py + padding + 0.5, innerW - 1, innerH - 1);

        if (cell.flagged) {
          // Draw flag
          const cx = px + cellSize / 2;
          const cy = py + cellSize / 2;
          const h = cellSize * 0.5;
          ctx.fillStyle = COLORS.flag;
          ctx.shadowColor = COLORS.flag;
          ctx.shadowBlur = 10;
          // Pole
          ctx.fillRect(cx - 1, cy - h/2, 2, h);
          // Triangle
          ctx.beginPath();
          ctx.moveTo(cx, cy - h/2);
          ctx.lineTo(cx + h * 0.6, cy - h/2 + h * 0.4);
          ctx.lineTo(cx, cy - h/2 + h * 0.3);
          ctx.closePath();
          ctx.fill();
          ctx.shadowBlur = 0;
        }
      }
    }
  }

  // Keyboard cursor highlight
  if (hasCursor && !gameOver) {
    const px = cursorX * cellSize;
    const py = cursorY * cellSize;
    ctx.strokeStyle = COLORS.cursor;
    ctx.lineWidth = 3;
    ctx.shadowColor = COLORS.neon_green;
    ctx.shadowBlur = 10;
    ctx.strokeRect(px + 1.5, py + 1.5, cellSize - 3, cellSize - 3);
    ctx.shadowBlur = 0;
  }

  // Game over overlay (handled by msg box, but subtle screen flash)
  if (gameOver && !win) {
    ctx.fillStyle = 'rgba(255, 51, 68, 0.15)';
    ctx.fillRect(0, 0, canvas.width, canvas.height);
  }
}

// ===== Input Handling =====
function getCellFromClient(clientX, clientY) {
  const rect = canvas.getBoundingClientRect();
  const x = Math.floor((clientX - rect.left) / cellSize);
  const y = Math.floor((clientY - rect.top) / cellSize);
  return { x, y };
}

function handleClick(clientX, clientY, isRightClick = false) {
  if (gameOver || state.paused) return;
  const { x, y } = getCellFromClient(clientX, clientY);
  if (x < 0 || x >= gridW || y < 0 || y >= gridH) return;
  hasCursor = true;
  cursorX = x; cursorY = y;
  if (isRightClick) {
    toggleFlag(x, y);
  } else {
    reveal(x, y);
  }
}

canvas.addEventListener('mousedown', e => {
  if (e.button === 2) e.preventDefault();
});
canvas.addEventListener('contextmenu', e => e.preventDefault());
canvas.addEventListener('click', e => handleClick(e.clientX, e.clientY, false));
canvas.addEventListener('contextmenu', e => handleClick(e.clientX, e.clientY, true));

// Touch handling
let touchStart = null;
let touchTimer = null;
canvas.addEventListener('touchstart', e => {
  if (e.touches.length !== 1) return;
  const touch = e.touches[0];
  touchStart = { x: touch.clientX, y: touch.clientY, time: Date.now() };
  touchTimer = setTimeout(() => {
    // Long press = flag
    if (touchStart) handleClick(touchStart.x, touchStart.y, true);
  }, 500);
}, { passive: false });
canvas.addEventListener('touchmove', e => {
  if (!touchStart) return;
  const touch = e.touches[0];
  if (Math.abs(touch.clientX - touchStart.x) > 10 || Math.abs(touch.clientY - touchStart.y) > 10) {
    clearTimeout(touchTimer);
    touchStart = null;
  }
}, { passive: true });
canvas.addEventListener('touchend', e => {
  if (touchStart) {
    clearTimeout(touchTimer);
    if (Date.now() - touchStart.time < 500) {
      handleClick(touchStart.x, touchStart.y, false);
    }
    touchStart = null;
  }
}, { passive: true });

// Keyboard
window.addEventListener('keydown', e => {
  if (gameOver) {
    if (e.key === 'Enter' || e.key === ' ') { hideMsg(); init(); }
    return;
  }
  if (e.key === 'Escape' || e.key === 'Escape') {
    if (state.paused) {
      resumeGame();
    } else {
      pauseGame();
    }
    return;
  }
  if (state.paused) return;
  switch (e.key) {
    case 'ArrowUp': cursorY = Math.max(0, cursorY - 1); hasCursor = true; draw(); break;
    case 'ArrowDown': cursorY = Math.min(gridH - 1, cursorY + 1); hasCursor = true; draw(); break;
    case 'ArrowLeft': cursorX = Math.max(0, cursorX - 1); hasCursor = true; draw(); break;
    case 'ArrowRight': cursorX = Math.min(gridW - 1, cursorX + 1); hasCursor = true; draw(); break;
    case 'Enter':
    case ' ': reveal(cursorX, cursorY); break;
    case 'f':
    case 'F': toggleFlag(cursorX, cursorY); break;
    case 'r':
    case 'R': init(); break;
  }
});

// Restart button
restartBtn.addEventListener('click', () => {
  init();
});

// --- Pause/Resume/Quit Functions for game-031 ---
function pauseGame() {
    if (!state.running) return;
    state.paused = true;
    clearInterval(timerId);
    pauseOverlay.classList.remove('hidden');
}

function resumeGame() {
    if (!state.paused) return;
    state.paused = false;
    startTime = Date.now() - (parseInt(timeEl.textContent) * 1000);
    timerId = setInterval(updateTimer, 1000);
    pauseOverlay.classList.add('hidden');
}

function quitToMenu() {
    state.running = false;
    state.paused = false;
    clearInterval(timerId);
    pauseOverlay.classList.add('hidden');
    gameOverOverlay.classList.add('hidden');
    msgBox.style.display = 'none';
    showStartScreen();
}

function showStartScreen() {
    // Reset to level 1
    level = 1;
    gridW = MIN_GRID;
    gridH = MIN_GRID;
    score = 0;
    init();
    state.running = true;
}

function startGame() {
    // Called from RETRY button on game over overlay
    gameOverOverlay.classList.add('hidden');
    level = 1;
    gridW = MIN_GRID;
    gridH = MIN_GRID;
    score = 0;
    init();
    state.running = true;
}

// Initialize on load
window.addEventListener('load', () => {
    showStartScreen();
});
</script>
</body>
</html>