<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no">
<title>Neon Minesweeper - Day 31</title>
<style>
:root {
  --bg: #0a0a12;
  --fg: #e0ffe0;
  --neon-green: #00ff88;
  --neon-blue: #00ccff;
  --neon-pink: #ff00aa;
  --neon-orange: #ff8800;
  --neon-red: #ff3344;
  --panel: rgba(10, 10, 20, 0.9);
  --border: #00ff88;
}
* { margin: 0; padding: 0; box-sizing: border-box; }
body {
  background: var(--bg);
  color: var(--fg);
  font-family: 'Courier New', Courier, monospace;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 100vh;
  overflow: hidden;
  touch-action: none;
}
canvas {
  display: block;
  border: 2px solid var(--border);
  border-radius: 8px;
  box-shadow: 0 0 20px rgba(0, 255, 136, 0.3), inset 0 0 20px rgba(0, 255, 136, 0.1);
  background: #05050a;
}
.ui {
  position: fixed;
  top: 12px;
  left: 50%;
  transform: translateX(-50%);
  display: flex;
  gap: 24px;
  padding: 8px 16px;
  background: var(--panel);
  border: 1px solid var(--border);
  border-radius: 6px;
  box-shadow: 0 0 15px rgba(0, 255, 136, 0.2);
  z-index: 10;
  font-size: 14px;
  letter-spacing: 1px;
}
.ui span { color: var(--neon-green); text-shadow: 0 0 5px var(--neon-green); }
.btn {
  position: fixed;
  bottom: 20px;
  left: 50%;
  transform: translateX(-50%);
  padding: 10px 28px;
  background: transparent;
  border: 2px solid var(--neon-green);
  color: var(--neon-green);
  font-family: inherit;
  font-size: 14px;
  letter-spacing: 2px;
  cursor: pointer;
  border-radius: 4px;
  transition: all 0.2s;
  text-shadow: 0 0 5px var(--neon-green);
}
.btn:hover, .btn:focus {
  background: var(--neon-green);
  color: var(--bg);
  box-shadow: 0 0 20px var(--neon-green);
}
.msg {
  position: fixed;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  padding: 30px 50px;
  background: var(--panel);
  border: 2px solid var(--neon-pink);
  border-radius: 12px;
  text-align: center;
  display: none;
  z-index: 20;
  box-shadow: 0 0 30px rgba(255, 0, 170, 0.4);
}
.msg h2 { margin-bottom: 12px; color: var(--neon-pink); text-shadow: 0 0 10px var(--neon-pink); font-size: 28px; }
.msg p { color: var(--neon-blue); margin-bottom: 20px; font-size: 18px; }
@media (max-width: 600px) {
  .ui { font-size: 11px; gap: 12px; padding: 6px 10px; top: 8px; }
  .btn { bottom: 12px; padding: 8px 20px; font-size: 12px; }
  .msg { padding: 20px 30px; width: 90%; }
  .msg h2 { font-size: 22px; }
  .msg p { font-size: 16px; }
}

.overlay {
    position: fixed;
    top: 0; left: 0; right: 0; bottom: 0;
    background: rgba(0,0,0,0.95);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    z-index: 100;
    gap: 20px;
    padding: 20px;
}
.overlay.hidden { display: none; }
.overlay h1 { font-size: clamp(32px, 8vw, 64px); text-shadow: 0 0 30px #00ffea; letter-spacing: 4px; }
.overlay p { color: #00ffea88; font-size: 14px; text-align: center; max-width: 400px; line-height: 1.6; }
.overlay .btn {
    position: static;
    transform: none;
    padding: 12px 32px;
    font-size: 16px;
    font-family: 'Courier New', monospace;
    background: transparent;
    color: #00ffea;
    border: 2px solid #00ffea;
    border-radius: 4px;
    cursor: pointer;
    transition: all 0.2s;
}
.overlay .btn:hover { background: #00ffea; color: #0a0a0f; box-shadow: 0 0 20px #00