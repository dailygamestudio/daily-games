<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no">
<title>Neon Onslaught - Day 40</title>
<style>
  * { margin:0; padding:0; box-sizing:border-box; -webkit-tap-highlight-color:transparent; }
  body { background:#0a0a12; color:#0ff; font-family:'Orbitron',sans-serif; overflow:hidden; height:100vh; display:flex; flex-direction:column; align-items:center; justify-content:center; }
  canvas { display:block; background:#05050a; box-shadow:0 0 30px #0ff4, inset 0 0 60px #000; }
  #ui { position:fixed; top:10px; left:10px; right:10px; display:flex; justify-content:space-between; pointer-events:none; z-index:10; }
  .stat { background:rgba(0,20,30,0.8); border:1px solid #0ff4; padding:5px 15px; border-radius:4px; text-shadow:0 0 5px #0ff; font-size:1.2rem; }
  .overlay { position:fixed; top:0; left:0; width:100%; height:100%; background:rgba(0,0,0,0.9); display:flex; flex-direction:column; align-items:center; justify-content:center; z-index:20; gap:20px; }
  .overlay.hidden { display:none; }
  .overlay h1 { font-size:3rem; text-shadow:0 0 20px #f0f, 0 0 40px #0ff; letter-spacing:4px; margin-bottom:10px; }
  .overlay p { font-size:1.5rem; color:#aaa; }
  button { background:linear-gradient(135deg,#001122,#003344); border:2px solid #0ff; color:#0ff; padding:15px 40px; font-size:1.3rem; font-family:inherit; border-radius:6px; cursor:pointer; transition:0.3s; text-transform:uppercase; letter-spacing:2px; text-shadow:0 0 5px #0ff; box-shadow:0 0 10px #0ff4; }
  button:hover, button:focus { background:linear-gradient(135deg,#003344,#005566); box-shadow:0 0 20px #0ff, inset 0 0 10px #0ff4; transform:scale(1.05); }
  .joystick-area { position:fixed; bottom:20px; width:120px; height:120px; pointer-events:none; z-index:15; }
  .joystick-area.left { left:20px; }
  .joystick-area.right { right:20px; }
  .joystick-base { position:absolute; width:100%; height:100%; border:2px solid #0ff4; border-radius:50%; background:rgba(0,255,255,0.05); }
  .joystick-stick { position:absolute; width:50px; height:50px; border-radius:50%; background:radial-gradient(circle at 30% 30%, #0ff, #088); border:2px solid #0ff; top:35px; left:35px; pointer-events:auto; touch-action:none; box-shadow:0 0 15px #0ff; }
  @media (min-width:768px) { .joystick-area { display:none; } }
</style>
</head>
<body>
<canvas id="gameCanvas"></canvas>
<div id="ui">
  <div class="stat">SCORE: <span id="score">0</span></div>
  <div class="stat">HIGH: <span id="highScore">0</span></div>
  <div class="stat">WAVE: <span id="wave">1</span></div>
</div>

<div class="joystick-area left">
  <div class="joystick-base"></div>
  <div class="joystick-stick" id="leftStick"></div>
</div>
<div class="joystick-area right">
  <div class="joystick-base"></div>
  <div class="joystick-stick" id="rightStick"></div>
</div>

<div id="startScreen" class="overlay">
  <h1>NEON ONSLAUGHT</h1>
  <p>Survive the endless neon horde</p>
  <p style="font-size:1rem; color:#666;">WASD/Arrows: Move | Mouse: Aim | Click/Space: Shoot | ESC/P: Pause</p>
  <p style="font-size:1rem; color:#666;">Mobile: Left Joystick Move | Right Joystick Aim</p>
  <button id="startBtn">START GAME</button>
</div>

<div id="pauseScreen" class="overlay hidden">
  <h1>PAUSED</h1>
  <button id="resumeBtn">RESUME</button>
  <button id="quitBtn">QUIT TO MENU</button>
</div>

<div id="gameOverScreen" class="overlay hidden">
  <h1>GAME OVER</h1>
  <p>Final Score: <span id="finalScore">0</span></p>
  <button id="retryBtn">RETRY</button>
  <button id="menuBtn">MAIN MENU</button>
</div>

<script>
// ========== GAME CONSTANTS & STATE ==========
const canvas = document.getElementById('gameCanvas');
const ctx = canvas.getContext('2d');
let width = 0, height = 0;

let gameState = 'start'; // 'start', 'playing', 'paused', 'gameover'
let running = false; // true when game loop runs (playing)
let lastTime = 0;
let score = 0;
let highScore = parseInt(localStorage.getItem('neonOnslaughtHigh') || '0', 10);
let wave = 1;
let waveTimer = 0;
let waveInterval = 10000; // ms between waves
let difficulty = 1;

const player = {
  x: 0, y: 0,
  radius: 18,
  speed: 300, // px/s
  hp: 3,
  maxHp: 3,
  fireRate: 200, // ms
  fireTimer: 0,
  angle: 0,
  color: '#0ff',
  glow: '#0ff'
};

const bullets = [];
const enemies = [];
const particles = [];
const pickups = [];

const keys = {};
const mouse = { x: 0, y: 0, down: false };

// Touch joysticks
const joysticks = {
  left: { active:false, id:null, baseX:0, baseY:0, stickX:0, stickY:0, dx:0, dy:0, element: document.getElementById('leftStick') },
  right: { active:false, id:null, baseX:0, baseY:0, stickX:0, stickY:0, dx:0, dy:0, element: document.getElementById('rightStick') }
};

// ========== INIT ==========
function resize() {
  width = canvas.width = window.innerWidth;
  height = canvas.height = window.innerHeight;
  player.x = width/2;
  player.y = height/2;
  // position joystick bases (fixed positions)
  joysticks.left.baseX = 80; joysticks.left.baseY = height - 80;
  joysticks.right.baseX = width - 80; joysticks.right.baseY = height - 80;
  joysticks.left.stickX = joysticks.left.baseX; joysticks.left.stickY = joysticks.left.baseY;
  joysticks.right.stickX = joysticks.right.baseX; joysticks.right.stickY = joysticks.right.baseY;
  updateJoystickVisual(joysticks.left);
  updateJoystickVisual(joysticks.right);
}
window.addEventListener('resize', resize);
resize();

document.getElementById('highScore').textContent = highScore;

// ========== INPUT ==========
window.addEventListener('keydown', e => {
  keys[e.code] = true;
  if (e.code === 'Escape' || e.code === 'KeyP') togglePause();
  if (e.code === 'Space') mouse.down = true;
});
window.addEventListener('keyup', e => { keys[e.code] = false; if (e.code === 'Space') mouse.down = false; });

canvas.addEventListener('mousemove', e => { mouse.x = e.clientX; mouse.y = e.clientY; });
canvas.addEventListener('mousedown', () => mouse.down = true);
canvas.addEventListener('mouseup', () => mouse.down = false);
canvas.addEventListener('contextmenu', e => e.preventDefault());

// Touch joystick handling
function handleTouchStart(e) {
  for (const touch of e.changedTouches) {
    const x = touch.clientX, y = touch.clientY;
    // left joystick area
    if (x < width/2 && y > height/2) {
      if (!joysticks.left.active) {
        joysticks.left.active = true;
        joysticks.left.id = touch.identifier;
        // base is fixed, stick starts at base
        joysticks.left.stickX = joysticks.left.baseX;
        joysticks.left.stickY = joysticks.left.baseY;
        updateJoystickVisual(joysticks.left);
      }
    }
    // right joystick area
    else if (x >= width/2 && y > height/2) {
      if (!joysticks.right.active) {
        joysticks.right.active = true;
        joysticks.right.id = touch.identifier;
        joysticks.right.stickX = joysticks.right.baseX;
        joysticks.right.stickY = joysticks.right.baseY;
        updateJoystickVisual(joysticks.right);
      }
    }
  }
}
function handleTouchMove(e) {
  e.preventDefault();
  for (const touch of e.changedTouches) {
    const x = touch.clientX, y = touch.clientY;
    if (touch.identifier === joysticks.left.id && joysticks.left.active) {
      updateJoystick(joysticks.left, x, y);
    } else if (touch.identifier === joysticks.right.id && joysticks.right.active) {
      updateJoystick(joysticks.right, x, y);
    }
  }
}
function handleTouchEnd(e) {
  for (const touch of e.changedTouches) {
    if (touch.identifier === joysticks.left.id) resetJoystick(joysticks.left);
    if (touch.identifier === joysticks.right.id) resetJoystick(joysticks.right);
  }
}
function updateJoystick(joy, x, y) {
  const dx = x - joy.baseX, dy = y - joy.baseY;
  const dist = Math.hypot(dx, dy);
  const maxR = 50;
  if (dist > maxR) {
    joy.stickX = joy.baseX + dx/dist * maxR;
    joy.stickY = joy.baseY + dy/dist * maxR;
    joy.dx = dx/dist; joy.dy = dy/dist;
  } else {
    joy.stickX = x; joy.stickY = y;
    joy.dx = dist>0? dx/dist:0; joy.dy = dist>0? dy/dist:0;
  }
  updateJoystickVisual(joy);
}
function resetJoystick(joy) {
  joy.active = false; joy.id = null;
  joy.stickX = joy.baseX; joy.stickY = joy.baseY;
  joy.dx = 0; joy.dy = 0;
  updateJoystickVisual(joy);
}
function updateJoystickVisual(joy) {
  if (joy.element) {
    // stick position relative to joystick-area (which is 120x120, base at center 60,60)
    // stick element is 50x50, so its top-left should be (stickX - baseX - 25 + 60, stickY - baseY - 25 + 60)
    // but the joystick-area is positioned at fixed bottom:20px left/right:20px.
    // The base center in screen coordinates is (joy.baseX, joy.baseY).
    // The stick element is inside the joystick-area, which has its own coordinate system.
    // The joystick-area's top-left is at (joy.baseX - 60, joy.baseY - 60).
    // So stick's top-left in area coordinates = (joy.stickX - (joy.baseX - 60) - 25, joy.stickY - (joy.baseY - 60) - 25)
    // = (joy.stickX - joy.baseX + 35, joy.stickY - joy.baseY + 35)
    const left = joy.stickX - joy.baseX + 35;
    const top = joy.stickY - joy.baseY + 35;
    joy.element.style.left = left + 'px';
    joy.element.style.top = top + 'px';
  }
}
canvas.addEventListener('touchstart', handleTouchStart, {passive:false});
canvas.addEventListener('touchmove', handleTouchMove, {passive:false});
canvas.addEventListener('touchend', handleTouchEnd);
canvas.addEventListener('touchcancel', handleTouchEnd);

// ========== GAME LOGIC ==========
function spawnEnemy() {
  const side = Math.floor(Math.random()*4);
  let x, y;
  const margin = 50;
  if (side===0) { x = Math.random()*width; y = -margin; }
  else if (side===1) { x = width+margin; y = Math.random()*height; }
  else if (side===2) { x = Math.random()*width; y = height+margin; }
  else { x = -margin; y = Math.random()*height; }
  const hp = 1 + Math.floor(difficulty/2);
  const speed = 60 + difficulty*10 + Math.random()*40;
  const size = 15 + Math.random()*10;
  enemies.push({ x, y, vx:0, vy:0, hp, maxHp:hp, speed, size, color:`hsl(${Math.random()*60+180},100%,50%)`, angle:0 });
}

function spawnPickup(x, y) {
  if (Math.random() < 0.15) {
    pickups.push({ x, y, radius:10, type:Math.random()<0.5?'health':'power', life:10000, color:Math.random()<0.5?'#f44':'#4f4' });
  }
}

function createParticles(x, y, color, count, speed) {
  for (let i=0;i<count;i++) {
    const ang = Math.random()*Math.PI*2;
    const spd = speed * (0.5+Math.random()*0.5);
    particles.push({ x, y, vx:Math.cos(ang)*spd, vy:Math.sin(ang)*spd, life:1, maxLife:0.5+Math.random()*0.5, size:2+Math.random()*3, color });
  }
}

function update(dt) {
  // Player movement
  let moveX = 0, moveY = 0;
  if (keys['KeyW'] || keys['ArrowUp']) moveY -= 1;
  if (keys['KeyS'] || keys['ArrowDown']) moveY += 1;
  if (keys['KeyA'] || keys['ArrowLeft']) moveX -= 1;
  if (keys['KeyD'] || keys['ArrowRight']) moveX += 1;
  // Touch joystick left
  if (joysticks.left.active) { moveX += joysticks.left.dx; moveY += joysticks.left.dy; }
  const moveLen = Math.hypot(moveX, moveY);
  if (moveLen > 0) { moveX /= moveLen; moveY /= moveLen; }
  player.x += moveX * player.speed * dt;
  player.y += moveY * player.speed * dt;
  // Clamp to screen
  player.x = Math.max(player.radius, Math.min(width-player.radius, player.x));
  player.y = Math.max(player.radius, Math.min(height-player.radius, player.y));

  // Aiming
  let aimX = 0, aimY = 0;
  if (joysticks.right.active) { aimX = joysticks.right.dx; aimY = joysticks.right.dy; }
  else { aimX = mouse.x - player.x; aimY = mouse.y - player.y; }
  const aimLen = Math.hypot(aimX, aimY);
  if (aimLen > 0) { player.angle = Math.atan2(aimY, aimX); }

  // Shooting
  player.fireTimer -= dt*1000;
  const shooting = mouse.down || (joysticks.right.active && (Math.abs(joysticks.right.dx)>0.2 || Math.abs(joysticks.right.dy)>0.2));
  if (shooting && player.fireTimer <= 0) {
    fireBullet();
    player.fireTimer = player.fireRate;
  }

  // Update bullets
  for (let i=bullets.length-1;i>=0;i--) {
    const b = bullets[i];
    b.x += b.vx * dt; b.y += b.vy * dt;
    b.life -= dt;
    if (b.life <= 0 || b.x < -50 || b.x > width+50 || b.y < -50 || b.y > height+50) bullets.splice(i,1);
  }

  // Update enemies
  for (let i=enemies.length-1;i>=0;i--) {
    const e = enemies[i];
    const dx = player.x - e.x, dy = player.y - e.y;
    const dist = Math.hypot(dx, dy);
    if (dist > 0) { e.vx = dx/dist * e.speed; e.vy = dy/dist * e.speed; }
    e.x += e.vx * dt; e.y += e.vy * dt;
    e.angle = Math.atan2(e.vy, e.vx);

    // Collision with player
    if (dist < player.radius + e.size) {
      player.hp--;
      createParticles(player.x, player.y, '#f44', 15, 200);
      // knockback
      player.x += dx/dist * 30; player.y += dy/dist * 30;
      if (player.hp <= 0) gameOver();
    }

    // Collision with bullets
    for (let j=bullets.length-1;j>=0;j--) {
      const b = bullets[j];
      const bdx = b.x - e.x, bdy = b.y - e.y;
      if (Math.hypot(bdx, bdy) < e.size + b.radius) {
        e.hp--;
        createParticles(b.x, b.y, e.color, 8, 150);
        bullets.splice(j,1);
        if (e.hp <= 0) {
          score += 10 * wave;
          document.getElementById('score').textContent = score;
          createParticles(e.x, e.y, e.color, 25, 300);
          spawnPickup(e.x, e.y);
          enemies.splice(i,1);
          break;
        }
      }
    }
  }

  // Update pickups
  for (let i=pickups.length-1;i>=0;i--) {
    const p = pickups[i];
    p.life -= dt*1000;
    const dx = player.x - p.x, dy = player.y - p.y;
    if (Math.hypot(dx, dy) < player.radius + p.radius) {
      if (p.type === 'health') { player.hp = Math.min(player.maxHp, player.hp+1); }
      else { player.fireRate = Math.max(50, player.fireRate - 20); }
      createParticles(p.x, p.y, p.color, 10, 100);
      pickups.splice(i,1);
    } else if (p.life <= 0) pickups.splice(i,1);
  }

  // Update particles
  for (let i=particles.length-1;i>=0;i--) {
    const p = particles[i];
    p.x += p.vx * dt; p.y += p.vy * dt;
    p.life -= dt;
    if (p.life <= 0) particles.splice(i,1);
  }

  // Wave management
  waveTimer += dt*1000;
  if (waveTimer >= waveInterval) {
    wave++;
    difficulty += 0.5;
    waveTimer = 0;
    document.getElementById('wave').textContent = wave;
    // spawn a bunch of enemies
    for (let i=0;i<3+wave;i++) spawnEnemy();
  }

  // Spawn enemies periodically
  if (Math.random() < 0.02 * difficulty * dt*60) spawnEnemy();
}

function fireBullet() {
  const spread = 0.05;
  const ang = player.angle + (Math.random()-0.5)*spread;
  const speed = 800;
  bullets.push({
    x: player.x + Math.cos(player.angle)*player.radius,
    y: player.y + Math.sin(player.angle)*player.radius,
    vx: Math.cos(ang)*speed,
    vy: Math.sin(ang)*speed,
    radius: 4,
    life: 1.5,
    color: '#0ff'
  });
  // muzzle flash
  createParticles(player.x + Math.cos(player.angle)*player.radius, player.y + Math.sin(player.angle)*player.radius, '#0ff', 5, 100);
}

function gameOver() {
  running = false;
  gameState = 'gameover';
  if (score > highScore) { highScore = score; localStorage.setItem('neonOnslaughtHigh', highScore); }
  document.getElementById('finalScore').textContent = score;
  document.getElementById('highScore').textContent = highScore;
  document.getElementById('gameOverScreen').classList.remove('hidden');
}

// ========== RENDER ==========
function draw() {
  // Clear with trail effect
  ctx.fillStyle = 'rgba(5,5,10,0.3)';
  ctx.fillRect(0,0,width,height);

  // Grid background
  ctx.strokeStyle = '#0ff1';
  ctx.lineWidth = 1;
  const gridSize = 50;
  for (let x=0;x<width;x+=gridSize) { ctx.beginPath(); ctx.moveTo(x,0); ctx.lineTo(x,height); ctx.stroke(); }
  for (let y=0;y<height;y+=gridSize) { ctx.beginPath(); ctx.moveTo(0,y); ctx.lineTo(width,y); ctx.stroke(); }

  // Particles
  for (const p of particles) {
    ctx.globalAlpha = p.life / p.maxLife;
    ctx.fillStyle = p.color;
    ctx.beginPath(); ctx.arc(p.x, p.y, p.size * (p.life/p.maxLife), 0, Math.PI*2); ctx.fill();
  }
  ctx.globalAlpha = 1;

  // Pickups
  for (const p of pickups) {
    ctx.fillStyle = p.color;
    ctx.shadowColor = p.color; ctx.shadowBlur = 15;
    ctx.beginPath(); ctx.arc(p.x, p.y, p.radius, 0, Math.PI*2); ctx.fill();
    ctx.shadowBlur = 0;
  }

  // Bullets
  for (const b of bullets) {
    ctx.fillStyle = b.color;
    ctx.shadowColor = b.color; ctx.shadowBlur = 10;
    ctx.beginPath(); ctx.arc(b.x, b.y, b.radius, 0, Math.PI*2); ctx.fill();
    ctx.shadowBlur = 0;
  }

  // Enemies
  for (const e of enemies) {
    ctx.save();
    ctx.translate(e.x, e.y);
    ctx.rotate(e.angle);
    // body
    const grad = ctx.createRadialGradient(0,0,0,0,0,e.size);
    grad.addColorStop(0, e.color);
    grad.addColorStop(1, '#000');
    ctx.fillStyle = grad;
    ctx.shadowColor = e.color; ctx.shadowBlur = 15;
    ctx.beginPath();
    ctx.moveTo(e.size, 0);
    ctx.lineTo(-e.size*0.7, e.size*0.6);
    ctx.lineTo(-e.size*0.3, 0);
    ctx.lineTo(-e.size*0.7, -e.size*0.6);
    ctx.closePath();
    ctx.fill();
    ctx.shadowBlur = 0;
    // health bar
    if (e.hp < e.maxHp) {
      ctx.fillStyle = '#333';
      ctx.fillRect(-e.size, -e.size-8, e.size*2, 4);
      ctx.fillStyle = '#f44';
      ctx.fillRect(-e.size, -e.size-8, e.size*2 * (e.hp/e.maxHp), 4);
    }
    ctx.restore();
  }

  // Player
  ctx.save();
  ctx.translate(player.x, player.y);
  ctx.rotate(player.angle);
  // glow
  ctx.shadowColor = player.glow; ctx.shadowBlur = 20;
  const pGrad = ctx.createRadialGradient(0,0,0,0,0,player.radius);
  pGrad.addColorStop(0, player.color);
  pGrad.addColorStop(1, '#003344');
  ctx.fillStyle = pGrad;
  ctx.beginPath();
  ctx.moveTo(player.radius, 0);
  ctx.lineTo(-player.radius*0.7, player.radius*0.6);
  ctx.lineTo(-player.radius*0.3, 0);
  ctx.lineTo(-player.radius*0.7, -player.radius*0.6);
  ctx.closePath();
  ctx.fill();
  ctx.shadowBlur = 0;
  // health indicator
  for (let i=0;i<player.maxHp;i++) {
    ctx.fillStyle = i < player.hp ? '#0f0' : '#333';
    ctx.shadowColor = i < player.hp ? '#0f0' : '#000';
    ctx.shadowBlur = i < player.hp ? 10 : 0;
    ctx.beginPath();
    ctx.arc(-player.radius + 10 + i*12, player.radius+10, 5, 0, Math.PI*2);
    ctx.fill();
  }
  ctx.shadowBlur = 0;
  ctx.restore();

  // UI: wave indicator (already in HTML)
}

// ========== GAME LOOP ==========
function gameLoop(timestamp) {
  if (!running) return;
  const dt = (timestamp - lastTime) / 1000; // seconds
  lastTime = timestamp;
  update(dt);
  draw();
  requestAnimationFrame(gameLoop);
}

// ========== STATE MANAGEMENT ==========
function startGame() {
  // reset game state
  score = 0;
  wave = 1;
