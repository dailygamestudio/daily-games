<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no">
<title>Neon Merge - Day 39</title>
<style>
  * { margin: 0; padding: 0; box-sizing: border-box; }
  body { 
    background: #0a0a12; 
    color: #00ffcc; 
    font-family: 'Courier New', Courier, monospace; 
    overflow: hidden; 
    height: 100vh; 
    display: flex; 
    justify-content: center; 
    align-items: center; 
  }
  #gameCanvas { 
    display: block; 
    box-shadow: 0 0 30px #00ffcc, inset 0 0 30px rgba(0,255,204,0.1); 
    border-radius: 8px; 
    background: #05050a; 
  }
  #ui { position: absolute; top: 0; left: 0; width: 100%; height: 100%; pointer-events: none; display: flex; flex-direction: column; align-items: center; justify-content: center; z-index: 10; }
  #hud { position: absolute; top: 20px; left: 20px; right: 20px; display: flex; justify-content: space-between; pointer-events: none; z-index: 10; }
  .hud-box { background: rgba(0,20,30,0.8); border: 1px solid #00ffcc; padding: 8px 16px; border-radius: 4px; box-shadow: 0 0 10px #00ffcc; font-size: 1.2rem; }
  .screen, .overlay { 
    position: absolute; 
    top: 50%; left: 50%; 
    transform: translate(-50%, -50%); 
    background: rgba(0,10,20,0.95); 
    border: 2px solid #00ffcc; 
    border-radius: 12px; 
    padding: 40px; 
    text-align: center; 
    box-shadow: 0 0 40px #00ffcc, inset 0 0 20px rgba(0,255,204,0.1); 
    z-index: 20; 
    pointer-events: auto; 
    min-width: 300px; 
  }
  .hidden { display: none !important; }
  h1 { font-size: 2.5rem; text-shadow: 0 0 10px #00ffcc, 0 0 20px #00ffcc; margin-bottom: 10px; letter-spacing: 4px; }
  h2 { font-size: 2rem; text-shadow: 0 0 10px #ff0066; margin-bottom: 20px; color: #ff0066; }
  p { margin: 10px 0; font-size: 1.1rem; opacity: 0.9; }
  button { 
    background: linear-gradient(135deg, #003322, #005533); 
    border: 2px solid #00ffcc; 
    color: #00ffcc; 
    padding: 12px 28px; 
    font-size: 1.1rem; 
    font-family: inherit; 
    border-radius: 4px; 
    cursor: pointer; 
    margin: 10px; 
    transition: all 0.2s; 
    box-shadow: 0 0 10px rgba(0,255,204,0.3); 
    text-transform: uppercase; 
    letter-spacing: 2px; 
  }
  button:hover, button:focus { background: linear-gradient(135deg, #005533, #007744); box-shadow: 0 0 20px #00ffcc; transform: scale(1.05); }
  button:active { transform: scale(0.98); }
  #pauseOverlay h2 { color: #ffcc00; text-shadow: 0 0 10px #ffcc00; }
  #gameOverOverlay h2 { color: #ff3344; text-shadow: 0 0 10px #ff3344; }
  @media (max-width: 600px) {
    .screen, .overlay { padding: 20px; min-width: 90vw; }
    h1 { font-size: 1.8rem; }
    button { padding: 10px 20px; font-size: 1rem; }
    #hud { top: 10px; left: 10px; right: 10px; }
    .hud-box { padding: 6px 12px; font-size: 1rem; }
  }
</style>
</head>
<body>
<canvas id="gameCanvas"></canvas>
<div id="ui">
  <div id="hud">
    <div class="hud-box">SCORE: <span id="score">0</span></div>
    <div class="hud-box">BEST: <span id="best">0</span></div>
  </div>
  <div id="startScreen" class="screen">
    <h1>NEON MERGE</h1>
    <p>Merge neon tiles to reach 2048</p>
    <p>Arrow keys or swipe to move</p>
    <button id="startBtn" type="button">START GAME</button>
  </div>
  <div id="pauseOverlay" class="overlay hidden">
    <h2>PAUSED</h2>
    <button id="resumeBtn" type="button">RESUME</button>
    <button id="quitBtn" type="button">QUIT TO MENU</button>
  </div>
  <div id="gameOverOverlay" class="overlay hidden">
    <h2>GAME OVER</h2>
    <p>Final Score: <span id="finalScore">0</span></p>
    <button id="retryBtn" type="button">RETRY</button>
    <button id="menuBtn" type="button">MAIN MENU</button>
  </div>
</div>
<script>
const canvas = document.getElementById('gameCanvas');
const ctx = canvas.getContext('2d');
const scoreEl = document.getElementById('score');
const bestEl = document.getElementById('best');
const finalScoreEl = document.getElementById('finalScore');
const startScreen = document.getElementById('startScreen');
const pauseOverlay = document.getElementById('pauseOverlay');
const gameOverOverlay = document.getElementById('gameOverOverlay');
const startBtn = document.getElementById('startBtn');
const resumeBtn = document.getElementById('resumeBtn');
const quitBtn = document.getElementById('quitBtn');
const retryBtn = document.getElementById('retryBtn');
const menuBtn = document.getElementById('menuBtn');

const GRID_SIZE = 4;
const TILE_SIZE = 80;
const GAP = 10;
const BOARD_SIZE = GRID_SIZE * TILE_SIZE + (GRID_SIZE + 1) * GAP;

let grid = Array(GRID_SIZE).fill().map(() => Array(GRID_SIZE).fill(0));
let score = 0;
let best = parseInt(localStorage.getItem('neonMergeBest')) || 0;
let gameOver = false;
let