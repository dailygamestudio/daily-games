<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no">
<title>Neon Rhythm</title>
<style>
* { margin: 0; padding: 0; box-sizing: border-box; }
body {
    background: #0a0a12;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    font-family: 'Orbitron', 'Courier New', monospace;
    color: #00ffea;
    overflow: hidden;
    touch-action: none;
}
@import url('https://fonts.googleapis.com/css2?family=Orbitron:wght@400;700;900&display=swap');

#gameContainer {
    position: relative;
    border: 3px solid #00ffea;
    border-radius: 8px;
    box-shadow: 
        0 0 30px #00ffea,
        0 0 60px #cc00ff,
        inset 0 0 30px rgba(0, 255, 234, 0.1);
    background: #050510;
}
#gameCanvas { display: block; }

#ui {
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    pointer-events: none;
    display: flex;
    flex-direction: column;
    padding: 16px;
}
#topBar {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
}
.statBox {
    background: rgba(0, 20, 30, 0.85);
    border: 1px solid #00ffea44;
    border-radius: 6px;
    padding: 8px 16px;
    backdrop-filter: blur(4px);
}
.statLabel { font-size: 10px; color: #00ffea88; text-transform: uppercase; letter-spacing: 1px; }
.statValue { font-size: 22px; font-weight: 700; color: #00ffea; text-shadow: 0 0 10px #00ffea; font-variant-numeric: tabular-nums; }
#highScore .statValue { color: #ffcc00; text-shadow: 0 0 10px #ffcc00; }
#combo .statValue { color: #ff6600; text-shadow: 0 0 10px #ff6600; }
#accuracy .statValue { color: #00ffcc; text-shadow: 0 0 10px #00ffcc; }

#bottomBar { margin-top: auto; display: flex; justify-content: center; gap: 12px; }
.controlHint {
    background: rgba(0, 20, 30, 0.85);
    border: 1px solid #00ffea44;
    border-radius: 20px;
    padding: 6px 14px;
    font-size: 11px;
    color: #00ffeaaa;
    display: flex;
    align-items: center;
    gap: 6px;
}
.controlHint kbd {
    background: #001122;
    border: 1px solid #00ffea66;
    border-radius: 4px;
    padding: 2px 8px;
    font-family: inherit;
    font-size: 10px;
    color: #00ffea;
}

.overlay {
    position: absolute;
    inset: 0;
    background: rgba(5, 5, 16, 0.98);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 24px;
    z-index: 10;
    backdrop-filter: blur(8px);
}
.overlay.hidden { display: none; }
.title {
    font-size: clamp(32px, 8vw, 56px);
    font-weight: 900;
    background: linear-gradient(135deg, #00ffea, #cc00ff, #ffcc00);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    text-shadow: none;
    letter-spacing: 4px;
    animation: pulse 2s ease-in-out infinite;
}
@keyframes pulse { 0%,100% { filter: brightness(1); } 50% { filter: brightness(1.3); } }
.subtitle { font-size: 14px; color: #00ffea88; letter-spacing: 3px; text-transform: uppercase; }
.btn {
    background: linear-gradient(135deg, #003344, #001122);
    border: 2px solid #00ffea;
    color: #00ffea;
    padding: 14px 48px;
    font-size: 16px;
    font-weight: 700;
    font-family: inherit;
    border-radius: 4px;
    cursor: pointer;
    text-transform: uppercase;
    letter-spacing: 2px;
    transition: all 0.2s;
    box-shadow: 0 0 20px #00ffea44;
}
.btn:hover, .btn:focus { background: linear-gradient(135deg, #00ffea, #cc00ff); color: #000; box-shadow: 0 0 30px #00ffea, 0 0 60px #cc00ff; outline: none; }
.btn:active { transform: scale(0.96); }

#finalScore { font-size: 28px; font-weight: 700; color: #00ffea; text-shadow: 0 0 15px #00ffea; }
#bestScore { font-size: 16px; color: #ffcc00; text-shadow: 0 0 10px #ffcc00; }
#finalCombo { font-size: 20px; color: #ff6600; text-shadow: 0 0 10px #ff6600; }
#finalAcc { font-size: 16px; color: #00ffcc; text-shadow: 0 0 10px #00ffcc; }

@media (max-width: 600px) {
    #gameContainer { border-width: 2px; border-radius: 0; width: 100vw; height: 100vh; max-width: 100%; max-height: 100%; }
    body { align-items: stretch; justify-content: stretch; }
    #ui { padding: 12px; }
    .statValue { font-size: 18px; }
    .controlHint { padding: 5px 10px; font-size: 10px; }
}
</style>
</head>
<body>
<div id="gameContainer">
    <canvas id="gameCanvas"></canvas>
    <div id="ui">
        <div id="topBar">
            <div class="statBox" id="score">
                <div class="statLabel">Score</div>
                <div class="statValue" id="scoreVal">0</div>
            </div>
            <div class="statBox" id="highScore">
                <div class="statLabel">Best</div>
                <div class="statValue" id="highScoreVal">0</div>
            </div>
            <div class="statBox" id="combo">
                <div class="statLabel">Combo</div>
                <div class="statValue" id="comboVal">0</div>
            </div>
            <div class="statBox" id="accuracy">
                <div class="statLabel">Acc</div>
                <div class="statValue" id="accVal">100%</div>
            </div>
        </div>
        <div id="bottomBar">
            <div class="controlHint"><kbd>D</kbd> <kbd>F</kbd> <kbd>J</kbd> <kbd>K</kbd> / Tap Lanes</div>
        </div>
    </div>

    <div id="startScreen" class="overlay">
        <div class="title">NEON RHYTHM</div>
        <div class="subtitle">4-Lane Neon Music Game</div>
        <button class="btn" id="startBtn">Start Game</button>
    </div>

    <div id="pauseOverlay" class="overlay hidden">
        <div class="title">PAUSED</div>
        <div class="subtitle">Wave <span id="pauseWave">1</span> • Score <span id="pauseScore">0</span></div>
        <button class="btn" id="resumeBtn">RESUME</button>
        <button class="btn" id="quitBtn">QUIT TO MENU</button>
    </div>

    <div id="gameOverOverlay" class="overlay hidden">
        <div class="title" style="color: #ff3366;">GAME OVER</div>
        <div id="finalScore">Score: 0</div>
        <div id="finalCombo">Max Combo: 0</div>
        <div id="finalAcc">Accuracy: 100%</div>
        <div id="bestScore">Best: 0</div>
        <button class="btn" id="retryBtn">RETRY</button>
        <button class="btn" id="menuBtn">MAIN MENU</button>
    </div>
</div>

<script>
// ============================================
// NEON RHYTHM - 4-Lane Neon Music Game
// ============================================

// Explicitly declare gameCanvas to avoid "already declared" errors
var gameCanvas = document.getElementById('gameCanvas');

// --- Config ---
const CONFIG = {
    baseWidth: 600,
    baseHeight: 800,
    lanes: 4,
    laneWidth: 80,
    judgmentLineY: 680,
    noteHeight: 20,
    noteWidth: 70,
    approachRate: 0.6,
    timingWindows: { perfect: 30, great: 60, good: 100, miss: 150 },
    scores: { perfect: 1000, great: 700, good: 400 },
    comboMultiplier: 1.5,
    spawnInterval: 1200,
    minSpawnInterval: 400,
    difficultyIncrease: 0.98,
    songLength: 120000,
    bpm: 140
};

const LANE_COLORS = [
    { main: '#00ffea', glow: '#00ffff', key: 'D' },
    { main: '#ff006e', glow: '#ff3388', key: 'F' },
    { main: '#ffbe0b', glow: '#ffcc00', key: 'J' },
    { main: '#cc00ff', glow: '#cc66ff', key: 'K' }
];

const KEY_MAP = { 'KeyD': 0, 'KeyF': 1, 'KeyJ': 2, 'KeyK': 3 };

// --- State ---
const state = {
    running: false,
    paused: false,
    score: 0,
    highScore: 0,
    combo: 0,
    maxCombo: 0,
    hits: { perfect: 0, great: 0, good: 0, miss: 0 },
    totalNotes: 0,
    notes: [],
    particles: [],
    screenShake: 0,
    gameTime: 0,
    nextSpawnTime: 1200,
    spawnInterval: 1200,
    pressedLanes: [false, false, false, false],
    lastSpawnTime: 0
};

// --- DOM Elements ---
let ctx;
let scoreVal, highScoreVal, comboVal, accVal;
let startBtn, retryBtn, menuBtn, resumeBtn, quitBtn;
let startScreen, pauseOverlay, gameOverOverlay;
let finalScoreEl, finalComboEl, finalAccEl, bestScoreEl, pauseWaveEl, pauseScoreEl;

// --- Particle System ---
class Particle {
    constructor(x, y, color, size, life, velocity, gravity = 0) {
        this.x