<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no">
<title>Neon Platformer</title>
<style>
* { margin: 0; padding: 0; box-sizing: border-box; }
body {
    background: #0a0a12;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    font-family: 'Orbitron', 'Courier New', monospace;
    color: #00ffea;
    overflow: hidden;
    touch-action: none;
}
@import url('https://fonts.googleapis.com/css2?family=Orbitron:wght@400;700;900&display=swap');

#gameContainer {
    position: relative;
    border: 3px solid #00ffea;
    border-radius: 8px;
    box-shadow: 
        0 0 30px #00ffea,
        0 0 60px #cc00ff,
        inset 0 0 30px rgba(0, 255, 234, 0.1);
    background: #050510;
    width: 800px;
    height: 600px;
    box-sizing: border-box;
}
canvas { display: block; width: 100%; height: 100%; }

#ui {
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    pointer-events: none;
    display: flex;
    flex-direction: column;
    padding: 16px;
}
#topBar {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
}
.statBox {
    background: rgba(0, 20, 30, 0.85);
    border: 1px solid #00ffea44;
    border-radius: 6px;
    padding: 8px 16px;
    backdrop-filter: blur(4px);
}
.statLabel { font-size: 10px; color: #00ffea88; text-transform: uppercase; letter-spacing: 1px; }
.statValue { font-size: 22px; font-weight: 700; color: #00ffea; text-shadow: 0 0 10px #00ffea; font-variant-numeric: tabular-nums; }
#highScore .statValue { color: #ffcc00; text-shadow: 0 0 10px #ffcc00; }
#level .statValue { color: #cc00ff; text-shadow: 0 0 10px #cc00ff; }
#lives .statValue { color: #ff3366; text-shadow: 0 0 10px #ff3366; }

#bottomBar { margin-top: auto; display: flex; justify-content: center; gap: 12px; }
.controlHint {
    background: rgba(0, 20, 30, 0.85);
    border: 1px solid #00ffea44;
    border-radius: 20px;
    padding: 6px 14px;
    font-size: 11px;
    color: #00ffea88;
    display: flex;
    align-items: center;
    gap: 6px;
}
.controlHint kbd {
    background: #001122;
    border: 1px solid #00ffea66;
    border-radius: 4px;
    padding: 2px 8px;
    font-family: inherit;
    font-size: 10px;
    color: #00ffea;
}

#startScreen, #gameOverScreen {
    position: absolute;
    inset: 0;
    background: rgba(5, 5, 16, 0.98);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 24px;
    z-index: 10;
    backdrop-filter: blur(8px);
}
#startScreen.hidden, #gameOverScreen.hidden { display: none; }
.title {
    font-size: clamp(32px, 8vw, 56px);
    font-weight: 900;
    background: linear-gradient(135deg, #00ffea, #cc00ff, #ffcc00);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    text-shadow: none;
    letter-spacing: 4px;
    animation: pulse 2s ease-in-out infinite;
}
@keyframes pulse { 0%,100% { filter: brightness(1); } 50% { filter: brightness(1.3); } }
.subtitle { font-size: 14px; color: #00ffea88; letter-spacing: 3px; text-transform: uppercase; }
.btn {
    background: linear-gradient(135deg, #003344, #001122);
    border: 2px solid #00ffea;
    color: #00ffea;
    padding: 14px 48px;
    font-size: 16px;
    font-weight: 700;
    font-family: inherit;
    border-radius: 4px;
    cursor: pointer;
    text-transform: uppercase;
    letter-spacing: 2px;
    transition: all 0.2s;
    box-shadow: 0 0 20px #00ffea44;
}
.btn:hover, .btn:focus { background: linear-gradient(135deg, #00ffea, #cc00ff); color: #000; box-shadow: 0 0 30px #00ffea, 0 0 60px #cc00ff; outline: none; }
.btn:active { transform: scale(0.96); }

#finalScore { font-size: 28px; font-weight: 700; color: #00ffea; text-shadow: 0 0 15px #00ffea; }
#bestScore { font-size: 16px; color: #ffcc00; text-shadow: 0 0 10px #ffcc00; }

.overlay {
    position: absolute;
    inset: 0;
    background: rgba(5, 5, 16, 0.98);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 16px;
    z-index: 20;
    backdrop-filter: blur(8px);
}
.overlay.hidden { display: none; }
.overlay h1 { font-size: 32px; font-weight: 900; background: linear-gradient(135deg, #00ffea, #cc00ff); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text; }
.overlay p { font-size: 18px; color: #00ffea88; }

@media (max-width: 600px) {
    #gameContainer { border-width: 2px; border-radius: 0; width: 100vw; height: 100vh; max-width: 100%; max-height: 100%; }
    body { align-items: stretch; justify-content: stretch; }
    #ui { padding: 12px; }
    .statValue { font-size: 18px; }
    .controlHint { padding: 5px 10px; font-size: 10px; }
}
</style>
</head>
<body>
<div id="gameContainer">
    <canvas id="canvas"></canvas>
    <div id="ui">
        <div id="topBar">
            <div class="statBox" id="score">
                <div class="statLabel">Score</div>
                <div class="statValue" id="scoreVal">0</div>
            </div>
            <div class="statBox" id="highScore">
                <div class="statLabel">Best</div>
                <div class="statValue" id="highScoreVal">0</div>
            </div>
            <div class="statBox" id="level">
                <div class="statLabel">Level</div>
                <div class="statValue" id="levelVal">1</div>
            </div>
            <div class="statBox" id="lives">
                <div class="statLabel">Lives</div>
                <div class="statValue" id="livesVal">3</div>
            </div>
        </div>
        <div id="bottomBar">
            <div class="controlHint"><kbd>←</kbd> <kbd>→</kbd> Move</div>
            <div class="controlHint"><kbd>Space</kbd> / <kbd>↑</kbd> Jump</div>
            <div class="controlHint"><kbd>↓</kbd> / <kbd>S</kbd> Drop</div>
        </div>
    </div>

    <div id="startScreen">
        <div class="title">NEON PLATFORMER</div>
        <div class="subtitle">Neon Cyberpunk Platformer</div>
        <button class="btn" id="startBtn">Start Game</button>
    </div>

    <div id="gameOverScreen" class="hidden">
        <div class="title">GAME OVER</div>
        <div id="finalScore">Score: 0</div>
        <div id="bestScore">Best: 0</div>
        <button class="btn" id="restartBtn">Play Again</button>
    </div>

    <div class="overlay hidden" id="pauseOverlay">
        <h1>PAUSED</h1>
        <p>Wave <span id="pauseWave">1</span> • Score <span id="pauseScore">0</span></p>
        <button class="btn" id="resumeBtn">RESUME</button>
        <button class="btn" id="quitBtn">QUIT TO MENU</button>
    </div>

    <div class="overlay hidden" id="gameOverOverlay">
        <h1 style="color: #ff3366;">GAME OVER</h1>
        <p>Final Score: <span id="finalScoreOverlay" style="color: #00ffea;">0</span></p>
        <p id="highScoreMsg" style="color: #ffd700;"></p>
        <button class="btn" id="retryBtn">RETRY</button>
        <button class="btn" id="menuBtn">MAIN MENU</button>
    </div>
</div>

<script>
// ============================================
// NEON PLATFORMER - Cyberpunk Precision Platformer
// ============================================

const canvas = document.getElementById('canvas');
const ctx = canvas.getContext('2d');

// --- Config ---
const CONFIG = {
    baseWidth: 800,
    baseHeight: 600,
    gravity: 0.5,
    playerSpeed: 6,
    jumpForce: -14,
    maxFallSpeed: 18,
    coyoteTime: 0.1,
    jumpBuffer: 0.1,
    levelTime: 60
};

// --- State ---
let state = {
    running: false,
    paused: false,
    score: 0,
    highScore: 0,
    level: 1,
    lives: 3,
    player: null,
    platforms: [],
    spikes: [],
    coins: [],
    particles: null,
    enemies: [],
    cameraX: 0,
    cameraY: 0,
    levelWidth: 0,
    levelHeight: 0,
    goalX: 0,
    goalY: 0,
    goal: null,
    levelComplete: false,
    screenShake: 0,
    lastTime: 0
};

// --- Utility ---
const rand = (min, max) => Math.random() * (max - min) + min;
const randInt = (min, max) => Math.floor(Math.random() * (max - min + 1)) + min;
const clampValue = (v, min, max) => Math.max(min, Math.min(max, v));

// --- Vec2 ---
class Vec2 {
    constructor(x = 0, y = 0) { this.x = x; this.y = y; }
    set(x, y) { this.x = x; this.y = y; return this; }
    copy(v) { this.x = v.x; this.y = v.y; return this; }
    add(v) { this.x += v.x; this.y += v.y; return this; }
    sub(v) { this.x -= v.x; this.y -= v.y; return this; }
    mul(s) { this.x *= s; this.y *= s; return this; }
    div(s) { this.x /= s; this.y /= s; return this; }
    len() { return Math.hypot(this.x, this.y); }
    normalize() { const l = this.len(); if (l > 0) this.div(l); return this; }
    limit(max) { const l = this.len(); if (l > max) this.mul(max / l); return this; }
    clone() { return new Vec2(this.x, this.y); }
}

// Particle System
class Particle {
    constructor(x, y, color, size, life, velocity, gravity = 0) {
        this.x = x; this.y = y;
        this.vx = velocity.x; this.vy = velocity.y;
        this.color = color;
        this.size = size;
        this.maxSize = size;
        this.life = life;
        this.maxLife = life;
        this.gravity = gravity;
    }
    update(dt) {
        this.x += this.vx * dt * 60;
        this.y += this.vy * dt * 60;
        this.vy += this.gravity * dt * 60;
        this.life -= dt;
    }
    draw(ctx) {
        if (this.life <= 0) return;
        const alpha = this.life / this.maxLife;
        ctx.save();
        ctx.globalAlpha = alpha;
        ctx.fillStyle = this.color;
        ctx.shadowColor = this.color;
        ctx.shadowBlur = 10;
        ctx.beginPath();
        ctx.arc(this.x, this.y, this.size * (this.life / this.maxLife), 0, Math.PI * 2);
        ctx.fill();
        ctx.restore();
    }
}

class ParticleSystem {
    constructor() { this.particles = []; }
    emit(x, y, color, count, options = {}) {
        for (let i = 0; i < count; i++) {
            const angle = Math.random() * Math.PI * 2;
            const speed = Math.random() * (options.maxSpeed || 150) + (options.minSpeed || 50);
            this.particles.push({
                x, y,
                vx: Math.cos(angle) * speed,
                vy: Math.sin(angle) * speed,
                color,
                size: Math.random() * (options.maxSize || 4) + (options.minSize || 2),
                life: Math.random() * (options.maxLife || 0.4) + (options.minLife || 0.1),
                maxLife: Math.random() * (options.maxLife || 0.4) + (options.minLife || 0.1),
                gravity: options.gravity || 0
            });
        }
    }
    update(dt) {
        for (let i = this.particles.length - 1; i >= 0; i--) {
            const p = this.particles[i];
            p.x += p.vx * dt * 60;
            p.y += p.vy * dt * 60;
            p.vy += p.gravity * dt * 60;
            p.life -= dt;
            if (p.life <= 0) this.particles.splice(i, 1);
        }
    }
    draw(ctx) { this.particles.forEach(p => p.draw(ctx)); }
}

// Player
class Player {
    constructor(x, y) {
        this.x = x;
        this.y = y;
        this.vel = { x: 0, y: 0 };
        this.width = 28;
        this.height = 44;
        this.color = '#00ffea';
        this.glowColor = '#00ffff';
        this.grounded = false;
        this.coyoteTimer = 0;
        this.jumpBufferTimer = 0;
        this.facing = 1;
        this.invulnTimer = 0;
        this.dashTimer = 0;
        this.dashing = false;
    }
    
    getHitbox() {
        return { x: this.x + 2, y: this.y + 4, w: 24, h: 40 };
    }
    
    update(dt, input, platforms) {
        // Horizontal movement
        const accel = 40;
        const maxSpeed = 8;
        const friction = 0.8;
        
        if (input.left) {
            this.vel.x -= accel * dt;
            this.facing = -1;
        }
        if (input.right) {
            this.vel.x += accel * dt;
            this.facing = 1;
        }
        
        if (!input.left && !input.right) {
            this.vel.x *= Math.pow(friction, dt * 60);
        }
        
        this.vel.x = clampValue(this.vel.x, -maxSpeed, maxSpeed);
        
        // Jump buffer
        if (input.jumpPressed) this.jumpBufferTimer = CONFIG.jumpBuffer;
        else this.jumpBufferTimer -= dt;
        
        // Coyote time
        if (this.grounded) this.coyoteTimer = CONFIG.coyoteTime;
        else this.coyoteTimer -= dt;
        
        // Jump
        if (this.jumpBufferTimer > 0 && this.coyoteTimer > 0) {
            this.vel.y = CONFIG.jumpForce;
            this.jumpBufferTimer = 0;
            this.coyoteTimer = 0;
            this.grounded = false;
            // Jump particles
            state.particles.emit(this.x + this.width/2, this.y + this.height, '#00ffea', 8, { minSpeed: 50, maxSpeed: 120, minSize: 2, maxSize: 5, minLife: 0.1, maxLife: 0.3, gravity: 200 });
        }
        
        // Drop through platform
        if (input.down && this.grounded) {
            this.grounded = false;
            this.coyoteTimer = 0;
        }
        
        // Gravity
        this.vel.y += CONFIG.gravity * dt * 60;
        this.vel.y = Math.min(this.vel.y, CONFIG.maxFallSpeed);
        
        // Move X
        this.x += this.vel.x * dt * 60;
        this.checkCollisionsX(platforms);
        
        // Move Y
        this.y += this.vel.y * dt * 60;
        this.grounded = false;
        this.checkCollisionsY(platforms);
        
        // Invulnerability
        if (this.invulnTimer > 0) this.invulnTimer -= dt;
        
        // Clamp to level bounds
        this.x = clampValue(this.x, 0, state.levelWidth - this.width);
        if (this.y > state.levelHeight + 200) {
            this.die();
        }
    }
    
    checkCollisionsX(platforms) {
        const hitbox = this.getHitbox();
        for (const p of platforms) {
            if (hitbox.x < p.x + p.w && hitbox.x + hitbox.w > p.x &&
                hitbox.y < p.y + p.h && hitbox.y + hitbox.h > p.y) {
                if (this.vel.x > 0) {
                    this.x = p.x - hitbox.w - 2;
                } else if (this.vel.x < 0) {
                    this.x = p.x + p.w + 2;
                }
                this.vel.x = 0;
                hitbox.x = this.x + 2;
            }
        }
    }
    
    checkCollisionsY(platforms) {
        const hitbox = this.getHitbox();
        for (const p of platforms) {
            if (hitbox.x < p.x + p.w && hitbox.x + hitbox.w > p.x &&
                hitbox.y < p.y + p.h && hitbox.y + hitbox.h > p.y) {
                if (this.vel.y > 0) {
                    this.y = p.y - hitbox.h - 4;
                    this.vel.y = 0;
                    this.grounded = true;
                } else if (this.vel.y < 0) {
                    this.y = p.y + p.h + 4;
                    this.vel.y = 0;
                }
                hitbox.y = this.y + 4;
            }
        }
    }
    
    die() {
        if (this.invulnTimer > 0) return;
        state.lives--;
        this.invulnTimer = 2;
        state.screenShake = 0.5;
        state.particles.emit(this.x + this.width/2, this.y + this.height/2, '#ff3366', 20, { minSpeed: 100, maxSpeed: 200, minSize: 3, maxSize: 8, minLife: 0.3, maxLife: 0.6, gravity: 100 });
        
        if (state.lives <= 0) {
            gameOver();
        } else {
            this.respawn();
        }
    }
    
    respawn() {
        this.x = 50;
        this.y = 100;
        this.vel.x = 0;
        this.vel.y = 0;
    }
    
    draw(ctx) {
        if (this.invulnTimer > 0 && Math.floor(this.invulnTimer * 10) % 2 === 0) return;
        
        ctx.save();
        // Glow
        ctx.shadowColor = this.glowColor;
        ctx.shadowBlur = 20;
        ctx.fillStyle = this.color;
        ctx.fillRect(this.x, this.y, this.width, this.height);
        
        // Face
        ctx.fillStyle = '#050510';
        const eyeY = this.y + 14;
        const eyeSize = 4;
        if (this.facing === 1) {
            ctx.fillRect(this.x + 18, eyeY, eyeSize, eyeSize);
            ctx.fillRect(this.x + 22, eyeY, eyeSize, eyeSize);
        } else {
            ctx.fillRect(this.x + 6, eyeY, eyeSize, eyeSize);
            ctx.fillRect(this.x + 10, eyeY, eyeSize, eyeSize);
        }
        ctx.restore();
    }
}

// Platform
class Platform {
    constructor(x, y, w, h, type = 'normal') {
        this.x = x; this.y = y; this.w = w; this.h = h; this.type = type;
        this.color = type === 'normal' ? '#003344' : '#330044';
        this.glowColor = type === 'normal' ? '#00ffea' : '#cc00ff';
    }
    draw(ctx) {
        ctx.save();
        ctx.fillStyle = this.color;
        ctx.shadowColor = this.glowColor;
        ctx.shadowBlur = 10;
        ctx.fillRect(this.x, this.y, this.w, this.h);
        // Top glow line
        ctx.shadowBlur = 0;
        ctx.fillStyle = this.glowColor;
        ctx.fillRect(this.x, this.y, this.w, 2);
        ctx.restore();
    }
}

// Spike
class Spike {
    constructor(x, y, dir = 'up') {
        this.x = x; this.y = y; this.dir = dir;
        this.size = 24;
    }
    draw(ctx) {
        ctx.save();
        ctx.fillStyle = '#ff3366';
        ctx.shadowColor = '#ff3366';
        ctx.shadowBlur = 15;
        ctx.beginPath();
        if (this.dir === 'up') {
            ctx.moveTo(this.x, this.y + this.size);
            ctx.lineTo(this.x + this.size/2, this.y);
            ctx.lineTo(this.x + this.size, this.y + this.size);
        } else {
            ctx.moveTo(this.x, this.y);
            ctx.lineTo(this.x + this.size/2, this.y + this.size);
            ctx.lineTo(this.x + this.size, this.y);
        }
        ctx.closePath();
        ctx.fill();
        ctx.restore();
    }
    getHitbox() {
        return { x: this.x, y: this.y, w: this.size, h: this.size };
    }
}

// Coin
class Coin {
    constructor(x, y) {
        this.x = x; this.y = y;
        this.radius = 10;
        this.collected = false;
        this.bobOffset = Math.random() * Math.PI * 2;
        this.bobSpeed = 2 + Math.random() * 2;
    }
    update(dt) {
        this.bobOffset += dt * this.bobSpeed;
        this.y += Math.sin(this.bobOffset) * 0.5;
    }
    draw(ctx) {
        if (this.collected) return;
        ctx.save();
        ctx.translate(this.x, this.y);
        ctx.fillStyle = '#ffcc00';
        ctx.shadowColor = '#ffcc00';
        ctx.shadowBlur = 15;
        ctx.beginPath();
        ctx.arc(0, 0, this.radius, 0, Math.PI * 2);
        ctx.fill();
        // Inner glow
        ctx.shadowBlur = 0;
        ctx.fillStyle = '#fff8cc';
        ctx.beginPath();
        ctx.arc(0, 0, this.radius * 0.5, 0, Math.PI * 2);
        ctx.fill();
        ctx.restore();
    }
    getHitbox() {
        return { x: this.x - this.radius, y: this.y - this.radius, w: this.radius * 2, h: this.radius * 2 };
    }
}

// Enemy
class Enemy {
    constructor(x, y, patrolDist = 100) {
        this.x = x; this.y = y;
        this.startX = x;
        this.patrolDist = patrolDist;
        this.dir = 1;
        this.width = 32;
        this.height = 32;
        this.speed = 2;
    }
    update(dt, platforms) {
        this.x += this.dir * this.speed * dt * 60;
        if (this.x > this.startX + this.patrolDist || this.x < this.startX - this.patrolDist) {
            this.dir *= -1;
        }
        // Simple platform edge detection
        const hitbox = this.getHitbox();
        let onPlatform = false;
        for (const p of platforms) {
            if (hitbox.x < p.x + p.w && hitbox.x + hitbox.w > p.x &&
                hitbox.y + hitbox.h >= p.y - 2 && hitbox.y + hitbox.h <= p.y + 2) {
                onPlatform = true;
                if ((this.dir === 1 && hitbox.x + hitbox.w >= p.x + p.w) ||
                    (this.dir === -1 && hitbox.x <= p.x)) {
                    this.dir *= -1;
                }
                break;
            }
        }
        if (!onPlatform) this.dir *= -1;
    }
    getHitbox() {
        return { x: this.x + 4, y: this.y + 4, w: 24, h: 24 };
    }
    draw(ctx) {
        ctx.save();
        ctx.fillStyle = '#cc00ff';
        ctx.shadowColor = '#cc00ff';
        ctx.shadowBlur = 15;
        ctx.fillRect(this.x, this.y, this.width, this.height);
        // Eyes
        ctx.fillStyle = '#050510';
        ctx.fillRect(this.x + 8, this.y + 10, 4, 4);
        ctx.fillRect(this.x + 20, this.y + 10, 4, 4);
        ctx.restore();
    }
}

// Goal
class Goal {
    constructor(x, y) {
        this.x = x; this.y = y;
        this.width = 40; this.height = 60;
        this.pulse = 0;
    }
    update(dt) { this.pulse += dt * 3; }
    draw(ctx) {
        ctx.save();
        ctx.translate(this.x + this.width/2, this.y + this.height/2);
        const scale = 1 + Math.sin(this.pulse) * 0.1;
        ctx.scale(scale, scale);
        ctx.fillStyle = '#00ffea';
        ctx.shadowColor = '#00ffea';
        ctx.shadowBlur = 20;
        ctx.beginPath();
        ctx.moveTo(0, -this.height/2);
        ctx.lineTo(this.width/2, 0);
        ctx.lineTo(0, this.height/2);
        ctx.lineTo(-this.width/2, 0);
        ctx.closePath();
        ctx.fill();
        ctx.restore();
    }
    getHitbox() {
        return { x: this.x, y: this.y, w: this.width, h: this.height };
    }
}

// Input
const input = {
    left: false, right: false, up: false, down: false,
    jumpPressed: false, jumpHeld: false
};

// Touch controls
const touchZones = {
    left: { x: 0, y: 0, w: 0, h: 0 },
    right: { x: 0, y: 0, w: 0, h: 0 },
    jump: { x: 0, y: 0, w: 0, h: 0 },
