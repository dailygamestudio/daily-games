<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no">
<title>Neon Lights Out - Day 38</title>
<style>
  * { margin: 0; padding: 0; box-sizing: border-box; }
  body { background: #0a0a12; color: #e0e0ff; font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; overflow: hidden; }
  canvas { display: block; margin: 0 auto; background: #05050a; box-shadow: 0 0 30px #00ffff, 0 0 60px #ff00ff, inset 0 0 60px rgba(0,255,255,0.1); touch-action: none; }
  #ui { position: fixed; top: 10px; left: 50%; transform: translateX(-50%); display: flex; gap: 20px; z-index: 10; pointer-events: none; }
  .stat { background: rgba(0,20,40,0.8); border: 1px solid #00ffff; padding: 5px 15px; border-radius: 4px; font-size: 14px; text-shadow: 0 0 5px #00ffff; }
  .stat span { color: #ffcc00; font-weight: bold; }
  #overlay { position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.85); display: none; flex-direction: column; align-items: center; justify-content: center; gap: 20px; z-index: 100; pointer-events: none; }
  #overlay.overlay-visible { display: flex; pointer-events: auto; }
  #overlay h1 { font-size: 2.5rem; text-shadow: 0 0 10px #00ffff, 0 0 20px #ff00ff; margin-bottom: 10px; }
  #overlay p { font-size: 1.2rem; color: #aaa; }
  .btn { background: linear-gradient(135deg, #004466, #002244); border: 2px solid #00ffff; color: #e0e0ff; padding: 12px 40px; font-size: 1.1rem; border-radius: 6px; cursor: pointer; text-transform: uppercase; letter-spacing: 2px; transition: all 0.2s; box-shadow: 0 0 10px #00ffff; pointer-events: auto; display: none; }
  .btn:hover, .btn:focus { background: linear-gradient(135deg, #006699, #004466); box-shadow: 0 0 20px #00ffff, 0 0 30px #ff00ff; transform: scale(1.05); }
  .btn:active { transform: scale(0.98); }
  #controlsHint { position: fixed; bottom: 10px; left: 50%; transform: translateX(-50%); color: #666; font-size: 0.85rem; text-align: center; pointer-events: none; text-shadow: 0 0 3px #00ffff; }
  @media (max-width: 600px) {
    #ui { flex-direction: column; align-items: center; top: 5px; gap: 5px; }
    .stat { font-size: 12px; padding: 4px 10px; }
    #overlay h1 { font-size: 1.8rem; }
    .btn { padding: 10px 30px; font-size: 1rem; }
  }
</style>
</head>
<body>
<canvas id="gameCanvas"></canvas>
<div id="ui">
  <div class="stat">LEVEL: <span id="levelDisplay">1</span></div>
  <div class="stat">MOVES: <span id="movesDisplay">0</span></div>
  <div class="stat">SCORE: <span id="scoreDisplay">0</span></div>
  <div class="stat">BEST: <span id="highScoreDisplay">0</span></div>
</div>
<div id="overlay">
  <h1 id="overlayTitle">NEON LIGHTS OUT</h1>
  <p id="overlayMessage">Tap a cell to toggle it and its neighbors. Turn all lights off.</p>
  <button class="btn" id="btnResume" type="button">RESUME</button>
  <button class="btn" id="btnStart" type="button">START GAME</button>
  <button class="btn" id="btnNextLevel" type="button">NEXT LEVEL</button>
  <button class="btn" id="btnRetry" type="button">RETRY</button>
  <button class="btn" id="btnQuit" type="button">QUIT TO MENU</button>
  <button class="btn" id="btnMainMenu" type="button">MAIN MENU</button>
</div>
<div id="controlsHint">Arrows/WASD: Move Cursor | Space/Enter: Toggle | ESC/P: Pause | Touch: Tap Cell</div>
<script>
/* ===== NEON LIGHTS OUT - DAY 38 =====
   Puzzle game: toggle lights to turn all off.
   Increasing grid size, move limits, neon aesthetic.
   Pause/Resume/Quit, touch & keyboard, high score.
*/

// ===== CONSTANTS & CONFIG =====
const MIN_GRID = 3;
const MAX_GRID = 8;
const BASE_MOVE_MULTIPLIER = 2;
const COLORS = {
  bg: '#05050a',
  gridLine: '#003344',
  gridLineGlow: '#00ffff',
  lightOn: ['#00ffff', '#ff00ff', '#ffff00', '#ff4400', '#44ff00', '#ff00aa'],
  lightOff: '#111122',
  cursor: '#ffcc00',
  cursorGlow: '#ffff00',
  text: '#e0e0ff',
  uiBorder: '#00ffff'
};

// ===== GAME STATE =====
let canvas, ctx;
let width, height;
let cellSize, gridOriginX, gridOriginY;

let gameState = 'start';
let running = false;

let gridSize = MIN_GRID;
let grid = [];
let solutionSteps = 0;
let moves = 0;
let level = 1;
let score = 0;
let highScore = 0;
let maxMoves = 0;
let cursor = { x: 0, y: 0 };
let pendingNextLevel = false;

let animationId = null;
let lastTime = 0;

// ===== DOM ELEMENTS =====
const overlay = document.getElementById('overlay');
const overlayTitle = document.getElementById('overlayTitle');
const overlayMessage = document.getElementById('overlayMessage');
const btnResume = document.getElementById('btnResume');
const btnStart = document.getElementById('btnStart');
const btnNextLevel = document.getElementById('btnNextLevel');
const btnRetry = document.getElementById('btnRetry');
const btnQuit = document.getElementById('btnQuit');
const btnMainMenu = document.getElementById('btnMainMenu');
const levelDisplay = document.getElementById('levelDisplay');
const movesDisplay = document.getElementById('movesDisplay');
const scoreDisplay = document.getElementById('scoreDisplay');
const highScoreDisplay = document.getElementById('highScoreDisplay');

// ===== ROUNDRECT POLYFILL =====
function drawRoundRect(ctx, x, y, w, h, r) {
  if (w < 2 * r) r = w / 2;
  if (h < 2 * r) r = h / 2;
  ctx.beginPath();
  ctx.moveTo(x + r, y);
  ctx.arcTo(x + w, y, x + w, y + h, r);
  ctx.arcTo(x + w, y + h, x, y + h, r);
  ctx.arcTo(x, y + h, x, y, r);
  ctx.arcTo(x, y, x + w, y, r);
  ctx.closePath();
}

// ===== OVERLAY HELPERS =====
function showOverlay(title, message, ...buttonIds) {
  overlayTitle.textContent = title;
  overlayMessage.textContent = message;
  [btnResume, btnStart, btnNextLevel, btnRetry, btnQuit, btnMainMenu].forEach(btn => btn.style.display = 'none');
  buttonIds.forEach(id => {
    const btn = document.getElementById(id);
    if (btn) btn.style.display = 'block';
  });
  overlay.classList.add('overlay-visible');
  overlay.style.display = 'flex';
  overlay.style.pointerEvents = 'auto';
}

function hideOverlay() {
  overlay.classList.remove('overlay-visible');
  overlay.style.display = 'none';
  overlay.style.pointerEvents = 'none';
}

// ===== INITIALIZATION =====
function init() {
  canvas = document.getElementById('gameCanvas');
  ctx = canvas.getContext('2d');
  resize();
  window.addEventListener('resize', resize);
  
  highScore = parseInt(localStorage.getItem('neonLightsOutHighScore')) || 0;
  highScoreDisplay.textContent = highScore;
  
  btnStart.addEventListener('click', () => {
    hideOverlay();
    startGame();
  });
  btnResume.addEventListener('click', () => {
    hideOverlay();
    resumeGame();
  });
  btnNextLevel.addEventListener('click', () => {
    hideOverlay();
    nextLevel();
  });
  btnRetry.addEventListener('click', () => {
    hideOverlay();
    startGame();
  });
  btnQuit.addEventListener('click', () => {
    hideOverlay();
    quitToMenu();
  });
  btnMainMenu.addEventListener('click', () => {
    hideOverlay();
    showStartScreen();
  });
  
  window.addEventListener('keydown', handleKeydown);
  
  canvas.addEventListener('touchstart', handleTouchStart, { passive: false });
  canvas.addEventListener('touchmove', handleTouchMove, { passive: false });
  canvas.addEventListener('touchend', handleTouchEnd, { passive: false });
  
  showStartScreen();
}

// ===== RESIZE & LAYOUT =====
function resize() {
  width = window.innerWidth;
  height = window.innerHeight;
  canvas.width = width;
  canvas.height = height;
  
  const maxGridSize = Math.min(width, height) * 0.85;
  cellSize = Math.floor(maxGridSize / MAX_GRID);
  cellSize = Math.max(cellSize, 30);
  
  gridOriginX = (width - cellSize * gridSize) / 2;
  gridOriginY = (height - cellSize * gridSize) / 2;
}

// ===== GAME FLOW =====
function showStartScreen() {
  gameState = 'start';
  running = false;
  level = 1;
  score = 0;
  gridSize = MIN_GRID;
  updateUI();
  showOverlay('NEON LIGHTS OUT', 'Tap a cell to toggle it and its neighbors. Turn all lights off.', 'btnStart');
}

function startGame() {
  level = 1;
  score = 0;
  gridSize = MIN_GRID;
  generateLevel();
  gameState = 'playing';
  running = true;
  lastTime = performance.now();
  if (!animationId) requestAnimationFrame(gameLoop);
}

function generateLevel() {
  grid = [];
  for (let y = 0; y < gridSize; y++) {
    grid[y] = [];
    for (let x = 0; x < gridSize; x++) {
      grid[y][x] = 0;
    }
  }
  
  solutionSteps = 0;
  const numToggles = gridSize * gridSize;
  for (let i = 0; i < numToggles; i++) {
    const rx = Math.floor(Math.random() * gridSize);
    const ry = Math.floor(Math.random() * gridSize);
    toggleCell(rx, ry, false);
    solutionSteps++;
  }
  
  moves = 0;
  maxMoves = gridSize * BASE_MOVE_MULTIPLIER + Math.floor(level * 1.5);
  cursor = { x: 0, y: 0 };
  updateUI();
}

function toggleCell(x, y, countMove = true) {
  if (x < 0 || x >= gridSize || y < 0 || y >= gridSize) return;
  grid[y][x] = 1 - grid[y][x];
  if (countMove) moves++;
  updateUI();
}

function toggleCellAndNeighbors(x, y) {
  toggleCell(x, y);
  toggleCell(x - 1, y, false);
  toggleCell(x + 1, y, false);
  toggleCell(x, y - 1, false);
  toggleCell(x, y + 1, false);
}

function checkWin() {
  for (let y = 0; y < gridSize; y++) {
    for (let x = 0; x < gridSize; x++) {
      if (grid[y][x] === 1) return false;
    }
  }
  return true;
}

function nextLevel() {
  if (level >= MAX_GRID) {
    gameState = 'win';
    showOverlay('VICTORY!', `You completed all ${MAX_GRID} levels! Final Score: ${score}`, 'btnMainMenu');
    return;
  }
  level++;
  gridSize = Math.min(MIN_GRID + level - 1, MAX_GRID);
  generateLevel();
  gameState = 'playing';
  running = true;
}

function pauseGame() {
  if (gameState !== 'playing') return;
  gameState = 'paused';
  running = false;
  showOverlay('PAUSED', 'Game paused.', 'btnResume', 'btnQuit');
}

function resumeGame() {
  if (gameState !== 'paused') return;
  gameState = 'playing';
  running = true;
  lastTime = performance.now();
  requestAnimationFrame(gameLoop);
}

function quitToMenu() {
  gameState = 'start';
  running = false;
  showStartScreen();
