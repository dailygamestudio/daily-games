<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no">
<title>Neon Lights Out - Day 38</title>
<style>
  * { margin: 0; padding: 0; box-sizing: border-box; }
  body { background: #0a0a12; color: #e0e0ff; font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; overflow: hidden; touch-action: none; }
  canvas { display: block; margin: 0 auto; background: #05050a; box-shadow: 0 0 30px #00ffff, 0 0 60px #ff00ff, inset 0 0 60px rgba(0,255,255,0.1); }
  #ui { position: fixed; top: 10px; left: 50%; transform: translateX(-50%); display: flex; gap: 20px; z-index: 10; pointer-events: none; }
  .stat { background: rgba(0,20,40,0.8); border: 1px solid #00ffff; padding: 5px 15px; border-radius: 4px; font-size: 14px; text-shadow: 0 0 5px #00ffff; }
  .stat span { color: #ffcc00; font-weight: bold; }
  #overlay { position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.85); display: none; flex-direction: column; align-items: center; justify-content: center; gap: 20px; z-index: 100; pointer-events: none; }
  #overlay.visible { display: flex; pointer-events: auto; }
  #overlay h1 { font-size: 2.5rem; text-shadow: 0 0 10px #00ffff, 0 0 20px #ff00ff; margin-bottom: 10px; }
  #overlay p { font-size: 1.2rem; color: #aaa; }
  .btn { background: linear-gradient(135deg, #004466, #002244); border: 2px solid #00ffff; color: #e0e0ff; padding: 12px 40px; font-size: 1.1rem; border-radius: 6px; cursor: pointer; text-transform: uppercase; letter-spacing: 2px; transition: all 0.2s; box-shadow: 0 0 10px #00ffff; pointer-events: auto; }
  .btn:hover, .btn:focus { background: linear-gradient(135deg, #006699, #004466); box-shadow: 0 0 20px #00ffff, 0 0 30px #ff00ff; transform: scale(1.05); }
  .btn:active { transform: scale(0.98); }
  #controlsHint { position: fixed; bottom: 10px; left: 50%; transform: translateX(-50%); color: #666; font-size: 0.85rem; text-align: center; pointer-events: none; text-shadow: 0 0 3px #00ffff; }
  @media (max-width: 600px) {
    #ui { flex-direction: column; align-items: center; top: 5px; gap: 5px; }
    .stat { font-size: 12px; padding: 4px 10px; }
    #overlay h1 { font-size: 1.8rem; }
    .btn { padding: 10px 30px; font-size: 1rem; }
  }
</style>
</head>
<body>
<canvas id="gameCanvas"></canvas>
<div id="ui">
  <div class="stat">LEVEL: <span id="levelDisplay">1</span></div>
  <div class="stat">MOVES: <span id="movesDisplay">0</span></div>
  <div class="stat">SCORE: <span id="scoreDisplay">0</span></div>
  <div class="stat">BEST: <span id="highScoreDisplay">0</span></div>
</div>
<div id="overlay">
  <h1 id="overlayTitle">NEON LIGHTS OUT</h1>
  <p id="overlayMessage">Tap a cell to toggle it and its neighbors. Turn all lights off.</p>
  <button class="btn" id="btnResume">RESUME</button>
  <button class="btn" id="btnStart">START GAME</button>
  <button class="btn" id="btnNextLevel">NEXT LEVEL</button>
  <button class="btn" id="btnRetry">RETRY</button>
  <button class="btn" id="btnQuit">QUIT TO MENU</button>
  <button class="btn" id="btnMainMenu">MAIN MENU</button>
</div>
<div id="controlsHint">Arrows/WASD: Move Cursor | Space/Enter: Toggle | ESC/P: Pause | Touch: Tap Cell</div>
<script>
/* ===== NEON LIGHTS OUT - DAY 38 =====
   Puzzle game: toggle lights to turn all off.
   Increasing grid size, move limits, neon aesthetic.
   Pause/Resume/Quit, touch & keyboard, high score.
*/

// ===== CONSTANTS & CONFIG =====
const MIN_GRID = 3;
const MAX_GRID = 8;
const BASE_MOVE_MULTIPLIER = 2;
const COLORS = {
  bg: '#05050a',
  gridLine: '#003344',
  gridLineGlow: '#00ffff',
  lightOn: ['#00ffff', '#ff00ff', '#ffff00', '#ff4400', '#44ff00', '#ff00aa'],
  lightOff: '#111122',
  cursor: '#ffcc00',
  cursorGlow: '#ffff00',
  text: '#e0e0ff',
  uiBorder: '#00ffff'
};

// ===== GAME STATE =====
let canvas, ctx;
let width, height;
let cellSize, gridOriginX, gridOriginY;

let gameState = 'start';
let running = false;

let gridSize = MIN_GRID;
let grid = [];
let solutionSteps = 0;
let moves = 0;
let level = 1;
let score = 0;
let highScore = 0;
let maxMoves = 0;
let cursor = { x: 0, y: 0 };
let pendingNextLevel = false;

let animationId = null;
let lastTime = 0;

// ===== DOM ELEMENTS =====
const overlay = document.getElementById('overlay');
const overlayTitle = document.getElementById('overlayTitle');
const overlayMessage = document.getElementById('overlayMessage');
const btnResume = document.getElementById('btnResume');
const btnStart = document.getElementById('btnStart');
const btnNextLevel = document.getElementById('btnNextLevel');
const btnRetry = document.getElementById('btnRetry');
const btnQuit = document.getElementById('btnQuit');
const btnMainMenu = document.getElementById('btnMainMenu');
const levelDisplay = document.getElementById('levelDisplay');
const movesDisplay = document.getElementById('movesDisplay');
const scoreDisplay = document.getElementById('scoreDisplay');
const highScoreDisplay = document.getElementById('highScoreDisplay');

// ===== ROUNDRECT POLYFILL =====
function drawRoundRect(ctx, x, y, w, h, r) {
  if (w < 2 * r) r = w / 2;
  if (h < 2 * r) r = h / 2;
  ctx.beginPath();
  ctx.moveTo(x + r, y);
  ctx.arcTo(x + w, y, x + w, y + h, r);
  ctx.arcTo(x + w, y + h, x, y + h, r);
  ctx.arcTo(x, y + h, x, y, r);
  ctx.arcTo(x, y, x + w, y, r);
  ctx.closePath();
}

// ===== INITIALIZATION =====
function init() {
  canvas = document.getElementById('gameCanvas');
  ctx = canvas.getContext('2d');
  resizeCanvas();
  window.addEventListener('resize', resizeCanvas);
  loadHighScore();
  setupEventListeners();
  gridSize = MIN_GRID;
  createEmptyGrid(gridSize);
  updateGridGeometry();
  showStartScreen();
  running = true;
  lastTime = performance.now();
  requestAnimationFrame(gameLoop);
}

function resizeCanvas() {
  const maxWidth = window.innerWidth - 20;
  const maxHeight = window.innerHeight - 100;
  const size = Math.min(maxWidth, maxHeight, 600);
  canvas.width = size;
  canvas.height = size;
  width = canvas.width;
  height = canvas.height;
  updateGridGeometry();
}

function updateGridGeometry() {
  const padding = 20;
  const availableSize = Math.min(width, height) - padding * 2;
  cellSize = availableSize / gridSize;
  gridOriginX = (width - cellSize * gridSize) / 2;
  gridOriginY = (height - cellSize * gridSize) / 2;
}

function loadHighScore() {
  highScore = parseInt(localStorage.getItem('neonLightsOutHighScore')) || 0;
  highScoreDisplay.textContent = highScore;
}

function saveHighScore() {
  if (score > highScore) {
    highScore = score;
    localStorage.setItem('neonLightsOutHighScore', highScore);
    highScoreDisplay.textContent = highScore;
  }
}

function setupEventListeners() {
  // Keyboard
  window.addEventListener('keydown', handleKeyDown);
  // Touch
  canvas.addEventListener('touchstart', handleTouchStart, { passive: false });
  canvas.addEventListener('touchmove', handleTouchMove, { passive: false });
  canvas.addEventListener('touchend', handleTouchEnd, { passive: false });
  // Mouse (for desktop testing)
  canvas.addEventListener('mousedown', handleMouseDown);
  canvas.addEventListener('mousemove', handleMouseMove);
  canvas.addEventListener('mouseup', handleMouseUp);
  canvas.addEventListener('mouseleave', handleMouseLeave);
  // Buttons
  btnStart.addEventListener('click', startGame);
  btnResume.addEventListener('click', resumeGame);
  btnNextLevel.addEventListener('click', nextLevel);
  btnRetry.addEventListener('click', retry);
  btnQuit.addEventListener('click', quitToMenu);
  btnMainMenu.addEventListener('click', quitToMenu);
}

// ===== GAME LOOP =====
function gameLoop(timestamp) {
  if (!running) return;
  const dt = timestamp - lastTime;
  lastTime = timestamp;
  update(dt);
  render();
  animationId = requestAnimationFrame(gameLoop);
}

function update(dt) {
  if (gameState !== 'playing') return;
  // Check win condition
  if (isGridSolved()) {
    levelComplete();
  }
  // Check move limit
  if (moves >= maxMoves && maxMoves > 0) {
    gameOver();
  }
}

function render() {
  // Clear
  ctx.fillStyle = COLORS.bg;
  ctx.fillRect(0, 0, width, height);
  
  // Draw grid background glow
  drawGridGlow();
  
  // Draw cells
  for (let y = 0; y < gridSize; y++) {
    for (let x = 0; x < gridSize; x++) {
      drawCell(x, y);
    }
  }
  
  // Draw grid lines
  drawGridLines();
  
  // Draw cursor if playing
  if (gameState === 'playing') {
    drawCursor();
  }
}

function drawGridGlow() {
  const gridWidth = cellSize * gridSize;
  const gridHeight = cellSize * gridSize;
  const gradient = ctx.createRadialGradient(
    gridOriginX + gridWidth/2, gridOriginY + gridHeight/2, 0,
    gridOriginX + gridWidth/2, gridOriginY + gridHeight/2, Math.max(gridWidth, gridHeight)/2
  );
  gradient.addColorStop(0, 'rgba(0,255,255,0.03)');
  gradient.addColorStop(1, 'rgba(0,0,0,0)');
  ctx.fillStyle = gradient;
  ctx.fillRect(gridOriginX, gridOriginY, gridWidth, gridHeight);
}

function drawCell(x, y) {
  const cx = gridOriginX + x * cellSize;
  const cy = gridOriginY + y * cellSize;
  const padding = 2;
  const cellW = cellSize - padding * 2;
  const cellH = cellSize - padding * 2;
  const radius = Math.min(cellW, cellH) * 0.15;
  
  const isOn = grid[y][x];
  const colorIndex = (x + y * gridSize) % COLORS.lightOn.length;
  
  if (isOn) {
    // Glow effect
    ctx.shadowColor = COLORS.lightOn[colorIndex];
    ctx.shadowBlur = 15;
    ctx.fillStyle = COLORS.lightOn[colorIndex];
  } else {
    ctx.shadowColor = 'transparent';
    ctx.shadowBlur = 0;
    ctx.fillStyle = COLORS.lightOff;
  }
  
  drawRoundRect(ctx, cx + padding, cy + padding, cellW, cellH, radius);
  ctx.fill();
  
  // Border
  ctx.strokeStyle = isOn ? COLORS.lightOn[colorIndex] : COLORS.gridLine;
  ctx.lineWidth = 1;
  ctx.stroke();
  
  ctx.shadowBlur = 0;
}

function drawGridLines() {
  ctx.strokeStyle = COLORS.gridLine;
  ctx.lineWidth = 1;
  ctx.beginPath();
  for (let i = 0; i <= gridSize; i++) {
    // Vertical
    ctx.moveTo(gridOriginX + i * cellSize, gridOriginY);
    ctx.lineTo(gridOriginX + i * cellSize, gridOriginY + gridSize * cellSize);
    // Horizontal
    ctx.moveTo(gridOriginX, gridOriginY + i * cellSize);
    ctx.lineTo(gridOriginX + gridSize * cellSize, gridOriginY + i * cellSize);
  }
  ctx.stroke();
}

function drawCursor() {
  const cx = gridOriginX + cursor.x * cellSize;
  const cy = gridOriginY + cursor.y * cellSize;
  const padding = 4;
  const pulse = Math.sin(Date.now() / 200) * 0.5 + 0.5;
  
  ctx.shadowColor = COLORS.cursorGlow;
  ctx.shadowBlur = 10 + pulse * 10;
  ctx.strokeStyle = COLORS.cursor;
  ctx.lineWidth = 3;
  drawRoundRect(ctx, cx + padding, cy + padding, cellSize - padding * 2, cellSize - padding * 2, 8);
  ctx.stroke();
  ctx.shadowBlur = 0;
}

// ===== GRID LOGIC =====
function createEmptyGrid(size) {
  grid = [];
  for (let y = 0; y < size; y++) {
    grid[y] = [];
    for (let x = 0; x < size; x++) {
      grid[y][x] = false;
    }
  }
}

function generatePuzzle(size) {
  createEmptyGrid(size);
  // Start with all off, apply random moves to create solvable puzzle
  const numMoves = size * size * 2;
  for (let i = 0; i < numMoves; i++) {
    const rx = Math.floor(Math.random() * size);
    const ry = Math.floor(Math.random() * size);
    toggleCell(rx, ry, false);
  }
  // Calculate optimal solution steps (approximate)
  solutionSteps = Math.ceil(numMoves * 0.7);
  maxMoves = solutionSteps * BASE_MOVE_MULTIPLIER;
}

function toggleCell(x, y, countMove = true) {
  if (x < 0 || x >= gridSize || y < 0 || y >= gridSize) return;
  grid[y][x] = !grid[y][x];
  // Neighbors
  toggleCell(x+1, y, false);
  toggleCell(x-1, y, false);
  toggleCell(x, y+1, false);
  toggleCell(x, y-1, false);
  if (countMove) {
    moves++;
    movesDisplay.textContent = moves;
  }
}

function isGridSolved() {
  for (let y = 0; y < gridSize; y++) {
    for (let x = 0; x < gridSize; x++) {
      if (grid[y][x]) return false;
    }
  }
  return true;
}

// ===== INPUT HANDLING =====
function handleKeyDown(e) {
  if (gameState === 'playing') {
    switch(e.key) {
      case 'ArrowUp': case 'w': case 'W':
        cursor.y = Math.max(0, cursor.y - 1); e.preventDefault(); break;
      case 'ArrowDown': case 's': case 'S':
        cursor.y = Math.min(gridSize-1, cursor.y + 1); e.preventDefault(); break;
      case 'ArrowLeft': case 'a': case 'A':
        cursor.x = Math.max(0, cursor.x - 1); e.preventDefault(); break;
      case 'ArrowRight': case 'd': case 'D':
        cursor.x = Math.min(gridSize-1, cursor.x + 1); e.preventDefault(); break;
      case ' ': case 'Enter':
        toggleCell(cursor.x, cursor.y); e.preventDefault(); break;
      case 'Escape': case 'p': case 'P':
        pauseGame(); break;
    }
  } else if (gameState === 'paused') {
    if (e.key === 'Escape' || e.key === 'p' || e.key === 'P') {
      resumeGame();
    }
  }
}

let touchStartX = 0, touchStartY = 0;
function handleTouchStart(e) {
  e.preventDefault();
  if (gameState !== 'playing') return;
  const touch = e.touches[0];
  touchStartX = touch.clientX;
  touchStartY = touch.clientY;
}

function handleTouchMove(e) {
  e.preventDefault();
}

function handleTouchEnd(e) {
  e.preventDefault();
  if (gameState !== 'playing') return;
  const touch = e.changedTouches[0];
  const dx = touch.clientX - touchStartX;
  const dy = touch.clientY - touchStartY;
  const threshold = 30;
  
  if (Math.abs(dx) > Math.abs(dy)) {
    if (Math.abs(dx) > threshold) {
      cursor.x += dx > 0 ? 1 : -1;
      cursor.x = Math.max(0, Math.min(gridSize-1, cursor.x));
    }
  } else {
    if (Math.abs(dy) > threshold) {
      cursor.y += dy > 0 ? 1 : -1;
      cursor.y = Math.max(0, Math.min(gridSize-1, cursor.y));
    }
  }
  
  // Tap detection (small movement)
  if (Math.abs(dx) < threshold && Math.abs(dy) < threshold) {
    const rect = canvas.getBoundingClientRect();
    const x = Math.floor((touch.clientX - rect.left - gridOriginX) / cellSize);
    const y = Math.floor((touch.clientY - rect.top - gridOriginY) / cellSize);
    if (x >= 0 && x < gridSize && y >= 0 && y < gridSize) {
      cursor.x = x;
      cursor.y = y;
      toggleCell(x, y);
    }
  }
}

function handleMouseDown(e) {
  if (gameState !== 'playing') return;
  const rect = canvas.getBoundingClientRect();
  const x = Math.floor((e.clientX - rect.left - gridOriginX) / cellSize);
  const y = Math.floor((e.clientY - rect.top - gridOriginY) / cellSize);
  if (x >= 0 && x < gridSize && y >= 0 && y < gridSize) {
    cursor.x = x;
    cursor.y = y;
    toggleCell(x, y);
  }
}

function handleMouseMove(e) {}
function handleMouseUp(e) {}
function handleMouseLeave(e) {}

// ===== GAME STATE FUNCTIONS =====
function showOverlay(title, message, buttons) {
  overlayTitle.textContent = title;
  overlayMessage.textContent = message;
  // Hide all buttons first
  const allButtons = [btnResume, btnStart, btnNextLevel, btnRetry, btnQuit, btnMainMenu];
  allButtons.forEach(btn => btn.style.display = 'none');
  // Show requested buttons
  buttons.forEach(btnId => {
    const btn = document.getElementById(btnId);
    if (btn) btn.style.display = 'inline-block';
  });
  overlay.classList.add('visible');
}

function hideOverlay() {
  overlay.classList.remove('visible');
}

function showStartScreen() {
  gameState = 'start';
  level = 1;
  score = 0;
  moves = 0;
  gridSize = MIN_GRID;
  generatePuzzle(gridSize);
  cursor = { x: 0, y: 0 };
  updateUI();
  showOverlay('NEON LIGHTS OUT', 'Tap a cell to toggle it and its neighbors. Turn all lights off.', ['btnStart']);
}

function startGame() {
  hideOverlay();
  gameState = 'playing';
  level = 1;
  score = 0;
  moves = 0;
  gridSize = MIN_GRID;
  generatePuzzle(gridSize);
  cursor = { x: 0, y: 0 };
  updateUI();
}

function pauseGame() {
  if (gameState !== 'playing') return;
  gameState = 'paused';
  showOverlay('PAUSED', 'Game paused. Press RESUME to continue.', ['btnResume', 'btnQuit']);
}

function resumeGame() {
  hideOverlay();
  gameState = 'playing';
}

function quitToMenu() {
  hideOverlay();
  showStartScreen();
}

function nextLevel() {
  hideOverlay();
  level++;
  gridSize = Math.min(MAX_GRID, MIN_GRID + level - 1);
  generatePuzzle(gridSize);
  moves = 0;
  cursor = { x: 0, y: 0 };
  updateGridGeometry();
  gameState = 'playing';
  updateUI();
}

function retry() {
  hideOverlay();
  generatePuzzle(gridSize);
  moves = 0;
  cursor = { x: 0, y: 0 };
  gameState = 'playing';
  updateUI();
}

function gameOver() {
  gameState = 'gameover';
  saveHighScore();
  showOverlay('GAME OVER', `You ran out of moves! Level ${level} failed.`, ['btnRetry', 'btnMainMenu']);
}

function levelComplete() {
  gameState = 'levelcomplete';
  // Score bonus: remaining moves * level * 100
  const bonus = Math.max(0, maxMoves - moves) * level * 100;
  score += bonus + level * 500;
  saveHighScore();
  if (level >= 20 || gridSize >= MAX_GRID) {
    showOverlay('VICTORY!', `You completed all levels! Final Score: ${score}`, ['btnRetry', 'btnMainMenu']);
  } else {
    showOverlay('LEVEL COMPLETE!', `Level ${level} cleared! Bonus: ${bonus}`, ['btnNextLevel', 'btnQuit']);
  }
}

function updateUI() {
  levelDisplay.textContent = level;
  movesDisplay.textContent = moves;
  scoreDisplay.textContent = score;
  highScoreDisplay.textContent = highScore;
}

// ===== START =====
init();
</script>
</body>
</html>