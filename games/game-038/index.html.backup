<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no">
    <title>NEON SNAKE</title>
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body { 
            background: #0a0a12; 
            color: #00ffcc; 
            font-family: 'Courier New', monospace; 
            overflow: hidden; 
            height: 100vh; 
            display: flex; 
            flex-direction: column; 
            align-items: center; 
            justify-content: center; 
        }
        #gameCanvas { 
            border: 2px solid #00ffcc; 
            box-shadow: 0 0 20px #00ffcc, inset 0 0 20px rgba(0,255,204,0.1); 
            background: #050510; 
            display: block; 
        }
        #ui { 
            position: fixed; 
            top: 10px; 
            left: 50%; 
            transform: translateX(-50%); 
            display: flex; 
            gap: 30px; 
            font-size: 1.2rem; 
            text-shadow: 0 0 10px #00ffcc; 
            z-index: 10; 
        }
        .stat { display: flex; flex-direction: column; align-items: center; }
        .stat-label { font-size: 0.7rem; opacity: 0.7; letter-spacing: 2px; }
        .stat-value { font-size: 1.5rem; font-weight: bold; }
        .overlay { 
            position: fixed; 
            top: 0; 
            left: 0; 
            width: 100%; 
            height: 100%; 
            background: rgba(5,5,16,0.95); 
            display: flex; 
            flex-direction: column; 
            align-items: center; 
            justify-content: center; 
            z-index: 100; 
            gap: 20px;
        }
        .overlay.hidden { display: none; }
        .overlay h1 { 
            font-size: 3rem; 
            text-shadow: 0 0 20px #00ffcc, 0 0 40px #00ffcc; 
            letter-spacing: 4px; 
            margin-bottom: 10px;
        }
        .overlay p { 
            font-size: 1.2rem; 
            opacity: 0.8; 
            letter-spacing: 1px; 
        }
        .btn { 
            background: transparent; 
            border: 2px solid #00ffcc; 
            color: #00ffcc; 
            padding: 15px 40px; 
            font-family: inherit; 
            font-size: 1.2rem; 
            letter-spacing: 2px; 
            cursor: pointer; 
            transition: all 0.3s; 
            text-transform: uppercase; 
            box-shadow: 0 0 10px rgba(0,255,204,0.3); 
        }
        .btn:hover { 
            background: #00ffcc; 
            color: #050510; 
            box-shadow: 0 0 20px #00ffcc, 0 0 40px #00ffcc; 
        }
        .btn:active { transform: scale(0.95); }
        .controls-hint { 
            position: fixed; 
            bottom: 20px; 
            left: 50%; 
            transform: translateX(-50%); 
            font-size: 0.8rem; 
            opacity: 0.5; 
            letter-spacing: 1px; 
            display: flex; 
            gap: 20px; 
        }
        @media (max-width: 600px) {
            #gameCanvas { width: 95vw; height: 95vw; max-width: 400px; max-height: 400px; }
            #ui { font-size: 1rem; gap: 15px; }
            .overlay h1 { font-size: 2rem; }
            .btn { padding: 12px 30px; font-size: 1rem; }
        }
    </style>
</head>
<body>
    <div id="ui">
        <div class="stat">
            <span class="stat-label">SCORE</span>
            <span class="stat-value" id="score">0</span>
        </div>
        <div class="stat">
            <span class="stat-label">HIGH SCORE</span>
            <span class="stat-value" id="highScore">0</span>
        </div>
    </div>
    <canvas id="gameCanvas"></canvas>
    <div class="controls-hint" id="controlsHint">ARROWS / WASD TO MOVE | ESC / P TO PAUSE</div>

    <div class="overlay" id="startOverlay">
        <h1>NEON SNAKE</h1>
        <p>EAT THE GLOWING ORBS TO GROW</p>
        <p>DON'T HIT WALLS OR YOURSELF</p>
        <button class="btn" id="startBtn">START GAME</button>
    </div>

    <div class="overlay hidden" id="pauseOverlay">
        <h1>PAUSED</h1>
        <button class="btn" id="resumeBtn">RESUME</button>
        <button class="btn" id="quitBtn">QUIT TO MENU</button>
    </div>

    <div class="overlay hidden" id="gameOverOverlay">
        <h1>GAME OVER</h1>
        <p id="finalScore">SCORE: 0</p>
        <button class="btn" id="retryBtn">RETRY</button>
        <button class="btn" id="menuBtn">MAIN MENU</button>
    </div>

    <script>
        const canvas = document.getElementById('gameCanvas');
        const ctx = canvas.getContext('2d');
        const scoreEl = document.getElementById('score');
        const highScoreEl = document.getElementById('highScore');
        const startOverlay = document.getElementById('startOverlay');
        const pauseOverlay = document.getElementById('pauseOverlay');
        const gameOverOverlay = document.getElementById('gameOverOverlay');
        const finalScoreEl = document.getElementById('finalScore');
        const controlsHint = document.getElementById('controlsHint');

        const GRID_SIZE = 20;
        let canvasSize = Math.min(window.innerWidth, window.innerHeight) * 0.9;
        canvasSize = Math.floor(canvasSize / GRID_SIZE) * GRID_SIZE;
        canvas.width = canvasSize;
        canvas.height = canvasSize;
        const COLS = canvas.width / GRID_SIZE;
        const ROWS = canvas.height / GRID_SIZE;

        let snake = [];
        let direction = { x: 1, y: 0 };
        let nextDirection = { x: 1, y: 0 };
        let food = { x: 0, y: 0 };
        let score = 0;
        let highScore = parseInt(localStorage.getItem('neonSnakeHighScore')) || 0;
        let gameLoop = null;
        let gameSpeed = 120;
        let isPaused = false;
        let isGameOver = false;
        let isMobile = /Android|webOS|iPhone|iPad|iPod|BlackBerry|IEMobile|Opera Mini/i.test(navigator.userAgent);
        let touchStartX = 0;
        let touchStartY = 0;

        highScoreEl.textContent = highScore;

        function initGame() {
            snake = [
                { x: Math.floor(COLS / 2), y: Math.floor(ROWS / 2) },
                { x: Math.floor(COLS / 2) - 1, y: Math.floor(ROWS / 2) },
                { x: Math.floor(COLS / 2) - 2, y: Math.floor(ROWS / 2) }
            ];
            direction = { x: 1, y: 0 };
            nextDirection = { x: 1, y: 0 };
            score = 0;
            scoreEl.textContent = score;
            spawnFood();
            isGameOver = false;
            isPaused = false;
        }

        function spawnFood() {
            let newFood;
            do {
                newFood = {
                    x: Math.floor(Math.random() * COLS),
                    y: Math.floor(Math.random() * ROWS)
                };
            } while (snake.some(seg => seg.x === newFood.x && seg.y === newFood.y));
            food = newFood;
        }

        function draw() {
            ctx.fillStyle = '#050510';
            ctx.fillRect(0, 0, canvas.width, canvas.height);

            // Grid lines
            ctx.strokeStyle = 'rgba(0,255,204,0.03)';
            ctx.lineWidth = 1;
            for (let i = 0; i <= COLS; i++) {
                ctx.beginPath();
                ctx.moveTo(i * GRID_SIZE, 0);
                ctx.lineTo(i * GRID_SIZE, canvas.height);
                ctx.stroke();
            }
            for (let i = 0; i <= ROWS; i++) {
                ctx.beginPath();
                ctx.moveTo(0, i * GRID_SIZE);
                ctx.lineTo(canvas.width, i * GRID_SIZE);
                ctx.stroke();
            }

            // Food with glow
            const foodX = food.x * GRID_SIZE + GRID_SIZE / 2;
            const foodY = food.y * GRID_SIZE + GRID_SIZE / 2;
            const gradient = ctx.createRadialGradient(foodX, foodY, 0, foodX, foodY, GRID_SIZE);
            gradient.addColorStop(0, '#00ffcc');
            gradient.addColorStop(0.5, '#00ccaa');
            gradient.addColorStop(1, 'rgba(0,255,204,0)');
            ctx.fillStyle = gradient;
            ctx.beginPath();
            ctx.arc(foodX, foodY, GRID_SIZE * 0.7, 0, Math.PI * 2);
            ctx.fill();

            // Snake
            snake.forEach((segment, index) => {
                const x = segment.x * GRID_SIZE;
                const y = segment.y * GRID_SIZE;
                const isHead = index === 0;
                const hue = isHead ? 180 : 180 - (index * 2);
                const brightness = isHead ? 100 : 70 - (index * 1.5);
                
                // Body glow
                ctx.shadowColor = `hsl(${hue}, 100%, 50%)`;
                ctx.shadowBlur = isHead ? 15 : 8;
                ctx.fillStyle = `hsl(${hue}, 100%, ${brightness}%)`;
                
                const radius = GRID_SIZE / 2 - 2;
                ctx.beginPath();
                ctx.roundRect(x + 2, y + 2, GRID_SIZE - 4, GRID_SIZE - 4, radius);
                ctx.fill();
                ctx.shadowBlur = 0;
            });
        }

        function update() {
            if (isPaused || isGameOver) return;

            direction = { ...nextDirection };
            const head = { x: snake[0].x + direction.x, y: snake[0].y + direction.y };

            // Wall collision
            if (head.x < 0 || head.x >= COLS || head.y < 0 || head.y >= ROWS) {
                gameOver();
                return;
            }

            // Self collision
            if (snake.some(seg => seg.x === head.x && seg.y === head.y)) {
                gameOver();
                return;
            }

            snake.unshift(head);

            // Food collision
            if (head.x === food.x && head.y === food.y) {
                score += 10;
                scoreEl.textContent = score;
                if (score > highScore) {
                    highScore = score;
                    highScoreEl.textContent = highScore;
                    localStorage.setItem('neonSnakeHighScore', highScore);
                }
                spawnFood();
                // Increase speed slightly
                if (gameSpeed > 60) {
                    gameSpeed -= 0.5;
                    clearInterval(gameLoop);
                    gameLoop = setInterval(update, gameSpeed);
                }
            } else {
                snake.pop();
            }

            draw();
        }

        function gameOver() {
            isGameOver = true;
            clearInterval(gameLoop);
            finalScoreEl.textContent = `SCORE: ${score}`;
            gameOverOverlay.classList.remove('hidden');
            controlsHint.style.display = 'none';
        }

        function startGame() {
            initGame();
            startOverlay.classList.add('hidden');
            pauseOverlay.classList.add('hidden');
            gameOverOverlay.classList.add('hidden');
            controlsHint.style.display = 'flex';
            draw();
            if (gameLoop) clearInterval(gameLoop);
            gameSpeed = 120;
            gameLoop = setInterval(update, gameSpeed);
        }

        function pauseGame() {
            if (isGameOver) return;
            isPaused = true;
            pauseOverlay.classList.remove('hidden');
            controlsHint.style.display = 'none';
        }

        function resumeGame() {
            isPaused = false;
            pauseOverlay.classList.add('hidden');
            controlsHint.style.display = 'flex';
        }

        function quitToMenu() {
            isPaused = false;
            pauseOverlay.classList.add('hidden');
            gameOverOverlay.classList.add('hidden');
            startOverlay.classList.remove('hidden');
            controlsHint.style.display = 'none';
            clearInterval(gameLoop);
            draw();
        }

        function showStartScreen() {
            quitToMenu();
        }

        // Keyboard controls
        document.addEventListener('keydown', (e) => {
            if (e.key === 'Escape' || e.key === 'p' || e.key === 'P') {
                if (isGameOver) return;
                if (isPaused) resumeGame();
                else pauseGame();
                return;
            }

            if (isPaused || isGameOver) return;

            switch (e.key) {
                case 'ArrowUp':
                case 'w':
                case 'W':
                    if (direction.y !== 1) nextDirection = { x: 0, y: -1 };
                    break;
                case 'ArrowDown':
                case 's':
                case 'S':
                    if (direction.y !== -1) nextDirection = { x: 0, y: 1 };
                    break;
                case 'ArrowLeft':
                case 'a':
                case 'A':
                    if (direction.x !== 1) nextDirection = { x: -1, y: 0 };
                    break;
                case 'ArrowRight':
                case 'd':
                case 'D':
                    if (direction.x !== -1) nextDirection = { x: 1, y: 0 };
                    break;
            }
        });

        // Touch controls
        canvas.addEventListener('touchstart', (e) => {
            touchStartX = e.touches[0].clientX;
            touchStartY = e.touches[0].clientY;
        }, { passive: false });

        canvas.addEventListener('touchmove', (e) => {
            e.preventDefault();
        }, { passive: false });

        canvas.addEventListener('touchend', (e) => {
            if (isPaused || isGameOver) return;
            const touchEndX = e.changedTouches[0].clientX;
            const touchEndY = e.changedTouches[0].clientY;
            const dx = touchEndX - touchStartX;
            const dy = touchEndY - touchStartY;

            if (Math.abs(dx) > Math.abs(dy)) {
                if (dx > 30 && direction.x !== -1) nextDirection = { x: 1, y: 0 };
                else if (dx < -30 && direction.x !== 1) nextDirection = { x: -1, y: 0 };
            } else {
                if (dy > 30 && direction.y !== -1) nextDirection = { x: 0, y: 1 };
                else if (dy < -30 && direction.y !== 1) nextDirection = { x: 0, y: -1 };
            }
        }, { passive: false });

        // Button events
        document.getElementById('startBtn').addEventListener('click', startGame);
        document.getElementById('resumeBtn').addEventListener('click', resumeGame);
        document.getElementById('quitBtn').addEventListener('click', quitToMenu);
        document.getElementById('retryBtn').addEventListener('click', startGame);
        document.getElementById('menuBtn').addEventListener('click', showStartScreen);

        // Handle resize
        window.addEventListener('resize', () => {
            const newSize = Math.min(window.innerWidth, window.innerHeight) * 0.9;
            const adjustedSize = Math.floor(newSize / GRID_SIZE) * GRID_SIZE;
            if (adjustedSize !== canvasSize) {
                canvasSize = adjustedSize;
                canvas.width = canvasSize;
                canvas.height = canvasSize;
                draw();
            }
        });

        // Initial draw
        draw();
    </script>
</body>
</html>