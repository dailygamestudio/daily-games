<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no">
<title>Neon Lights Out - Day 38</title>
<style>
  * { margin: 0; padding: 0; box-sizing: border-box; }
  body { background: #0a0a12; color: #e0e0ff; font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; overflow: hidden; touch-action: none; }
  canvas { display: block; margin: 0 auto; background: #05050a; box-shadow: 0 0 30px #00ffff, 0 0 60px #ff00ff, inset 0 0 60px rgba(0,255,255,0.1); }
  #ui { position: fixed; top: 10px; left: 50%; transform: translateX(-50%); display: flex; gap: 20px; z-index: 10; pointer-events: none; }
  .stat { background: rgba(0,20,40,0.8); border: 1px solid #00ffff; padding: 5px 15px; border-radius: 4px; font-size: 14px; text-shadow: 0 0 5px #00ffff; }
  .stat span { color: #ffcc00; font-weight: bold; }
  #overlay { position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.85); display: none; flex-direction: column; align-items: center; justify-content: center; gap: 20px; z-index: 100; }
  #overlay.visible { display: flex; }
  #overlay h1 { font-size: 2.5rem; text-shadow: 0 0 10px #00ffff, 0 0 20px #ff00ff; margin-bottom: 10px; }
  #overlay p { font-size: 1.2rem; color: #aaa; }
  .btn { background: linear-gradient(135deg, #004466, #002244); border: 2px solid #00ffff; color: #e0e0ff; padding: 12px 40px; font-size: 1.1rem; border-radius: 6px; cursor: pointer; text-transform: uppercase; letter-spacing: 2px; transition: all 0.2s; box-shadow: 0 0 10px #00ffff; }
  .btn:hover, .btn:focus { background: linear-gradient(135deg, #006699, #004466); box-shadow: 0 0 20px #00ffff, 0 0 30px #ff00ff; transform: scale(1.05); }
  .btn:active { transform: scale(0.98); }
  #controlsHint { position: fixed; bottom: 10px; left: 50%; transform: translateX(-50%); color: #666; font-size: 0.85rem; text-align: center; pointer-events: none; text-shadow: 0 0 3px #00ffff; }
  @media (max-width: 600px) {
    #ui { flex-direction: column; align-items: center; top: 5px; gap: 5px; }
    .stat { font-size: 12px; padding: 4px 10px; }
    #overlay h1 { font-size: 1.8rem; }
    .btn { padding: 10px 30px; font-size: 1rem; }
  }
</style>
</head>
<body>
<canvas id="gameCanvas"></canvas>
<div id="ui">
  <div class="stat">LEVEL: <span id="levelDisplay">1</span></div>
  <div class="stat">MOVES: <span id="movesDisplay">0</span></div>
  <div class="stat">SCORE: <span id="scoreDisplay">0</span></div>
  <div class="stat">BEST: <span id="highScoreDisplay">0</span></div>
</div>
<div id="overlay">
  <h1 id="overlayTitle">NEON LIGHTS OUT</h1>
  <p id="overlayMessage">Tap a cell to toggle it and its neighbors. Turn all lights off.</p>
  <button class="btn" id="btnResume">RESUME</button>
  <button class="btn" id="btnStart">START GAME</button>
  <button class="btn" id="btnRetry">RETRY</button>
  <button class="btn" id="btnQuit">QUIT TO MENU</button>
  <button class="btn" id="btnMainMenu">MAIN MENU</button>
</div>
<div id="controlsHint">Arrows/WASD: Move Cursor | Space/Enter: Toggle | ESC/P: Pause | Touch: Tap Cell</div>
<script>
/* ===== NEON LIGHTS OUT - DAY 38 =====
   Puzzle game: toggle lights to turn all off.
   Increasing grid size, move limits, neon aesthetic.
   Pause/Resume/Quit, touch & keyboard, high score.
*/

// ===== CONSTANTS & CONFIG =====
const MIN_GRID = 3;
const MAX_GRID = 8;
const BASE_MOVE_MULTIPLIER = 2; // max moves = optimal * this
const COLORS = {
  bg: '#05050a',
  gridLine: '#003344',
  gridLineGlow: '#00ffff',
  lightOn: ['#00ffff', '#ff00ff', '#ffff00', '#ff4400', '#44ff00', '#ff00aa'],
  lightOff: '#111122',
  cursor: '#ffcc00',
  cursorGlow: '#ffff00',
  text: '#e0e0ff',
  uiBorder: '#00ffff'
};

// ===== GAME STATE =====
let canvas, ctx;
let width, height;
let cellSize, gridOriginX, gridOriginY;

let gameState = 'start'; // 'start', 'playing', 'paused', 'gameover'
let running = false; // animation loop flag

let gridSize = MIN_GRID;
let grid = []; // 2D array of 0/1
let solution = []; // not used, but could store solution path
let moves = 0;
let level = 1;
let score = 0;
let highScore = 0;
let maxMoves = 0;
let cursor = { x: 0, y: 0 }; // for keyboard navigation

let animationId = null;
let lastTime = 0;

// ===== DOM ELEMENTS =====
const overlay = document.getElementById('overlay');
const overlayTitle = document.getElementById('overlayTitle');
const overlayMessage = document.getElementById('overlayMessage');
const btnResume = document.getElementById('btnResume');
const btnStart = document.getElementById('btnStart');
const btnRetry = document.getElementById('btnRetry');
const btnQuit = document.getElementById('btnQuit');
const btnMainMenu = document.getElementById('btnMainMenu');
const levelDisplay = document.getElementById('levelDisplay');
const movesDisplay = document.getElementById('movesDisplay');
const scoreDisplay = document.getElementById('scoreDisplay');
const highScoreDisplay = document.getElementById('highScoreDisplay');

// ===== INITIALIZATION =====
function init() {
  canvas = document.getElementById('gameCanvas');
  ctx = canvas.getContext('2d');
  resizeCanvas();
  window.addEventListener('resize', resizeCanvas);
  loadHighScore();
  setupEventListeners();
  showStartScreen();
  // start render loop (even for start screen)
  running = true;
  requestAnimationFrame(gameLoop);
}

function resizeCanvas() {
  const maxWidth = window.innerWidth - 20;
  const maxHeight = window.innerHeight - 100; // leave room for UI
  const size = Math.min(maxWidth, maxHeight, 600);
  canvas.width = size;
  canvas.height = size;
  width = canvas.width;
  height = canvas.height;
  // cell size will be set per level in generateLevel
}

// ===== HIGH SCORE =====
function loadHighScore() {
  highScore = parseInt(localStorage.getItem('neonLightsOutHighScore')) || 0;
  highScoreDisplay.textContent = highScore;
}
function saveHighScore() {
  if (score > highScore) {
    highScore = score;
    localStorage.setItem('neonLightsOutHighScore', highScore);
    highScoreDisplay.textContent = highScore;
  }
}

// ===== EVENT LISTENERS =====
function setupEventListeners() {
  // Keyboard
  window.addEventListener('keydown', handleKeydown);
  // Pause buttons
  btnResume.addEventListener('click', resumeGame);
  btnStart.addEventListener('click', startGame);
  btnRetry.addEventListener('click', startGame);
  btnQuit.addEventListener('click', quitToMenu);
  btnMainMenu.addEventListener('click', quitToMenu);
  // Touch / Mouse on canvas
  canvas.addEventListener('pointerdown', handlePointerDown, { passive: false });
  // Prevent context menu
  canvas.addEventListener('contextmenu', e => e.preventDefault());
}

function handleKeydown(e) {
  if (gameState === 'playing') {
    switch (e.key) {
      case 'ArrowUp': case 'w': case 'W': moveCursor(0, -1); break;
      case 'ArrowDown': case 's': case 'S': moveCursor(0, 1); break;
      case 'ArrowLeft': case 'a': case 'A': moveCursor(-1, 0); break;
      case 'ArrowRight': case 'd': case 'D': moveCursor(1, 0); break;
      case ' ': case 'Enter': toggleCell(cursor.x, cursor.y); break;
      case 'Escape': case 'p': case 'P': pauseGame(); break;
    }
    e.preventDefault();
  } else if (gameState === 'paused') {
    if (e.key === 'Escape' || e.key === 'p' || e.key === 'P') resumeGame();
  }
}

function handlePointerDown(e) {
  if (gameState !== 'playing') return;
  const rect = canvas.getBoundingClientRect();
  const x = e.clientX - rect.left;
  const y = e.clientY - rect.top;
  // Convert to grid coordinates
  const col = Math.floor((x - gridOriginX) / cellSize);
  const row = Math.floor((y - gridOriginY) / cellSize);
  if (col >= 0 && col < gridSize && row >= 0 && row < gridSize) {
    toggleCell(col, row);
  }
}

// ===== GAME STATE FUNCTIONS =====
function showStartScreen() {
  gameState =