<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no">
<title>Neon Lights Out - Day 38</title>
<style>
  * { margin: 0; padding: 0; box-sizing: border-box; }
  body { background: #0a0a12; color: #e0e0ff; font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; overflow: hidden; touch-action: none; }
  canvas { display: block; margin: 0 auto; background: #05050a; box-shadow: 0 0 30px #00ffff, 0 0 60px #ff00ff, inset 0 0 60px rgba(0,255,255,0.1); }
  #ui { position: fixed; top: 10px; left: 50%; transform: translateX(-50%); display: flex; gap: 20px; z-index: 10; pointer-events: none; }
  .stat { background: rgba(0,20,40,0.8); border: 1px solid #00ffff; padding: 5px 15px; border-radius: 4px; font-size: 14px; text-shadow: 0 0 5px #00ffff; }
  .stat span { color: #ffcc00; font-weight: bold; }
  #overlay { position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.85); display: none; flex-direction: column; align-items: center; justify-content: center; gap: 20px; z-index: 100; pointer-events: none; }
  #overlay.visible { display: flex; pointer-events: auto; }
  #overlay h1 { font-size: 2.5rem; text-shadow: 0 0 10px #00ffff, 0 0 20px #ff00ff; margin-bottom: 10px; }
  #overlay p { font-size: 1.2rem; color: #aaa; }
  .btn { background: linear-gradient(135deg, #004466, #002244); border: 2px solid #00ffff; color: #e0e0ff; padding: 12px 40px; font-size: 1.1rem; border-radius: 6px; cursor: pointer; text-transform: uppercase; letter-spacing: 2px; transition: all 0.2s; box-shadow: 0 0 10px #00ffff; pointer-events: auto; }
  .btn:hover, .btn:focus { background: linear-gradient(135deg, #006699, #004466); box-shadow: 0 0 20px #00ffff, 0 0 30px #ff00ff; transform: scale(1.05); }
  .btn:active { transform: scale(0.98); }
  #controlsHint { position: fixed; bottom: 10px; left: 50%; transform: translateX(-50%); color: #666; font-size: 0.85rem; text-align: center; pointer-events: none; text-shadow: 0 0 3px #00ffff; }
  @media (max-width: 600px) {
    #ui { flex-direction: column; align-items: center; top: 5px; gap: 5px; }
    .stat { font-size: 12px; padding: 4px 10px; }
    #overlay h1 { font-size: 1.8rem; }
    .btn { padding: 10px 30px; font-size: 1rem; }
  }
</style>
</head>
<body>
<canvas id="gameCanvas"></canvas>
<div id="ui">
  <div class="stat">LEVEL: <span id="levelDisplay">1</span></div>
  <div class="stat">MOVES: <span id="movesDisplay">0</span></div>
  <div class="stat">SCORE: <span id="scoreDisplay">0</span></div>
  <div class="stat">BEST: <span id="highScoreDisplay">0</span></div>
</div>
<div id="overlay">
  <h1 id="overlayTitle">NEON LIGHTS OUT</h1>
  <p id="overlayMessage">Tap a cell to toggle it and its neighbors. Turn all lights off.</p>
  <button class="btn" id="btnResume">RESUME</button>
  <button class="btn" id="btnStart">START GAME</button>
  <button class="btn" id="btnRetry">RETRY</button>
  <button class="btn" id="btnQuit">QUIT TO MENU</button>
  <button class="btn" id="btnMainMenu">MAIN MENU</button>
</div>
<div id="controlsHint">Arrows/WASD: Move Cursor | Space/Enter: Toggle | ESC/P: Pause | Touch: Tap Cell</div>
<script>
/* ===== NEON LIGHTS OUT - DAY 38 =====
   Puzzle game: toggle lights to turn all off.
   Increasing grid size, move limits, neon aesthetic.
   Pause/Resume/Quit, touch & keyboard, high score.
*/

// ===== CONSTANTS & CONFIG =====
const MIN_GRID = 3;
const MAX_GRID = 8;
const BASE_MOVE_MULTIPLIER = 2;
const COLORS = {
  bg: '#05050a',
  gridLine: '#003344',
  gridLineGlow: '#00ffff',
  lightOn: ['#00ffff', '#ff00ff', '#ffff00', '#ff4400', '#44ff00', '#ff00aa'],
  lightOff: '#111122',
  cursor: '#ffcc00',
  cursorGlow: '#ffff00',
  text: '#e0e0ff',
  uiBorder: '#00ffff'
};

// ===== GAME STATE =====
let canvas, ctx;
let width, height;
let cellSize, gridOriginX, gridOriginY;

let gameState = 'start';
let running = false;

let gridSize = MIN_GRID;
let grid = [];
let solutionSteps = 0;
let moves = 0;
let level = 1;
let score = 0;
let highScore = 0;
let maxMoves = 0;
let cursor = { x: 0, y: 0 };
let pendingNextLevel = false;

let animationId = null;
let lastTime = 0;

// ===== DOM ELEMENTS =====
const overlay = document.getElementById('overlay');
const overlayTitle = document.getElementById('overlayTitle');
const overlayMessage = document.getElementById('overlayMessage');
const btnResume = document.getElementById('btnResume');
const btnStart = document.getElementById('btnStart');
const btnRetry = document.getElementById('btnRetry');
const btnQuit = document.getElementById('btnQuit');
const btnMainMenu = document.getElementById('btnMainMenu');
const levelDisplay = document.getElementById('levelDisplay');
const movesDisplay = document.getElementById('movesDisplay');
const scoreDisplay = document.getElementById('scoreDisplay');
const highScoreDisplay = document.getElementById('highScoreDisplay');

// ===== INITIALIZATION =====
function init() {
  canvas = document.getElementById('gameCanvas');
  ctx = canvas.getContext('2d');
  resizeCanvas();
  window.addEventListener('resize', resizeCanvas);
  loadHighScore();
  setupEventListeners();
  gridSize = MIN_GRID;
  createEmptyGrid(gridSize);
  updateGridGeometry();
  showStartScreen();
  running = true;
  lastTime = performance.now();
  requestAnimationFrame(gameLoop);
}

function resizeCanvas() {
  const maxWidth = window.innerWidth - 20;
  const maxHeight = window.innerHeight - 100;
  const size = Math.min(maxWidth, maxHeight, 600);
  canvas.width = size;
  canvas.height = size;
  width = canvas.width;
  height = canvas.height;
  updateGridGeometry();
}

function updateGridGeometry() {
  const padding = 20;
  const availableSize = Math.min(width, height) - padding * 2;
  cellSize = availableSize / gridSize;
  gridOriginX = (width - cellSize * gridSize) / 2;
  gridOriginY = (height - cellSize * gridSize) / 2;
}

function createEmptyGrid(size) {
  grid = [];
  for (let y = 0; y < size; y++) {
    grid[y] = [];
    for (let x = 0; x < size; x++) {
      grid[y][x] = 0;
    }
  }
}

// ===== HIGH SCORE =====
function loadHighScore() {
  highScore = parseInt(localStorage.getItem('neonLightsOutHighScore')) || 0;
  highScoreDisplay.textContent = highScore;
}
function saveHighScore() {
  if (score > highScore) {
    highScore = score;
    localStorage.setItem('neonLightsOutHighScore', highScore);
    highScoreDisplay.textContent = highScore;
  }
}

// ===== EVENT LISTENERS =====
function setupEventListeners() {
  window.addEventListener('keydown', handleKeydown);
  canvas.addEventListener('click', handleCanvasClick, { passive: false });
  canvas.addEventListener('touchstart', handleTouch, { passive: false });
  
  btnResume.addEventListener('click', resumeGame);
  btnStart.addEventListener('click', startGame);
  btnRetry.addEventListener('click', handleRetryClick);
  btnQuit.addEventListener('click', quitToMenu);
  btnMainMenu.addEventListener('click', quitToMenu);
}

function handleKeydown(e) {
  if (gameState !== 'playing') {
    if ((e.key === 'Escape' || e.key === 'p' || e.key === 'P') && gameState === 'paused') {
      resumeGame();
    }
    return;
  }
  
  switch(e.key) {
    case 'ArrowUp': case 'w': case 'W':
      cursor.y = (cursor.y - 1 + gridSize) % gridSize; break;
    case 'ArrowDown': case 's': case 'S':
      cursor.y = (cursor.y + 1) % gridSize; break;
    case 'ArrowLeft': case 'a': case 'A':
      cursor.x = (cursor.x - 1 + gridSize) % gridSize; break;
    case 'ArrowRight': case 'd': case 'D':
      cursor.x = (cursor.x + 1) % gridSize; break;
    case ' ': case 'Enter':
      e.preventDefault();
      toggleCell(cursor.x, cursor.y);
      break;
    case 'Escape': case 'p': case 'P':
      pauseGame();
      break;
  }
}

function handleCanvasClick(e) {
  if (gameState !== 'playing') return;
  const rect = canvas.getBoundingClientRect();
  const x = e.clientX - rect.left;
  const y = e.clientY - rect.top;
  const gridX = Math.floor((x - gridOriginX) / cellSize);
  const gridY = Math.floor((y - gridOriginY) / cellSize);
  if (gridX >= 0 && gridX < gridSize && gridY >= 0 && gridY < gridSize) {
    toggleCell(gridX, gridY);
  }
}

function handleTouch(e) {
  if (gameState !== 'playing') return;
  e.preventDefault();
  const touch = e.touches[0];
  const rect = canvas.getBoundingClientRect();
  const x = touch.clientX - rect.left;
  const y = touch.clientY - rect.top;
  const gridX = Math.floor((x - gridOriginX) / cellSize);
  const gridY = Math.floor((y - gridOriginY) / cellSize);
  if (gridX >= 0 && gridX < gridSize && gridY >= 0 && gridY < gridSize) {
    toggleCell(gridX, gridY);
  }
}

function handleRetryClick() {
  if (gameState === 'gameover') {
    startGame();
  }
}

// ===== GAME LOGIC =====
function generatePuzzle() {
  createEmptyGrid(gridSize);
  solutionSteps = 0;
  const steps = Math.floor(gridSize * gridSize * 0.4) + gridSize;
  for (let i = 0; i < steps; i++) {
    const x = Math.floor(Math.random() * gridSize);
    const y = Math.floor(Math.random() * gridSize);
    toggleCellSilent(x, y);
    solutionSteps++;
  }
  maxMoves = solutionSteps * BASE_MOVE_MULTIPLIER;
  moves = 0;
  cursor = { x: 0, y: 0 };
  updateUI();
}

function toggleCellSilent(x, y) {
  const dirs = [[0,0], [0,-1], [0,1], [-1,0], [1,0]];
  for (const [dx, dy] of dirs) {
    const nx = x + dx;
    const ny = y + dy;
    if (nx >= 0 && nx < gridSize && ny >= 0 && ny < gridSize) {
      grid[ny][nx] = 1 - grid[ny][nx];
    }
  }
}

function toggleCell(x, y) {
  toggleCellSilent(x, y);
  moves++;
  updateUI();
  checkWin();
  if (moves >= maxMoves && gameState === 'playing') {
    gameOver(false);
  }
}

function checkWin() {
  for (let y = 0; y < gridSize; y++) {
    for (let x = 0; x < gridSize; x++) {
      if (grid[y][x] === 1) return;
    }
  }
  gameOver(true);
}

function gameOver(won) {
  gameState = 'gameover';
  if (won) {
    const bonus = Math.max(0, (maxMoves - moves) * 10);
    const levelScore = 100 * gridSize + bonus;
    score += levelScore;
    saveHighScore();
    overlayTitle.textContent = 'LEVEL COMPLETE!';
    overlayMessage.textContent = `Score: +${levelScore} | Total: ${score}`;
    btnRetry.style.display = 'none';
    btnMainMenu.style.display = 'inline-block';
    btnQuit.style.display = 'none';
    pendingNextLevel = true;
  } else {
    overlayTitle.textContent = 'GAME OVER';
    overlayMessage.textContent = `Out of moves! Final Score: ${score}`;
    btnRetry.style.display = 'inline-block';
    btnMainMenu.style.display = 'inline-block';
    btnQuit.style.display = 'none';
    pendingNextLevel = false;
  }
  showOverlay();
}

function nextLevel() {
  if (gridSize < MAX_GRID) {
    gridSize++;
  }
  level++;
  generatePuzzle();
  updateGridGeometry();
  gameState = 'playing';
  hideOverlay();
}

function startGame() {
  level = 1;
  score = 0;
  gridSize = MIN_GRID;
  generatePuzzle();
  updateGridGeometry();
  gameState = 'playing';
  hideOverlay();
  pendingNextLevel = false;
}

function pauseGame() {
  if (gameState !== 'playing') return;
  gameState = 'paused';
  overlayTitle.textContent = 'PAUSED';
  overlayMessage.textContent = 'Game paused. Press Resume to continue.';
  btnResume.style.display = 'inline-block';
  btnQuit.style.display = 'inline-block';
  btnStart.style.display = 'none';
  btnRetry.style.display = 'none';
  btnMainMenu.style.display = 'none';
  showOverlay();
}

function resumeGame() {
  if (gameState !== 'paused') return;
  gameState = 'playing';
  hideOverlay();
}

function quitToMenu() {
  gameState = 'start';
  showStartScreen();
}

function showStartScreen() {
  overlayTitle.textContent = 'NEON LIGHTS OUT';
  overlayMessage.textContent = 'Tap a cell to toggle it and its neighbors. Turn all lights off.';
  btnStart.style.display = 'inline-block';
  btnResume.style.display = 'none';
  btnQuit.style.display = 'none';
  btnRetry.style.display = 'none';
  btnMainMenu.style.display = 'none';
  showOverlay();
}

function showOverlay() {
  overlay.classList.add('visible');
}

function hideOverlay() {
  overlay.classList.remove('visible');
}

function updateUI() {
  levelDisplay.textContent = level;
  movesDisplay.textContent = `${moves}/${maxMoves}`;
  scoreDisplay.textContent = score;
}

// ===== RENDER LOOP =====
function gameLoop(timestamp) {
  if (!running) return;
  const dt = timestamp - lastTime;
  lastTime = timestamp;
  draw();
  animationId = requestAnimationFrame(gameLoop);
}

function draw() {
  ctx.fillStyle = COLORS.bg;
  ctx.fillRect(0, 0, width, height);
  
  // Grid lines
  ctx.strokeStyle = COLORS.gridLine;
  ctx.lineWidth = 1;
  for (let i = 0; i <= gridSize; i++) {
    const x = gridOriginX + i * cellSize;
    const y = gridOriginY + i * cellSize;
    ctx.beginPath();
    ctx.moveTo(x, gridOriginY);
    ctx.lineTo(x, gridOriginY + gridSize * cellSize);
    ctx.stroke();
    ctx.beginPath();
    ctx.moveTo(gridOriginX, y);
    ctx.lineTo(gridOriginX + gridSize * cellSize, y);
    ctx.stroke();
  }
  
  // Cells
  for (let y = 0; y < gridSize; y++) {
    for (let x = 0; x < gridSize; x++) {
      const cx = gridOriginX + x * cellSize;
      const cy = gridOriginY + y * cellSize;
      const padding = 2;
      const size = cellSize - padding * 2;
      
      if (grid[y][x] === 1) {
        const colorIndex = (x + y * gridSize) % COLORS.lightOn.length;
        const color = COLORS.lightOn[colorIndex];
        ctx.fillStyle = color;
        ctx.shadowColor = color;
        ctx.shadowBlur = 15;
        ctx.beginPath();
        ctx.roundRect(cx + padding, cy + padding, size, size, 4);
        ctx.fill();
        ctx.shadowBlur = 0;
      } else {
        ctx.fillStyle = COLORS.lightOff;
        ctx.beginPath();
        ctx.roundRect(cx + padding, cy + padding, size, size, 4);
        ctx.fill();
      }
    }
  }
  
  // Cursor
  if (gameState === 'playing') {
    const cx = gridOriginX + cursor.x * cellSize;
    const cy = gridOriginY + cursor.y * cellSize;
    const padding = 2;
    const size = cellSize - padding * 2;
    ctx.strokeStyle = COLORS.cursor;
    ctx.lineWidth = 3;
    ctx.shadowColor = COLORS.cursorGlow;
    ctx.shadowBlur = 10;
    ctx.beginPath();
    ctx.roundRect(cx + padding, cy + padding, size, size, 4);
    ctx.stroke();
    ctx.shadowBlur = 0;
  }
  
  // Move limit warning
  if (gameState === 'playing' && moves > maxMoves * 0.8) {
    ctx.fillStyle = 'rgba(255, 0, 0, 0.1)';
    ctx.fillRect(0, 0, width, height);
  }
}

// ===== START =====
init();
</script>
</body>
</html>