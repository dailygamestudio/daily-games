<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no">
<title>Neon Pinball - Day 27</title>
<style>
* { margin: 0; padding: 0; box-sizing: border-box; }
body {
    background: #0a0a12;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    font-family: 'Orbitron', 'Segoe UI', sans-serif;
    overflow: hidden;
    touch-action: none;
}
#gameContainer {
    position: relative;
    border-radius: 8px;
    box-shadow: 
        0 0 30px #00ffff88,
        0 0 60px #ff00ff44,
        inset 0 0 60px #000022,
        inset 0 0 2px #00ffff;
    background: linear-gradient(180deg, #050510 0%, #0a0a1a 100%);
}
canvas { display: block; border-radius: 6px; }
#ui {
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    pointer-events: none;
    display: flex;
    flex-direction: column;
    padding: 16px;
    color: #00ffff;
    text-shadow: 0 0 10px #00ffff, 0 0 20px #00ffff;
}
#topUI { display: flex; justify-content: space-between; align-items: flex-start; }
#bottomUI { margin-top: auto; display: flex; justify-content: space-between; align-items: flex-end; }
.statBox {
    background: linear-gradient(135deg, #001122 0%, #000811 100%);
    border: 1px solid #00ffff44;
    border-radius: 6px;
    padding: 8px 16px;
    min-width: 100px;
    text-align: center;
    box-shadow: 0 0 15px #00ffff22;
}
.statLabel { font-size: 10px; color: #00ffffaa; text-transform: uppercase; letter-spacing: 1px; }
.statValue { font-size: 20px; font-weight: 700; color: #00ffff; text-shadow: 0 0 10px #00ffff; }
#ballsStat .statValue { color: #ff00ff; text-shadow: 0 0 10px #ff00ff; }

.overlay {
    position: fixed;
    top: 0; left: 0; right: 0; bottom: 0;
    background: rgba(10, 10, 18, 0.95);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    z-index: 100;
    backdrop-filter: blur(8px);
    transition: opacity 0.3s ease;
}
.overlay.hidden { display: none; }
.overlay h1 { font-size: 48px; margin-bottom: 16px; text-shadow: 0 0 20px currentColor; }
.overlay p { font-size: 18px; margin: 8px 0; color: #00ffffaa; }
.btn {
    background: linear-gradient(135deg, #002244 0%, #001122 100%);
    border: 1px solid #00ffff66;
    color: #00ffff;
    padding: 14px 40px;
    margin: 12px;
    border-radius: 4px;
    font-family: inherit;
    font-size: 16px;
    text-transform: uppercase;
    letter-spacing: 2px;
    cursor: pointer;
    transition: all 0.2s ease;
    box-shadow: 0 0 15px #00ffff33;
}
.btn:hover, .btn:active { background: linear-gradient(135deg, #004488 0%, #002244 100%); box-shadow: 0 0 25px #00ffff66; transform: scale(1.05); }
.btn:active { transform: scale(0.98); }
#startScreen { z-index: 200; }
#startScreen h1 { color: #00ffff; }
#startScreen .btn { border-color: #00ffff; }
#pauseOverlay h1 { color: #ffaa00; }
#pauseOverlay .btn { border-color: #ffaa00; color: #ffaa00; }
#pauseOverlay .btn:hover { box-shadow: 0 0 25px #ffaa0066; }
#gameOverOverlay h1 { color: #ff3366; }
#gameOverOverlay .btn { border-color: #ff3366; color: #ff3366; }
#gameOverOverlay .btn:hover { box-shadow: 0 0 25px #ff336666; }
#highScoreMsg { font-size: 16px; min-height: 24px; }
.controlsHint {
    position: absolute;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    color: #00ffff66;
    font-size: 12px;
    text-align: center;
    pointer-events: none;
}
@media (max-width: 600px) {
    #gameContainer { width: 100vw; height: 100vh; border-radius: 0; }
    canvas { border-radius: 0; }
    .overlay h1 { font-size: 36px; }
    .btn { padding: 12px 30px; font-size: 14px; }
}
</style>
</head>
<body>
<div id="gameContainer">
    <canvas id="gameCanvas"></canvas>
    <div id="ui">
        <div id="topUI">
            <div class="statBox" id="scoreStat">
                <div class="statLabel">Score</div>
                <div class="statValue" id="scoreValue">0</div>
            </div>
            <div class="statBox" id="highScoreStat">
                <div class="statLabel">Best</div>
                <div class="statValue" id="highScoreValue">0</div>
            </div>
            <div class="statBox" id="ballsStat">
                <div class="statLabel">Balls</div>
                <div class="statValue" id="ballsValue">3</div>
            </div>
        </div>
        <div id="bottomUI">
            <div class="statBox">
                <div class="statLabel">Multiplier</div>
                <div class="statValue" id="multiplierValue">1x</div>
            </div>
        </div>
    </div>
    <div class="controlsHint" id="controlsHint">← / A : Left Flipper  |  → / D : Right Flipper  |  SPACE : Launch Ball  |  ESC : Pause</div>
</div>

<div class="overlay" id="startScreen">
    <h1>NEON PINBALL</h1>
    <p>Classic arcade action with cyberpunk style</p>
    <button class="btn" id="startBtn">START GAME</button>
    <p style="font-size: 12px; margin-top: 20px; color: #666;">Click or tap to play</p>
</div>

<div class="overlay hidden" id="pauseOverlay">
    <h1>PAUSED</h1>
    <p>Wave <span id="pauseWave">1</span> • Score <span id="pauseScore">0</span></p>
    <button class="btn" id="resumeBtn">RESUME</button>
    <button class="btn" id="quitBtn">QUIT TO MENU</button>
</div>

<div class="overlay hidden" id="gameOverOverlay">
    <h1 style="color: #ff3366;">GAME OVER</h1>
    <p>Final Score: <span id="finalScore" style="color: #00ffea;">0</span></p>
    <p id="highScoreMsg" style="color: #ffd700;"></p>
    <button class="btn" id="retryBtn">RETRY</button>
    <button class="btn" id="menuBtn">MAIN MENU</button>
</div>

<script>
// Game constants
const CANVAS_WIDTH = 400;
const CANVAS_HEIGHT = 700;
const GRAVITY = 0.4;
const FLIPPER_SPEED = 12;
const BALL_RADIUS = 8;
const LAUNCH_POWER = -18;

// Game state
const state = {
    running: false,
    paused: false,
    score: 0,
    highScore: parseInt(localStorage.getItem('neonPinballHighScore') || '0'),
    balls: 3,
    multiplier: 1,
    wave: 1,
    lastTime: 0
};

// Game objects
let ball = null;
let leftFlipper = null;
let rightFlipper = null;
let plunger = null;
let bumpers = [];
let walls = [];
let particles = [];
let keys = { left: false, right: false, launch: false };

// Touch controls
const touchControls = {
    left: false,
    right: false,
    launch: false,
    launchTouchId: null,
    leftTouchId: null,
    rightTouchId: null
};

// Canvas setup
const canvas = document.getElementById('gameCanvas');
const ctx = canvas.getContext('2d');
canvas.width = CANVAS_WIDTH;
canvas.height = CANVAS_HEIGHT;

// DOM elements
const scoreValue = document.getElementById('scoreValue');
const highScoreValue = document.getElementById('highScoreValue');
const ballsValue = document.getElementById('ballsValue');
const multiplierValue = document.getElementById('multiplierValue');
const pauseWave = document.getElementById('pauseWave');
const pauseScore = document.getElementById('pauseScore');
const finalScore = document.getElementById('finalScore');
const highScoreMsg = document.getElementById('highScoreMsg');
const controlsHint = document.getElementById('controlsHint');

// Initialize high score display
highScoreValue.textContent = state.highScore;

// Classes
class Vector {
    constructor(x, y) { this.x = x; this.y = y; }
    add(v) { return new Vector(this.x + v.x, this.y + v.y); }
    sub(v) { return new Vector(this.x - v.x, this.y - v.y); }
    mul(s) { return new Vector(this.x * s, this.y * s); }
    mag() { return Math.hypot(this.x, this.y); }
    normalize() { const m = this.mag(); return m ? this.mul(1/m) : new Vector(0,0); }
    dot(v) { return this.x * v.x + this.y * v.y; }
}

class Ball {
    constructor(x, y) {
        this.pos = new Vector(x, y);
        this.vel = new Vector(0, 0);
        this.radius = BALL_RADIUS;
        this.onPlunger = true;
        this.trail = [];
        this.maxTrail = 8;
    }
    update() {
        if (this.onPlunger) {
            this.pos.x = plunger.pos.x;
            this.pos.y = plunger.pos.y - this.radius - 2;
            return;
        }
        this.vel.y += GRAVITY;
        this.pos = this.pos.add(this.vel);
        
        // Trail
        this.trail.unshift({x: this.pos.x, y: this.pos.y});
        if (this.trail.length > this.maxTrail) this.trail.pop();
        
        // Wall collisions
        if (this.pos.x - this.radius < 0) { this.pos.x = this.radius; this.vel.x *= -0.8; }
        if (this.pos.x + this.radius > CANVAS_WIDTH) { this.pos.x = CANVAS_WIDTH - this.radius; this.vel.x *= -0.8; }
        if (this.pos.y - this.radius < 0) { this.pos.y = this.radius; this.vel.y *= -0.8; }
        
        // Bottom - lose ball
        if (this.pos.y - this.radius > CANVAS_HEIGHT) {
            this.loseBall();
        }
        
        // Flipper collisions
        this.checkFlipperCollision(leftFlipper);
        this.checkFlipperCollision(rightFlipper);
        
        // Bumper collisions
        bumpers.forEach(b => this.checkBumperCollision(b));
        
        // Wall collisions (slanted walls)
        walls.forEach(w => this.checkWallCollision(w));
    }
    checkFlipperCollision(flipper) {
        if (!flipper.active) return;
        const flipperTip = flipper.getTipPosition();
        const dx = this.pos.x - flipperTip.x;
        const dy = this.pos.y - flipperTip.y;
        const dist = Math.hypot(dx, dy);
        if (dist < this.radius + 10) {
            const angle = flipper.angle + (flipper.side === 'left' ? Math.PI/2 : -Math.PI/2);
            const normal = new Vector(Math.cos(angle), Math.sin(angle));
            const relVel = this.vel.dot(normal);
            if (relVel < 0) {
                this.vel = this.vel.sub(normal.mul(relVel * 1.5));
                this.vel = this.vel.add(normal.mul(FLIPPER_SPEED));
                this.addScore(100);
                this.createParticles(flipperTip.x, flipperTip.y, '#00ffff');
            }
        }
    }
    checkBumperCollision(bumper) {
        const dx = this.pos.x - bumper.x;
        const dy = this.pos.y - bumper.y;
        const dist = Math.hypot(dx, dy);
        if (dist < this.radius + bumper.radius) {
            const normal = new Vector(dx, dy).normalize();
            this.vel = this.vel.sub(normal.mul(2 * this.vel.dot(normal)));
            this.vel = this.vel.add(normal.mul(8));
            bumper.hit = true;
            bumper.hitTimer = 10;
            this.addScore(500 * state.multiplier);
            this.createParticles(bumper.x, bumper.y, bumper.color);
        }
    }
    checkWallCollision(wall) {
        const {x1, y1, x2, y2} = wall;
        const dx = x2 - x1;
        const dy = y2 - y1;
        const len = Math.hypot(dx, dy);
        const nx = -dy / len;
        const ny = dx / len;
        
        const vx = this.pos.x - x1;
        const vy = this.pos.y - y1;
        const proj = vx * nx + vy * ny;
        
        if (proj < this.radius && proj > -this.radius) {
            const tx = x1 + dx * ((vx * dx + vy * dy) / (len * len));
            const ty = y1 + dy * ((vx * dx + vy * dy) / (len * len));
            const tdx = this.pos.x - tx;
            const tdy = this.pos.y - ty;
            const tdist = Math.hypot(tdx, tdy);
            if (tdist < this.radius) {
                const normal = new Vector(nx, ny);
                this.vel = this.vel.sub(normal.mul(2 * this.vel.dot(normal)));
                this.vel = this.vel.add(normal.mul(2));
            }
        }
    }
    launch(power) {
        this.onPlunger = false;
        this.vel = new Vector((Math.random() - 0.5) * 3, power);
    }
    loseBall() {
        state.balls--;
        ballsValue.textContent = state.balls;
        if (state.balls <= 0) {
            gameOver();
        } else {
            resetBall();
        }
    }
    resetBall() {
        this.pos = new Vector(CANVAS_WIDTH / 2, CANVAS_HEIGHT - 100);
        this.vel = new Vector(0, 0);
        this.onPlunger = true;
        this.trail = [];
    }
    addScore(points) {
        state.score += points;
        scoreValue.textContent = state.score;
        if (state.score > state.highScore) {
            state.highScore = state.score;
            highScoreValue.textContent = state.highScore;
            localStorage.setItem('neonPinballHighScore', state.highScore);
        }
        // Increase multiplier every 10000 points
        const newMultiplier = Math.floor(state.score / 10000) + 1;
        if (newMultiplier > state.multiplier) {
            state.multiplier = newMultiplier;
            multiplierValue.textContent = state.multiplier + 'x';
        }
    }
    createParticles(x, y, color) {
        for (let i = 0; i < 8; i++) {
            const angle = Math.random() * Math.PI * 2;
            const speed = Math.random() * 5 + 2;
            particles.push({
                x, y,
                vx: Math.cos(angle) * speed,
                vy: Math.sin(angle) * speed,
                life: 30,
                maxLife: 30,
                color,
                size: Math.random() * 3 + 2
            });
        }
    }
    draw() {
        // Trail
        this.trail.forEach((p, i) => {
            const alpha = (1 - i / this.maxTrail) * 0.5;
            ctx.beginPath();
            ctx.arc(p.x, p.y, this.radius * (1 - i / this.maxTrail), 0, Math.PI * 2);
            ctx.fillStyle = `rgba(0, 255, 255, ${alpha})`;
            ctx.shadowColor = '#00ffff';
            ctx.shadowBlur = 10;
            ctx.fill();
        });
        
        // Ball
        ctx.beginPath();
        ctx.arc(this.pos.x, this.pos.y, this.radius, 0, Math.PI * 2);
        const gradient = ctx.createRadialGradient(
            this.pos.x - 2, this.pos.y - 2, 0,
            this.pos.x, this.pos.y, this.radius
        );
        gradient.addColorStop(0, '#ffffff');
        gradient.addColorStop(0.5, '#00ffff');
        gradient.addColorStop(1, '#0088ff');
        ctx.fillStyle = gradient;
        ctx.shadowColor = '#00ffff';
        ctx.shadowBlur = 20;
        ctx.fill();
        ctx.shadowBlur = 0;
        
        // Plunger indicator
        if (this.onPlunger) {
            ctx.strokeStyle = '#ff00ff';
            ctx.lineWidth = 2;
            ctx.setLineDash([5, 5]);
            ctx.beginPath();
            ctx.moveTo(this.pos.x, this.pos.y + this.radius);
            ctx.lineTo(this.pos.x, CANVAS_HEIGHT - 50);
            ctx.stroke();
            ctx.setLineDash([]);
        }
    }
}

class Flipper {
    constructor(x, y, side) {
        this.base = new Vector(x, y);
        this.side = side;
        this.length = 60;
        this.width = 14;
        this.angle = side === 'left' ? -0.5 : 0.5;
        this.targetAngle = this.angle;
        this.active = false;
        this.angularVel = 0;
    }
    update() {
        const target = this.active ? (this.side === 'left' ? -1.2 : 1.2) : (this.side === 'left' ? -0.5 : 0.5);
        const diff = target - this.angle;
        this.angularVel = diff * 0.3;
        this.angle += this.angularVel;
        if (Math.abs(this.angle - target) < 0.01) {
            this.angle = target;
            this.active = false;
        }
    }
    getTipPosition() {
        return new Vector(
            this.base.x + Math.cos(this.angle) * this.length,
            this.base.y + Math.sin(this.angle) * this.length
        );
    }
    draw() {
        const tip = this.getTipPosition();
        ctx.beginPath();
        ctx.moveTo(this.base.x, this.base.y);
        ctx.lineTo(tip.x, tip.y);
        ctx.lineWidth = this.width;
        ctx.lineCap = 'round';
        const gradient = ctx.createLinearGradient(this.base.x, this.base.y, tip.x, tip.y);
        gradient.addColorStop(0, '#ff00ff');
        gradient.addColorStop(1, '#00ffff');
        ctx.strokeStyle = gradient;
        ctx.shadowColor = '#ff00ff';
        ctx.shadowBlur = 15;
        ctx.stroke();
        ctx.shadowBlur = 0;
        
        // Base
        ctx.beginPath();
        ctx.arc(this.base.x, this.base.y, this.width/2, 0, Math.PI * 2);
        ctx.fillStyle = '#003366';
        ctx.fill();
    }
}

class Plunger {
    constructor(x, y) {
        this.pos = new Vector(x, y);
        this.power = 0;
        this.charging = false;
        this.maxPower = 22;
    }
    update() {
        if (this.charging && this.power < this.maxPower) {
            this.power += 0.5;
        }
    }
    release() {
        const power = this.power;
        this.power = 0;
        this.charging = false;
        return power;
    }
    draw() {
        // Plunger rod
        ctx.strokeStyle = '#ff00ff';
        ctx.lineWidth = 6;
        ctx.lineCap = 'round';
        ctx.shadowColor = '#ff00ff';
        ctx.shadowBlur = 10;
        ctx.beginPath();
        ctx.moveTo(this.pos.x, this.pos.y);
        ctx.lineTo(this.pos.x, this.pos.y + 80 - this.power * 2);
        ctx.stroke();
        ctx.shadowBlur = 0;
        
        // Power meter
        if (this.charging || this.power > 0) {
            const meterX = this.pos.x + 30;
            const meterY = this.pos.y - 20;
            ctx.fillStyle = '#001122';
            ctx.fillRect(meterX, meterY, 20, 100);
            ctx.fillStyle = `hsl(${300 - this.power/this.maxPower*300}, 100%, 50%)`;
            ctx.fillRect(meterX, meterY + 100 - this.power/this.maxPower*100, 20, this.power/this.maxPower*100);
            ctx.strokeStyle = '#00ffff';
            ctx.strokeRect(meterX, meterY, 20, 100);
        }
    }
}

class Bumper {
    constructor(x, y, radius, color) {
        this.x = x;
        this.y = y;
        this.radius = radius;
        this.color = color;
        this.hit = false;
        this.hitTimer = 0;
    }
    update() {
        if (this.hitTimer > 0) this.hitTimer--;
        else this.hit = false;
    }
    draw() {
        ctx.beginPath();
        ctx.arc(this.x, this.y, this.radius, 0, Math.PI * 2);
        const gradient = ctx.createRadialGradient(this.x, this.y, 0, this.x, this.y, this.radius);
        if (this.hit) {
            gradient.addColorStop(0, '#ffffff');
            gradient.addColorStop(0.5, this.color);
            gradient.addColorStop(1, '#000000');
        } else {
            gradient.addColorStop(0, this.color);
            gradient.addColorStop(1, '#000000');
        }
        ctx.fillStyle = gradient;
        ctx.shadowColor = this.color;
        ctx.shadowBlur = this.hit ? 30 : 15;
        ctx.fill();
        ctx.shadowBlur = 0;
        
        // Ring
        ctx.strokeStyle = '#00ffff';
        ctx.lineWidth = 2;
        ctx.stroke();
    }
}

// Initialize game objects
function initGameObjects() {
    ball = new Ball(CANVAS_WIDTH / 2, CANVAS_HEIGHT - 100);
    leftFlipper = new Flipper(80, CANVAS_HEIGHT - 80, 'left');
    rightFlipper = new Flipper(CANVAS_WIDTH - 80, CANVAS_HEIGHT - 80, 'right');
    plunger = new Plunger(CANVAS_WIDTH - 40, CANVAS_HEIGHT - 50);
    
    bumpers = [
        new Bumper(CANVAS_WIDTH * 0.3, CANVAS_HEIGHT * 0.3, 25, '#ff00ff'),
        new Bumper(CANVAS_WIDTH * 0.7, CANVAS_HEIGHT * 0.3, 25, '#00ffff'),
        new Bumper(CANVAS_WIDTH * 0.5, CANVAS_HEIGHT * 0.5, 20, '#ffff00'),
        new Bumper(CANVAS_WIDTH * 0.2, CANVAS_HEIGHT * 0.6, 18, '#ff6600'),
        new Bumper(CANVAS_WIDTH * 0.8, CANVAS_HEIGHT * 0.6, 18, '#6600ff')
    ];
    
    walls = [
        {x1: 0, y1: CANVAS_HEIGHT * 0.8, x2: 60, y2: CANVAS_HEIGHT - 80},
        {x1: CANVAS_WIDTH, y1: CANVAS_HEIGHT * 0.8, x2: CANVAS_WIDTH - 60, y2: CANVAS_HEIGHT - 80},
        {x1: 0, y1: 0, x2: 0, y2: CANVAS_HEIGHT},
        {x1: CANVAS_WIDTH, y1: 0, x2: CANVAS_WIDTH, y2: CANVAS_HEIGHT}
    ];
    
    particles = [];
}

function resetBall() {
    ball.resetBall();
    plunger.power = 0;
    plunger.charging = false;
}

// Game loop
function gameLoop(timestamp) {
    if (!state.running) return;
    
    const dt = timestamp - state.lastTime;
    state.lastTime = timestamp;
    
    update();
    draw();
    
    requestAnimationFrame(gameLoop);
}

function update() {
    if (state.paused) return;
    
    // Input handling - keyboard
    if (keys.left) leftFlipper.active = true;
    if (keys.right) rightFlipper.active = true;
    if (keys.launch && ball.onPlunger) {
        plunger.charging = true;
    }
    if (!keys.launch && plunger.charging) {
        const power = plunger.release();
        ball.launch(power);
    }
    
    // Touch controls
    if (touchControls.left) leftFlipper.active = true;
    if (touchControls.right) rightFlipper.active = true;
    if (touchControls.launch && ball.onPlunger) {
        plunger.charging = true;
    }
    if (!touchControls.launch && plunger.charging) {
        const power = plunger.release();
        ball.launch(power);
    }
    
    // Update objects
    ball.update();
    leftFlipper.update();
    rightFlipper.update();
    plunger.update();
    bumpers.forEach(b => b.update());
    
    // Update particles
    for (let i = particles.length - 1; i >= 0; i--) {
        const p = particles[i];
        p.x += p.vx;
        p.y += p.vy;
        p.vy += 0.1; // gravity
        p.life--;
        if (p.life <= 0) particles.splice(i, 1);
    }
}

function draw() {
    // Clear canvas
    ctx.fillStyle = '#050510';
    ctx.fillRect(0, 0, CANVAS_WIDTH, CANVAS_HEIGHT);
    
    // Draw grid background
    ctx.strokeStyle = '#00ffff11';
    ctx.lineWidth = 1;
    for (let x = 0; x <= CANVAS_WIDTH; x += 40) {
        ctx.beginPath();
        ctx.moveTo(x, 0);
        ctx.lineTo(x, CANVAS_HEIGHT);
        ctx.stroke();
    }
    for (let y = 0; y <= CANVAS_HEIGHT; y += 40) {
        ctx.beginPath();
        ctx.moveTo(0, y);
        ctx.lineTo(CANVAS_WIDTH, y);
        ctx.stroke();
    }
    
    // Draw walls
    ctx.strokeStyle = '#00ffff44';
    ctx.lineWidth = 4;
    ctx.lineCap = 'round';
    walls.forEach(w => {
        ctx.beginPath();
        ctx.moveTo(w.x1, w.y1);
        ctx.lineTo(w.x2, w.y2);
        ctx.stroke();
    });
    
    // Draw bumpers
    bumpers.forEach(b => b.draw());
    
    // Draw flippers
    leftFlipper.draw();
    rightFlipper.draw();
    
    // Draw plunger
    plunger.draw();
    
    // Draw particles
    particles.forEach(p => {
        const alpha = p.life / p.maxLife;
        ctx.beginPath();
        ctx.arc(p.x, p.y, p.size * alpha, 0, Math.PI * 2);
        ctx.fillStyle = p.color.replace(')', `, ${alpha})`).replace('rgb', 'rgba').replace('#', '');
        // Simple color with alpha
        ctx.fillStyle = `rgba(${parseInt(p.color.slice(1,3),16)}, ${parseInt(p.color.slice(3,5),16)}, ${parseInt(p.color.slice(5,7),16)}, ${alpha})`;
        ctx.shadowColor = p.color;
        ctx.shadowBlur = 10;
        ctx.fill();
    });
    ctx.shadowBlur = 0;
    
    // Draw ball
    ball.draw();
}

// Game control functions
function startGame() {
    state.running = true;
    state.paused = false;
    state.score = 0;
    state.balls = 3;
    state.multiplier = 1;
    state.wave = 1;
    state.lastTime = performance.now();
    
    scoreValue.textContent = '0';
    ballsValue.textContent = '3';
    multiplierValue.textContent = '1x';
    
    initGameObjects();
    
    document.getElementById('startScreen').classList.add('hidden');
    document.getElementById('pauseOverlay').classList.add('hidden');
    document.getElementById('gameOverOverlay').classList.add('hidden');
    
    requestAnimationFrame(gameLoop);
}

function pauseGame() {
    if (!state.running || state.paused) return;
    state.paused = true;
    pauseWave.textContent = state.wave;
    pauseScore.textContent = state.score;
    document.getElementById('pauseOverlay').classList.remove('hidden');
}

function resumeGame() {
    if (!state.running || !state.paused) return;
    state.paused = false;
    state.lastTime = performance.now();
    document.getElementById('pauseOverlay').classList.add('hidden');
    requestAnimationFrame(gameLoop);
}

function quitToMenu() {
    state.running = false;
    state.paused = false;
    document.getElementById('pauseOverlay').classList.add('hidden');
    document.getElementById('startScreen').classList.remove('hidden');
}

function gameOver() {
    state.running = false;
    finalScore.textContent = state.score;
    if (state.score >= state.highScore) {
        highScoreMsg.textContent = 'NEW HIGH SCORE!';
    } else {
        highScoreMsg.textContent = `Best: ${state.highScore}`;
    }
    document.getElementById('gameOverOverlay').classList.remove('hidden');
}

function showStartScreen() {
    state.running = false;
    state.paused = false;
    document.getElementById('gameOverOverlay').classList.add('hidden');
    document.getElementById('startScreen').classList.remove('hidden');
}

function retryGame() {
    startGame();
}

