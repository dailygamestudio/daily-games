<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Neon Dash - Day 28</title>
<style>
* { margin: 0; padding: 0; box-sizing: border-box; }
body { background: #0a0a0f; font-family: 'Courier New', monospace; color: #0ff; overflow: hidden; touch-action: none; }
canvas { display: block; }
#ui { position: fixed; top: 10px; left: 50%; transform: translateX(-50%); display: flex; gap: 30px; z-index: 10; pointer-events: none; }
.stat { text-align: center; text-shadow: 0 0 10px #0ff; }
.stat-label { font-size: 11px; color: #666; text-transform: uppercase; letter-spacing: 1px; }
.stat-value { font-size: 24px; font-weight: bold; }
#highscore { color: #f0f; text-shadow: 0 0 10px #f0f; }
#message { position: fixed; top: 50%; left: 50%; transform: translate(-50%, -50%); text-align: center; pointer-events: none; z-index: 20; }
#message h1 { font-size: 48px; text-shadow: 0 0 20px #0ff, 0 0 40px #0ff; margin-bottom: 10px; }
#message p { color: #888; font-size: 14px; margin-bottom: 20px; }
#message button { background: #111; border: 2px solid #0ff; color: #0ff; padding: 12px 32px; font-size: 16px; font-family: inherit; cursor: pointer; border-radius: 4px; transition: all 0.2s; text-shadow: 0 0 10px #0ff; }
#message button:hover { background: #0a0a1a; box-shadow: 0 0 20px rgba(0,255,255,0.3); }
.hidden { display: none !important; }
@media (max-width: 600px) {
  #message h1 { font-size: 32px; }
  .stat-value { font-size: 18px; }
  #ui { gap: 15px; }
}

.overlay {
    position: fixed;
    top: 0; left: 0; right: 0; bottom: 0;
    background: rgba(0,0,0,0.95);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    z-index: 100;
    gap: 20px;
    padding: 20px;
}
.overlay.hidden { display: none; }
.overlay h1 { font-size: clamp(32px, 8vw, 64px); text-shadow: 0 0 30px #00ffea; letter-spacing: 4px; }
.overlay p { color: #00ffea88; font-size: 14px; text-align: center; max-width: 400px; line-height: 1.6; }
.btn {
    padding: 12px 32px;
    font-size: 16px;
    font-family: 'Courier New', monospace;
    background: transparent;
    color: #00ffea;
    border: 2px solid #00ffea;
    border-radius: 4px;
    cursor: pointer;
    transition: all 0.2s;
}
.btn:hover { background: #00ffea; color: #0a0a0f; box-shadow: 0 0 20px #00ffea; }
.mobile-hint { color: #ff6b00; font-size: 12px; }
</style>
</head>
<body>
<div id="ui">
  <div class="stat">
    <div class="stat-label">Score</div>
    <div class="stat-value" id="score">0</div>
  </div>
  <div class="stat">
    <div class="stat-label">High Score</div>
    <div class="stat-value" id="highscore">0</div>
  </div>
  <div class="stat">
    <div class="stat-label">Speed</div>
    <div class="stat-value" id="speed">1.0x</div>
  </div>
</div>
<div id="message" class="hidden">
  <h1>NEON DASH</h1>
  <p>Tap / Click / Space to jump<br>Dodge the neon obstacles</p>
  <button id="startBtn">START</button>
</div>
<canvas id="canvas"></canvas>

<div class="overlay hidden" id="pauseOverlay">
    <h1>PAUSED</h1>
    <p>Wave <span id="pauseWave">1</span> • Score <span id="pauseScore">0</span></p>
    <button class="btn" id="resumeBtn">RESUME</button>
    <button class="btn" id="quitBtn">QUIT TO MENU</button>
</div>

<div class="overlay hidden" id="gameOverOverlay">
    <h1 style="color: #ff3366;">GAME OVER</h1>
    <p>Final Score: <span id="finalScore" style="color: #00ffea;">0</span></p>
    <p id="highScoreMsg" style="color: #ffd700;"></p>
    <button class="btn" id="retryBtn">RETRY</button>
    <button class="btn" id="menuBtn">MAIN MENU</button>
</div>

<script>
const canvas = document.getElementById('canvas');
const ctx = canvas.getContext('2d');
const scoreEl = document.getElementById('score');
const highscoreEl = document.getElementById('highscore');
const speedEl = document.getElementById('speed');
const messageEl = document.getElementById('message');
const startBtn = document.getElementById('startBtn');
const pauseOverlay = document.getElementById('pauseOverlay');
const gameOverOverlay = document.getElementById('gameOverOverlay');
const resumeBtn = document.getElementById('resumeBtn');
const quitBtn = document.getElementById('quitBtn');
const retryBtn = document.getElementById('retryBtn');
const menuBtn = document.getElementById('menuBtn');
const pauseWaveEl = document.getElementById('pauseWave');
const pauseScoreEl = document.getElementById('pauseScore');
const finalScoreEl = document.getElementById('finalScore');
const highScoreMsgEl = document.getElementById('highScoreMsg');

let width = 0, height = 0, dpr = 1;
let running = false;
let score = 0;
let highScore = parseInt(localStorage.getItem('neonDashHighScore') || '0', 10);
let gameSpeed = 1;
let frames = 0;
let animationId = null;

const player = { x: 0, y: 0, w: 40, h: 40, vy: 0, grounded: false, color: '#0ff', glow: '#0ff' };
const obstacles = [];
const particles = [];
const bgStars = [];

const GRAVITY = 0.6;
const JUMP_FORCE = -14;
const BASE_SPEED = 5;
const OBSTACLE_SPAWN_RATE = 120;
const SPEED_INCREASE_INTERVAL = 3000;

highscoreEl.textContent = highScore;

function resize() {
  try {
    dpr = window.devicePixelRatio || 1;
    width = window.innerWidth;
    height = window.innerHeight;
    canvas.width = width * dpr;
    canvas.height = height * dpr;
    canvas.style.width = width + 'px';
    canvas.style.height = height + 'px';
    ctx.setTransform(1, 0, 0, 1, 0, 0);
    ctx.scale(dpr, dpr);
    
    player.x = 60;
    player.y = height - 80 - player.h;
    
    bgStars.length = 0;
    for (let i = 0; i < 80; i++) {
      bgStars.push({
        x: Math.random() * width,
        y: Math.random() * height,
        size: Math.random() * 2 + 0.5,
        speed: Math.random() * 0.5 + 0.1,
        hue: Math.random() * 60 + 180
      });
    }
  } catch (e) {
    console.error('Resize error:', e);
  }
}
window.addEventListener('resize', resize);

function spawnObstacle() {
  const types = ['block', 'spike', 'wall'];
  const type = types[Math.floor(Math.random() * types.length)];
  let h, w, y;
  
  if (type === 'block') {
    w = 40 + Math.random() * 40;
    h = 40 + Math.random() * 60;
    y = height - 80 - h;
  } else if (type === 'spike') {
    w = 30;
    h = 50;
    y = height - 80 - h;
  } else {
    w = 20;
    h = height - 80;
    y = 80;
  }
  
  obstacles.push({
    x: width + w,
    y: y,
    w: w,
    h: h,
    type: type,
    hue: 180 + Math.random() * 60,
    passed: false
  });
}

function createParticles(x, y, color, count) {
  for (let i = 0; i < count; i++) {
    particles.push({
      x: x,
      y: y,
      vx: (Math.random() - 0.5) * 8,
      vy: (Math.random() - 0.5) * 8 - 2,
      size: Math.random() * 4 + 2,
      life: 1,
      decay: 0.02 + Math.random() * 0.03,
      color: color
    });
  }
}

function jump() {
  if (player.grounded && running) {
    player.vy = JUMP_FORCE;
    player.grounded = false;
    createParticles(player.x + player.w/2, player.y + player.h, player.glow, 8);
  }
}

function cancelAnimation() {
  if (animationId !== null) {
    cancelAnimationFrame(animationId);
    animationId = null;
  }
}

function startGame() {
  cancelAnimation();
  running = true;
  score = 0;
  gameSpeed = 1;
  frames = 0;
  obstacles.length = 0;
  particles.length = 0;
  player.y = height - 80 - player.h;
  player.vy = 0;
  player.grounded = true;
  scoreEl.textContent = '0';
  speedEl.textContent = '1.0x';
  messageEl.classList.add('hidden');
  pauseOverlay.classList.add('hidden');
  gameOverOverlay.classList.add('hidden');
  gameLoop();
}

function gameOver() {
  running = false;
  cancelAnimation();
  if (score > highScore) {
    highScore = score;
    localStorage.setItem('neonDashHighScore', highScore.toString());
    highscoreEl.textContent = highScore;
    highScoreMsgEl.textContent = 'NEW HIGH SCORE!';
  } else {
    highScoreMsgEl.textContent = 'High Score: ' + highScore;
  }
  finalScoreEl.textContent = score;
  gameOverOverlay.classList.remove('hidden');
  pauseOverlay.classList.add('hidden');
  createParticles(player.x + player.w/2, player.y + player.h/2, '#f00', 30);
}

function pauseGame() {
  if (!running) return;
  running = false;
  cancelAnimation();
  pauseWaveEl.textContent = Math.floor(score / 10) + 1;
  pauseScoreEl.textContent = score;
  pauseOverlay.classList.remove('hidden');
}

function resumeGame() {
  if (running) return;
  running = true;
  pauseOverlay.classList.add('hidden');
  gameLoop();
}

function quitToMenu() {
  running = false;
  cancelAnimation();
  pauseOverlay.classList.add('hidden');
  gameOverOverlay.classList.add('hidden');
  showStartScreen();
}

function showStartScreen() {
  running = false;
  cancelAnimation();
  messageEl.classList.remove('hidden');
  pauseOverlay.classList.add('hidden');
  gameOverOverlay.classList.add('hidden');
}

function update() {
  if (!running) return;
  
  frames++;
  
  if (frames % SPEED_INCREASE_INTERVAL === 0) {
    gameSpeed += 0.15;
    speedEl.textContent = gameSpeed.toFixed(1) + 'x';
  }
  
  player.vy += GRAVITY;
  player.y += player.vy;
  
  const groundY = height - 80 - player.h;
  if (player.y >= groundY) {
    player.y = groundY;
    player.vy = 0;
    if (!player.grounded) {
      createParticles(player.x + player.w/2, player.y + player.h, player.glow, 4);
    }
    player.grounded = true;
  }
  
  const spawnInterval = Math.max(30, OBSTACLE_SPAWN_RATE - gameSpeed * 10);
  if (frames % spawnInterval === 0) {
    spawnObstacle();
  }
  
  for (let i = obstacles.length - 1; i >= 0; i--) {
    const obs = obstacles[i];
    obs.x -= BASE_SPEED * gameSpeed;
    
    if (player.x < obs.x + obs.w &&
        player.x + player.w > obs.x &&
        player.y < obs.y + obs.h &&
        player.y + player.h > obs.y) {
      gameOver();
      return;
    }
    
    if (!obs.passed && obs.x + obs.w < player.x) {
      obs.passed = true;
      score++;
      scoreEl.textContent = score;
      createParticles(obs.x, obs.y + obs.h/2, 'hsl(' + obs.hue + ', 100%, 50%)', 6);
    }
    
    if (obs.x + obs.w < 0) {
      obstacles.splice(i, 1);
    }
  }
  
  for (let i = particles.length - 1; i >= 0; i--) {
    const p = particles[i];
    p.x += p.vx;
    p.y += p.vy;
    p.vy += 0.15;
    p.life -= p.decay;
    if (p.life <= 0) particles.splice(i, 1);
  }
  
  for (const star of bgStars) {
    star.x -= star.speed * gameSpeed;
    if (star.x < 0) star.x = width;
  }
}

function draw() {
  try {
    ctx.fillStyle = '#050508';
    ctx.fillRect(0, 0, width, height);
    
    ctx.strokeStyle = 'rgba(0, 255, 255, 0.03)';
    ctx.lineWidth = 1;
    const gridSize = 40;
    const offset = (frames * BASE_SPEED * gameSpeed) % gridSize;
    for (let x = -offset; x < width; x += gridSize) {
      ctx.beginPath();
      ctx.moveTo(x, 0);
      ctx.lineTo(x, height);
      ctx.stroke();
    }
    for (let y = 0; y < height; y += gridSize) {
      ctx.beginPath();
      ctx.moveTo(0, y);
      ctx.lineTo(width, y);
      ctx.stroke();
    }
    
    for (const star of bgStars) {
      ctx.fillStyle = 'hsla(' + star.hue + ', 100%, 50%, ' + (0.3 + Math.sin(frames * 0.05 + star.x) * 0.2) + ')';
      ctx.beginPath();
      ctx.arc(star.x, star.y, star.size, 0, Math.PI * 2);
      ctx.fill();
    }
    
    const groundY = height - 80;
    const gradient = ctx.createLinearGradient(0, groundY, 0, height);
    gradient.addColorStop(0, '#111');
    gradient.addColorStop(1, '#0a0a0f');
    ctx.fillStyle = gradient;
    ctx.fillRect(0, groundY, width, 80);
    
    ctx.strokeStyle = '#0ff';
    ctx.lineWidth = 3;
    ctx.shadowColor = '#0ff';
    ctx.shadowBlur = 15;
    ctx.beginPath();
    ctx.moveTo(0, groundY);
    ctx.lineTo(width, groundY);
    ctx.stroke();
    ctx.shadowBlur = 0;
    
    ctx.strokeStyle = 'rgba(0, 255, 255, 0.1)';
    ctx.lineWidth = 1;
    for (let x = -offset % 20; x < width; x += 20) {
      ctx.beginPath();
      ctx.moveTo(x, groundY);
      ctx.lineTo(x, height);
      ctx.stroke();
    }
    
    for (const obs of obstacles) {
      const obsGradient = ctx.createLinearGradient(obs.x, obs.y, obs.x + obs.w, obs.y + obs.h);
      obsGradient.addColorStop(0, 'hsl(' + obs.hue + ', 100%, 60%)');
      obsGradient.addColorStop(1, 'hsl(' + obs.hue + ', 100%, 30%)');
      ctx.fillStyle = obsGradient;
      
      ctx.shadowColor = 'hsl(' + obs.hue + ', 100%, 50%)';
      ctx.shadowBlur = 15;
      
      if (obs.type === 'block') {
        ctx.fillRect(obs.x, obs.y, obs.w, obs.h);
        ctx.strokeStyle = 'hsl(' + obs.hue + ', 100%, 70%)';
        ctx.lineWidth = 2;
        ctx.strokeRect(obs.x, obs.y, obs.w, obs.h);
      } else if (obs.type === 'spike') {
        ctx.beginPath();
        ctx.moveTo(obs.x, obs.y + obs.h);
        ctx.lineTo(obs.x + obs.w/2, obs.y);
        ctx.lineTo(obs.x + obs.w, obs.y + obs.h);
        ctx.closePath();
        ctx.fill();
        ctx.stroke();
      } else {
        ctx.fillRect(obs.x, obs.y, obs.w, obs.h);
        ctx.strokeStyle = 'hsl(' + obs.hue + ', 100%, 70%)';
        ctx.lineWidth = 1;
        for (let i = 1; i < 4; i++) {
          const lx = obs.x + obs.w * i / 4;
          ctx.beginPath();
          ctx.moveTo(lx, obs.y);
          ctx.lineTo(lx, obs.y + obs.h);
          ctx.stroke();
        }
      }
      ctx.shadowBlur = 0;
    }
    
    const playerGradient = ctx.createLinearGradient(player.x, player.y, player.x, player.y + player.h);
    playerGradient.addColorStop(0, player.color);
    playerGradient.addColorStop(1, '#088');
    ctx.fillStyle = playerGradient;
    ctx.shadowColor = player.glow;
    ctx.shadowBlur = 20;
    ctx.fillRect(player.x, player.y, player.w, player.h);
    ctx.shadowBlur = 0;
    
    ctx.strokeStyle = player.glow;
    ctx.lineWidth = 2;
    ctx.strokeRect(player.x, player.y, player.w, player.h);
    
    ctx.fillStyle = '#fff';
    ctx.shadowColor = '#fff';
    ctx.shadowBlur = 10;
    ctx.fillRect(player.x + 8, player.y + 8, player.w - 16, player.h - 16);
    ctx.shadowBlur = 0;
    
    for (const p of particles) {
      ctx.globalAlpha = p.life;
      ctx.fillStyle = p.color;
      ctx.shadowColor = p.color;
      ctx.shadowBlur = 10;
      ctx.beginPath();
      ctx.arc(p.x, p.y, p.size * p.life, 0, Math.PI * 2);
      ctx.fill();
      ctx.shadowBlur = 0;
    }
    ctx.globalAlpha = 1;
    
    if (gameSpeed > 2) {
      ctx.strokeStyle = 'rgba(0, 255, 255, 0.1)';
      ctx.lineWidth = 2;
      for (let i = 0; i < 5; i++) {
        const x = (frames * 20 + i * 150) % width;
        ctx.beginPath();
        ctx.moveTo(x, 0);
        ctx.lineTo(x, height);
        ctx.stroke();
      }
    }
  } catch (e) {
    console.error('Draw error:', e);
  }
}

function gameLoop() {
  if (!running) return;
  try {
    update();
    draw();
  } catch (e) {
    console.error('Game loop error:', e);
    gameOver();
    return;
  }
  animationId = requestAnimationFrame(gameLoop);
}

// Event listeners
startBtn.addEventListener('click', startGame);
resumeBtn.addEventListener('click', resumeGame);
quitBtn.addEventListener('click', quitToMenu);
retryBtn.addEventListener('click', startGame);
menuBtn.addEventListener('click', showStartScreen);

document.addEventListener('keydown', (e) => {
  if (e.code === 'Space' || e.code === 'ArrowUp' || e.code === 'KeyW') {
    e.preventDefault();
    jump();
  }
  if (e.code === 'Escape' || e.code === 'KeyP') {
    e.preventDefault();
    if (running) pauseGame();
    else if (!pauseOverlay.classList.contains('hidden')) resumeGame();
  }
}, { passive: false });

canvas.addEventListener('click', (e) => {
  if (running) jump();
}, { passive: false });

canvas.addEventListener('touchstart', (e) => {
  e.preventDefault();
  if (running) jump();
}, { passive: false });

// Prevent context menu on long press
canvas.addEventListener('contextmenu', (e) => e.preventDefault());

// Handle page visibility change
document.addEventListener('visibilitychange', () => {
  if (document.hidden && running) {
    pauseGame();
  }
});

// Initialize
resize();
showStartScreen();
</script>
</body>
</html>