<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no">
<title>Neon Swing - Day 30</title>
<style>
:root { --bg:#0a0a12; --fg:#e0e0ff; --accent:#00ffea; --accent2:#ff00c8; --warn:#ffcc00; }
*{margin:0;padding:0;box-sizing:border-box}
body{background:var(--bg);color:var(--fg);font-family:'Orbitron',sans-serif;min-height:100vh;display:flex;flex-direction:column;align-items:center;overflow:hidden}
@import url('https://fonts.googleapis.com/css2?family=Orbitron:wght@400;700;900&display=swap');
canvas{display:block;background:radial-gradient(ellipse at center,#1a1a2e 0%,#0a0a12 70%);box-shadow:0 0 60px rgba(0,255,234,0.15),inset 0 0 60px rgba(0,0,0,0.5);border:2px solid #00ffea33;border-radius:4px}
.ui{position:absolute;top:12px;left:12px;right:12px;display:flex;justify-content:space-between;align-items:center;pointer-events:none;z-index:10}
.ui>div{pointer-events:auto;background:rgba(10,10,18,0.85);border:1px solid var(--accent);padding:8px 16px;border-radius:4px;text-shadow:0 0 8px var(--accent);font-weight:700;letter-spacing:1px}
.ui .title{font-size:1.2rem;font-weight:900;text-align:center;flex:1;background:none;border:none;padding:0;text-shadow:0 0 12px var(--accent2),0 0 24px var(--accent)}
.btn{background:linear-gradient(135deg,#00ffea22,#ff00c822);border:1px solid var(--accent);color:var(--fg);padding:10px 28px;font-family:inherit;font-size:1rem;font-weight:700;letter-spacing:2px;cursor:pointer;transition:all .2s;text-transform:uppercase;box-shadow:0 0 20px rgba(0,255,234,0.3)}
.btn:hover,.btn:active{background:linear-gradient(135deg,var(--accent),var(--accent2));color:#000;box-shadow:0 0 30px var(--accent),0 0 60px var(--accent2)}
.overlay{position:fixed;inset:0;background:rgba(0,0,0,0.95);display:flex;flex-direction:column;align-items:center;justify-content:center;gap:20px;z-index:20;opacity:0;pointer-events:none;transition:opacity .3s;padding:20px}
.overlay.active{opacity:1;pointer-events:auto}
.overlay.hidden{display:none}
.overlay h1{font-size:clamp(32px, 8vw, 64px);font-weight:900;background:linear-gradient(90deg,var(--accent),var(--accent2));-webkit-background-clip:text;-webkit-text-fill-color:transparent;text-shadow:0 0 30px var(--accent);letter-spacing:4px}
.overlay p{font-size:1.2rem;color:var(--warn);text-shadow:0 0 10px var(--warn);text-align:center;max-width:400px;line-height:1.6}
.overlay .stats{display:flex;gap:30px;text-align:center}
.overlay .stat{display:flex;flex-direction:column}
.overlay .stat span:first-child{font-size:2.5rem;font-weight:900;color:var(--accent);text-shadow:0 0 15px var(--accent)}
.overlay .stat span:last-child{font-size:.8rem;color:#888;text-transform:uppercase;letter-spacing:2px}
.mobile-hint{position:absolute;bottom:12px;left:50%;transform:translateX(-50%);font-size:.75rem;color:#666;text-align:center;pointer-events:none;letter-spacing:1px}
@media (max-width:600px){.ui{top:8px;left:8px;right:8px}.ui>div{padding:6px 10px;font-size:.8rem}.overlay h1{font-size:2rem}.overlay .stats{gap:15px}.overlay .stat span:first-child{font-size:1.8rem}}
.mobile-hint { color: #ff6b00; font-size: 12px; }
</style>
</head>
<body>
<canvas id="c"></canvas>
<div class="ui">
<div class="title">NEON SWING</div>
<div>SCORE: <span id="score">0</span></div>
<div>BEST: <span id="best">0</span></div>
</div>
<div class="overlay active" id="startOverlay">
<h1>NEON SWING</h1>
<p>Click / Tap to swing. Avoid the walls. Survive as long as possible.</p>
<button class="btn" id="startBtn">START</button>
</div>
<div class="overlay hidden" id="pauseOverlay">
<h1>PAUSED</h1>
<button class="btn" id="resumeBtn">RESUME</button>
<button class="btn" id="quitBtn">QUIT TO MENU</button>
</div>
<div class="overlay hidden" id="gameOverOverlay">
<h1>GAME OVER</h1>
<div class="stats">
<div class="stat"><span id="finalScore">0</span><span>Score</span></div>
<div class="stat"><span id="finalBest">0</span><span>Best</span></div>
</div>
<button class="btn" id="retryBtn">RETRY</button>
<button class="btn" id="menuBtn">MAIN MENU</button>
</div>
<div class="mobile-hint">Tap to swing | ESC/P to pause</div>
<script>
const canvas = document.getElementById('c');
const ctx = canvas.getContext('2d');
let width, height;
function resize() {
  width = canvas.width = Math.min(window.innerWidth, 800);
  height = canvas.height = Math.min(window.innerHeight, 600);
}
window.addEventListener('resize', resize);
resize();

const scoreEl = document.getElementById('score');
const bestEl = document.getElementById('best');
const startOverlay = document.getElementById('startOverlay');
const pauseOverlay = document.getElementById('pauseOverlay');
const gameOverOverlay = document.getElementById('gameOverOverlay');
const startBtn = document.getElementById('startBtn');
const resumeBtn = document.getElementById('resumeBtn');
const quitBtn = document.getElementById('quitBtn');
const retryBtn = document.getElementById('retryBtn');
const menuBtn = document.getElementById('menuBtn');
const finalScoreEl = document.getElementById('finalScore');
const finalBestEl = document.getElementById('finalBest');

let best = parseInt(localStorage.getItem('neonSwingBest')) || 0;
bestEl.textContent = best;

let state = 'start'; // start, playing, paused, gameover
let score = 0;
let frame = 0;
let rafId = null;

const player = {
  x: 0, y: 0, vx: 0, vy: 0, radius: 12,
  angle: 0, swingRadius: 0, swinging: false, anchor: null
};

const anchors = [];
const particles = [];
const walls = [];

function initGame() {
  player.x = width / 2;
  player.y = height * 0.2;
  player.vx = 0;
  player.vy = 0;
  player.swinging = false;
  player.anchor = null;
  score = 0;
  frame = 0;
  anchors.length = 0;
  particles.length = 0;
  walls.length = 0;
  generateAnchors();
  generateWalls();
  scoreEl.textContent = score;
}

function generateAnchors() {
  const cols = 4, rows = 3;
  const marginX = 60, marginY = 80;
  for (let i = 0; i < cols; i++) {
    for (let j = 0; j < rows; j++) {
      const x = marginX + i * (width - 2 * marginX) / (cols - 1);
      const y = marginY + j * (height - 2 * marginY) / (rows - 1);
      anchors.push({ x, y, radius: 8, active: true, pulse: Math.random() * Math.PI * 2 });
    }
  }
}

function generateWalls() {
  const thickness = 20;
  walls.push({ x: 0, y: 0, w: width, h: thickness }); // top
  walls.push({ x: 0, y: height - thickness, w: width, h: thickness }); // bottom
  walls.push({ x: 0, y: 0, w: thickness, h: height }); // left
  walls.push({ x: width - thickness, y: 0, w: thickness, h: height }); // right
}

function startGame() {
  state = 'playing';
  startOverlay.classList.remove('active');
  startOverlay.classList.add('hidden');
  pauseOverlay.classList.add('hidden');
  gameOverOverlay.classList.add('hidden');
  initGame();
  if (rafId) cancelAnimationFrame(rafId);
  loop();
}

function pauseGame() {
  if (state !== 'playing') return;
  state = 'paused';
  pauseOverlay.classList.remove('hidden');
  pauseOverlay.classList.add('active');
  cancelAnimationFrame(rafId);
}

function resumeGame() {
  if (state !== 'paused') return;
  state = 'playing';
  pauseOverlay.classList.remove('active');
  pauseOverlay.classList.add('hidden');
  loop();
}

function quitToMenu() {
  state = 'start';
  pauseOverlay.classList.remove('active');
  pauseOverlay.classList.add('hidden');
  startOverlay.classList.remove('hidden');
  startOverlay.classList.add('active');
  cancelAnimationFrame(rafId);
}

function showStartScreen() {
  state = 'start';
  gameOverOverlay.classList.remove('active');
  gameOverOverlay.classList.add('hidden');
  startOverlay.classList.remove('hidden');
  startOverlay.classList.add('active');
  cancelAnimationFrame(rafId);
}

function gameOver() {
  state = 'gameover';
  if (score > best) {
    best = score;
    localStorage.setItem('neonSwingBest', best);
    bestEl.textContent = best;
  }
  finalScoreEl.textContent = score;
  finalBestEl.textContent = best;
  gameOverOverlay.classList.remove('hidden');
  gameOverOverlay.classList.add('active');
  cancelAnimationFrame(rafId);
}

function loop() {
  if (state !== 'playing') return;
  update();
  draw();
  rafId = requestAnimationFrame(loop);
}

function update() {
  frame++;
  score = Math.floor(frame / 6);
  scoreEl.textContent = score;

  const gravity = 0.35;
  const friction = 0.99;
  const maxSpeed = 15;

  if (player.swinging && player.anchor) {
    const dx = player.anchor.x - player.x;
    const dy = player.anchor.y - player.y;
    const dist = Math.hypot(dx, dy);
    const targetDist = player.swingRadius;
    if (dist > 0) {
      const force = (dist - targetDist) * 0.02;
      player.vx += dx / dist * force;
      player.vy += dy / dist * force;
    }
    player.vy += gravity * 0.3;
  } else {
    player.vy += gravity;
  }

  player.vx *= friction;
  player.vy *= friction;
  const speed = Math.hypot(player.vx, player.vy);
  if (speed > maxSpeed) {
    player.vx = player.vx / speed * maxSpeed;
    player.vy = player.vy / speed * maxSpeed;
  }

  player.x += player.vx;
  player.y += player.vy;

  // Wall collision
  for (const wall of walls) {
    if (player.x + player.radius > wall.x &&
        player.x - player.radius < wall.x + wall.w &&
        player.y + player.radius > wall.y &&
        player.y - player.radius < wall.y + wall.h) {
      // Determine collision side
      const overlapX = Math.min(player.x + player.radius - wall.x, wall.x + wall.w - (player.x - player.radius));
      const overlapY = Math.min(player.y + player.radius - wall.y, wall.y + wall.h - (player.y - player.radius));
      if (overlapX < overlapY) {
        if (player.x < wall.x + wall.w / 2) player.x = wall.x - player.radius;
        else player.x = wall.x + wall.w + player.radius;
        player.vx *= -0.5;
      } else {
        if (player.y < wall.y + wall.h / 2) player.y = wall.y - player.radius;
        else player.y = wall.y + wall.h + player.radius;
        player.vy *= -0.5;
      }
      // Game over if hit wall hard
      if (Math.abs(player.vx) > 8 || Math.abs(player.vy) > 8) {
        gameOver();
        return;
      }
    }
  }

  // Anchor pulse
  for (const a of anchors) {
    a.pulse += 0.05;
  }

  // Particles
  for (let i = particles.length - 1; i >= 0; i--) {
    const p = particles[i];
    p.x += p.vx;
    p.y += p.vy;
    p.life -= 1;
    p.alpha = p.life / p.maxLife;
    if (p.life <= 0) particles.splice(i, 1);
  }

  // Spawn trail particles when swinging fast
  if (player.swinging && speed > 5) {
    particles.push({
      x: player.x, y: player.y,
      vx: (Math.random() - 0.5) * 2,
      vy: (Math.random() - 0.5) * 2,
      radius: Math.random() * 3 + 1,
      color: Math.random() > 0.5 ? '#00ffea' : '#ff00c8',
      life: 30, maxLife: 30, alpha: 1
    });
  }
}

function draw() {
  ctx.clearRect(0, 0, width, height);

  // Grid background
  ctx.strokeStyle = '#00ffea11';
  ctx.lineWidth = 1;
  const gridSize = 40;
  for (let x = 0; x <= width; x += gridSize) {
    ctx.beginPath();
    ctx.moveTo(x, 0);
    ctx.lineTo(x, height);
    ctx.stroke();
  }
  for (let y = 0; y <= height; y += gridSize) {
    ctx.beginPath();
    ctx.moveTo(0, y);
    ctx.lineTo(width, y);
    ctx.stroke();
  }

  // Walls
  ctx.fillStyle = '#00ffea44';
  for (const wall of walls) {
    ctx.fillRect(wall.x, wall.y, wall.w, wall.h);
  }

  // Anchors
  for (const a of anchors) {
    const pulse = Math.sin(a.pulse) * 2 + 8;
    const grad = ctx.createRadialGradient(a.x, a.y, 0, a.x, a.y, pulse * 2);
    grad.addColorStop(0, '#00ffea88');
    grad.addColorStop(1, '#00ffea00');
    ctx.fillStyle = grad;
    ctx.beginPath();
    ctx.arc(a.x, a.y, pulse * 2, 0, Math.PI * 2);
    ctx.fill();

    ctx.strokeStyle = '#00ffea';
    ctx.lineWidth = 2;
    ctx.shadowColor = '#00ffea';
    ctx.shadowBlur = 10;
    ctx.beginPath();
    ctx.arc(a.x, a.y, a.radius, 0, Math.PI * 2);
    ctx.stroke();
    ctx.shadowBlur = 0;
  }

  // Rope
  if (player.swinging && player.anchor) {
    ctx.strokeStyle = '#ff00c8';
    ctx.lineWidth = 3;
    ctx.shadowColor = '#ff00c8';
    ctx.shadowBlur = 15;
    ctx.beginPath();
    ctx.moveTo(player.x, player.y);
    ctx.lineTo(player.anchor.x, player.anchor.y);
    ctx.stroke();
    ctx.shadowBlur = 0;
  }

  // Particles
  for (const p of particles) {
    ctx.globalAlpha = p.alpha;
    ctx.fillStyle = p.color;
    ctx.shadowColor = p.color;
    ctx.shadowBlur = 10;
    ctx.beginPath();
    ctx.arc(p.x, p.y, p.radius, 0, Math.PI * 2);
    ctx.fill();
    ctx.shadowBlur = 0;
  }
  ctx.globalAlpha = 1;

  // Player
  const playerGrad = ctx.createRadialGradient(player.x, player.y, 0, player.x, player.y, player.radius * 2);
  playerGrad.addColorStop(0, '#fff');
  playerGrad.addColorStop(0.5, '#00ffea');
  playerGrad.addColorStop(1, '#ff00c8');
  ctx.fillStyle = playerGrad;
  ctx.shadowColor = '#00ffea';
  ctx.shadowBlur = 20;
  ctx.beginPath();
  ctx.arc(player.x, player.y, player.radius, 0, Math.PI * 2);
  ctx.fill();
  ctx.shadowBlur = 0;

  // Inner glow
  ctx.fillStyle = '#fff';
  ctx.beginPath();
  ctx.arc(player.x, player.y, player.radius * 0.4, 0, Math.PI * 2);
  ctx.fill();
}

function findNearestAnchor(x, y, maxDist = 200) {
  let nearest = null;
  let minDist = maxDist;
  for (const a of anchors) {
    const d = Math.hypot(a.x - x, a.y - y);
    if (d < minDist) {
      minDist = d;
      nearest = a;
    }
  }
  return nearest;
}

function attachToAnchor(anchor) {
  player.swinging = true;
  player.anchor = anchor;
  const dx = anchor.x - player.x;
  const dy = anchor.y - player.y;
  player.swingRadius = Math.hypot(dx, dy);
  // Add velocity perpendicular to rope for swing momentum
  const perpX = -dy / player.swingRadius;
  const perpY = dx / player.swingRadius;
  const speed = Math.hypot(player.vx, player.vy);
  player.vx += perpX * speed * 0.5;
  player.vy += perpY * speed * 0.5;
}

function detachAnchor() {
  player.swinging = false;
  player.anchor = null;
}

function handlePointerDown(x, y) {
  if (state !== 'playing') return;
  const anchor = findNearestAnchor(x, y);
  if (anchor && !player.swinging) {
    attachToAnchor(anchor);
  } else if (player.swinging) {
    detachAnchor();
  }
}

function handlePointerMove(x, y) {
  // Not used for swing mechanic, but could be for aiming
}

canvas.addEventListener('mousedown', e => {
  const rect = canvas.getBoundingClientRect();
  handlePointerDown(e.clientX - rect.left, e.clientY - rect.top);
}, { passive: false });

canvas.addEventListener('touchstart', e => {
  e.preventDefault();
  const rect = canvas.getBoundingClientRect();
  const touch = e.touches[0];
  handlePointerDown(touch.clientX - rect.left, touch.clientY - rect.top);
}, { passive: false });

canvas.addEventListener('touchmove', e => {
  e.preventDefault();
}, { passive: false });

window.addEventListener('keydown', e => {
  if (e.key === 'Escape' || e.key === 'p' || e.key === 'P') {
    if (state === 'playing') pauseGame();
    else if (state === 'paused') resumeGame();
  }
  if (e.key === ' ' && state === 'playing') {
    if (player.swinging) detachAnchor();
    else {
      const anchor = findNearestAnchor(player.x, player.y);
      if (anchor) attachToAnchor(anchor);
    }
  }
});

startBtn.addEventListener('click', startGame);
resumeBtn.addEventListener('click', resumeGame);
quitBtn.addEventListener('click', quitToMenu);
retryBtn.addEventListener('click', startGame);
menuBtn.addEventListener('click', showStartScreen);

// Initial show
showStartScreen();
</script>
</body>
</html>