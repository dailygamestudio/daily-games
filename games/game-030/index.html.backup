<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no">
<title>Neon Swing - Day 30</title>
<style>
:root { --bg:#0a0a12; --fg:#e0e0ff; --accent:#00ffea; --accent2:#ff00c8; --warn:#ffcc00; }
*{margin:0;padding:0;box-sizing:border-box}
body{background:var(--bg);color:var(--fg);font-family:'Orbitron',sans-serif;min-height:100vh;display:flex;flex-direction:column;align-items:center;overflow:hidden}
@import url('https://fonts.googleapis.com/css2?family=Orbitron:wght@400;700;900&display=swap');
canvas{display:block;background:radial-gradient(ellipse at center,#1a1a2e 0%,#0a0a12 70%);box-shadow:0 0 60px rgba(0,255,234,0.15),inset 0 0 60px rgba(0,0,0,0.5);border:2px solid #00ffea33;border-radius:4px}
.ui{position:absolute;top:12px;left:12px;right:12px;display:flex;justify-content:space-between;align-items:center;pointer-events:none;z-index:10}
.ui>div{pointer-events:auto;background:rgba(10,10,18,0.85);border:1px solid var(--accent);padding:8px 16px;border-radius:4px;text-shadow:0 0 8px var(--accent);font-weight:700;letter-spacing:1px}
.ui .title{font-size:1.2rem;font-weight:900;text-align:center;flex:1;background:none;border:none;padding:0;text-shadow:0 0 12px var(--accent2),0 0 24px var(--accent)}
.btn{background:linear-gradient(135deg,#00ffea22,#ff00c822);border:1px solid var(--accent);color:var(--fg);padding:10px 28px;font-family:inherit;font-size:1rem;font-weight:700;letter-spacing:2px;cursor:pointer;transition:all .2s;text-transform:uppercase;box-shadow:0 0 20px rgba(0,255,234,0.3)}
.btn:hover,.btn:active{background:linear-gradient(135deg,var(--accent),var(--accent2));color:#000;box-shadow:0 0 30px var(--accent),0 0 60px var(--accent2)}
.overlay{position:fixed;inset:0;background:rgba(0,0,0,0.95);display:flex;flex-direction:column;align-items:center;justify-content:center;gap:20px;z-index:20;opacity:0;pointer-events:none;transition:opacity .3s;padding:20px}
.overlay.active{opacity:1;pointer-events:auto}
.overlay.hidden{display:none}
.overlay h1{font-size:clamp(32px, 8vw, 64px);font-weight:900;background:linear-gradient(90deg,var(--accent),var(--accent2));-webkit-background-clip:text;-webkit-text-fill-color:transparent;text-shadow:0 0 30px var(--accent);letter-spacing:4px}
.overlay p{font-size:1.2rem;color:var(--warn);text-shadow:0 0 10px var(--warn);text-align:center;max-width:400px;line-height:1.6}
.overlay .stats{display:flex;gap:30px;text-align:center}
.overlay .stat{display:flex;flex-direction:column}
.overlay .stat span:first-child{font-size:2.5rem;font-weight:900;color:var(--accent);text-shadow:0 0 15px var(--accent)}
.overlay .stat span:last-child{font-size:.8rem;color:#888;text-transform:uppercase;letter-spacing:2px}
.mobile-hint{position:absolute;bottom:12px;left:50%;transform:translateX(-50%);font-size:.75rem;color:#666;text-align:center;pointer-events:none;letter-spacing:1px}
@media (max-width:600px){.ui{top:8px;left:8px;right:8px}.ui>div{padding:6px 10px;font-size:.8rem}.overlay h1{font-size:2rem}.overlay .stats{gap:15px}.overlay .stat span:first-child{font-size:1.8rem}}
.mobile-hint { color: #ff6b00; font-size: 12px; }
</style>
</head>
<body>
<canvas id="c"></canvas>
<div class="ui">
<div class="title">NEON SWING</div>
<div>SCORE: <span id="score">0</span></div>
<div>BEST: <span id="best">0</span></div>
</div>
<div class="overlay active" id="startOverlay">
<h1>NEON SWING</h1>
<p>Click /